<?xml version="1.0" encoding="UTF-8"?>
<!--
  TSVG report template (tsvg new <dir>). Built on the tsvg:report library: edit the props, nothing else.
  Each line below is one scene. say = the narration (also the caption): 1–3 short sentences.
  Lists: items separated by |, an item may add a detail after ::  ("Fixed login :: the token refresh ran twice").
  Swap images/screenshot.jpg for your own screenshot; box="x y w h" marks the part that matters (fractions 0–1).
  Delete scenes you don't need. More scene types: tsvg lib report (stat, compare, code). Then: tsvg make <file>.tsvg
-->
<tsvg version="0.3" title="TICKET-1: what this report is about">
  <import src="tsvg:report" as="r" key="TICKET-1"/>
  <timeline>
    <r:title title="What this report is about" sub="One line: the outcome, in plain words"
             say="Here is what changed in this ticket, in under a minute."/>
    <r:list title="What changed" items="First change, short | Second change :: an optional detail line | Third change"
            say="Three things changed. Say them in one or two plain sentences."/>
    <r:shot src="images/screenshot.jpg" box="0.08 0.10 0.42 0.40" caption="Where to look on the screenshot"
            say="This is where to look. The box marks the part that matters."/>
    <r:list kind="check" title="How it was checked" items="Tests: 42/42 pass | Checked in the browser on phone and desktop"
            say="How it was checked: the tests pass and it was tried by hand."/>
    <r:list kind="open" title="Still open" items="Anything not verified, or a decision needed"
            say="One thing is still open. It is listed here."/>
  </timeline>
</tsvg>
