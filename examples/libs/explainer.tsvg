<?xml version="1.0" encoding="UTF-8"?>
<tsvg version="0.3" title="How vaccines work">
  <import src="tsvg:explainer" as="ex"/>
  <timeline>
    <ex:title title="How vaccines work" kicker="Explained in a minute" sub="A short explainer" say="How do vaccines actually work?"/>
    <ex:point text="Your body learns from a harmless copy" kicker="The idea" icon="idea" say="Your body learns from a harmless copy."/>
    <ex:chapter n="1" title="The three steps" say="Here are the steps."/>
    <ex:steps title="Three steps" items="Show :: a harmless piece | Learn :: the immune system trains | Remember :: memory cells stay" say="Show, learn, remember."/>
    <ex:stat value="95" suffix="%" label="fewer severe cases" sub="in trials" say="Up to ninety five percent fewer severe cases."/>
    <ex:quote text="Prevention is better than cure." by="Erasmus" say="Prevention is better than cure."/>
    <ex:picture src="images/screenshot.jpg" caption="A picture with a slow zoom" say="Pictures get a slow zoom."/>
    <ex:versus left="Vaccine" right="Infection" ltext="Safe practice run" rtext="The real, risky thing" say="A practice run versus the real thing."/>
    <ex:outro title="That's it" sub="Share it with someone curious" say="That's it."/>
  </timeline>


