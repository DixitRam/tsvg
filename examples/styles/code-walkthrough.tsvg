<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: code walkthrough. An editor panel in JetBrains Mono with token colours (one text node per token at
     column × 0.6 em), a highlight bar that moves between lines, annotations that pop out beside them,
     and a unified diff (− / +) where following lines slide down to make room. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:am_michael"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
    <option id="theme" label="Theme" default="night"><choice id="night" label="Night"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.18" sfx="0.5"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
  </mixes>
  <themes>
    <theme id="night" bg="#070a12" fg="#e6ebf5" muted="#7f8aa3" panel="#0f1422" bar="#151b2d" line="#1f2740" accent="#82aaff" note="#ffcb6b" good="#4ade80" bad="#f87171"/>
  </themes>
  <strings>
    <s id="title" en="Code walkthrough: debounce() in TypeScript"/>
    <s id="file" en="debounce.ts"/>
    <s id="h1" en="debounce()"/><s id="h1b" en="Wait until the typing stops. Explained line by line."/>
    <s id="a2" en="A generic T keeps the caller's argument types."/>
    <s id="a2b" en="wait defaults to 300 ms."/>
    <s id="a3" en="One timer, shared by every call through the closure."/>
    <s id="a4" en="Each call cancels the pending run…"/>
    <s id="a4b" en="…and schedules a fresh one."/>
    <s id="ks" en="keystrokes"/><s id="fires" en="fn() runs once"/>
    <s id="a5" en="Diff: give the returned function a cancel(), so a closing screen can drop the pending call."/>
    <s id="a6" en="Usage"/>
    <s id="a6b" en="Save the draft 500 ms after the last key, and never after unmount."/>
    <s id="r1" en="One timer in a closure"/><s id="r2" en="Clear, then set again"/><s id="r3" en="Expose cancel() for cleanup"/>
    <s id="ch1" en="Intro"/><s id="ch2" en="Signature"/><s id="ch3" en="The timer"/><s id="ch4" en="The returned function"/><s id="ch5" en="Diff: cancel()"/><s id="ch6" en="Usage"/><s id="ch7" en="Recap"/>
    <s id="vo1" en="Let's read a debounce function, line by line. It waits until a burst of calls stops, then runs once."/>
    <s id="vo2" en="The signature. A generic T keeps the caller's argument types, and wait defaults to three hundred milliseconds."/>
    <s id="vo3" en="Line five holds a single timer. Every call shares it, through the closure."/>
    <s id="vo4" en="The returned function does two things. It clears the pending timer, then schedules a new one. So only the last call in a burst survives."/>
    <s id="vo5" en="Now a small change. We name the function run, attach a cancel method, and return it. A closing screen can now drop the pending call."/>
    <s id="vo6" en="In use: save the draft five hundred milliseconds after the last key, and cancel when the screen unmounts."/>
    <s id="vo7" en="One timer in a closure. Clear, then set again. And expose cancel for cleanup."/>
  </strings>

  <defs>
    <data id="keys" v="20, 70, 110, 160, 210"/>
    <fn id="lastKey" args="p">p &gt;= 210 ? 210 : p &gt;= 160 ? 160 : p &gt;= 110 ? 110 : p &gt;= 70 ? 70 : 20</fn>
    <!-- code types in line by line (scene 1) -->
    <mask id="codeIn"><rect x="0" y="0" w="1920" h="=180 + 600*ease((T - 0.3)/2.2, 'io')" fill="#000"/></mask>
    <mask id="useIn"><rect x="1240" y="380" w="=640*clamp((T - 0.8)/1.4, 0, 1)" h="150" fill="#000"/></mask>
    <symbol id="code">
  <group y="215" opacity="1"><text x="210.0" size="28" font="JetBrains Mono" fill="#c792ea" text="export"/><text x="327.6" size="28" font="JetBrains Mono" fill="#c792ea" text="function"/><text x="478.8" size="28" font="JetBrains Mono" fill="#82aaff" text="debounce"/><text x="613.2" size="28" font="JetBrains Mono" fill="#89ddff" text="&lt;"/><text x="630.0" size="28" font="JetBrains Mono" fill="#ffcb6b" text="T"/><text x="663.6" size="28" font="JetBrains Mono" fill="#c792ea" text="extends"/><text x="798.0" size="28" font="JetBrains Mono" fill="#ffcb6b" text="unknown"/><text x="915.6" size="28" font="JetBrains Mono" fill="#89ddff" text="["/><text x="932.4" size="28" font="JetBrains Mono" fill="#89ddff" text="]"/><text x="949.2" size="28" font="JetBrains Mono" fill="#89ddff" text="&gt;"/><text x="966.0" size="28" font="JetBrains Mono" fill="#89ddff" text="("/></group>
  <group y="265" opacity="1"><text x="243.6" size="28" font="JetBrains Mono" fill="#82aaff" text="fn"/><text x="277.2" size="28" font="JetBrains Mono" fill="#89ddff" text=":"/><text x="310.8" size="28" font="JetBrains Mono" fill="#89ddff" text="("/><text x="327.6" size="28" font="JetBrains Mono" fill="#89ddff" text="..."/><text x="378.0" size="28" font="JetBrains Mono" fill="#d6deeb" text="args"/><text x="445.20000000000005" size="28" font="JetBrains Mono" fill="#89ddff" text=":"/><text x="478.8" size="28" font="JetBrains Mono" fill="#ffcb6b" text="T"/><text x="495.6" size="28" font="JetBrains Mono" fill="#89ddff" text=")"/><text x="529.2" size="28" font="JetBrains Mono" fill="#89ddff" text="{'=&gt;'}"/><text x="579.6" size="28" font="JetBrains Mono" fill="#ffcb6b" text="void"/><text x="646.8" size="28" font="JetBrains Mono" fill="#89ddff" text=","/></group>
  <group y="315" opacity="1"><text x="243.6" size="28" font="JetBrains Mono" fill="#d6deeb" text="wait"/><text x="327.6" size="28" font="JetBrains Mono" fill="#89ddff" text="{'='}"/><text x="361.20000000000005" size="28" font="JetBrains Mono" fill="#f78c6c" text="300"/><text x="411.6" size="28" font="JetBrains Mono" fill="#89ddff" text=","/></group>
  <group y="365" opacity="1"><text x="210.0" size="28" font="JetBrains Mono" fill="#89ddff" text=")"/><text x="243.6" size="28" font="JetBrains Mono" fill="#89ddff" text="{"/></group>
  <group y="415" opacity="1"><text x="243.6" size="28" font="JetBrains Mono" fill="#c792ea" text="let"/><text x="310.8" size="28" font="JetBrains Mono" fill="#d6deeb" text="timer"/><text x="394.8" size="28" font="JetBrains Mono" fill="#89ddff" text=":"/><text x="428.4" size="28" font="JetBrains Mono" fill="#ffcb6b" text="ReturnType"/><text x="596.4000000000001" size="28" font="JetBrains Mono" fill="#89ddff" text="&lt;"/><text x="613.2" size="28" font="JetBrains Mono" fill="#c792ea" text="typeof"/><text x="730.8000000000001" size="28" font="JetBrains Mono" fill="#82aaff" text="setTimeout"/><text x="898.8000000000001" size="28" font="JetBrains Mono" fill="#89ddff" text="&gt;"/><text x="932.4" size="28" font="JetBrains Mono" fill="#89ddff" text="|"/><text x="966.0" size="28" font="JetBrains Mono" fill="#ffcb6b" text="undefined"/><text x="1117.2" size="28" font="JetBrains Mono" fill="#89ddff" text=";"/></group>
  <group y="465" opacity="1"></group>
  <rect x="170" y="491" w="1010" h="48" fill="#f43f5e2e" opacity="=clamp((t-37)/0.3,0,1)"/>
