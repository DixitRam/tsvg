  </group>
</symbol>
    <symbol id="editor">
      <rect x="80" y="110" w="1100" h="860" r="18" fill="$panel" stroke="$line" sw="2" shadow="0 30 70 #000a"/>
      <rect x="80" y="110" w="1100" h="54" r="18" fill="$bar"/><rect x="80" y="146" w="1100" h="18" fill="$bar"/>
      <circle x="112" y="137" r="7" fill="#ff5f57"/><circle x="136" y="137" r="7" fill="#febc2e"/><circle x="160" y="137" r="7" fill="#28c840"/>
      <rect x="196" y="118" w="200" h="46" r="10" fill="$panel"/>
      <rect x="214" y="131" w="22" h="20" r="4" fill="#3178c6"/><text x="225" y="141" size="11" weight="800" align="center" fill="#fff" text="TS"/>
      <text x="248" y="141" size="20" fill="$fg" text="@file"/>
      <rect x="80" y="164" w="90" h="806" fill="#0c101c"/>
    </symbol>
  </defs>

  <assets>
    <asset id="bed" src="audio/pad.m4a"/>
    <asset id="blip" src="audio/blip.m4a"/>
    <asset id="pop" src="audio/pop.m4a"/>
    <asset id="typing" src="audio/typing.m4a"/>
    <asset id="whoosh" src="audio/whoosh.m4a"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <font family="JetBrains Mono" src="fonts/JetBrainsMono.ttf"/>
  </assets>

  <music src="bed" start="0" loop="1" vol="0.6"/>

  <timeline>
    <!-- 1 · intro -->
    <scene id="intro" dur="8" chapter="@ch1">
      <say at="0.5" text="@vo1"/>
      <sfx at="0.2" src="whoosh"/>
      <group><anim prop="opacity" from="0" to="1" dur="0.6"/><use ref="editor"/></group>
      <group mask="url(#codeIn)"><use ref="code"/></group>
      <group x="1240" y="420" at="0.8"><anim prop="opacity" from="0" to="1" dur="0.6"/><anim prop="x" from="1280" to="1240" dur="0.6"/>
        <text y="0" size="96" weight="800" font="JetBrains Mono" fill="$accent" text="@h1"/>
        <text y="110" size="36" maxw="600" lh="1.3" fill="$muted" text="@h1b"/>
      </group>
    </scene>

    <!-- 2 · the signature, lines 1-4 -->
    <scene id="sig" dur="9" chapter="@ch2">
      <say at="0.4" text="@vo2"/>
      <sfx at="0.6" src="blip"/><sfx at="4.2" src="blip"/>
      <use ref="editor"/>
      <rect x="170" y="190" w="1010" h="200" fill="#82aaff14"><keys prop="y" ease="io" v="3.8: 190; 4.4: 290"/><keys prop="h" ease="io" v="3.8: 200; 4.4: 50"/></rect>
      <rect x="170" y="190" w="5" h="200" fill="$accent"><keys prop="y" ease="io" v="3.8: 190; 4.4: 290"/><keys prop="h" ease="io" v="3.8: 200; 4.4: 50"/></rect>
      <use ref="code"/>
      <group at="0.6"><anim prop="opacity" from="0" to="1" dur="0.4"/>
        <path d="M1050 215 C 1150 215, 1150 260, 1240 260" stroke="$note" sw="3" fill="none"><anim prop="draw" from="0" to="1" dur="0.4"/></path>
        <rect x="1240" y="200" w="600" h="120" r="18" fill="$bar" stroke="$note" sw="2"/>
        <text x="1270" y="260" size="32" maxw="540" lh="1.25" fill="$fg" text="@a2"/>
      </group>
      <group at="4.2"><anim prop="opacity" from="0" to="1" dur="0.4"/><anim prop="y" from="20" to="0" dur="0.4"/>
        <path d="M420 315 L1150 315 C 1200 315, 1200 420, 1240 420" stroke="$note" sw="3" fill="none"><anim prop="draw" from="0" to="1" dur="0.5"/></path>
        <rect x="1240" y="380" w="600" h="80" r="18" fill="$bar" stroke="$note" sw="2"/>
        <text x="1270" y="420" size="32" fill="$fg" text="@a2b"/>
      </group>
    </scene>

    <!-- 3 · line 5, the timer -->
    <scene id="timer" dur="8" chapter="@ch3">
      <say at="0.4" text="@vo3"/>
      <sfx at="0.8" src="blip"/>
      <use ref="editor"/>
      <rect x="170" y="290" w="1010" h="50" fill="#82aaff14"><keys prop="y" ease="io" v="0: 290; 0.6: 390"/></rect>
      <rect x="170" y="290" w="5" h="50" fill="$accent"><keys prop="y" ease="io" v="0: 290; 0.6: 390"/></rect>
      <use ref="code"/>
      <group at="0.8"><anim prop="opacity" from="0" to="1" dur="0.4"/><anim prop="x" from="30" to="0" dur="0.4"/>
        <path d="M1150 415 L1240 415" stroke="$note" sw="3"/>
        <rect x="1240" y="355" w="600" h="120" r="18" fill="$bar" stroke="$note" sw="2"/>
        <text x="1270" y="415" size="32" maxw="540" lh="1.25" fill="$fg" text="@a3"/>
      </group>
      <!-- the closure: three calls point at one timer -->
      <group x="1540" y="680" at="2.4"><anim prop="opacity" from="0" to="1" dur="0.4"/>
        <circle r="60" fill="none" stroke="$note" sw="4"/>
        <path d="M0 -36 V0 L24 16" stroke="$note" sw="5" fill="none" rot="=T*90"/>
        <text y="100" size="24" font="JetBrains Mono" align="center" fill="$note" text="timer"/>
        <group repeat="3" as="k" x="=-220 + k*220" y="200">
          <rect x="-70" y="-26" w="140" h="52" r="12" fill="$bar" stroke="$line" sw="2"/>
          <text size="22" font="JetBrains Mono" align="center" fill="$accent" text="call {k+1}"/>
          <line x1="0" y1="-26" x2="=(220 - k*220)*0.7" y2="-120" stroke="$muted" sw="2" draw="=ease((T - 2.8 - k*0.3)/0.4,'out')"/>
        </group>
      </group>
    </scene>

    <!-- 4 · the returned function, lines 7-10 -->
    <scene id="body" dur="11" chapter="@ch4">
      <say at="0.4" text="@vo4"/>
      <sfx at="1" src="blip"/><sfx at="3" src="blip"/><sfx at="5" src="typing" vol="0.6"/><sfx at="7.2" src="pop"/>
      <use ref="editor"/>
      <rect x="170" y="390" w="1010" h="50" fill="#82aaff14"><keys prop="y" ease="io" v="0: 390; 0.6: 540; 2.6: 540; 3.2: 590"/><keys prop="h" ease="io" v="0: 50; 0.6: 50"/></rect>
      <rect x="170" y="390" w="5" h="50" fill="$accent"><keys prop="y" ease="io" v="0: 390; 0.6: 540; 2.6: 540; 3.2: 590"/></rect>
      <use ref="code"/>
      <group at="1"><anim prop="opacity" from="0" to="1" dur="0.4"/>
        <path d="M630 565 L1150 565 C 1200 565, 1200 540, 1240 540" stroke="$note" sw="3" fill="none"><anim prop="draw" from="0" to="1" dur="0.4"/></path>
        <rect x="1240" y="500" w="600" h="80" r="18" fill="$bar" stroke="$note" sw="2"/>
        <text x="1270" y="540" size="30" fill="$fg" text="@a4"/>
      </group>
      <group at="3.2"><anim prop="opacity" from="0" to="1" dur="0.4"/>
        <path d="M1070 615 L1150 615 C 1200 615, 1200 640, 1240 640" stroke="$note" sw="3" fill="none"><anim prop="draw" from="0" to="1" dur="0.4"/></path>
        <rect x="1240" y="600" w="600" h="80" r="18" fill="$bar" stroke="$note" sw="2"/>
        <text x="1270" y="640" size="30" fill="$fg" text="@a4b"/>
      </group>
      <!-- a burst of keystrokes; the timer restarts each time and fires once after the quiet -->
      <group x="1240" y="820" at="4.6"><anim prop="opacity" from="0" to="1" dur="0.4"/>
        <rect x="0" y="-90" w="600" h="250" r="18" fill="$bar"/>
        <text x="24" y="-50" size="22" weight="600" fill="$muted" text="@ks"/>
        <line x1="24" y1="40" x2="576" y2="40" stroke="$line" sw="3"/>
        <circle repeat="5" as="k" x="=24 + data('keys', k)" y="40" r="11" fill="$accent" when="=24 + 110*(T - 4.8) &gt;= 24 + data('keys', k)"/>
        <rect x="=24 + lastKey(110*(T - 4.8))" y="58" h="14" r="7" w="=min(max(0, 110*(T - 4.8) - lastKey(110*(T - 4.8))), 90)" fill="$note" when="=T &gt; 4.8"/>
        <line x1="=24 + min(110*(T - 4.8), 552)" y1="0" x2="=24 + min(110*(T - 4.8), 552)" y2="80" stroke="$fg" sw="2" when="=T &gt; 4.8"/>
