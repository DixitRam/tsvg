  <group y="515" opacity="=1 - 0.45*clamp((t-37)/0.3,0,1)"><text x="243.6" size="28" font="JetBrains Mono" fill="#c792ea" text="return"/><text x="361.20000000000005" size="28" font="JetBrains Mono" fill="#89ddff" text="("/><text x="378.0" size="28" font="JetBrains Mono" fill="#89ddff" text="..."/><text x="428.4" size="28" font="JetBrains Mono" fill="#d6deeb" text="args"/><text x="495.6" size="28" font="JetBrains Mono" fill="#89ddff" text=":"/><text x="529.2" size="28" font="JetBrains Mono" fill="#ffcb6b" text="T"/><text x="546.0" size="28" font="JetBrains Mono" fill="#89ddff" text=")"/><text x="579.6" size="28" font="JetBrains Mono" fill="#89ddff" text="{'=&gt;'}"/><text x="630.0" size="28" font="JetBrains Mono" fill="#89ddff" text="{"/></group>
  <line x1="210" y1="515" x2="=210+436.8*clamp((t-37.2)/0.5,0,1)" y2="515" stroke="#f87171" sw="2" opacity="=t &gt;= 37.2 ? 1 : 0"/>
  <group y="=565 + 50*ease((t - 37)/0.6, 'io')" opacity="1"><text x="277.2" size="28" font="JetBrains Mono" fill="#82aaff" text="clearTimeout"/><text x="478.8" size="28" font="JetBrains Mono" fill="#89ddff" text="("/><text x="495.6" size="28" font="JetBrains Mono" fill="#d6deeb" text="timer"/><text x="579.6" size="28" font="JetBrains Mono" fill="#89ddff" text=")"/><text x="596.4000000000001" size="28" font="JetBrains Mono" fill="#89ddff" text=";"/></group>
  <group y="=615 + 50*ease((t - 37)/0.6, 'io')" opacity="1"><text x="277.2" size="28" font="JetBrains Mono" fill="#d6deeb" text="timer"/><text x="378.0" size="28" font="JetBrains Mono" fill="#89ddff" text="{'='}"/><text x="411.6" size="28" font="JetBrains Mono" fill="#82aaff" text="setTimeout"/><text x="579.6" size="28" font="JetBrains Mono" fill="#89ddff" text="("/><text x="596.4000000000001" size="28" font="JetBrains Mono" fill="#89ddff" text="("/><text x="613.2" size="28" font="JetBrains Mono" fill="#89ddff" text=")"/><text x="646.8" size="28" font="JetBrains Mono" fill="#89ddff" text="{'=&gt;'}"/><text x="697.2" size="28" font="JetBrains Mono" fill="#82aaff" text="fn"/><text x="730.8000000000001" size="28" font="JetBrains Mono" fill="#89ddff" text="("/><text x="747.6" size="28" font="JetBrains Mono" fill="#89ddff" text="..."/><text x="798.0" size="28" font="JetBrains Mono" fill="#d6deeb" text="args"/><text x="865.2" size="28" font="JetBrains Mono" fill="#89ddff" text=")"/><text x="882.0" size="28" font="JetBrains Mono" fill="#89ddff" text=","/><text x="915.6" size="28" font="JetBrains Mono" fill="#d6deeb" text="wait"/><text x="982.8000000000001" size="28" font="JetBrains Mono" fill="#89ddff" text=")"/><text x="999.6" size="28" font="JetBrains Mono" fill="#89ddff" text=";"/></group>
  <group y="=665 + 50*ease((t - 37)/0.6, 'io')" opacity="1"><text x="243.6" size="28" font="JetBrains Mono" fill="#89ddff" text="}"/><text x="260.4" size="28" font="JetBrains Mono" fill="#89ddff" text=";"/></group>
  <group y="=715 + 150*ease((t - 37)/0.6, 'io')" opacity="1"><text x="210.0" size="28" font="JetBrains Mono" fill="#89ddff" text="}"/></group>
  <text repeat="14" as="r" x="150" y="=215+r*50" size="24" font="JetBrains Mono" align="right" fill="#4b5566" text="{r+1}" opacity="=r &lt; 11 || t &gt;= 37.4 ? 1 : 0"/>
  <group opacity="=clamp((t-37.4)/0.4,0,1)">
    <rect x="170" y="541" w="1010" h="48" fill="#22c55e2e"/>
    <text x="186" y="565" size="26" font="JetBrains Mono" fill="#4ade80" text="+"/>
