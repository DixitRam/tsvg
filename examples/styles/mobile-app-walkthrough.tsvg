<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: mobile app walkthrough. A vector phone frame holds a real screenshot and vector screens;
     finger taps leave ripples, screens slide, a bottom sheet rises, and the phone turns sideways.
     Inside the phone everything is in screen points (390×844); the phone group is centred at its x/y. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
    <layout id="portrait" w="1080" h="1920"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:af_bella"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
    <option id="theme" label="Theme" default="dark"><choice id="dark" label="Dark"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.25" sfx="0.7"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
  </mixes>
  <themes>
    <theme id="dark" bg="#0d1020" fg="#f2f4fb" muted="#9aa3b8" panel="#181c30" accent="#7aa2ff" pink="#ff6b9a" good="#5fd39a" tap="#ffffff"/>
  </themes>
  <strings>
    <s id="title" en="Watch a TSVG video on your phone"/>
    <s id="ch1" en="Open"/><s id="ch2" en="Phone layout"/><s id="ch3" en="Play"/><s id="ch4" en="Options"/><s id="ch5" en="Skip and captions"/><s id="ch6" en="Rotate"/><s id="ch7" en="Done"/>
    <s id="k1" en="MOBILE WALKTHROUGH"/>
    <s id="h1" en="Your videos, in your pocket"/><s id="b1" en="The playground works on any phone browser."/>
    <s id="h2" en="Pick Phone 9:16"/><s id="b2" en="The same file re-lays itself out for a tall screen."/>
    <s id="h3" en="Tap play"/><s id="b3" en="Full screen, drawn live, sharp on every display."/>
    <s id="h4" en="Change options"/><s id="b4" en="Language, audio mix and theme, while it plays."/>
    <s id="h5" en="Double-tap to skip"/><s id="b5" en="Tap the right side for +10 s. CC shows captions."/>
    <s id="h6" en="Turn it sideways"/><s id="b6" en="Auto layout switches to landscape."/>
    <s id="h7" en="That's the tour"/><s id="b7" en="One file. Every screen."/>
    <s id="opt" en="Options"/><s id="o1" en="Language"/><s id="o2" en="Audio"/><s id="o3" en="Theme"/>
    <s id="v1" en="English"/><s id="v2" en="Full"/><s id="dark" en="Dark"/><s id="light" en="Light"/>
    <s id="cap" en="Gradients, clips and masks."/>
    <s id="vo1" en="Here is how a TSVG video plays on your phone. Open the playground in any mobile browser."/>
    <s id="vo1_say" en="Here is how a T. S. V. G. video plays on your phone. Open the playground in any mobile browser."/>
    <s id="vo2" en="Tap Phone nine by sixteen. The same file lays itself out again for a tall screen."/>
    <s id="vo3" en="Tap play. The video goes full screen, drawn live, and sharp on every display."/>
    <s id="vo4" en="Open the options sheet to change the language, the audio mix, or the theme, while it plays."/>
    <s id="vo5" en="Double tap the right side to skip ten seconds. Tap C C to show the captions."/>
    <s id="vo6" en="Turn the phone sideways, and auto layout switches to landscape."/>
    <s id="vo7" en="That is the tour. One file, every screen."/>
  </strings>

  <defs>
    <clip id="scr"><rect x="0" y="0" w="390" h="844" r="46"/></clip>
    <radial id="glow" x="0" y="0" r="700"><stop at="0" color="#7aa2ff" opacity="0.25"/><stop at="1" color="#7aa2ff" opacity="0"/></radial>
    <linear id="ink" x1="-120" y1="0" x2="120" y2="0"><stop at="0" color="#7aa2ff"/><stop at="1" color="#ff6b9a"/></linear>
    <!-- the device: drawn around a 390×844 screen whose top-left is (-195, -422) -->
    <symbol id="frame">
      <rect x="-213" y="-440" w="426" h="880" r="64" fill="#05060b" stroke="#3a4058" sw="3" shadow="0 40 80 #0009"/>
      <rect x="-217" y="-260" w="4" h="70" r="2" fill="#3a4058"/><rect x="213" y="-300" w="4" h="110" r="2" fill="#3a4058"/>
    </symbol>
    <symbol id="island"><rect x="-60" y="-410" w="120" h="34" r="17" fill="#000"/></symbol>
    <!-- the vector player screen; the viewer switches it to light at t = 28.7 (options scene) -->
    <fn id="lk" args="x">ease((x - 28.7)/0.6, 'io')</fn>
    <symbol id="player">
      <rect w="390" h="844" fill="=mix('#0e1117', '#f6f3ec', lk(t))"/>
      <circle x="=110 + 20*sin(T*0.8)" y="200" r="90" fill="#7aa2ff" opacity="0.25"/>
      <circle x="300" y="=560 + 20*sin(T)" r="120" fill="#ff6b9a" opacity="0.2"/>
      <group x="195" y="330">
        <circle r="=86 + 6*sin(T*2)" fill="none" stroke="url(#ink)" sw="8"/>
        <path d="M-60 0 C-40 -50 -20 50 0 0 S 40 -50 60 0" stroke="#5fd39a" sw="5" fill="none"/>
      </group>
      <text x="195" y="490" size="44" weight="800" align="center" fill="url(#ink)" text="Gradients"/>
      <text x="195" y="540" size="18" align="center" fill="=mix('#9aa3b8', '#6b7280', lk(t))" text="clips · masks · shadows"/>
      <!-- controls -->
      <rect x="20" y="752" w="350" h="4" r="2" fill="=mix('#ffffff33', '#00000022', lk(t))"/>
      <rect x="20" y="752" w="=120 + 10*T" h="4" r="2" fill="#ff5a5a"/>
      <circle x="=140 + 10*T" y="754" r="8" fill="#ff5a5a"/>
      <text x="20" y="790" size="16" weight="600" font="Inter" fill="=mix('#ffffff', '#1b1e26', lk(t))" text="0:{fmt(14 + T,0)} / 0:49"/>
      <path d="M28 812 v20 l16 -10 z" fill="=mix('#ffffff', '#1b1e26', lk(t))"/>
      <rect x="276" y="808" w="34" h="26" r="6" fill="none" stroke="=mix('#ffffff', '#1b1e26', lk(t))" sw="2.5"/>
      <text x="293" y="821" size="12" weight="800" align="center" fill="=mix('#ffffff', '#1b1e26', lk(t))" text="CC"/>
      <circle x="350" y="821" r="11" fill="none" stroke="=mix('#ffffff', '#1b1e26', lk(t))" sw="3"/>
      <circle x="350" y="821" r="4" fill="=mix('#ffffff', '#1b1e26', lk(t))"/>
    </symbol>
    <!-- a finger tap: a dot + expanding ring, at (tx, ty) from 0 -->
    <symbol id="tap">
      <circle r="=22*(1 - clamp(T - T0, 0, 0.6)/0.6)" fill="#ffffffaa"/>
      <circle r="=18 + 50*clamp((T - T0)/0.6, 0, 1)" fill="none" stroke="#ffffff" sw="4" opacity="=1 - clamp((T - T0)/0.6, 0, 1)"/>
    </symbol>
  </defs>

  <assets>
    <asset id="shot" src="images/ui-phone-playground.jpg"/>
    <asset id="bed" src="audio/bright.ogg"/>
    <asset id="click" src="audio/click.ogg"/>
    <asset id="whoosh" src="audio/whoosh.ogg"/>
    <asset id="pop" src="audio/pop.ogg"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <font family="Space Grotesk" src="fonts/SpaceGrotesk.ttf"/>
  </assets>

  <music src="bed" start="0" loop="1" vol="0.5"/>

  <backdrop>
    <circle x="1300" y="540" x.portrait="540" y.portrait="1060" r="700" fill="url(#glow)"/>
  </backdrop>

  <timeline>
    <!-- 1 · open the playground -->
    <scene id="open" dur="8" chapter="@ch1">
      <say at="0.5" text="@vo1" speak="@vo1_say"/>
      <sfx at="0.2" src="whoosh"/>
      <group x="140" y="420" x.portrait="540" y.portrait="230"><anim prop="opacity" from="0" to="1" dur="0.6"/>
        <text x="0" y="-150" y.portrait="-90" size="24" weight="800" fill="$accent" align="left" align.portrait="center" text="@k1"/>
        <text x="0" y="0" size="76" size.portrait="64" weight="700" font="Space Grotesk" maxw="820" maxw.portrait="960" lh="1.1" align="left" align.portrait="center" fill="$fg" text="@h1"/>
        <text x="0" y="170" y.portrait="110" size="36" maxw="760" maxw.portrait="900" align="left" align.portrait="center" fill="$muted" text="@b1"/>
      </group>
      <group x="1360" y="540" x.portrait="540" y.portrait="1100" scale="1" scale.portrait="1.3">
        <anim prop="y" from="=portrait ? 1500 : 900" to="=portrait ? 1100 : 540" dur="1.2" ease="out"/>
        <use ref="frame"/>
        <group x="-195" y="-422" clip="url(#scr)">
          <image src="shot" x="0" y="0" w="390" h="844"/>
        </group>
        <use ref="island"/>
      </group>
    </scene>

    <!-- 2 · tap Phone 9:16 -->
    <scene id="layout" dur="8" chapter="@ch2">
      <say at="0.4" text="@vo2"/>
      <sfx at="2" src="click"/><sfx at="2.2" src="pop"/>
      <group x="140" y="420" x.portrait="540" y.portrait="230"><anim prop="opacity" from="0" to="1" dur="0.5"/>
        <text x="0" y="-90" size="24" weight="800" fill="$accent" align="left" align.portrait="center" text="1 / 5"/>
        <text x="0" y="0" size="76" size.portrait="64" weight="700" font="Space Grotesk" maxw="820" align="left" align.portrait="center" fill="$fg" text="@h2"/>
        <text x="0" y="110" size="36" maxw="760" maxw.portrait="900" align="left" align.portrait="center" fill="$muted" text="@b2"/>
      </group>
      <group x="1360" y="540" x.portrait="540" y.portrait="1100" scale="1" scale.portrait="1.3">
        <use ref="frame"/>
        <group x="-195" y="-422" clip="url(#scr)">
          <image src="shot" x="0" y="0" w="390" h="844"/>
          <!-- button state flips -->
          <rect x="194" y="139" w="90" h="30" r="7" fill="#1e2a4d" stroke="#7aa2ff" sw="1.5" at="2.1"/>
          <text x="239" y="154" size="13" weight="600" align="center" fill="#7aa2ff" text="Phone 9:16" at="2.1"/>
          <rect x="70" y="139" w="118" h="30" r="7" fill="#151820" stroke="#3a4058" sw="1.5" at="2.1"/>
          <text x="129" y="154" size="13" weight="600" align="center" fill="#e6e9f2" text="Landscape 16:9" at="2.1"/>
          <!-- the preview re-lays out: a tall frame grows in -->
          <group at="2.6"><anim prop="opacity" from="0" to="1" dur="0.4"/>
            <rect x="0" y="200" w="390" h="200" fill="#0c0e14"/>
            <rect x="140" y="204" w="110" h="196" r="10" fill="#0e1117" stroke="#7aa2ff" sw="2">
              <anim prop="h" from="0" to="196" dur="0.5"/>
            </rect>
            <text x="195" y="260" size="15" weight="800" align="center" fill="#f2f4fb" text="One file."/>
            <rect x="150" y="300" w="90" h="30" r="6" fill="#1a1f2b"/>
            <rect x="150" y="340" w="90" h="30" r="6" fill="#1a1f2b"/>
          </group>
        </group>
        <use ref="island"/>
        <group x="44" y="-268"><use ref="tap" at="2"/></group>
      </group>
    </scene>

    <!-- 3 · tap play → full screen player slides in -->
    <scene id="play" dur="8" chapter="@ch3">
      <say at="0.4" text="@vo3"/>
      <sfx at="1.6" src="click"/><sfx at="1.8" src="whoosh"/>
      <group x="140" y="420" x.portrait="540" y.portrait="230"><anim prop="opacity" from="0" to="1" dur="0.5"/>
        <text x="0" y="-90" size="24" weight="800" fill="$accent" align="left" align.portrait="center" text="2 / 5"/>
        <text x="0" y="0" size="76" size.portrait="64" weight="700" font="Space Grotesk" maxw="820" align="left" align.portrait="center" fill="$fg" text="@h3"/>
        <text x="0" y="110" size="36" maxw="760" maxw.portrait="900" align="left" align.portrait="center" fill="$muted" text="@b3"/>
      </group>
      <group x="1360" y="540" x.portrait="540" y.portrait="1100" scale="1" scale.portrait="1.3">
        <use ref="frame"/>
        <group x="-195" y="-422" clip="url(#scr)">
          <group><keys prop="x" ease="io" v="1.8: 0; 2.4: -390"/>
            <image src="shot" x="0" y="0" w="390" h="844"/>
          </group>
          <group x="390"><keys prop="x" ease="io" v="1.8: 390; 2.4: 0"/>
            <use ref="player"/>
          </group>
        </group>
        <use ref="island"/>
        <group x="-146" y="-54"><use ref="tap" at="1.6"/></group>
      </group>
    </scene>

    <!-- 4 · options sheet, switch theme -->
    <scene id="options" dur="9" chapter="@ch4">
      <say at="0.4" text="@vo4"/>
      <sfx at="1.2" src="click"/><sfx at="1.3" src="whoosh"/><sfx at="4.6" src="click"/>
      <group x="140" y="420" x.portrait="540" y.portrait="230"><anim prop="opacity" from="0" to="1" dur="0.5"/>
        <text x="0" y="-90" size="24" weight="800" fill="$accent" align="left" align.portrait="center" text="3 / 5"/>
        <text x="0" y="0" size="76" size.portrait="64" weight="700" font="Space Grotesk" maxw="820" align="left" align.portrait="center" fill="$fg" text="@h4"/>
        <text x="0" y="110" size="36" maxw="760" maxw.portrait="900" align="left" align.portrait="center" fill="$muted" text="@b4"/>
      </group>
      <group x="1360" y="540" x.portrait="540" y.portrait="1100" scale="1" scale.portrait="1.3">
        <use ref="frame"/>
        <group x="-195" y="-422" clip="url(#scr)">
          <use ref="player"/>
          <rect w="390" h="844" fill="#000" opacity="=0.45*clamp((T-1.3)/0.3,0,1)*(1 - clamp((T-6.2)/0.3,0,1))"/>
          <group y="844" at="1.3">
            <keys prop="y" ease="out" v="0: 844; 0.4: 504; 4.9: 504; 5.3: 844"/>
            <rect w="390" h="380" r="28" fill="#181c30"/>
            <rect x="170" y="12" w="50" h="5" r="3" fill="#3a4058"/>
            <text x="28" y="54" size="22" weight="800" fill="#f2f4fb" text="@opt"/>
            <group repeat="3" as="r" y="=110 + r*70">
              <text x="28" size="19" fill="#9aa3b8" text="=r == 0 ? 'Language' : r == 1 ? 'Audio' : 'Theme'"/>
              <rect x="190" y="-20" w="172" h="40" r="20" fill="=r == 2 &amp;&amp; T &gt; 4.7 ? '#7aa2ff' : '#252a42'"/>
              <text x="276" size="17" weight="700" align="center" fill="#f2f4fb" text="=r == 0 ? 'English' : r == 1 ? 'Full' : (T &gt; 4.7 ? 'Light' : 'Dark')"/>
              <line x1="28" y1="35" x2="362" y2="35" stroke="#252a42" sw="1.5"/>
            </group>
          </group>
        </group>
        <use ref="island"/>
        <group x="155" y="399"><use ref="tap" at="1.2"/></group>
        <group x="81" y="-38"><use ref="tap" at="4.6"/></group>
      </group>
    </scene>

    <!-- 5 · double-tap to skip, CC -->
    <scene id="skip" dur="8" chapter="@ch5">
      <say at="0.4" text="@vo5"/>
      <sfx at="1.4" src="pop"/><sfx at="1.6" src="pop"/><sfx at="4.4" src="click"/>
      <group x="140" y="420" x.portrait="540" y.portrait="230"><anim prop="opacity" from="0" to="1" dur="0.5"/>
        <text x="0" y="-90" size="24" weight="800" fill="$accent" align="left" align.portrait="center" text="4 / 5"/>
        <text x="0" y="0" size="76" size.portrait="64" weight="700" font="Space Grotesk" maxw="820" align="left" align.portrait="center" fill="$fg" text="@h5"/>
        <text x="0" y="110" size="36" maxw="760" maxw.portrait="900" align="left" align.portrait="center" fill="$muted" text="@b5"/>
      </group>
      <group x="1360" y="540" x.portrait="540" y.portrait="1100" scale="1" scale.portrait="1.3">
        <use ref="frame"/>
        <group x="-195" y="-422" clip="url(#scr)">
          <use ref="player"/>
          <!-- skip indicator: a half-moon on the right -->
          <group at="1.6" dur="1.4"><anim prop="opacity" from="1" to="0" at="0.9" dur="0.5"/>
            <ellipse x="390" y="380" rx="160" ry="300" fill="#00000022"/>
            <text x="320" y="380" size="30" weight="800" align="center" fill="#1b1e26" text="» +10 s"/>
          </group>
          <!-- caption bubble -->
          <group at="4.5"><anim prop="opacity" from="0" to="1" dur="0.3"/>
            <rect x="35" y="660" w="320" h="56" r="10" fill="#000000cc"/>
            <text x="195" y="688" size="18" weight="600" align="center" fill="#fff" text="@cap"/>
          </group>
          <rect x="276" y="808" w="34" h="26" r="6" fill="#1b1e26" at="4.5"/>
          <text x="293" y="821" size="12" weight="800" align="center" fill="#fff" text="CC" at="4.5"/>
        </group>
        <use ref="island"/>
        <group x="105" y="-40"><use ref="tap" at="1.4"/></group>
        <group x="105" y="-40"><use ref="tap" at="1.65"/></group>
        <group x="98" y="399"><use ref="tap" at="4.4"/></group>
      </group>
    </scene>

    <!-- 6 · rotate: the phone turns, the layout switches -->
    <scene id="rotate" dur="8" chapter="@ch6">
      <say at="0.4" text="@vo6"/>
      <sfx at="1.2" src="whoosh"/>
      <group x="140" y="420" x.portrait="540" y.portrait="230"><anim prop="opacity" from="0" to="1" dur="0.5"/>
        <text x="0" y="-90" size="24" weight="800" fill="$accent" align="left" align.portrait="center" text="5 / 5"/>
        <text x="0" y="0" size="76" size.portrait="64" weight="700" font="Space Grotesk" maxw="820" align="left" align.portrait="center" fill="$fg" text="@h6"/>
        <text x="0" y="110" size="36" maxw="760" maxw.portrait="900" align="left" align.portrait="center" fill="$muted" text="@b6"/>
      </group>
      <group x="1360" y="540" x.portrait="540" y.portrait="1100" scale="1" scale.portrait="1.3">
        <keys prop="rot" ease="io" v="1.2: 0; 2.4: -90"/>
        <keys prop="x" ease="io" v="1.2: =portrait ? 540 : 1360; 2.4: =portrait ? 540 : 1390"/>
        <keys prop="scale" ease="io" v="1.2: =portrait ? 1.3 : 1; 2.4: =portrait ? 1.15 : 1.15"/>
        <use ref="frame"/>
        <group x="-195" y="-422" clip="url(#scr)">
          <use ref="player" when="=T &lt; 2.4"/>
          <!-- the landscape layout, drawn upright in the rotated phone -->
          <group x="390" y="0" rot="90" at="2.4">
            <anim prop="opacity" from="0" to="1" dur="0.4"/>
              <rect w="844" h="390" fill="#f6f3ec"/>
              <circle x="250" y="170" r="100" fill="none" stroke="url(#ink)" sw="8"/>
              <text x="560" y="150" size="52" weight="800" align="center" fill="url(#ink)" text="Gradients"/>
              <text x="560" y="205" size="20" align="center" fill="#6b7280" text="clips · masks · shadows"/>
              <rect x="40" y="320" w="764" h="4" r="2" fill="#00000022"/>
              <rect x="40" y="320" w="=290 + 10*T" h="4" r="2" fill="#ff5a5a"/>
              <text x="40" y="352" size="16" weight="600" fill="#1b1e26" text="0:{fmt(22 + T, 0)} / 0:49  ·  landscape 1920×1080"/>
                      </group>
        </group>
        <use ref="island"/>
      </group>
    </scene>

    <!-- 7 · outro -->
    <scene id="outro" dur="6.5" chapter="@ch7">
      <say at="0.4" text="@vo7"/>
      <sfx at="0.3" src="pop"/>
      <group x="=W/2" y="=H/2 - 60"><anim prop="opacity" from="0" to="1" dur="0.6"/><anim prop="scale" from="0.9" to="1" dur="0.8" ease="back"/>
        <text y="0" size="96" size.portrait="80" weight="700" font="Space Grotesk" align="center" fill="$fg" text="@h7"/>
        <text y="110" size="44" align="center" fill="url(#ink)" text="@b7"/>
      </group>
      <group x="=W/2 - 160" y="=H/2 + 260" at="0.8">
        <anim prop="opacity" from="0" to="1" dur="0.5"/>
        <!-- small phones: portrait and landscape -->
        <rect x="0" y="-90" w="90" h="180" r="16" fill="#05060b" stroke="#3a4058" sw="3"/>
        <rect x="8" y="-82" w="74" h="164" r="10" fill="#0e1117"/>
        <circle x="45" y="-20" r="20" fill="none" stroke="url(#ink)" sw="4"/>
        <rect x="140" y="-45" w="180" h="90" r="16" fill="#05060b" stroke="#3a4058" sw="3"/>
        <rect x="148" y="-37" w="164" h="74" r="10" fill="#f6f3ec"/>
        <circle x="190" r="20" fill="none" stroke="url(#ink)" sw="4"/>
      </group>
    </scene>
  </timeline>

  <!-- written by `tsvg bake`: one recorded clip per <say> line and language -->
  <voices>
    <voice say="vo1" lang="en" src="voice/mobile-app-walkthrough/en/vo1.6dc08b6c8e.ogg" dur="7.11" hash="6dc08b6c8e" engine="kokoro:af_bella"/>
    <voice say="vo2" lang="en" src="voice/mobile-app-walkthrough/en/vo2.8dd550c46b.ogg" dur="5.61" hash="8dd550c46b" engine="kokoro:af_bella"/>
    <voice say="vo3" lang="en" src="voice/mobile-app-walkthrough/en/vo3.1ce89de7bd.ogg" dur="5.11" hash="1ce89de7bd" engine="kokoro:af_bella"/>
    <voice say="vo4" lang="en" src="voice/mobile-app-walkthrough/en/vo4.07efe8ddba.ogg" dur="5.61" hash="07efe8ddba" engine="kokoro:af_bella"/>
    <voice say="vo5" lang="en" src="voice/mobile-app-walkthrough/en/vo5.86c7b3dcd1.ogg" dur="4.81" hash="86c7b3dcd1" engine="kokoro:af_bella"/>
    <voice say="vo6" lang="en" src="voice/mobile-app-walkthrough/en/vo6.2aaab176b0.ogg" dur="3.81" hash="2aaab176b0" engine="kokoro:af_bella"/>
    <voice say="vo7" lang="en" src="voice/mobile-app-walkthrough/en/vo7.35e3f7ad69.ogg" dur="2.61" hash="35e3f7ad69" engine="kokoro:af_bella"/>
  </voices>
</tsvg>
