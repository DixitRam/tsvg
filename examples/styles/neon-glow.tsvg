      <text x="1420" y="260" size="46" font="Space Grotesk" weight="500" align="left" fill="#f4e9ff" text="@c_neon2" at="0.8999999999999999" shadow="0 0 14 #ff5a36"><anim prop="opacity" from="0" to="1" dur="0.4"/></text>
      
      <group x="560" y="510">
        <rect x="-30" y="-34" w="40" h="68" r="8" fill="#9aa0a8"/><rect x="790" y="-34" w="40" h="68" r="8" fill="#9aa0a8"/>
        <rect x="0" y="-30" w="800" h="60" r="30" fill="#ffffff10" stroke="#ffffff40" sw="3"/>
        
