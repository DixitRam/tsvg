<?xml version="1.0" encoding="UTF-8"?>
<tsvg version="0.2" title="@title" font="Space Grotesk">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:am_michael"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full (voice + music + sfx)"/><choice id="speech" label="Speech only"/><choice id="ambient" label="No voice"/></option>
    <option id="theme" label="Theme" default="night"><choice id="night" label="Night"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.35" sfx="0.7"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
    <mix id="ambient" voice="0" music="0.6" sfx="0.7"/>
  </mixes>
  <themes>
    <theme id="night" bg="#120a0c" fg="#f4e9ff" muted="#a08a9a" accent="#ff4fd8"/>
  </themes>
  <strings>
    <s id="title" en="How a neon sign glows"/>
    <s id="ch1" en="Neon"/>
    <s id="ch2" en="The tube"/>
    <s id="ch3" en="Voltage"/>
    <s id="ch4" en="Light"/>
    <s id="ch5" en="Colours"/>
    <s id="ch6" en="Bending"/>
    <s id="ch7" en="Open"/>
    <s id="t1" en="neon"/>
    <s id="t2" en="how a sign glows"/>
    <s id="l_glass" en="sealed glass tube"/>
    <s id="l_elec" en="electrode"/>
    <s id="l_gas" en="neon gas, almost a vacuum"/>
    <s id="volts" en="15,000 V"/>
    <s id="l_e" en="electrons race through"/>
    <s id="l_hit" en="and hit gas atoms"/>
    <s id="up" en="kick up"/>
    <s id="down" en="fall back = light"/>
    <s id="c_neon" en="neon"/>
    <s id="c_neon2" en="red-orange"/>
    <s id="c_arg" en="argon + mercury"/>
    <s id="c_arg2" en="blue"/>
    <s id="c_ph" en="coated glass"/>
    <s id="c_ph2" en="any colour"/>
    <s id="bend" en="bent by hand over a flame"/>
    <s id="open" en="open"/>
    <s id="late" en="late"/>
    <s id="o2" en="glass · gas · voltage"/>
    <s id="vo_intro" en="A neon sign is a glass tube, a little gas, and a lot of voltage. Here is how it glows."/>
    <s id="vo_tube" en="The tube is sealed glass with an electrode at each end, filled with neon at very low pressure."/>
    <s id="vo_volt" en="A transformer puts about fifteen thousand volts across it. Electrons race through and slam into the gas atoms."/>
    <s id="vo_light" en="Each hit kicks an electron up to a higher orbit. When it falls back, the energy leaves as light."/>
    <s id="vo_col" en="Pure neon glows red orange. Argon with a drop of mercury glows blue. Coatings inside the glass make every other colour."/>
    <s id="vo_bend" en="Each letter is bent by hand over a flame, then pumped empty and filled with gas."/>
    <s id="vo_outro" en="Glass, gas and voltage. That is the glow."/>
  </strings>
  <defs>
<radial id="vig" x="960" y="540" r="1150"><stop at="0.35" color="#000" opacity="0"/><stop at="1" color="#000" opacity="0.85"/></radial>
  </defs>
  <assets>
    <font family="Space Grotesk" src="fonts/SpaceGrotesk.ttf"/>
    <font family="Caveat" src="fonts/Caveat.ttf"/>
    <asset id="drone" src="audio/drone.m4a"/>
    <asset id="click" src="audio/click.m4a"/>
    <asset id="blip" src="audio/blip.m4a"/>
    <asset id="ding" src="audio/ding.m4a"/>
    <asset id="whoosh" src="audio/whoosh.m4a"/>

  </assets>
  <music src="drone" start="0" loop="1" vol="0.6"/>
  <backdrop>

    <group repeat="24" as="row" y="=row*46">
      <rect repeat="17" as="c" x="=c*120 - (row % 2)*60 + 3" y="3" w="114" h="40" r="3" fill="=mix('#2a1519', '#3b1e22', rand(row*31 + c))"/>
    </group>
    <rect w="1920" h="1080" fill="url(#vig)"/>
  </backdrop>
  <timeline>
