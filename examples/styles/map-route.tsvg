<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: travel / route explainer on an antique map. A camera (pan + zoom from <fn>s on t) follows
     a dotted route drawn leg by leg, with a moving ship marker, city pins and distance/time cards.
     Generated by a small script; positions are in the map image's own pixels (1344 × 768). -->
<tsvg version="0.2" title="@title" font="Playfair Display, Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:bm_lewis"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.3" sfx="0.5"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
  </mixes>
  <themes>
    <theme id="antique" bg="#2a1d12" fg="#2b1d10" ink="#3a2614" ink2="#6b4e2e" paper="#f1e4c6" red="#a8261b" gold="#c99a3e"/>
  </themes>

  <strings>
    <s id="title" en="The sea route to India"/>
    <s id="kick" en="A voyage in five legs"/>
    <s id="years" en="Lisbon to Calicut · 1497–1498"/>
    <s id="lis" en="Lisbon"/><s id="cv" en="Cape Verde"/><s id="cgh" en="Cape of Good Hope"/>
    <s id="moz" en="Mozambique"/><s id="mal" en="Malindi"/><s id="cal" en="Calicut"/>
    <s id="sum1" en="about ten months at sea"/>
    <s id="sum2" en="8 July 1497 – 20 May 1498"/>
    <s id="note" en="Route and distances approximate."/>
    <s id="ch1" en="The voyage"/><s id="ch2" en="Leg I"/><s id="ch3" en="Leg II"/><s id="ch4" en="Leg III"/><s id="ch5" en="Leg IV"/><s id="ch6" en="Leg V"/><s id="ch7" en="Ten months"/>
    <s id="vo1" en="One summer morning in 1497, four small ships left Lisbon. Their goal: India, by sea, all the way around Africa."/>
    <s id="vo2" en="The first leg was the easy one. Down the African coast to the Cape Verde islands, about three thousand kilometres in two and a half weeks."/>
    <s id="vo3" en="Then a bold move. Instead of hugging the coast, the fleet swung far out into the Atlantic, ninety three days without seeing land, to ride the winds south."/>
    <s id="vo4" en="In November they rounded the Cape of Good Hope, and crept up Africa's east coast towards Mozambique, into waters no European chart described."/>
    <s id="vo5" en="At Malindi, in today's Kenya, the local ruler offered something priceless: an experienced pilot who knew the monsoon winds."/>
    <s id="vo6" en="With the monsoon behind them, they crossed the Arabian Sea in just twenty three days, and reached Calicut in May 1498."/>
    <s id="vo7" en="In all: about twenty three thousand kilometres and ten months at sea. The ocean route between Europe and Asia was open."/>
    <s id="k1" en="LEG I"/><s id="t1" en="Lisbon → Cape Verde"/><s id="d1" en="≈ 3,000 km · 18 days"/>
    <s id="k2" en="LEG II"/><s id="t2" en="Cape Verde → Cape of Good Hope"/><s id="d2" en="≈ 10,000 km · 93 days out of sight of land"/>
    <s id="k3" en="LEG III"/><s id="t3" en="Around the Cape → Mozambique"/><s id="d3" en="≈ 4,000 km · coastal, against the current"/>
    <s id="k4" en="LEG IV"/><s id="t4" en="Mozambique → Malindi"/><s id="d4" en="≈ 2,000 km · a pilot joins the fleet"/>
    <s id="k5" en="LEG V"/><s id="t5" en="Malindi → Calicut"/><s id="d5" en="≈ 4,000 km · 23 days on the monsoon"/>
  </strings>

  <defs>
    <data id="x0" v="645, 598, 742, 812, 820"/>
    <data id="y0" v="312, 410, 582, 505, 455"/>
    <data id="qx" v="600, 500, 805, 830, 870"/>
    <data id="qy" v="352, 560, 590, 480, 385"/>
    <data id="x1" v="598, 742, 812, 820, 935"/>
    <data id="y1" v="410, 582, 505, 455, 415"/>
    <data id="ls" v="12.1, 21.5, 32.1, 42.6, 51.8"/>
    <data id="ld" v="4, 6, 4.5, 3.5, 4.5"/>
    <data id="ccx" v="672, 622, 640, 780, 818, 880, 770"/>
    <data id="ccy" v="384, 362, 490, 545, 478, 430, 470"/>
    <data id="cs" v="1.43, 3.4, 2.5, 3.3, 4.2, 3.0, 2.1"/>
    <data id="st" v="0, 10.9, 20.3, 30.9, 41.4, 50.6, 60.7"/>
    <!-- which scene we are in, and the camera that eases between scene focus points -->
    <fn id="sc">(t &gt;= 10.9)+(t &gt;= 20.3)+(t &gt;= 30.9)+(t &gt;= 41.4)+(t &gt;= 50.6)+(t &gt;= 60.7)</fn>
    <fn id="ck">ease((t - data('st', sc()))/2.2, 'io')</fn>
    <fn id="cz">sc() == 0 ? data('cs', 0) : exp(lerp(log(data('cs', sc() - 1)), log(data('cs', sc())), ck()))</fn>
    <fn id="cx">sc() == 0 ? data('ccx', 0) : lerp(data('ccx', sc() - 1), data('ccx', sc()), ck())</fn>
    <fn id="cy">sc() == 0 ? data('ccy', 0) : lerp(data('ccy', sc() - 1), data('ccy', sc()), ck())</fn>
    <!-- leg progress and the quadratic Bézier of each leg -->
    <fn id="pr" args="g">ease((t - data('ls', g))/data('ld', g), 'io')</fn>
    <fn id="bx" args="g,u">(1 - u)*(1 - u)*data('x0', g) + 2*(1 - u)*u*data('qx', g) + u*u*data('x1', g)</fn>
    <fn id="by" args="g,u">(1 - u)*(1 - u)*data('y0', g) + 2*(1 - u)*u*data('qy', g) + u*u*data('y1', g)</fn>

    <radial id="vig" x="960" y="540" r="1150"><stop at="0.55" color="#1a0f05" opacity="0"/><stop at="1" color="#1a0f05" opacity="0.75"/></radial>
    <radial id="halo" x="0" y="0" r="14"><stop at="0" color="$red" opacity="0.5"/><stop at="1" color="$red" opacity="0"/></radial>

    <symbol id="world">
      <image src="map" x="0" y="0" w="1344" h="768"/>
      <rect x="0" y="0" w="1344" h="768" fill="#c8a466" opacity="0.12" blend="multiply"/>
      <!-- the dotted route -->
      <group repeat="5" as="g">
        <circle repeat="46" as="d" x="=bx(g, d/45)" y="=by(g, d/45)" r="=d % 3 == 0 ? 1.7 : 1.2" fill="$red" when="d/45 &lt;= pr(g)"/>
      </group>
      <group x="645" y="312" opacity="=clamp((t - 0)*3, 0, 1)">
        <circle r="3.2" fill="$red" stroke="$paper" sw="1.2"/>
        <text x="-7" y="-0.5" size="10" weight="700" italic="1" align="right" fill="$ink" font="Playfair Display" text="@lis"/>
      </group>
      <group x="598" y="410" opacity="=clamp((t - 15.8)*3, 0, 1)">
        <circle r="3.2" fill="$red" stroke="$paper" sw="1.2"/>
        <text x="-7" y="-0.5" size="10" weight="700" italic="1" align="right" fill="$ink" font="Playfair Display" text="@cv"/>
      </group>
      <group x="742" y="582" opacity="=clamp((t - 27.2)*3, 0, 1)">
        <circle r="3.2" fill="$red" stroke="$paper" sw="1.2"/>
        <text x="7" y="-0.5" size="10" weight="700" italic="1" align="left" fill="$ink" font="Playfair Display" text="@cgh"/>
      </group>
      <group x="812" y="505" opacity="=clamp((t - 36.3)*3, 0, 1)">
        <circle r="3.2" fill="$red" stroke="$paper" sw="1.2"/>
        <text x="7" y="-0.5" size="10" weight="700" italic="1" align="left" fill="$ink" font="Playfair Display" text="@moz"/>
      </group>
      <group x="820" y="455" opacity="=clamp((t - 45.8)*3, 0, 1)">
        <circle r="3.2" fill="$red" stroke="$paper" sw="1.2"/>
        <text x="7" y="-0.5" size="10" weight="700" italic="1" align="left" fill="$ink" font="Playfair Display" text="@mal"/>
      </group>
      <group x="935" y="415" opacity="=clamp((t - 56.0)*3, 0, 1)">
        <circle r="3.2" fill="$red" stroke="$paper" sw="1.2"/>
        <text x="7" y="-0.5" size="10" weight="700" italic="1" align="left" fill="$ink" font="Playfair Display" text="@cal"/>
      </group>
      <!-- the ship: on the active leg, then moored at Calicut -->
      <group repeat="5" as="g" x="=bx(g, pr(g))" y="=by(g, pr(g))" when="t &gt;= data('ls', g) &amp;&amp; (pr(g) &lt; 1 || g == 4)">
        <circle r="=12 + 2*sin(t*4)" fill="url(#halo)"/>
        <circle r="4.5" fill="$paper" stroke="$red" sw="2"/>
        <path d="M -3 1.5 L 3 1.5 L 2 3 L -2 3 Z M 0 -4 L 0 1 L 2.6 1 Z" fill="$red"/>
      </group>
    </symbol>
  </defs>

  <assets>
    <asset id="map" src="images/oldmap.jpg"/>
    <asset id="drone" src="audio/pad.m4a"/>
    <asset id="whoosh" src="audio/whoosh.m4a"/>
    <font family="Playfair Display" src="fonts/PlayfairDisplay.ttf"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
  </assets>

  <music src="drone" start="0" loop="1" vol="0.8"/>

  <backdrop>
    <group x="=960 - cz()*cx()" y="=540 - cz()*cy()" scale="=cz()">
      <use ref="world"/>
    </group>
  </backdrop>

  <overlay>
    <rect x="0" y="0" w="1920" h="1080" fill="url(#vig)"/>
    <!-- compass rose -->
    <group x="150" y="930" opacity="0.85" rot="=4*sin(t*0.3)">
      <circle r="70" fill="none" stroke="$paper" sw="2"/>
      <circle r="56" fill="none" stroke="$paper" sw="1"/>
      <path d="M 0 -90 L 12 -12 L 90 0 L 12 12 L 0 90 L -12 12 L -90 0 L -12 -12 Z" fill="$paper" stroke="$ink" sw="1.5"/>
      <path d="M 0 -90 L 12 -12 L 0 0 Z M 90 0 L 12 12 L 0 0 Z M 0 90 L -12 12 L 0 0 Z M -90 0 L -12 -12 L 0 0 Z" fill="$ink"/>
      <text x="0" y="-108" size="26" weight="700" align="center" fill="$paper" font="Playfair Display" text="N"/>
    </group>
    <text x="1860" y="1050" size="20" italic="1" align="right" fill="$paper" opacity="0.7" font="Playfair Display" text="@note"/>
  </overlay>

  <timeline>
    <scene id="s0" dur="10.9" chapter="@ch1">
      <say at="0.6" text="@vo1"/>

      <rect x="0" y="0" w="=W" h="=H" fill="$paper" opacity="=0.55*(1 - ease((T - 7)/1.5, 'io'))"/>
      <group opacity="=1 - ease((T - 7.3)/1.2, 'io')">
        <text x="=W/2" y="360" size="34" italic="1" align="center" fill="$ink2" font="Playfair Display" text="@kick">
          <anim prop="opacity" from="0" to="1" dur="0.8"/>
        </text>
        <text x="=W/2" y="480" size="120" weight="800" align="center" fill="$ink" font="Playfair Display" text="@title">
          <anim prop="opacity" from="0" to="1" dur="1"/>
          <anim prop="scale" from="0.94" to="1" dur="1.6"/>
        </text>
        <path x="=W/2" y="580" d="M -300 0 L -30 0 M 30 0 L 300 0 M -12 0 L 0 -12 L 12 0 L 0 12 Z" fill="$red" stroke="$red" sw="3">
          <anim prop="draw" from="0" to="1" at="0.8" dur="1.2"/>
        </path>
        <text x="=W/2" y="650" size="40" italic="1" align="center" fill="$ink" font="Playfair Display" text="@years" at="1.2">
          <anim prop="opacity" from="0" to="1" dur="0.8"/>
        </text>
      </group>
    </scene>

    <scene id="s1" dur="9.4" chapter="@ch2">
      <say at="0.4" text="@vo2"/>
      <sfx at="0.3" src="whoosh"/>
      <group x="1300" y="660" at="0.8">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
        <anim prop="y" from="700" to="660" dur="0.6"/>
        <rect w="540" h="260" r="6" fill="$paper" stroke="$ink" sw="2" shadow="0 14 30 #2a1a0a66"/>
        <rect x="10" y="10" w="520" h="240" r="4" fill="none" stroke="$ink" sw="1" opacity="0.5"/>
        <text x="270" y="52" size="26" weight="700" align="center" fill="$red" font="Playfair Display" text="@k1"/>
        <line x1="190" y1="76" x2="350" y2="76" stroke="$ink" sw="1.5" opacity="0.6"/>
        <text x="270" y="125" size="34" weight="700" align="center" maxw="490" fill="$ink" font="Playfair Display" text="@t1"/>
        <text x="270" y="195" size="26" italic="1" align="center" maxw="480" fill="$ink2" font="Playfair Display" text="@d1"/>
      </group>
    </scene>

    <scene id="s2" dur="10.6" chapter="@ch3">
      <say at="0.4" text="@vo3"/>
      <sfx at="0.3" src="whoosh"/>
      <group x="1300" y="660" at="0.8">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
        <anim prop="y" from="700" to="660" dur="0.6"/>
        <rect w="540" h="260" r="6" fill="$paper" stroke="$ink" sw="2" shadow="0 14 30 #2a1a0a66"/>
        <rect x="10" y="10" w="520" h="240" r="4" fill="none" stroke="$ink" sw="1" opacity="0.5"/>
        <text x="270" y="52" size="26" weight="700" align="center" fill="$red" font="Playfair Display" text="@k2"/>
        <line x1="190" y1="76" x2="350" y2="76" stroke="$ink" sw="1.5" opacity="0.6"/>
        <text x="270" y="125" size="34" weight="700" align="center" maxw="490" fill="$ink" font="Playfair Display" text="@t2"/>
        <text x="270" y="195" size="26" italic="1" align="center" maxw="480" fill="$ink2" font="Playfair Display" text="@d2"/>
      </group>
    </scene>

    <scene id="s3" dur="10.5" chapter="@ch4">
      <say at="0.4" text="@vo4"/>
      <sfx at="0.3" src="whoosh"/>
      <group x="1300" y="660" at="0.8">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
        <anim prop="y" from="700" to="660" dur="0.6"/>
        <rect w="540" h="260" r="6" fill="$paper" stroke="$ink" sw="2" shadow="0 14 30 #2a1a0a66"/>
        <rect x="10" y="10" w="520" h="240" r="4" fill="none" stroke="$ink" sw="1" opacity="0.5"/>
        <text x="270" y="52" size="26" weight="700" align="center" fill="$red" font="Playfair Display" text="@k3"/>
        <line x1="190" y1="76" x2="350" y2="76" stroke="$ink" sw="1.5" opacity="0.6"/>
        <text x="270" y="125" size="34" weight="700" align="center" maxw="490" fill="$ink" font="Playfair Display" text="@t3"/>
        <text x="270" y="195" size="26" italic="1" align="center" maxw="480" fill="$ink2" font="Playfair Display" text="@d3"/>
      </group>
    </scene>

    <scene id="s4" dur="9.2" chapter="@ch5">
      <say at="0.4" text="@vo5"/>
      <sfx at="0.3" src="whoosh"/>
      <group x="1300" y="660" at="0.8">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
        <anim prop="y" from="700" to="660" dur="0.6"/>
        <rect w="540" h="260" r="6" fill="$paper" stroke="$ink" sw="2" shadow="0 14 30 #2a1a0a66"/>
        <rect x="10" y="10" w="520" h="240" r="4" fill="none" stroke="$ink" sw="1" opacity="0.5"/>
        <text x="270" y="52" size="26" weight="700" align="center" fill="$red" font="Playfair Display" text="@k4"/>
        <line x1="190" y1="76" x2="350" y2="76" stroke="$ink" sw="1.5" opacity="0.6"/>
        <text x="270" y="125" size="34" weight="700" align="center" maxw="490" fill="$ink" font="Playfair Display" text="@t4"/>
        <text x="270" y="195" size="26" italic="1" align="center" maxw="480" fill="$ink2" font="Playfair Display" text="@d4"/>
      </group>
    </scene>

    <scene id="s5" dur="10.1" chapter="@ch6">
      <say at="0.4" text="@vo6"/>
      <sfx at="0.3" src="whoosh"/>
      <group x="1300" y="660" at="0.8">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
        <anim prop="y" from="700" to="660" dur="0.6"/>
        <rect w="540" h="260" r="6" fill="$paper" stroke="$ink" sw="2" shadow="0 14 30 #2a1a0a66"/>
        <rect x="10" y="10" w="520" h="240" r="4" fill="none" stroke="$ink" sw="1" opacity="0.5"/>
        <text x="270" y="52" size="26" weight="700" align="center" fill="$red" font="Playfair Display" text="@k5"/>
        <line x1="190" y1="76" x2="350" y2="76" stroke="$ink" sw="1.5" opacity="0.6"/>
        <text x="270" y="125" size="34" weight="700" align="center" maxw="490" fill="$ink" font="Playfair Display" text="@t5"/>
        <text x="270" y="195" size="26" italic="1" align="center" maxw="480" fill="$ink2" font="Playfair Display" text="@d5"/>
      </group>
    </scene>

    <scene id="s6" dur="8.8" chapter="@ch7">
      <say at="0.4" text="@vo7"/>
      <sfx at="0.3" src="whoosh"/>
      <group x="1250" y="560" at="1">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
        <rect w="600" h="330" r="6" fill="$paper" stroke="$ink" sw="2" shadow="0 14 30 #2a1a0a66"/>
        <rect x="10" y="10" w="580" h="310" r="4" fill="none" stroke="$ink" sw="1" opacity="0.5"/>
        <text x="300" y="110" size="96" weight="800" align="center" fill="$red" font="Playfair Display" text="≈ {fmt(23*ease((T - 1.4)/2.2, 'out'), 0)},000 km"/>
        <text x="300" y="190" size="34" italic="1" align="center" fill="$ink" font="Playfair Display" text="@sum1"/>
        <line x1="200" y1="230" x2="400" y2="230" stroke="$ink" sw="1.5" opacity="0.6"/>
        <text x="300" y="275" size="30" align="center" fill="$ink2" font="Playfair Display" text="@sum2"/>
      </group>
    </scene>
  </timeline>

  <!-- written by `tsvg bake`: one recorded clip per <say> line and language -->
  <voices>
    <voice say="vo1" lang="en" src="voice/map-route/en/vo1.ee08b907ea.m4a" dur="9.71" hash="ee08b907ea" engine="kokoro:bm_lewis"/>
    <voice say="vo2" lang="en" src="voice/map-route/en/vo2.088678c530.m4a" dur="8.41" hash="088678c530" engine="kokoro:bm_lewis"/>
    <voice say="vo3" lang="en" src="voice/map-route/en/vo3.4cd4136bd9.m4a" dur="9.61" hash="4cd4136bd9" engine="kokoro:bm_lewis"/>
    <voice say="vo4" lang="en" src="voice/map-route/en/vo4.7816cc6d3f.m4a" dur="9.51" hash="7816cc6d3f" engine="kokoro:bm_lewis"/>
    <voice say="vo5" lang="en" src="voice/map-route/en/vo5.c4666a5d55.m4a" dur="8.21" hash="c4666a5d55" engine="kokoro:bm_lewis"/>
    <voice say="vo6" lang="en" src="voice/map-route/en/vo6.509b0837e5.m4a" dur="9.11" hash="509b0837e5" engine="kokoro:bm_lewis"/>
    <voice say="vo7" lang="en" src="voice/map-route/en/vo7.a9e002488c.m4a" dur="7.71" hash="a9e002488c" engine="kokoro:bm_lewis"/>
  </voices>
</tsvg>
