<?xml version="1.0" encoding="UTF-8"?>
<!-- Startup pitch deck: slide chrome, problem → ask, growing traction chart, team, use-of-funds donut. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts><layout id="landscape" w="1920" h="1080"/></layouts>
  <options>
    <option id="lang" default="en"><choice id="en" label="English" tts="kokoro:am_michael"/></option>
    <option id="mix" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.25" sfx="0.5"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="corporate" bg="#f7f8fa" fg="#0b1f3a" navy="#0b1f3a" muted="#5b6b80" slate="#8a97a8" panel="#ffffff" rule="#e3e7ee" teal="#0fb5a6" teal2="#5eead4" tealsoft="#d9f5f2" coral="#f0715a"/></themes>
  <strings>
    <s id="title" en="GridLeaf seed pitch"/>
    <s id="brand" en="GridLeaf"/>
    <s id="round" en="Seed round · 2026"/>
    <s id="confidential" en="Confidential · for discussion"/>
    <s id="tag" en="Fresh greens grown on the roof of the store that sells them"/>
    <s id="seedchip" en="Seed deck · 8 slides"/>
    <s id="farm" en="Farm, 3 states away"/>
    <s id="store" en="City store shelf"/>
    <s id="p1" en="average distance travelled"/>
    <s id="p2" en="shelf life lost in transit"/>
    <s id="p3" en="of greens thrown away"/>
    <s id="s1" en="Bolt-on unit"/>
    <s id="s1d" en="A 40 m² hydroponic module craned onto the roof in one night."/>
    <s id="s2" en="Cut at 9:00"/>
    <s id="s2d" en="Store staff harvest each morning from a tablet pick list."/>
    <s id="s3" en="Shelf by 10:00"/>
    <s id="s3d" en="One lift ride down. Zero cold chain, zero trucks."/>
    <s id="water" en="95% less water · no pesticides · 18 harvests a year"/>
    <s id="tam" en="TAM"/>
    <s id="tamd" en="Fresh leafy greens, global retail"/>
    <s id="sam" en="SAM"/>
    <s id="samd" en="Urban grocery chains in 12 launch cities"/>
    <s id="som" en="SOM"/>
    <s id="somd" en="5-year target: 600 roofs"/>
    <s id="mrr" en="monthly recurring revenue"/>
    <s id="stores" en="store roofs live"/>
    <s id="mom" en="avg. monthly growth"/>
    <s id="modelline" en="Store pays a flat monthly fee per roof, we run the farm"/>
    <s id="fee" en="$7,200 / mo"/>
    <s id="gm" en="gross margin per roof"/>
    <s id="payback" en="hardware payback"/>
    <s id="contract" en="standard contract length"/>
    <s id="seed" en="seed round"/>
    <s id="u1" en="Build 30 more roofs"/>
    <s id="u2" en="Grow-tech R&amp;D"/>
    <s id="u3" en="Team &amp; city launches"/>
    <s id="milestone" en="40 roofs · break-even in 18 months"/>
    <s id="vo_title" en="GridLeaf grows fresh greens on the roof of the store that sells them."/>
    <s id="ch_title" en="Title"/>
    <s id="vo_problem" en="City lettuce travels about two thousand four hundred kilometres. It loses half its shelf life on the way, and a third is thrown out."/>
    <s id="ch_problem" en="PROBLEM"/>
    <s id="k_problem" en="PROBLEM"/>
    <s id="t_problem" en="City greens are old before they reach the shelf"/>
    <s id="vo_solution" en="Our hydroponic units bolt onto the store roof. Greens are cut at nine and shelved by ten, with ninety-five percent less water."/>
    <s id="ch_solution" en="SOLUTION"/>
    <s id="k_solution" en="SOLUTION"/>
    <s id="t_solution" en="Grow it on the store’s own roof"/>
    <s id="vo_market" en="Leafy greens are a thirty-eight billion dollar market. Grocers in our twelve launch cities spend four point two billion of it."/>
    <s id="ch_market" en="MARKET"/>
    <s id="k_market" en="MARKET"/>
    <s id="t_market" en="A $38B category, starting city by city"/>
    <s id="vo_traction" en="We are live on eleven roofs. Monthly revenue grew from four thousand to eighty-six thousand dollars in fourteen months."/>
    <s id="ch_traction" en="TRACTION"/>
    <s id="k_traction" en="TRACTION"/>
    <s id="t_traction" en="Monthly revenue, last 14 months"/>
    <s id="vo_model" en="Stores pay a flat monthly fee per roof. Gross margin is sixty-two percent, with a fourteen month payback."/>
    <s id="ch_model" en="BUSINESS MODEL"/>
    <s id="k_model" en="BUSINESS MODEL"/>
    <s id="t_model" en="Farms as a service"/>
    <s id="vo_team" en="Our team has run grocery operations, built greenhouse controls, and scaled last-mile delivery."/>
    <s id="ch_team" en="TEAM"/>
    <s id="k_team" en="TEAM"/>
    <s id="t_team" en="Operators who have done this before"/>
    <s id="vo_ask" en="We are raising three million dollars to reach forty roofs and break even within eighteen months."/>
    <s id="ch_ask" en="THE ASK"/>
    <s id="k_ask" en="THE ASK"/>
    <s id="t_ask" en="Raising $3M seed"/>
