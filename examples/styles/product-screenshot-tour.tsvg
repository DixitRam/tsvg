<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: product screenshot tour. Real screenshots in a browser frame, zoom-ins on regions,
     spotlight dimming (a path with a hole that morphs), highlight boxes, callout pills with drawn arrows.
     The screenshot lives in one group in screenshot pixels (1600×1000); x/y/scale keys move the camera:
     screen = (x, y) + scale × pixel. Overview: scale 0.8 at (320, 200). -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:af_bella"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
    <option id="theme" label="Theme" default="light"><choice id="light" label="Light"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.22" sfx="0.6"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
  </mixes>
  <themes>
    <theme id="light" bg="#eceef6" fg="#12131a" muted="#5d6475" panel="#ffffff" accent="#5b4cf0" hl="#ff5a36" ink="#15161f" chrome="#dfe2ec"/>
  </themes>
  <strings>
    <s id="title" en="Product tour: the TSVG playground"/>
    <s id="kicker" en="PRODUCT TOUR"/>
    <s id="h1" en="The TSVG playground"/>
    <s id="h1b" en="Write a video. Watch it play. 60 seconds."/>
    <s id="url" en="tsvg.dev/playground"/>
    <s id="ch1" en="Intro"/><s id="ch2" en="Pick a screen"/><s id="ch3" en="The player"/><s id="ch4" en="Edit the source"/>
    <s id="ch5" en="Captions and keys"/><s id="ch6" en="Open source"/><s id="ch7" en="Try it"/>
    <s id="st2" en="1  ·  Pick a screen"/><s id="st3" en="2  ·  The player"/><s id="st4" en="3  ·  Edit the source"/>
    <s id="st5" en="4  ·  Captions and shortcuts"/><s id="st6" en="5  ·  Open source"/>
    <s id="c2a" en="Landscape or phone, one click"/>
    <s id="c2b" en="Live option values"/>
    <s id="c3a" en="Chapters on the timeline"/>
    <s id="c3b" en="±10 s skips"/>
    <s id="c3c" en="Captions · speed · options"/>
    <s id="c4a" en="The whole video is this XML"/>
    <s id="c4b" en="Apply re-renders instantly"/>
    <s id="c5a" en="Captions = the narration text"/>
    <s id="c5b" en="Keys: space · j / l · c · f"/>
    <s id="c6a" en="Web + Flutter engines, CLI"/>
    <s id="c6b" en="MIT licence, open spec"/>
    <s id="o1" en="Try it yourself"/>
    <s id="o2" en="Open any .tsvg or .tsvgz file in the playground."/>
    <s id="o3" en="Open the playground"/>
    <s id="vo1" en="Here is a one minute tour of the TSVG playground, where you write a video and watch it play."/>
    <s id="vo1_say" en="Here is a one minute tour of the T. S. V. G. playground, where you write a video and watch it play."/>
    <s id="vo2" en="Top left, pick a screen: landscape or phone. Next to it are the live option values: language, audio mix and theme."/>
    <s id="vo3" en="The player works like any video player. Chapters on the timeline, ten second skips, captions, speed and options."/>
    <s id="vo4" en="On the right is the source. Change a line, press Apply, and the video re-renders instantly."/>
    <s id="vo5" en="Captions come straight from the narration text. Under the player, the keyboard shortcuts are listed."/>
    <s id="vo6" en="Everything is open source on GitHub, under the MIT licence, with web and Flutter engines."/>
    <s id="vo7" en="Open any TSVG file in the playground and try it yourself."/>
    <s id="vo7_say" en="Open any T. S. V. G. file in the playground and try it yourself."/>
  </strings>

  <defs>
    <linear id="bgwash" x1="0" y1="0" x2="1920" y2="1080"><stop at="0" color="#f4f1ff"/><stop at="0.55" color="#eceef6"/><stop at="1" color="#e4f0ff"/></linear>
    <radial id="glowA" x="0" y="0" r="520"><stop at="0" color="#8b7dff" opacity="0.35"/><stop at="1" color="#8b7dff" opacity="0"/></radial>
    <radial id="glowB" x="0" y="0" r="460"><stop at="0" color="#ff8a5c" opacity="0.25"/><stop at="1" color="#ff8a5c" opacity="0"/></radial>
    <linear id="cta" x1="0" y1="0" x2="520" y2="0"><stop at="0" color="#5b4cf0"/><stop at="1" color="#9b5cf6"/></linear>
    <!-- the browser viewport: everything zoomed stays inside it -->
    <clip id="viewport"><rect x="320" y="155" w="1280" h="845" r="18"/></clip>
    <!-- arrow cursor, tip at 0,0 -->
    <symbol id="cursor"><path d="M0 0 L0 34 L9 26 L16 41 L22 38 L15 24 L27 24 Z" fill="#111" stroke="#fff" sw="2.5" shadow="0 4 8 #0006"/></symbol>
  </defs>

  <assets>
    <asset id="play" src="images/ui-playground.jpg"/>
    <asset id="gh" src="images/ui-github.jpg"/>
    <asset id="bed" src="audio/pulse.m4a"/>
    <asset id="click" src="audio/click.m4a"/>
    <asset id="whoosh" src="audio/whoosh.m4a"/>
    <asset id="pop" src="audio/pop.m4a"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
  </assets>

  <music src="bed" start="0" loop="1" vol="0.7"/>

  <backdrop>
    <rect w="=W" h="=H" fill="url(#bgwash)"/>
    <circle x="=180 + 40*sin(t*0.2)" y="160" r="520" fill="url(#glowA)"/>
    <circle x="=W - 160" y="=H - 120 + 30*sin(t*0.25)" r="460" fill="url(#glowB)"/>
  </backdrop>

  <timeline>
    <!-- 1 · intro: the browser window rises into place -->
    <scene id="intro" dur="7.5" chapter="@ch1">
      <say at="0.5" text="@vo1" speak="@vo1_say"/>
      <sfx at="0.2" src="whoosh"/>
      <group x="320" y="200" scale="0.8">
        <anim prop="y" from="420" to="200" dur="1.4" ease="out"/>
        <anim prop="opacity" from="0" to="1" dur="0.8"/>
        <keys prop="scale" v="0:0.74; 1.4:0.8; 7.5:0.8"/>
        <rect x="0" y="-56" w="1600" h="1056" r="22" fill="$chrome" shadow="0 40 80 #1a1f4a40"/>
        <circle x="30" y="-28" r="9" fill="#ff5f57"/><circle x="58" y="-28" r="9" fill="#febc2e"/><circle x="86" y="-28" r="9" fill="#28c840"/>
        <rect x="560" y="-44" w="480" h="32" r="16" fill="#ffffffcc"/>
        <text x="800" y="-28" size="18" align="center" fill="$muted" text="@url"/>
        <image src="play" x="0" y="0" w="1600" h="1000"/>
      </group>
      <!-- title card over the window -->
      <group x="960" y="560" at="0.6">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
        <anim prop="scale" from="0.92" to="1" dur="0.8" ease="back"/>
        <rect x="-560" y="-150" w="1120" h="300" r="32" fill="#ffffffee" shadow="0 30 60 #1a1f4a33"/>
        <rect x="-110" y="-110" w="220" h="44" r="22" fill="#5b4cf01f"/>
        <text x="0" y="-88" size="22" weight="700" align="center" fill="$accent" text="@kicker"/>
        <text x="0" y="-6" size="76" weight="800" align="center" fill="$ink" text="@h1"/>
        <text x="0" y="82" size="34" align="center" fill="$muted" text="@h1b"/>
      </group>
    </scene>

    <!-- 2 · pick a screen: zoom on the top-left toolbar -->
    <scene id="screen" dur="9" chapter="@ch2">
      <say at="0.4" text="@vo2"/>
      <sfx at="0.3" src="whoosh"/><sfx at="1.8" src="pop"/><sfx at="4.6" src="pop"/>
      <text x="320" y="88" size="40" weight="800" fill="$ink" text="@st2"><anim prop="opacity" from="0" to="1" dur="0.5"/></text>
      <group clip="url(#viewport)">
        <rect x="320" y="155" w="1280" h="845" fill="$chrome"/>
        <group x="320" y="200" scale="0.8">
          <keys prop="x" ease="io" v="0:320; 1.4:381.4"/>
          <keys prop="y" ease="io" v="0:200; 1.4:365.2"/>
          <keys prop="scale" ease="io" v="0:0.8; 1.4:1.8"/>
          <rect x="0" y="-56" w="1600" h="56" fill="$chrome"/>
          <circle x="30" y="-28" r="9" fill="#ff5f57"/><circle x="58" y="-28" r="9" fill="#febc2e"/><circle x="86" y="-28" r="9" fill="#28c840"/>
          <rect x="560" y="-44" w="480" h="32" r="16" fill="#ffffffcc"/>
          <text x="800" y="-28" size="18" align="center" fill="$muted" text="@url"/>
          <image src="play" x="0" y="0" w="1600" h="1000"/>
        </group>
        <!-- spotlight: a frame-sized path with a hole; the hole morphs to the next target -->
        <path fill="#0b0d1acc" at="1.5" d="M320 155 H1600 V1000 H320 Z M492 480 V562 H908 V480 Z">
          <anim prop="opacity" from="0" to="1" dur="0.4"/>
          <keys prop="d" ease="io" v="2.6: M320 155 H1600 V1000 H320 Z M492 480 V562 H908 V480 Z; 3.6: M320 155 H1600 V1000 H320 Z M902 490 V556 H1280 V490 Z"/>
        </path>
      </group>
      <rect x="492" y="480" w="416" h="82" r="14" fill="none" stroke="$hl" sw="5" at="1.6">
        <anim prop="opacity" from="0" to="1" dur="0.3"/>
        <keys prop="x" ease="io" v="1: 492; 2: 902"/><keys prop="y" ease="io" v="1: 480; 2: 490"/>
        <keys prop="w" ease="io" v="1: 416; 2: 378"/><keys prop="h" ease="io" v="1: 82; 2: 66"/>
      </rect>
      <!-- callouts -->
      <group at="1.8">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <line x1="700" y1="562" x2="700" y2="660" stroke="$hl" sw="4"><anim prop="draw" from="0" to="1" dur="0.5"/></line>
        <rect x="470" y="660" w="560" h="70" r="35" fill="$ink" shadow="0 14 30 #0006"/>
        <circle x="510" y="695" r="9" fill="$hl"/>
        <text x="534" y="695" size="31" weight="600" fill="#fff" text="@c2a"/>
      </group>
      <group at="4.4">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <line x1="1091" y1="490" x2="1091" y2="400" stroke="$hl" sw="4"><anim prop="draw" from="0" to="1" dur="0.5"/></line>
        <rect x="900" y="330" w="390" h="70" r="35" fill="$ink" shadow="0 14 30 #0006"/>
        <circle x="940" y="365" r="9" fill="$hl"/>
        <text x="964" y="365" size="31" weight="600" fill="#fff" text="@c2b"/>
      </group>
    </scene>

    <!-- 3 · the player controls -->
    <scene id="player" dur="9.5" chapter="@ch3">
      <say at="0.4" text="@vo3"/>
      <sfx at="0.2" src="whoosh"/><sfx at="2.2" src="pop"/><sfx at="3.4" src="pop"/><sfx at="4.6" src="pop"/>
      <text x="320" y="88" size="40" weight="800" fill="$ink" text="@st3"><anim prop="opacity" from="0" to="1" dur="0.5"/></text>
      <group clip="url(#viewport)">
        <rect x="320" y="155" w="1280" h="845" fill="#0d1017"/>
        <group x="381.4" y="365.2" scale="1.8">
          <keys prop="x" ease="io" v="0:381.4; 1.4:319.8"/>
          <keys prop="y" ease="io" v="0:365.2; 1.4:106.2"/>
          <keys prop="scale" ease="io" v="0:1.8; 1.4:1.1"/>
          <image src="play" x="0" y="0" w="1600" h="1000"/>
          <!-- a live playhead sweeping the timeline -->
          <rect x="639" y="689" w="=320*ease((T-2)/6,'io')" h="5" fill="#ff5a5a" at="1.6"/>
          <circle x="=639 + 320*ease((T-2)/6,'io')" y="691" r="7" fill="#ff5a5a" at="1.6"/>
        </group>
        <path fill="#0b0d1acc" at="1.6" d="M320 155 H1600 V1000 H320 Z M340 848 V928 H1584 V848 Z">
          <anim prop="opacity" from="0" to="1" dur="0.4"/>
        </path>
      </group>
      <rect x="340" y="848" w="1244" h="80" r="14" fill="none" stroke="$hl" sw="5" at="1.7"><anim prop="opacity" from="0" to="1" dur="0.3"/></rect>
      <group at="2.2">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <line x1="760" y1="700" x2="760" y2="862" stroke="$hl" sw="4"><anim prop="draw" from="0" to="1" dur="0.5"/></line>
        <circle x="760" y="866" r="8" fill="$hl"/>
        <rect x="560" y="630" w="460" h="70" r="35" fill="$ink" shadow="0 14 30 #0006"/>
        <circle x="600" y="665" r="9" fill="$hl"/>
        <text x="624" y="665" size="31" weight="600" fill="#fff" text="@c3a"/>
      </group>
      <group at="3.4">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <line x1="440" y1="820" x2="440" y2="890" stroke="$hl" sw="4"><anim prop="draw" from="0" to="1" dur="0.4"/></line>
        <rect x="360" y="750" w="250" h="70" r="35" fill="$ink" shadow="0 14 30 #0006"/>
        <circle x="400" y="785" r="9" fill="$hl"/>
        <text x="424" y="785" size="31" weight="600" fill="#fff" text="@c3b"/>
      </group>
      <group at="4.6">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <line x1="1440" y1="700" x2="1440" y2="890" stroke="$hl" sw="4"><anim prop="draw" from="0" to="1" dur="0.5"/></line>
        <rect x="1100" y="630" w="470" h="70" r="35" fill="$ink" shadow="0 14 30 #0006"/>
        <circle x="1140" y="665" r="9" fill="$hl"/>
        <text x="1164" y="665" size="31" weight="600" fill="#fff" text="@c3c"/>
      </group>
    </scene>

    <!-- 4 · the editor and Apply -->
    <scene id="editor" dur="8.5" chapter="@ch4">
      <say at="0.4" text="@vo4"/>
      <sfx at="0.2" src="whoosh"/><sfx at="1.9" src="pop"/><sfx at="5.3" src="click"/>
      <text x="320" y="88" size="40" weight="800" fill="$ink" text="@st4"><anim prop="opacity" from="0" to="1" dur="0.5"/></text>
      <group clip="url(#viewport)">
        <rect x="320" y="155" w="1280" h="845" fill="#0d1017"/>
        <group x="319.8" y="106.2" scale="1.1">
          <keys prop="x" ease="io" v="0:319.8; 1.4:-133.9"/>
          <keys prop="y" ease="io" v="0:106.2; 1.4:150"/>
          <keys prop="scale" ease="io" v="0:1.1; 1.4:0.9"/>
          <image src="play" x="0" y="0" w="1600" h="1000"/>
        </group>
        <path fill="#0b0d1acc" at="1.6" d="M320 155 H1600 V1000 H320 Z M904 240 V1004 H1296 V240 Z">
          <anim prop="opacity" from="0" to="1" dur="0.4"/>
          <keys prop="d" ease="io" v="2.4: M320 155 H1600 V1000 H320 Z M904 240 V1004 H1296 V240 Z; 3.6: M320 155 H1600 V1000 H320 Z M1142 207 V248 H1240 V207 Z"/>
        </path>
      </group>
      <rect x="904" y="240" w="392" h="764" r="14" fill="none" stroke="$hl" sw="5" at="1.7">
        <anim prop="opacity" from="0" to="1" dur="0.3"/>
        <keys prop="x" ease="io" v="0.7: 904; 1.9: 1142"/><keys prop="y" ease="io" v="0.7: 240; 1.9: 207"/>
        <keys prop="w" ease="io" v="0.7: 392; 1.9: 98"/><keys prop="h" ease="io" v="0.7: 764; 1.9: 41"/>
      </rect>
      <group at="1.9" dur="2">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <line x1="840" y1="560" x2="900" y2="560" stroke="$hl" sw="4"><anim prop="draw" from="0" to="1" dur="0.4"/></line>
        <rect x="380" y="525" w="460" h="70" r="35" fill="$ink" shadow="0 14 30 #0006"/>
        <circle x="420" y="560" r="9" fill="$hl"/>
        <text x="444" y="560" size="31" weight="600" fill="#fff" text="@c4a"/>
      </group>
      <group at="3.6">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <line x1="840" y1="330" x2="1138" y2="236" stroke="$hl" sw="4"><anim prop="draw" from="0" to="1" dur="0.5"/></line>
        <rect x="380" y="295" w="460" h="70" r="35" fill="$ink" shadow="0 14 30 #0006"/>
        <circle x="420" y="330" r="9" fill="$hl"/>
        <text x="444" y="330" size="31" weight="600" fill="#fff" text="@c4b"/>
      </group>
      <!-- cursor glides to Apply and clicks -->
      <use ref="cursor" x="760" y="760" at="3.8">
        <keys prop="x" ease="io" v="0: 760; 1.4: 1192"/>
        <keys prop="y" ease="io" v="0: 760; 1.4: 230"/>
        <keys prop="scale" v="1.4: 1; 1.5: 0.85; 1.65: 1"/>
      </use>
      <circle x="1192" y="228" r="10" fill="none" stroke="$hl" sw="4" at="5.3" dur="0.8">
        <anim prop="r" from="10" to="70" dur="0.8"/>
        <anim prop="opacity" from="1" to="0" dur="0.8"/>
      </circle>
    </scene>

    <!-- 5 · captions and keyboard shortcuts -->
    <scene id="captions" dur="8.5" chapter="@ch5">
      <say at="0.4" text="@vo5"/>
      <sfx at="0.2" src="whoosh"/><sfx at="1.9" src="pop"/><sfx at="4.4" src="pop"/>
      <text x="320" y="88" size="40" weight="800" fill="$ink" text="@st5"><anim prop="opacity" from="0" to="1" dur="0.5"/></text>
      <group clip="url(#viewport)">
        <rect x="320" y="155" w="1280" h="845" fill="#0d1017"/>
        <group x="-133.9" y="150" scale="0.9">
          <keys prop="x" ease="io" v="0:-133.9; 1.4:306.6"/>
          <keys prop="y" ease="io" v="0:150; 1.4:-360.4"/>
          <keys prop="scale" ease="io" v="0:0.9; 1.4:1.3"/>
          <image src="play" x="0" y="0" w="1600" h="1000"/>
        </group>
        <path fill="#0b0d1acc" at="1.6" d="M320 155 H1600 V1000 H320 Z M560 462 V530 H1570 V462 Z">
          <anim prop="opacity" from="0" to="1" dur="0.4"/>
          <keys prop="d" ease="io" v="2.6: M320 155 H1600 V1000 H320 Z M560 462 V530 H1570 V462 Z; 3.8: M320 155 H1600 V1000 H320 Z M326 608 V656 H1520 V608 Z"/>
        </path>
      </group>
      <rect x="560" y="462" w="1010" h="68" r="14" fill="none" stroke="$hl" sw="5" at="1.7">
        <anim prop="opacity" from="0" to="1" dur="0.3"/>
        <keys prop="x" ease="io" v="0.9: 560; 2.1: 326"/><keys prop="y" ease="io" v="0.9: 462; 2.1: 608"/>
        <keys prop="w" ease="io" v="0.9: 1010; 2.1: 1194"/><keys prop="h" ease="io" v="0.9: 68; 2.1: 48"/>
      </rect>
      <group at="1.9" dur="2.2">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <line x1="900" y1="380" x2="900" y2="458" stroke="$hl" sw="4"><anim prop="draw" from="0" to="1" dur="0.4"/></line>
        <rect x="640" y="310" w="520" h="70" r="35" fill="$ink" shadow="0 14 30 #0006"/>
        <circle x="680" y="345" r="9" fill="$hl"/>
        <text x="704" y="345" size="31" weight="600" fill="#fff" text="@c5a"/>
      </group>
      <group at="4.2">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <line x1="800" y1="660" x2="800" y2="760" stroke="$hl" sw="4"><anim prop="draw" from="0" to="1" dur="0.4"/></line>
        <rect x="560" y="760" w="500" h="70" r="35" fill="$ink" shadow="0 14 30 #0006"/>
        <circle x="600" y="795" r="9" fill="$hl"/>
        <text x="624" y="795" size="31" weight="600" fill="#fff" text="@c5b"/>
      </group>
    </scene>

    <!-- 6 · the repo: the screenshot swaps, the camera pulls back -->
    <scene id="repo" dur="9" chapter="@ch6">
      <say at="0.5" text="@vo6"/>
      <sfx at="0.2" src="whoosh"/><sfx at="2.2" src="pop"/><sfx at="4.4" src="pop"/>
      <text x="320" y="88" size="40" weight="800" fill="$ink" text="@st6"><anim prop="opacity" from="0" to="1" dur="0.5"/></text>
      <group clip="url(#viewport)">
        <rect x="320" y="155" w="1280" h="845" fill="#fff"/>
        <group x="306.6" y="-360.4" scale="1.3">
          <keys prop="x" ease="io" v="0:306.6; 1.2:320"/>
          <keys prop="y" ease="io" v="0:-360.4; 1.2:200"/>
          <keys prop="scale" ease="io" v="0:1.3; 1.2:0.8"/>
          <image src="play" x="0" y="0" w="1600" h="1000"/>
          <image src="gh" x="0" y="0" w="1600" h="1000" at="0.5"><anim prop="opacity" from="0" to="1" dur="0.7"/></image>
          <rect x="0" y="-56" w="1600" h="56" fill="$chrome"/>
          <circle x="30" y="-28" r="9" fill="#ff5f57"/><circle x="58" y="-28" r="9" fill="#febc2e"/><circle x="86" y="-28" r="9" fill="#28c840"/>
          <rect x="560" y="-44" w="480" h="32" r="16" fill="#ffffffcc"/>
          <text x="800" y="-28" size="18" align="center" fill="$muted" text="github.com/Panth977/tsvg"/>
        </group>
        <path fill="#0b0d1abb" at="2" d="M320 155 H1600 V1000 H320 Z M1100 400 V444 H1206 V400 Z">
          <anim prop="opacity" from="0" to="1" dur="0.4"/>
          <keys prop="d" ease="io" v="2.2: M320 155 H1600 V1000 H320 Z M1100 400 V444 H1206 V400 Z; 3.2: M320 155 H1600 V1000 H320 Z M1216 400 V544 H1458 V400 Z"/>
        </path>
      </group>
      <rect x="1100" y="400" w="106" h="44" r="10" fill="none" stroke="$hl" sw="5" at="2.1">
        <anim prop="opacity" from="0" to="1" dur="0.3"/>
        <keys prop="x" ease="io" v="0.1: 1100; 1.1: 1216"/><keys prop="y" ease="io" v="0.1: 400; 1.1: 400"/>
        <keys prop="w" ease="io" v="0.1: 106; 1.1: 242"/><keys prop="h" ease="io" v="0.1: 44; 1.1: 144"/>
      </rect>
      <group at="2.2" dur="2">
