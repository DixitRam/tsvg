  <music src="drone" start="0" loop="1" vol="0.7"/>
  <backdrop>

    <group opacity="0.22">
      <group repeat="48" as="c" x="=c*40 + 10" y="=-200 + fract(t*(0.08 + 0.12*rand(c*3)) + rand(c))*1480 - 200">
        <text repeat="14" as="r" y="=r*-34" size="34" font="VT323" align="center" fill="=r == 0 ? '#d8fff0' : '#00ff9c'" opacity="=1 - r/14" text="{data('glyphs', floor(rand(c*13 + r*7 + floor(t*6))*20))}"/>
      </group>
    </group>
  </backdrop>
  <timeline>
    <scene id="intro" dur="8" chapter="@ch1">
      <say at="0.5" text="@vo_intro"/>

      <sfx at="0.2" src="whoosh"/><sfx at="1.2" src="blip"/>
      
      <group x="960" y="430" at="0">
        <anim prop="opacity" from="0" to="1" dur="0.4" ease="step"/>
        <text x="=-6 - 14*step(0.82, rand(floor(T*12) + 1))" size="120" weight="700" align="center" text="@t1" fill="#ff3355" opacity="0.8" blend="screen"/>
        <text x="=6 + 14*step(0.82, rand(floor(T*12) + 10))" size="120" weight="700" align="center" text="@t1" fill="#00f0ff" opacity="0.8" blend="screen"/>
        <group repeat="6" as="b" clip="url(#band26)" x="=40*(rand(floor(T*12)*7 + b + 1) - 0.5)*2*step(0.75, rand(floor(T*12) + 4))">
          <text y="=0" size="120" weight="700" align="center" text="@t1" fill="#eafcff"/>
        </group>
      </group>
      
      <group x="960" y="590" at="0.8">
        <anim prop="opacity" from="0" to="1" dur="0.4" ease="step"/>
        <text x="=-6 - 14*step(0.82, rand(floor(T*12) + 5))" size="90" weight="700" align="center" text="@t2" fill="#ff3355" opacity="0.8" blend="screen"/>
