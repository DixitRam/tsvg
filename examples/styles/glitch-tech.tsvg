    <scene id="otp" dur="8" chapter="@ch4">
      <say at="0.5" text="@vo_otp"/>

      <sfx at="1" src="blip"/>
      
      <group x="120" y="150" at="0">
        <anim prop="opacity" from="0" to="1" dur="0.4" ease="step"/>
        <text x="=-6 - 14*step(0.82, rand(floor(T*12) + 41))" size="64" weight="700" align="left" text="@h4" fill="#ff3355" opacity="0.8" blend="screen"/>
        <text x="=6 + 14*step(0.82, rand(floor(T*12) + 50))" size="64" weight="700" align="left" text="@h4" fill="#00f0ff" opacity="0.8" blend="screen"/>
        <group repeat="6" as="b" clip="url(#band14)" x="=40*(rand(floor(T*12)*7 + b + 41) - 0.5)*2*step(0.75, rand(floor(T*12) + 44))">
          <text y="=0" size="64" weight="700" align="left" text="@h4" fill="#eafcff"/>
        </group>
      </group>
      <group x="960" y="600">
        <rect x="-190" y="-340" w="380" h="680" r="48" fill="#0b1220" stroke="#00f0ff" sw="4" shadow="0 0 30 #00f0ff66"/>
        <rect x="-160" y="-290" w="320" h="560" r="20" fill="#0f1a2c"/>
        <text y="-150" size="30" font="JetBrains Mono" align="center" fill="#00f0ff" text="verification code"/>
        <text y="-40" size="72" font="JetBrains Mono" weight="700" align="center" fill="#eafcff" text="{floor(T*0.25) % 2 ? '904 116' : '372 851'}" at="0.8"><anim prop="reveal" from="0" to="1" dur="0.6" ease="linear"/></text>
        <rect x="-130" y="40" w="=260*(1 - fract(T*0.25))" h="10" r="5" fill="#00ff9c"/>
        <text y="120" size="26" font="JetBrains Mono" align="center" fill="#7d8b99" text="expires in {30 - floor(fract(T*0.25)*30)} s"/>
      </group>
      <group x="1450" y="560" at="2.4"><anim prop="scale" from="0" to="1" dur="0.3" ease="back"/>
        <path d="M 0 -150 L 120 -100 L 120 10 C 120 90 60 140 0 170 C -60 140 -120 90 -120 10 L -120 -100 Z" fill="#00ff9c22" stroke="#00ff9c" sw="5" shadow="0 0 24 #00ff9c"/>
        <path d="M -50 10 L -10 50 L 60 -40" fill="none" stroke="#00ff9c" sw="10"/>
      </group>
      <text x="300" y="450" size="34" font="JetBrains Mono" fill="#ff3355" text="password ✓ (stolen)" at="0.6"><anim prop="reveal" from="0" to="1" dur="0.4" ease="linear"/></text>
      <text x="300" y="520" size="34" font="JetBrains Mono" fill="#00ff9c" text="+ code ✗" at="1.6"><anim prop="reveal" from="0" to="1" dur="0.4" ease="linear"/></text>
    </scene>
    <scene id="proxy" dur="10" chapter="@ch5">
      <say at="0.5" text="@vo_proxy"/>

      <sfx at="2" src="whoosh"/><sfx at="4" src="blip"/>
      
