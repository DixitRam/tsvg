<?xml version="1.0" encoding="UTF-8"?>
<tsvg version="0.2" title="@title" font="Space Grotesk">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:am_adam"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full (voice + music + sfx)"/><choice id="speech" label="Speech only"/><choice id="ambient" label="No voice"/></option>
    <option id="theme" label="Theme" default="dark"><choice id="dark" label="Dark"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.35" sfx="0.7"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
    <mix id="ambient" voice="0" music="0.6" sfx="0.7"/>
  </mixes>
  <themes>
    <theme id="dark" bg="#05060a" fg="#eafcff" muted="#7d8b99" accent="#00f0ff"/>
  </themes>
  <strings>
    <s id="title" en="Why passwords leak"/>
    <s id="ch1" en="Leaked"/>
    <s id="ch2" en="Breaches"/>
    <s id="ch3" en="Stuffing"/>
    <s id="ch4" en="Codes"/>
    <s id="ch5" en="Phishing"/>
    <s id="ch6" en="Passkeys"/>
    <s id="ch7" en="Fix"/>
    <s id="t1" en="YOUR PASSWORD"/>
    <s id="t2" en="IS ALREADY OUT THERE"/>
    <s id="h2" en="BREACH DUMP"/>
    <s id="leaked" en="RECORDS LEAKED THIS YEAR"/>
    <s id="h3" en="CREDENTIAL STUFFING"/>
    <s id="h4" en="ONE-TIME CODE"/>
    <s id="h5" en="PHISHING PROXY"/>
    <s id="fake" en="FAKE LOGIN"/>
    <s id="h6" en="PASSKEY"/>
    <s id="bound" en="SIGNED FOR ONE DOMAIN ONLY"/>
    <s id="o1" en="USE PASSKEYS"/>
    <s id="o2" en="nothing to reuse · nothing to phish"/>
    <s id="u" en="YOU"/>
    <s id="real" en="REAL SITE"/>
    <s id="vo_intro" en="Your password is probably already out there. Here is why, and what actually fixes it."/>
    <s id="vo_dump" en="Every year, billions of logins leak from hacked websites, and they are sold in bulk."/>
    <s id="vo_stuff" en="Attackers replay those passwords on other sites. Reuse one, and a single leak unlocks everything."/>
    <s id="vo_otp" en="A one-time code helps, because the stolen password alone is no longer enough."/>
    <s id="vo_proxy" en="But a fake login page can ask for the code too, and relay it to the real site within seconds."/>
    <s id="vo_pass" en="Passkeys fix this. The key never leaves your device, and it only answers the real domain."/>
    <s id="vo_outro" en="Nothing to reuse, nothing to phish. Turn on passkeys."/>
  </strings>
  <defs>

    <data id="users" v="maya.k,j.ortiz,rahul88,lena_v,sam.p,ana.r,kofi.a,mei.l,tom_b,ivy.c,omar.s,zoe.w,raj.p,eva.m,li.h,noah.g,priya.d,leo.t"/><data id="domains" v="mail.example,web.example,shop.example,post.example"/><data id="hashes" v="5f4dcc3b5aa765d6,e99a18c428cb38d5,25d55ad283aa400a,d8578edf8458ce06,fcea920f7412b5da,827ccb0eea8a706c,96e79218965eb72c,0d107d09f5bbe40c,6cb75f652a9b52798"/>
