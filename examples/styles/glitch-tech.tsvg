        <text x="=6 + 14*step(0.82, rand(floor(T*12) + 60))" size="64" weight="700" align="left" text="@h5" fill="#00f0ff" opacity="0.8" blend="screen"/>
        <group repeat="6" as="b" clip="url(#band14)" x="=40*(rand(floor(T*12)*7 + b + 51) - 0.5)*2*step(0.75, rand(floor(T*12) + 54))">
          <text y="=0" size="64" weight="700" align="left" text="@h5" fill="#eafcff"/>
        </group>
      </group>
      
      <group x="300" y="560" at="0.4"><anim prop="opacity" from="0" to="1" dur="0.1" ease="step"/>
        <rect x="-200" y="-150" w="400" h="300" fill="#070b12e6" stroke="#00f0ff" sw="3" shadow="0 0 24 #00f0ff55"/>
        <text y="-90" size="44" weight="700" align="center" fill="#00f0ff" text="@u"/>
        <rect x="-150" y="-20" w="300" h="50" fill="#ffffff10" stroke="#ffffff33" sw="1"/><rect x="-150" y="50" w="300" h="50" fill="#ffffff10" stroke="#ffffff33" sw="1"/>
      </group>
      <group x="960" y="560" at="0.8"><anim prop="opacity" from="0" to="1" dur="0.1" ease="step"/>
        <rect x="-200" y="-150" w="400" h="300" fill="#070b12e6" stroke="#ff3355" sw="3" shadow="0 0 24 #ff335555"/>
        <text y="-90" size="44" weight="700" align="center" fill="#ff3355" text="@fake"/>
        <rect x="-150" y="-20" w="300" h="50" fill="#ffffff10" stroke="#ffffff33" sw="1"/><rect x="-150" y="50" w="300" h="50" fill="#ffffff10" stroke="#ffffff33" sw="1"/>
      </group>
      <group x="1620" y="560" at="1.2000000000000002"><anim prop="opacity" from="0" to="1" dur="0.1" ease="step"/>
        <rect x="-200" y="-150" w="400" h="300" fill="#070b12e6" stroke="#00ff9c" sw="3" shadow="0 0 24 #00ff9c55"/>
