      </group>
      <group x="=960 + 10*(rand(floor(T*12)) - 0.5)*step(0.6, rand(floor(T*12) + 55))" y="375" at="1.2" opacity="=0.6 + 0.4*step(0.5, rand(floor(T*12) + 57))">
        <text size="30" font="JetBrains Mono" align="center" fill="#ff3355" text="bank-login.example"/></group>
      <text x="1620" y="375" size="30" font="JetBrains Mono" align="center" fill="#00ff9c" text="bank.example" at="1.6"/>
      
      <group at="2">
        <line x1="500" y1="560" x2="760" y2="560" stroke="#ff3355" sw="4" draw="=ease((T-2)/0.5,'out')" shadow="0 0 12 #ff3355"/>
        <path d="M 760 560 L 736 546 L 736 574 Z" fill="#ff3355" at="0.5"/>
        <text x="630" y="520" size="26" font="JetBrains Mono" align="center" fill="#eafcff" text="pw + 372 851" at="0.3"/>
      </group>
      <group at="3.4">
        <line x1="1160" y1="560" x2="1420" y2="560" stroke="#ff3355" sw="4" draw="=ease((T-3.4)/0.5,'out')" shadow="0 0 12 #ff3355"/>
        <path d="M 1420 560 L 1396 546 L 1396 574 Z" fill="#ff3355" at="0.5"/>
        <text x="1290" y="520" size="26" font="JetBrains Mono" align="center" fill="#eafcff" text="pw + 372 851" at="0.3"/>
      </group>
      <text x="960" y="840" size="40" font="JetBrains Mono" align="center" fill="#ff3355" text="relayed in 0.8 s" at="4.6"><anim prop="reveal" from="0" to="1" dur="0.6" ease="linear"/></text>
    </scene>
    <scene id="pass" dur="10" chapter="@ch6">
      <say at="0.5" text="@vo_pass"/>

      <sfx at="1.2" src="ding"/><sfx at="4" src="click"/>
      
      <group x="120" y="150" at="0">
