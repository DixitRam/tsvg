          text="{data('users', r + floor(T*1.5))}@{data('domains', r*3 + floor(T*1.5))}  :  {data('hashes', r*7 + floor(T*1.5))}"/>
      </group>
      <group x="1560" y="520" at="1.5"><anim prop="opacity" from="0" to="1" dur="0.2" ease="step"/>
        <text size="130" weight="700" align="center" fill="#ff2bd6" text="{fmt(2.6*ease((T-1.5)/2.5,'out'), 1)} B" shadow="0 0 30 #ff2bd6"/>
        <text y="110" size="30" font="JetBrains Mono" align="center" fill="#eafcff" text="@leaked"/>
      </group>
    </scene>
