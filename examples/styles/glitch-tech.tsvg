    <clip id="band24"><rect x="-2000" y="=-71.5 + b*24" w="4000" h="24"/></clip>
    <clip id="band26"><rect x="-2000" y="=-78 + b*26" w="4000" h="26"/></clip>
    <clip id="band14"><rect x="-2000" y="=-41.6 + b*14" w="4000" h="14"/></clip>
    <clip id="band22"><rect x="-2000" y="=-65 + b*22" w="4000" h="22"/></clip>
    <clip id="band20"><rect x="-2000" y="=-58.5 + b*20" w="4000" h="20"/></clip>
  </defs>
