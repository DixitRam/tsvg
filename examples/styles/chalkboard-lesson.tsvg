<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: chalkboard lesson. Green board, dusty chalk strokes, handwriting, underlines and circled answers. -->
<tsvg version="0.2" title="@title" font="Caveat, Inter">
  <layouts><layout id="landscape" w="1920" h="1080"/></layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:bm_george"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
    <option id="theme" default="chalk"><choice id="chalk" label="Chalkboard"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.18" sfx="0.5"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="chalk" bg="#24392e" fg="#f1efe4" chalk="#f1efe4" yellow="#f3dc7a" pink="#f4a3b4" blue="#9fd0f0" wood="#7a5232" wood2="#5b3a22"/></themes>
  <strings>
    <s id="title" en="Adding fractions"/>
    <s id="lesson" en="Lesson 7 · Tuesday"/>
    <s id="ch1" en="Today"/>
    <s id="ch2" en="The problem"/>
    <s id="ch3" en="A common mistake"/>
    <s id="ch4" en="Common denominator"/>
    <s id="ch5" en="Rewrite"/>
    <s id="ch6" en="Add"/>
    <s id="ch7" en="Remember"/>
    <s id="plus" en="+"/>
    <s id="eq" en="="/>
    <s id="neq" en="≠"/>
    <s id="q" en="?"/>
    <s id="why" en="smaller than ⅓ ?!"/>
    <s id="m3" en="threes:"/>
    <s id="m4" en="fours:"/>
    <s id="l3" en="3   6   9   12"/>
    <s id="l4" en="4   8   12"/>
    <s id="x4" en="× 4"/>
    <s id="x3" en="× 3"/>
    <s id="rule1" en="Make the bottoms the same,"/>
    <s id="rule2" en="then add the tops."/>
    <s id="hw" en="Homework:  1/2 + 1/5"/>
    <s id="vo1" en="Today on the board: adding fractions that do not share a bottom number. Let us try one third plus one quarter."/>
    <s id="vo2" en="One third of a pie, plus one quarter of a pie. The pieces are different sizes, so we cannot just add them."/>
    <s id="vo3" en="A common mistake is to add the tops and the bottoms, and get two sevenths. But that is smaller than a third, so it cannot be right."/>
    <s id="vo4" en="Instead, find a common denominator. Count in threes and in fours. The first number both lists reach is twelve."/>
    <s id="vo5" en="Now rewrite each fraction in twelfths. One third becomes four twelfths, and one quarter becomes three twelfths."/>
    <s id="vo6" en="Now the pieces match, so we add the tops. Four twelfths plus three twelfths is seven twelfths."/>
    <s id="vo7" en="So remember: make the bottoms the same, then add the tops. Homework: one half plus one fifth."/>
    <s id="n3_3" en="3"/>
    <s id="n3_6" en="6"/>
    <s id="n3_9" en="9"/>
    <s id="n3_12" en="12"/>
    <s id="n4_4" en="4"/>
    <s id="n4_8" en="8"/>
    <s id="n4_12" en="12"/>
    <s id="lcd12" en="LCD = 12"/>
    <s id="seven" en="7 of 12 slices"/>
    <s id="f0" en="1"/>
    <s id="f1" en="3"/>
    <s id="f2" en="1"/>
    <s id="f3" en="4"/>
    <s id="f4" en="1"/>
    <s id="f5" en="3"/>
    <s id="f6" en="1"/>
    <s id="f7" en="4"/>
    <s id="f8" en="1"/>
    <s id="f9" en="3"/>
    <s id="f10" en="1"/>
    <s id="f11" en="4"/>
    <s id="f12" en="2"/>
    <s id="f13" en="7"/>
    <s id="f14" en="1"/>
    <s id="f15" en="3"/>
    <s id="f16" en="4"/>
    <s id="f17" en="12"/>
    <s id="f18" en="1"/>
    <s id="f19" en="4"/>
    <s id="f20" en="3"/>
    <s id="f21" en="12"/>
    <s id="f22" en="4"/>
    <s id="f23" en="12"/>
    <s id="f24" en="3"/>
    <s id="f25" en="12"/>
    <s id="f26" en="7"/>
    <s id="f27" en="12"/>
  </strings>
  <defs>
    <radial id="board" x="960" y="480" r="1200"><stop at="0" color="#2e4a3b"/><stop at="1" color="#1b2b22"/></radial>
    <linear id="woodg" x1="0" y1="0" x2="0" y2="60"><stop at="0" color="$wood"/><stop at="1" color="$wood2"/></linear>
  </defs>
  <assets>
    <asset id="pad" src="audio/pad.m4a"/><asset id="click" src="audio/click.m4a"/>
