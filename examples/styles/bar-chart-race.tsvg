<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: bar chart race (data story). Ranked bars slide past each other; ranks are a soft count of
     which bars are bigger, so they move continuously. Everything is driven by data() + <fn>. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:am_michael"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
    <option id="theme" label="Theme" default="light"><choice id="light" label="Light"/><choice id="dark" label="Dark"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.22" sfx="0.6"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
  </mixes>
  <themes>
    <theme id="light" bg="#f7f5f0" fg="#16181d" muted="#6f7482" grid="#dcd8cf" panel="#ffffff" accent="#e4572e" ink="#16181d"/>
    <theme id="dark" bg="#111318" fg="#eef0f4" muted="#8a90a0" grid="#2a2e38" panel="#1b1e26" accent="#ff7a50" ink="#eef0f4"/>
  </themes>

  <strings>
    <s id="title" en="The solar race"/>
    <s id="sub" en="Solar electricity generated per year, by country (terawatt-hours)"/>
    <s id="kicker" en="DATA STORY"/>
    <s id="t1" en="Who makes the most electricity from sunlight?"/>
    <s id="t2" en="Ten countries · ten years · one race"/>
    <s id="src" en="Figures rounded from national energy statistics. Illustrative chart."/>
    <s id="unit" en="TWh"/>
    <s id="ch1" en="Intro"/><s id="ch2" en="2015: a tie"/><s id="ch3" en="China pulls away"/>
    <s id="ch4" en="New entrants"/><s id="ch5" en="2024"/><s id="ch6" en="Takeaway"/>
    <s id="c2" en="2015: the top four are within 10 TWh of each other"/>
    <s id="c3" en="India: 7 TWh in 2015, 51 TWh in 2019"/>
    <s id="c4" en="Brazil: 0.1 TWh in 2015, 30 TWh by 2022"/>
    <s id="c5" en="China 834 TWh &gt; next five combined (683 TWh)"/>
    <s id="o1" en="Early leaders&#10;rarely stay ahead"/>
    <s id="o2" en="when a cheaper technology starts to scale."/>
    <s id="o3" en="China's share of these ten countries, 2024"/>
    <s id="vo1" en="Ten years ago, solar power was a rounding error. Here is how the biggest solar producers raced ahead, year by year."/>
    <s id="vo2" en="In 2015, China, the United States, Germany and Japan were almost level, each making about forty terawatt hours."/>
    <s id="vo3" en="Then China pulls away. Watch India too: it climbs from the back of the pack into the top four by 2019."/>
    <s id="vo4" en="Germany and Japan flatten out as their best rooftops fill up, while Brazil appears almost from nowhere."/>
    <s id="vo5" en="By 2024, China generates more solar power than the next five countries combined, and Brazil edges past Germany."/>
    <s id="vo6" en="The lesson for forecasters: early leaders rarely stay ahead once a cheaper technology starts to scale."/>
  </strings>

  <defs>
    <!-- 10 countries × 10 years (2015…2024), year-major -->
    <data id="d" v="45,40,35,38.7,7,23,14,6,0.1,7.5,
                    75,55,46,38,14,22,14,7,0.1,10.4,
                    118,77,55,39,26,24,15,8,0.8,11.5,
                    177,93,63,46,40,23,13.5,11,3.5,12.4,
                    224,107,69,46,51,24,15,17,6.7,12.7,
                    261,132,79,50,61,25,20,24,10.7,13.2,
                    327,165,86,50,68,25,27,31,16.8,12.1,
                    428,205,97,60,95,28,32,38,30,13.3,
                    584,238,99,62,113,31,41,45,51,14,
                    834,303,101,72,133,36,48,50,74,15"/>
    <data id="name" v="China, United States, Japan, Germany, India, Italy, Spain, Australia, Brazil, United Kingdom"/>
    <data id="code" v="CN, US, JP, DE, IN, IT, ES, AU, BR, UK"/>
    <data id="col" v="#e4572e, #3b6fd8, #d64f8a, #5b5f6b, #f29e2e, #2e9e6b, #c9a227, #19a3b5, #57a83c, #7a5cc7"/>
    <!-- race clock: 2015 held until t=15, then one year every 3.5 s, holds at 2024 -->
    <fn id="yr">clamp((t - 15) / 3.5, 0, 9)</fn>
    <fn id="v" args="k">lerp(data('d', min(floor(yr()), 8) * 10 + k), data('d', min(floor(yr()), 8) * 10 + 10 + k), yr() - min(floor(yr()), 8))</fn>
    <fn id="mx">max(v(0), v(1), v(2), v(3), v(4), v(5), v(6), v(7), v(8), v(9))</fn>
    <fn id="gt" args="j,k">smooth(-0.5 - 0.02*v(k), 0.5 + 0.02*v(k), v(j) - v(k))</fn>
    <fn id="rank" args="k">gt(0,k)+gt(1,k)+gt(2,k)+gt(3,k)+gt(4,k)+gt(5,k)+gt(6,k)+gt(7,k)+gt(8,k)+gt(9,k) - 0.5</fn>

    <linear id="sheen" x1="0" y1="-28" x2="0" y2="28"><stop at="0" color="#ffffff" opacity="0.22"/><stop at="1" color="#ffffff" opacity="0"/></linear>

    <!-- the whole chart as a symbol so every scene shows the same continuous race -->
    <symbol id="race">
      <text x="120" y="92" size="22" weight="800" fill="$accent" text="@kicker"/>
      <text x="120" y="138" size="52" weight="800" fill="$fg" text="@title"/>
      <text x="120" y="190" size="28" fill="$muted" text="@sub"/>
      <!-- grid: 25-step lines fade out as the scale grows, 100-step lines fade in -->
      <group x="380" y="262">
        <group repeat="10" as="g" opacity="=clamp((260 - mx())/80, 0, 1)">
          <line x1="=g*25/mx()*1150" x2="=g*25/mx()*1150" y1="-6" y2="706" stroke="$grid" sw="2" when="g*25/mx() &lt; 1.02"/>
          <text x="=g*25/mx()*1150" y="-30" size="20" align="center" fill="$muted" text="{g*25}" when="g*25/mx() &lt; 1.02"/>
        </group>
        <group repeat="10" as="g" opacity="=clamp((mx() - 180)/80, 0, 1)">
          <line x1="=g*100/mx()*1150" x2="=g*100/mx()*1150" y1="-6" y2="706" stroke="$grid" sw="2" when="g*100/mx() &lt; 1.02"/>
          <text x="=g*100/mx()*1150" y="-30" size="20" align="center" fill="$muted" text="{g*100}" when="g*100/mx() &lt; 1.02"/>
        </group>
      </group>
      <!-- bars -->
      <group repeat="10" as="k" x="380" y="=290 + rank(k)*70">
        <rect x="0" y="-28" w="=max(6, v(k)/mx()*1150)" h="56" r="6" fill="=data('col', k)"/>
        <rect x="0" y="-28" w="=max(6, v(k)/mx()*1150)" h="56" r="6" fill="url(#sheen)"/>
        <text x="-22" y="0" size="27" weight="700" align="right" fill="$fg" text="{data('name', k)}"/>
        <text x="=max(6, v(k)/mx()*1150) + 16" y="0" size="26" weight="700" fill="$fg" text="{fmt(v(k), v(k) &lt; 10 ? 1 : 0)}"/>
        <text x="=max(6, v(k)/mx()*1150) - 14" y="1" size="20" weight="800" align="right" fill="#ffffff" opacity="0.9" text="{data('code', k)}" when="v(k)/mx() &gt; 0.08"/>
      </group>
      <line x1="380" y1="250" x2="380" y2="970" stroke="$fg" sw="3"/>
      <!-- year counter + scrubber -->
      <text x="1800" y="880" size="190" weight="900" align="right" fill="$muted" opacity="0.55" font="Anton" text="{2015 + floor(yr() + 0.001)}"/>
      <group x="1290" y="1000">
        <rect w="510" h="6" r="3" fill="$grid"/>
        <rect w="=510*yr()/9" h="6" r="3" fill="$accent"/>
        <circle x="=510*yr()/9" y="3" r="11" fill="$accent"/>
        <text x="0" y="-26" size="18" fill="$muted" text="2015"/>
        <text x="510" y="-26" size="18" align="right" fill="$muted" text="2024"/>
      </group>
      <text x="120" y="1030" size="20" fill="$muted" text="@src"/>
    </symbol>
    <!-- a callout card (text from the scene) -->
  </defs>

  <assets>
    <asset id="pulse" src="audio/pulse.ogg"/>
    <asset id="whoosh" src="audio/whoosh.ogg"/>
    <asset id="ding" src="audio/ding.ogg"/>
    <asset id="click" src="audio/click.ogg"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <font family="Anton" src="fonts/Anton.ttf"/>
  </assets>

  <music src="pulse" start="0" loop="1" vol="0.7"/>

  <timeline>
    <!-- 1 · title card -->
    <scene id="intro" dur="9" chapter="@ch1">
      <say at="0.5" text="@vo1"/>
      <sfx at="0.2" src="whoosh"/>
      <!-- sketch of bars growing behind the title -->
      <group x="=W/2 - 520" y="820" opacity="0.9">
        <rect repeat="10" as="k" x="=k*108" w="78" ay="1" r="8" h="=(40 + 42*k + 18*sin(k*1.7)) * ease((T - 0.4 - k*0.08)/1.1, 'out')" fill="=data('col', 9 - k)" opacity="0.85"/>
        <line x1="-30" y1="0" x2="1090" y2="0" stroke="$fg" sw="4"/>
      </group>
      <text x="=W/2" y="180" size="26" weight="800" align="center" fill="$accent" text="@kicker">
        <anim prop="opacity" from="0" to="1" dur="0.5"/>
      </text>
      <text x="=W/2" y="270" size="120" weight="900" align="center" fill="$fg" text="@title" font="Anton">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
        <anim prop="y" from="300" to="270" dur="0.8"/>
      </text>
      <text x="=W/2" y="370" size="40" align="center" fill="$fg" text="@t1" at="0.9">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
      </text>
      <text x="=W/2" y="430" size="30" align="center" fill="$muted" text="@t2" at="1.5">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
      </text>
      <circle x="=W/2 + 600" y="250" r="=46*ease((T-1)/1, 'back')" fill="#f2b632">
        <anim prop="rot" from="0" to="90" dur="8" ease="linear"/>
      </circle>
      <group x="=W/2 + 600" y="250" rot="=T*20" opacity="=clamp(T - 1.3, 0, 1)">
        <group repeat="8" as="r" rot="=r*45"><rect x="-4" y="-86" w="8" h="22" r="4" fill="#f2b632"/></group>
      </group>
    </scene>

    <!-- 2 · 2015–2017 -->
    <scene id="y2015" dur="10.5" chapter="@ch2">
      <say at="0.3" text="@vo2"/>
      <sfx at="0.1" src="click"/>
      <use ref="race"/>
      <group x="1130" y="560" at="1">
        <anim prop="opacity" from="0" to="1" dur="0.5"/>
        <anim prop="opacity" from="1" to="0" at="7.6" dur="0.5"/>
        <rect w="660" h="110" r="14" fill="$panel" shadow="0 10 30 #0002"/>
        <rect w="8" h="110" r="4" fill="$accent"/>
        <text x="36" y="55" size="30" weight="600" maxw="600" fill="$fg" text="@c2"/>
      </group>
    </scene>

    <!-- 3 · 2017–2019 -->
    <scene id="y2017" dur="9.5" chapter="@ch3">
      <say at="0.3" text="@vo3"/>
      <use ref="race"/>
      <group x="1130" y="560" at="3">
        <anim prop="opacity" from="0" to="1" dur="0.5"/>
        <anim prop="opacity" from="1" to="0" at="5.8" dur="0.5"/>
        <rect w="660" h="110" r="14" fill="$panel" shadow="0 10 30 #0002"/>
        <rect w="8" h="110" r="4" fill="#f29e2e"/>
        <text x="36" y="55" size="30" weight="600" maxw="600" fill="$fg" text="@c3"/>
      </group>
    </scene>

    <!-- 4 · 2019–2022 -->
    <scene id="y2019" dur="11" chapter="@ch4">
      <say at="0.3" text="@vo4"/>
      <use ref="race"/>
      <group x="1130" y="560" at="4">
        <anim prop="opacity" from="0" to="1" dur="0.5"/>
        <anim prop="opacity" from="1" to="0" at="6.3" dur="0.5"/>
        <rect w="660" h="110" r="14" fill="$panel" shadow="0 10 30 #0002"/>
        <rect w="8" h="110" r="4" fill="#57a83c"/>
        <text x="36" y="55" size="30" weight="600" maxw="600" fill="$fg" text="@c4"/>
      </group>
    </scene>

    <!-- 5 · 2022–2024, final standings -->
    <scene id="y2024" dur="11" chapter="@ch5">
      <say at="0.3" text="@vo5"/>
      <sfx at="8.2" src="ding"/>
      <use ref="race"/>
      <!-- bracket over the next five once the race stops -->
      <group at="8.2">
        <anim prop="opacity" from="0" to="1" dur="0.5"/>
        <path x="0" y="0" d="M 1020 334 L 1040 334 L 1040 646 L 1020 646" stroke="$accent" sw="4" fill="none">
          <anim prop="draw" from="0" to="1" dur="0.8"/>
        </path>
        <group x="1070" y="435">
          <rect w="760" h="110" r="14" fill="$panel" shadow="0 10 30 #0002"/>
          <rect w="8" h="110" r="4" fill="$accent"/>
          <text x="36" y="55" size="30" weight="700" maxw="700" fill="$fg" text="@c5"/>
        </group>
      </group>
    </scene>

    <!-- 6 · takeaway -->
    <scene id="outro" dur="9" chapter="@ch6">
      <say at="0.4" text="@vo6"/>
      <group opacity="0.07"><use ref="race"/></group>
      <!-- donut: China's share of the ten -->
      <group x="560" y="560">
        <circle r="230" fill="$grid"/>
        <circle r="230" from="0" to="=360*0.5*ease((T-0.5)/1.6,'io')" fill="#e4572e"/>
        <circle r="150" fill="$bg"/>
        <text y="-10" size="96" weight="900" align="center" font="Anton" fill="$fg" text="{fmt(50*ease((T-0.5)/1.6,'io'), 0)}%"/>
        <text y="70" size="24" align="center" fill="$muted" maxw="260" text="@o3"/>
      </group>
      <text x="900" y="440" size="70" lh="1.1" weight="800" maxw="900" fill="$fg" text="@o1" at="1.2">
        <anim prop="reveal" from="0" to="1" dur="1.0" ease="linear"/>
      </text>
      <text x="900" y="580" size="44" maxw="900" fill="$muted" text="@o2" at="2.4">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
      </text>
      <rect x="900" y="650" w="0" h="8" r="4" fill="$accent" at="3">
        <anim prop="w" from="0" to="300" dur="0.8" ease="io"/>
      </rect>
    </scene>
  </timeline>

  <!-- written by `tsvg bake`: one recorded clip per <say> line and language -->
  <voices>
    <voice say="vo1" lang="en" src="voice/bar-chart-race/en/vo1.ee52a06c11.ogg" dur="7.91" hash="ee52a06c11" engine="kokoro:am_michael"/>
    <voice say="vo2" lang="en" src="voice/bar-chart-race/en/vo2.bd2a06d525.ogg" dur="9.61" hash="bd2a06d525" engine="kokoro:am_michael"/>
    <voice say="vo3" lang="en" src="voice/bar-chart-race/en/vo3.646a8cd909.ogg" dur="7.91" hash="646a8cd909" engine="kokoro:am_michael"/>
    <voice say="vo4" lang="en" src="voice/bar-chart-race/en/vo4.1046d26ff9.ogg" dur="6.71" hash="1046d26ff9" engine="kokoro:am_michael"/>
    <voice say="vo5" lang="en" src="voice/bar-chart-race/en/vo5.a7c7e05235.ogg" dur="9.21" hash="a7c7e05235" engine="kokoro:am_michael"/>
    <voice say="vo6" lang="en" src="voice/bar-chart-race/en/vo6.b3ca510870.ogg" dur="6.91" hash="b3ca510870" engine="kokoro:am_michael"/>
  </voices>
</tsvg>
