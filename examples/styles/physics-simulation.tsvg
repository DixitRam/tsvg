<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: physics simulation explainer. Live motion from expressions: projectile with trace, vectors, a pendulum, parameters changing on screen. -->
<tsvg version="0.2" title="@title" font="Space Grotesk, Inter">
  <layouts><layout id="landscape" w="1920" h="1080"/></layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:am_adam"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
    <option id="theme" default="lab"><choice id="lab" label="Lab"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.25" sfx="0.5"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="lab" bg="#0a1320" fg="#e6eef7" muted="#7f93a8" cyan="#4fd1ff" orange="#ffa94d" green="#7ee081" red="#ff6b6b" grid="#14273b"/></themes>
  <strings>
    <s id="title" en="Motion from equations"/>
    <s id="sub" en="projectiles · pendulums"/>
    <s id="ch1" en="Intro"/>
    <s id="ch2" en="Projectile"/>
    <s id="ch3" en="Launch angle"/>
    <s id="ch4" en="Pendulum"/>
    <s id="ch5" en="String length"/>
    <s id="ch6" en="Amplitude"/>
    <s id="ch7" en="Summary"/>
    <s id="g" en="g"/>
    <s id="vx" en="vₓ"/>
    <s id="vy" en="v_y"/>
    <s id="v" en="v"/>
    <s id="T" en="tension"/>
    <s id="mg" en="mg"/>
    <s id="ke" en="KE"/>
    <s id="pe" en="PE"/>
    <s id="theta" en="θ"/>
    <s id="best" en="45° = max range"/>
    <s id="same" en="SAME PERIOD"/>
    <s id="f1" en="R = v² · sin 2θ / g"/>
    <s id="f2" en="T = 2π · √(L / g)"/>
    <s id="f1n" en="range of a projectile"/>
    <s id="f2n" en="period of a pendulum"/>
    <s id="a10" en="θ₀ = 10°"/>
    <s id="a20" en="θ₀ = 20°"/>
    <s id="len" en="L"/>
    <s id="per" en="period vs length"/>
    <s id="vo1" en="Physics is easier to feel when you can watch it move. Every frame here is computed from the equations of motion."/>
    <s id="vo2" en="Launch a ball at twenty metres per second, forty five degrees up. Its sideways speed stays constant, while gravity steadily eats the upward speed."/>
    <s id="vo3" en="Now change the angle. Low shots fall short, steep shots go high but not far. Forty five degrees gives the longest range."/>
    <s id="vo4" en="A pendulum trades height for speed. At the bottom it moves fastest. At the ends it stops for an instant, and turns back."/>
    <s id="vo5" en="Make the string longer, and the swing slows down. The period grows with the square root of the length."/>
    <s id="vo6" en="But the size of the swing barely matters. A small swing and a bigger one keep the same beat."/>
    <s id="vo7" en="Two short formulas, and a whole world of motion."/>
  </strings>
  <defs>
    <fn id="L5" args="">0.5 + 1.5*clamp((T - 1)/7, 0, 1)</fn>
    <fn id="ph5" args="">T &lt; 1 ? 4.4272*T : T &lt; 8 ? 4.4272 + 29.2180*(sqrt(L5()) - 0.7071) : 25.0874 + 2.2136*(T - 8)</fn>
    <radial id="ball" x="-8" y="-8" r="30"><stop at="0" color="#fff3d6"/><stop at="1" color="$orange"/></radial>
    <radial id="bob" x="-10" y="-10" r="40"><stop at="0" color="#e8fbff"/><stop at="1" color="#2aa6d8"/></radial>
    <radial id="bobglow" x="0" y="0" r="50"><stop at="0" color="$cyan" opacity="0.4"/><stop at="1" color="$cyan" opacity="0"/></radial>
    <clip id="trail"><rect x="0" y="0" w="=(200 + 480.83261120685233*clamp((T - 1.2)*0.62, 0, 2.886))" h="1080"/></clip>
  </defs>
  <assets>
    <asset id="pulse" src="audio/pulse.ogg"/><asset id="whoosh" src="audio/whoosh.ogg"/><asset id="click" src="audio/click.ogg"/><asset id="ding" src="audio/ding.ogg"/>
    <font family="Space Grotesk" src="fonts/SpaceGrotesk.ttf"/><font family="JetBrains Mono" src="fonts/JetBrainsMono.ttf"/><font family="Inter" src="fonts/Inter.ttf"/>
  </assets>
  <music src="pulse" loop="1" vol="0.5"/>
  <backdrop>
    <line repeat="25" as="k" x1="=k*80" y1="0" x2="=k*80" y2="1080" stroke="$grid" sw="=k % 5 == 0 ? 2 : 1"/>
    <line repeat="14" as="k" x1="0" y1="=k*80" x2="1920" y2="=k*80" stroke="$grid" sw="=k % 5 == 0 ? 2 : 1"/>
  </backdrop>
  <overlay>
    <text x="1880" y="1050" size="22" font="JetBrains Mono" align="right" fill="$muted" text="SIM · t = {fmt(t, 2)} s"/>
  </overlay>
  <timeline>
    <scene id="intro" dur="9" chapter="@ch1">
      <say at="0.5" text="@vo1"/>
      <sfx at="0.3" src="whoosh"/>
      <line x1="80" y1="900" x2="1840" y2="900" stroke="#5a7a99" sw="3"/><line repeat="44" as="k" x1="=90 + k*40" y1="904" x2="=70 + k*40" y2="926" stroke="#2f4a66" sw="2"/>
      <path d="M 200 900 Q 893.9 206.1 1587.8 900" stroke="$orange" sw="3" fill="none" opacity="0.5"><anim prop="draw" from="0" to="1" at="0.5" dur="3" ease="linear"/></path>
      <circle x="=(200 + 480.83261120685233*clamp((T-0.5)/3,0,1)*2.886)" y="=(900 - 34*(14.142135623730951*clamp((T-0.5)/3,0,1)*2.886 - 4.9*clamp((T-0.5)/3,0,1)*2.886*clamp((T-0.5)/3,0,1)*2.886))" r="22" fill="url(#ball)"/>
      <group x="1560" y="160">
        <rect x="-70" y="-16" w="140" h="16" r="4" fill="#2a4b6b"/>
        <path d="M -143.8 263.3 A 300 300 0 0 0 143.8 263.3" stroke="$cyan" sw="2" fill="none" opacity="0.35"/>
        <line x1="0" y1="0" x2="=(300)*sin((0.5*cos(2.4*T)))" y2="=(300)*cos((0.5*cos(2.4*T)))" stroke="#c9d6e3" sw="3"/>
        <group x="=(300)*sin((0.5*cos(2.4*T)))" y="=(300)*cos((0.5*cos(2.4*T)))">
          <circle r="40" fill="url(#bobglow)"/><circle r="26" fill="url(#bob)" stroke="#fff6" sw="2"/></group>
        <circle r="8" fill="#c9d6e3"/>
      </group>
      <text x="140" y="190" size="104" weight="700" fill="$fg" text="@title"><anim prop="reveal" from="0" to="1" dur="1.2" ease="linear"/></text>
      <text x="144" y="290" size="44" font="JetBrains Mono" fill="$cyan" text="@sub" at="1.2"><anim prop="opacity" from="0" to="1" dur="0.6"/></text>
    </scene>

    <scene id="projectile" dur="11" chapter="@ch2">
      <say at="0.3" text="@vo2"/>
      <line x1="80" y1="900" x2="1840" y2="900" stroke="#5a7a99" sw="3"/><line repeat="44" as="k" x1="=90 + k*40" y1="904" x2="=70 + k*40" y2="926" stroke="#2f4a66" sw="2"/>
      <path d="M 200 900 Q 893.9 206.1 1587.8 900" stroke="$orange" sw="4" fill="none" clip="url(#trail)"/>
      <circle repeat="12" as="k" x="=(200 + 480.83261120685233*(k*0.25))" y="=(900 - 34*(14.142135623730951*(k*0.25) - 4.9*(k*0.25)*(k*0.25)))" r="7" fill="$orange" opacity="0.45" when="=clamp((T - 1.2)*0.62, 0, 2.886) &gt; k*0.25 + 0.01"/>
      <group x="=(200 + 480.83261120685233*clamp((T - 1.2)*0.62, 0, 2.886))" y="=(900 - 34*(14.142135623730951*clamp((T - 1.2)*0.62, 0, 2.886) - 4.9*clamp((T - 1.2)*0.62, 0, 2.886)*clamp((T - 1.2)*0.62, 0, 2.886)))">
        <line x1="0" y1="0" x2="113.1" y2="0" stroke="$green" sw="5"/><path x="113.1" d="M -18 -10 L 0 0 L -18 10 Z" fill="$green"/>
        <line x1="0" y1="0" x2="0" y2="=-8*(14.142 - 9.8*clamp((T - 1.2)*0.62, 0, 2.886))" stroke="$orange" sw="5"/>
        <group rot="=atan2(-8*(14.142 - 9.8*clamp((T - 1.2)*0.62, 0, 2.886)), 113.14)*180/PI"><line x1="0" y1="0" x2="=max(0, sqrt(12800.0 + pow(8*(14.142 - 9.8*clamp((T - 1.2)*0.62, 0, 2.886)),2)) - 16)" y2="0" stroke="$cyan" sw="6"/><path x="=sqrt(12800.0 + pow(8*(14.142 - 9.8*clamp((T - 1.2)*0.62, 0, 2.886)),2))" d="M -22 -12 L 0 0 L -22 12 Z" fill="$cyan" when="=sqrt(12800.0 + pow(8*(14.142 - 9.8*clamp((T - 1.2)*0.62, 0, 2.886)),2)) &gt; 8"/></group>
        <group rot="90"><line x1="40" y1="0" x2="110" y2="0" stroke="$red" sw="5"/><path x="120" d="M -18 -10 L 0 0 L -18 10 Z" fill="$red"/></group>
        <text x="16" y="140" size="30" font="JetBrains Mono" fill="$red" text="@g"/>
        <circle r="24" fill="url(#ball)" shadow="0 0 24 $orange"/>
      </group>
      <group x="200" y="900"><circle r="70" from="45" to="90" fill="$cyan" opacity="0.18"/><text x="96" y="-36" size="30" font="JetBrains Mono" fill="$cyan" text="45°"/></group>
      <group x="1400" y="110"><rect w="440" h="310" r="14" fill="#0f2236cc" stroke="#2a4b6b" sw="2"/><text x="28" y="48" size="32" font="JetBrains Mono" fill="$fg" text="t  = {fmt(clamp((T - 1.2)*0.62, 0, 2.886), 2)} s"/><text x="28" y="102" size="32" font="JetBrains Mono" fill="$fg" text="x  = {fmt(14.142*clamp((T - 1.2)*0.62, 0, 2.886), 1)} m"/><text x="28" y="156" size="32" font="JetBrains Mono" fill="$fg" text="y  = {fmt(14.142*clamp((T - 1.2)*0.62, 0, 2.886) - 4.9*pow(clamp((T - 1.2)*0.62, 0, 2.886),2), 1)} m"/><text x="28" y="210" size="32" font="JetBrains Mono" fill="$green" text="vₓ = 14.1 m/s"/><text x="28" y="264" size="32" font="JetBrains Mono" fill="$orange" text="v_y= {fmt(14.142 - 9.8*clamp((T - 1.2)*0.62, 0, 2.886), 1)} m/s"/></group>
    </scene>

    <scene id="angle" dur="10" chapter="@ch3">
      <say at="0.3" text="@vo3"/>
      <line x1="80" y1="900" x2="1840" y2="900" stroke="#5a7a99" sw="3"/><line repeat="44" as="k" x1="=90 + k*40" y1="904" x2="=70 + k*40" y2="926" stroke="#2f4a66" sw="2"/>
      <path d="M 200 900 Q 646.0 737.7 1092.0 900" stroke="$muted" sw="2" fill="none" opacity="0.35"/><path d="M 200 900 Q 800.9 553.1 1401.8 900" stroke="$muted" sw="2" fill="none" opacity="0.35"/><path d="M 200 900 Q 800.9 -140.8 1401.8 900" stroke="$muted" sw="2" fill="none" opacity="0.35"/><path d="M 200 900 Q 646.0 -325.4 1092.0 900" stroke="$muted" sw="2" fill="none" opacity="0.35"/>
      <path d="M 200 900 Q {200 + 17*(400*sin(2*(45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1))*PI/180)/9.8)} {900 - 68*(400*pow(sin((45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1))*PI/180),2)/19.6)} {200 + 34*(400*sin(2*(45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1))*PI/180)/9.8)} 900" stroke="$orange" sw="5" fill="none" shadow="0 0 14 $orange"/>
      <circle x="=200 + 34*(400*sin(2*(45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1))*PI/180)/9.8)" y="900" r="12" fill="$orange"/>
      <group x="200" y="900"><circle r="90" from="=90 - (45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1))" to="90" fill="$cyan" opacity="0.22"/>
        <group rot="=-(45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1))"><line x1="0" y1="0" x2="=max(0, 150 - 16)" y2="0" stroke="$cyan" sw="5"/><path x="=150" d="M -22 -12 L 0 0 L -22 12 Z" fill="$cyan" when="=150 &gt; 8"/></group>
        <text x="120" y="-40" size="32" font="JetBrains Mono" fill="$cyan" text="{fmt((45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1)), 0)}°"/></group>
      <!-- slider -->
      <group x="160" y="1000">
        <text x="0" y="0" size="32" font="JetBrains Mono" fill="$muted" text="@theta"/>
        <rect x="50" y="-4" w="600" h="8" r="4" fill="#2a4b6b"/>
        <rect x="50" y="-4" w="=600*((45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1)) - 15)/60" h="8" r="4" fill="$cyan"/>
        <circle x="=50 + 600*((45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1)) - 15)/60" y="0" r="18" fill="$cyan" stroke="#fff" sw="3"/>
      </group>
      <group x="1400" y="110"><rect w="440" h="202" r="14" fill="#0f2236cc" stroke="#2a4b6b" sw="2"/><text x="28" y="48" size="32" font="JetBrains Mono" fill="$cyan" text="θ = {fmt((45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1)), 0)}°"/><text x="28" y="102" size="32" font="JetBrains Mono" fill="$orange" text="R = {fmt((400*sin(2*(45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1))*PI/180)/9.8), 1)} m"/><text x="28" y="156" size="32" font="JetBrains Mono" fill="$fg" text="H = {fmt((400*pow(sin((45 + 28*sin(max(0, T - 1)*0.9)*clamp((8.6 - T)/1.2, 0, 1))*PI/180),2)/19.6), 1)} m"/></group>
      <group x="1620" y="380" at="7.4"><anim prop="opacity" from="0" to="1" dur="0.4"/><anim prop="scale" from="1.3" to="1" dur="0.5" ease="back"/>
        <rect x="-220" y="-40" w="440" h="80" r="40" fill="$orange"/><text x="0" y="2" size="34" weight="700" align="center" fill="#0a1320" text="@best"/></group>
      <sfx at="7.4" src="ding"/>
    </scene>

    <scene id="pendulum" dur="10" chapter="@ch4">
      <say at="0.3" text="@vo4"/>
      <group x="860" y="150">
        <rect x="-70" y="-16" w="140" h="16" r="4" fill="#2a4b6b"/>
        <path d="M -278.3 486.0 A 560 560 0 0 0 278.3 486.0" stroke="$cyan" sw="2" fill="none" opacity="0.35"/>
        <line x1="0" y1="0" x2="=(560)*sin((0.52*cos(2.2136*T)))" y2="=(560)*cos((0.52*cos(2.2136*T)))" stroke="#c9d6e3" sw="3"/>
        <group x="=(560)*sin((0.52*cos(2.2136*T)))" y="=(560)*cos((0.52*cos(2.2136*T)))"><group rot="=-(0.52*cos(2.2136*T))*180/PI"><line x1="0" y1="0" x2="=-170*sin(2.2136*T)" y2="0" stroke="$cyan" sw="6"/><path x="=-170*sin(2.2136*T) + 14*sign(-170*sin(2.2136*T))" scale="=sign(-170*sin(2.2136*T))" d="M -22 -12 L 0 0 L -22 12 Z" fill="$cyan" when="=abs(-170*sin(2.2136*T)) &gt; 10"/></group>
          <group rot="90"><line x1="40" y1="0" x2="120" y2="0" stroke="$red" sw="5"/><path x="130" d="M -18 -10 L 0 0 L -18 10 Z" fill="$red"/></group>
          <text x="26" y="160" size="28" font="JetBrains Mono" fill="$red" text="@mg"/>
          <circle r="48" fill="url(#bobglow)"/><circle r="34" fill="url(#bob)" stroke="#fff6" sw="2"/></group>
        <circle r="8" fill="#c9d6e3"/>
      </group>
      <!-- energy bars -->
      <group x="1500" y="820">
        <rect x="0" y="-460" w="110" h="460" r="10" fill="#0f2236" stroke="#2a4b6b" sw="2"/>
        <rect x="160" y="-460" w="110" h="460" r="10" fill="#0f2236" stroke="#2a4b6b" sw="2"/>
        <rect x="0" y="0" w="110" ay="1" r="10" h="=460*(1 - (1 - cos((0.52*cos(2.2136*T))))/(1 - cos(0.52)))" fill="$cyan"/>
        <rect x="160" y="0" w="110" ay="1" r="10" h="=460*(1 - cos((0.52*cos(2.2136*T))))/(1 - cos(0.52))" fill="$orange"/>
        <text x="55" y="40" size="32" font="JetBrains Mono" align="center" fill="$cyan" text="@ke"/>
        <text x="215" y="40" size="32" font="JetBrains Mono" align="center" fill="$orange" text="@pe"/>
      </group>
      <group x="120" y="110"><rect w="440" h="202" r="14" fill="#0f2236cc" stroke="#2a4b6b" sw="2"/><text x="28" y="48" size="32" font="JetBrains Mono" fill="$fg" text="θ = {fmt((0.52*cos(2.2136*T))*180/PI, 1)}°"/><text x="28" y="102" size="32" font="JetBrains Mono" fill="$fg" text="L = 2.00 m"/><text x="28" y="156" size="32" font="JetBrains Mono" fill="$cyan" text="T = 2.84 s"/></group>
    </scene>

    <scene id="length" dur="10" chapter="@ch5">
      <say at="0.3" text="@vo5"/>
      <group x="640" y="120">
        <rect x="-70" y="-16" w="140" h="16" r="4" fill="#2a4b6b"/>
        
        <line x1="0" y1="0" x2="=(260*L5())*sin((0.45*cos(ph5())))" y2="=(260*L5())*cos((0.45*cos(ph5())))" stroke="#c9d6e3" sw="3"/>
        <group x="=(260*L5())*sin((0.45*cos(ph5())))" y="=(260*L5())*cos((0.45*cos(ph5())))">
          <circle r="48" fill="url(#bobglow)"/><circle r="34" fill="url(#bob)" stroke="#fff6" sw="2"/></group>
        <circle r="8" fill="#c9d6e3"/>
      </group>
      <!-- length slider -->
      <group x="300" y="1010">
        <text x="0" y="0" size="32" font="JetBrains Mono" fill="$muted" text="@len"/>
        <rect x="50" y="-4" w="600" h="8" r="4" fill="#2a4b6b"/>
        <rect x="50" y="-4" w="=600*(L5() - 0.5)/1.5" h="8" r="4" fill="$cyan"/>
        <circle x="=50 + 600*(L5() - 0.5)/1.5" y="0" r="18" fill="$cyan" stroke="#fff" sw="3"/>
      </group>
      <!-- period plot -->
      <group>
        <line x1="1220" y1="820" x2="1820" y2="820" stroke="$muted" sw="3"/><line x1="1240" y1="840" x2="1240" y2="300" stroke="$muted" sw="3"/>
        <text x="1820" y="860" size="28" font="JetBrains Mono" align="right" fill="$muted" text="L →"/>
        <text x="1260" y="300" size="28" font="JetBrains Mono" fill="$muted" text="T ↑"/>
        <path d="M 1240.0 819.1 L 1254.1 793.4 L 1268.1 770.0 L 1282.2 748.3 L 1296.3 728.0 L 1310.3 708.9 L 1324.4 690.8 L 1338.4 673.5 L 1352.5 657.0 L 1366.6 641.1 L 1380.6 625.8 L 1394.7 611.0 L 1408.8 596.7 L 1422.8 582.8 L 1436.9 569.3 L 1450.9 556.2 L 1465.0 543.4 L 1479.1 530.9 L 1493.1 518.8 L 1507.2 506.8 L 1521.3 495.2 L 1535.3 483.7 L 1549.4 472.5 L 1563.4 461.5 L 1577.5 450.7 L 1591.6 440.1 L 1605.6 429.6 L 1619.7 419.4 L 1633.8 409.3 L 1647.8 399.3 L 1661.9 389.5 L 1675.9 379.8 L 1690.0 370.3 L 1704.1 360.9 L 1718.1 351.6 L 1732.2 342.5 L 1746.3 333.4 L 1760.3 324.5 L 1774.4 315.7 L 1788.4 307.0 L 1802.5 298.4" stroke="$cyan" sw="5" fill="none"><anim prop="draw" from="0" to="1" dur="1.6"/></path>
        <circle x="=1240 + (L5() - 0.25)*250" y="=820 - (2*PI*sqrt(L5()/9.8) - 1)*240" r="14" fill="$orange" shadow="0 0 16 $orange"/>
        <text x="1530" y="250" size="34" align="center" fill="$fg" text="@per"/>
      </group>
      <group x="1240" y="880"><rect w="640" h="94" r="14" fill="#0f2236cc" stroke="#2a4b6b" sw="2"/><text x="28" y="48" size="32" font="JetBrains Mono" fill="$fg" text="L = {fmt(L5(), 2)} m   T = {fmt(2*PI*sqrt(L5()/9.8), 2)} s"/></group>
    </scene>

    <scene id="amplitude" dur="9" chapter="@ch6">
      <say at="0.3" text="@vo6"/>
      <group x="620" y="150">
        <rect x="-70" y="-16" w="140" h="16" r="4" fill="#2a4b6b"/>
        <path d="M -90.3 512.1 A 520 520 0 0 0 90.3 512.1" stroke="$cyan" sw="2" fill="none" opacity="0.35"/>
        <line x1="0" y1="0" x2="=(520)*sin((0.1745*cos(2.2136*T)))" y2="=(520)*cos((0.1745*cos(2.2136*T)))" stroke="#c9d6e3" sw="3"/>
        <group x="=(520)*sin((0.1745*cos(2.2136*T)))" y="=(520)*cos((0.1745*cos(2.2136*T)))">
          <circle r="48" fill="url(#bobglow)"/><circle r="34" fill="url(#bob)" stroke="#fff6" sw="2"/></group>
        <circle r="8" fill="#c9d6e3"/>
      </group>
      <group x="1300" y="150">
        <rect x="-70" y="-16" w="140" h="16" r="4" fill="#2a4b6b"/>
        <path d="M -177.8 488.7 A 520 520 0 0 0 177.8 488.7" stroke="$cyan" sw="2" fill="none" opacity="0.35"/>
        <line x1="0" y1="0" x2="=(520)*sin((0.349*cos(2.2136*T)))" y2="=(520)*cos((0.349*cos(2.2136*T)))" stroke="#c9d6e3" sw="3"/>
        <group x="=(520)*sin((0.349*cos(2.2136*T)))" y="=(520)*cos((0.349*cos(2.2136*T)))">
          <circle r="48" fill="url(#bobglow)"/><circle r="34" fill="url(#bob)" stroke="#fff6" sw="2"/></group>
