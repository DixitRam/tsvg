    <s id="sub" en="6 steps · about 5 minutes"/>
    <s id="ch0" en="1. Install Node.js"/>
    <s id="chE" en="Done"/>
    <s id="guide" en="HOW-TO GUIDE"/>
    <s id="done" en="Your site is live!"/>
    <s id="url" en="https://my-site.example.app"/>
    <s id="helloA" en="Hello, world"/>
    <s id="helloB" en="Hello, TSVG"/>
    <s id="vo0" en="Here is how to set up a new web project from scratch, in six short steps."/>
    <s id="vo7" en="That is it. Six steps, and your site is live."/>
    <s id="s0" en="Install Node.js"/>
    <s id="st0" en="STEP 1 OF 6"/>
    <s id="vo1" en="Step one: install Node.js, version 18 or newer. Check it with node --version."/>
    <s id="vs1" en="Step one: install Node J S, version eighteen or newer. Check it with node, dash dash version."/>
    <s id="c00" en="Version 18 or newer"/>
    <s id="c01" en="npm comes with it"/>
    <s id="s1" en="Create the project"/>
    <s id="st1" en="STEP 2 OF 6"/>
    <s id="vo2" en="Step two: create the project with npm create vite, pick the Vanilla template, and a new folder appears."/>
    <s id="vs2" en="Step two: create the project with N P M create veet, pick the vanilla template, and a new folder appears."/>
    <s id="ch1" en="2. Create the project"/>
    <s id="c10" en="Pick the Vanilla template"/>
    <s id="c11" en="A folder my-site appears"/>
    <s id="s2" en="Install dependencies"/>
    <s id="st2" en="STEP 3 OF 6"/>
    <s id="vo3" en="Step three: move into the folder and run npm install to download the packages."/>
    <s id="vs3" en="Step three: move into the folder and run N P M install to download the packages."/>
    <s id="ch2" en="3. Install dependencies"/>
    <s id="c20" en="Downloads the packages"/>
    <s id="c21" en="Creates node_modules"/>
    <s id="s3" en="Start the dev server"/>
    <s id="st3" en="STEP 4 OF 6"/>
    <s id="vo4" en="Step four: start the dev server with npm run dev, and open the local address in your browser."/>
    <s id="vs4" en="Step four: start the dev server with N P M run dev, and open the local address in your browser."/>
    <s id="ch3" en="4. Start the dev server"/>
    <s id="c30" en="Opens on localhost:5173"/>
    <s id="c31" en="Leave it running"/>
    <s id="s4" en="Edit a page"/>
    <s id="st4" en="STEP 5 OF 6"/>
    <s id="vo5" en="Step five: edit index.html and save. The page in the browser updates instantly."/>
    <s id="vs5" en="Step five: edit index dot html and save. The page in the browser updates instantly."/>
    <s id="ch4" en="5. Edit a page"/>
    <s id="c40" en="Save index.html"/>
    <s id="c41" en="The page updates instantly"/>
    <s id="s5" en="Build and deploy"/>
    <s id="st5" en="STEP 6 OF 6"/>
    <s id="vo6" en="Step six: run npm run build. The finished site lands in the dist folder, ready to upload anywhere."/>
    <s id="vs6" en="Step six: run N P M run build. The finished site lands in the dist folder, ready to upload anywhere."/>
    <s id="ch5" en="6. Build and deploy"/>
    <s id="c50" en="Static files land in dist/"/>
    <s id="c51" en="Upload dist/ to any host"/>
    <s id="t0_0" en="$ node --version"/>
    <s id="t0_1" en="v22.11.0"/>
    <s id="t1_0" en="$ npm create vite@latest my-site"/>
    <s id="t1_1" en="✔ Select a framework: › Vanilla"/>
    <s id="t1_2" en="✔ Select a variant: › JavaScript"/>
    <s id="t1_3" en="Scaffolding project in ./my-site…"/>
    <s id="t2_0" en="$ cd my-site &amp;&amp; npm install"/>
