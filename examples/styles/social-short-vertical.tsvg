<?xml version="1.0" encoding="UTF-8"?>
<!-- Vertical social short: hook, word-by-word captions, quick cuts, stickers, progress bar. Portrait-first. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="portrait" w="1080" h="1920"/>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" default="en"><choice id="en" label="English" tts="kokoro:af_bella"/></option>
    <option id="mix" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.3" sfx="0.6"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="main" bg="#111" fg="#fff" muted="#ffffffaa" accent="#FFE14D"/></themes>
  <strings>
    <s id="title" en="Salt your pasta water (properly)"/>
    <s id="stop" en="STOP"/>
    <s id="hook2" en="YOU'RE DOING IT WRONG"/>
    <s id="myth" en="MYTH"/>
    <s id="myth_sub" en="boiling point, +1 tbsp salt"/>
    <s id="soak" en="SOAKS IT UP"/>
    <s id="g10" en="10 g"/>
    <s id="l1" en="PER 1 L"/>
    <s id="boil" en="ROLLING BOIL"/>
    <s id="sauce" en="LIQUID GOLD"/>
    <s id="follow" en="+ FOLLOW"/>
    <s id="handle" en="@onekitchenfact"/>
    <s id="vo_hook" en="Stop. You are salting your pasta water wrong. Here's the fix."/>
    <s id="vo_myth" en="Myth one. Salt does not make water boil faster. It raises the boiling point by less than one degree."/>
    <s id="vo_why" en="The real reason? Pasta soaks up water as it cooks, so the water is your only chance to season it from the inside."/>
    <s id="vo_much" en="How much? Aim for one percent. That's ten grams per litre, roughly two teaspoons."/>
    <s id="vo_when" en="Add it once the water is boiling hard, so it dissolves fast and never pits your pot."/>
    <s id="vo_bonus" en="Bonus tip. Save a cup of that starchy water. It turns butter and cheese into a glossy sauce."/>
    <s id="vo_cta" en="Follow for one kitchen fact a day. Which one surprised you?"/>
    <s id="ch_hook" en="Hook"/>
    <s id="ch_myth" en="Myth"/>
    <s id="ch_why" en="Why"/>
    <s id="ch_much" en="How much"/>
    <s id="ch_when" en="When"/>
    <s id="ch_bonus" en="Bonus"/>
    <s id="ch_cta" en="Follow"/>
  </strings>
  <defs>
    <linear id="bg_hook" x1="0" y1="0" x2="=W*0.4" y2="=H"><stop at="0" color="#ff3b30"/><stop at="1" color="#ff9500"/></linear>
    <linear id="bg_myth" x1="0" y1="0" x2="=W*0.4" y2="=H"><stop at="0" color="#1f5eff"/><stop at="1" color="#00c2ff"/></linear>
