  <music src="pulse" loop="1" vol="0.8"/>
  <timeline>
    <scene id="hook" dur="5.76" chapter="@ch_hook">
      <say at="0.25" text="@vo_hook"/>
      <sfx at="0" src="pop"/>
      <sfx at="1.2" src="pop"/>
      <rect w="=W" h="=H" fill="url(#bg_hook)"/>
      <group repeat="14" as="k" opacity="0.10">
        <rect x="=-200 + k*170 + 60*sin(T*0.6 + k)" y="-200" w="60" h="=H+400" rot="18" fill="#fff"/>
      </group>
      
      <group x="=W/2" y="720" x.landscape="560" y.landscape="560" >
        <anim prop="scale" from="1.25" to="1" dur="0.35" ease="out"/>
        <group scale="=1 + 0.03*sin(T*2.2)">
          
          <rect x="-230" y="-40" w="460" h="250" r="40" fill="#2b2f36" stroke="#fff" sw="10"/>
          <rect x="-270" y="-60" w="540" h="40" r="20" fill="#3d434d" stroke="#fff" sw="10"/>
          <rect x="-330" y="10" w="70" h="30" r="15" fill="#3d434d" stroke="#fff" sw="8"/><rect x="260" y="10" w="70" h="30" r="15" fill="#3d434d" stroke="#fff" sw="8"/>
          <path repeat="3" as="k" x="=-110 + k*110" y="-90" d="M 0 0 C -30 -40 30 -70 0 -120 C -30 -160 30 -190 0 -230" stroke="#ffffffcc" sw="14" fill="none" opacity="=0.4 + 0.5*fract(T*0.6 + k*0.33)">
            <anim prop="draw" from="0" to="1" dur="1.2" ease="io"/>
          </path>
          <group y="-330" rot="-7">
            <path d="M -120 -290 L 120 -290 L 290 -120 L 290 120 L 120 290 L -120 290 L -290 120 L -290 -120 Z" fill="#fff" scale="0.62" shadow="0 14 0 #0005"/>
            <path d="M -120 -290 L 120 -290 L 290 -120 L 290 120 L 120 290 L -120 290 L -290 120 L -290 -120 Z" fill="#e0001b" scale="0.56"/>
            <text font="Anton" size="150" align="center" y="6" fill="#fff" text="@stop"/>
          </group>
        </group>
      </group>
      <group x="=W/2 + 6*sin(T*60)*(T &lt; 0.5 ? 1 : 0)" y="1150" x.landscape="1350" y.landscape="330" at="0.15">
        <anim prop="scale" from="2.2" to="1" dur="0.25" ease="out"/>
        <text font="Anton" size="96" align="center" fill="#fff" stroke="#000" sw="16" text="@hook2"/>
      </group>
      
        <group x="=W - 170" x.landscape="1790" y="360" y.landscape="170" rot="12" at="1.0">
          <anim prop="scale" from="0" to="1" dur="0.4" ease="back"/>
          <group rot="=4*sin(T*3)">
          <circle r="92" fill="#fff" shadow="0 10 0 #0004"/><circle r="82" fill="#FFD23F"/>
          <ellipse x="-28" y="-18" rx="11" ry="17" fill="#3b2400"/><ellipse x="28" y="-18" rx="11" ry="17" fill="#3b2400"/>
          <ellipse y="34" rx="20" ry="=24 + 4*sin(T*8)" fill="#3b2400"/>
          <path d="M -50 -50 Q -30 -66 -10 -54" stroke="#3b2400" sw="7" fill="none"/><path d="M 50 -50 Q 30 -66 10 -54" stroke="#3b2400" sw="7" fill="none"/></group>
        </group>
      <group x="=W/2" y="1390" x.landscape="1350" y.landscape="800">
        <text repeat="=count('w_hook')" as="i" font="Anton" size="104" align="center" sw="18" stroke="#000"
              x="=data('x_hook', i)" when="=T &gt;= data('cs_hook', i) &amp;&amp; T &lt; data('ce_hook', i)"
              fill="=(T &gt;= data('t0_hook', i) &amp;&amp; T &lt; data('ce_hook', i)) ? (T &lt; data('t1_hook', i) ? '#FFE14D' : '#ffffff') : '#ffffffaa'"
              scale="=1 + 0.16*(T &gt;= data('t0_hook', i) &amp;&amp; T &lt; data('t1_hook', i) ? 1 - ease((T - data('t0_hook', i))/0.18,'out')*0.4 : 0)"
              rot="=(T &gt;= data('t0_hook', i) &amp;&amp; T &lt; data('t1_hook', i)) ? -3 : 0" shadow="0 10 0 #0007" text="{data('w_hook', i)}"/>
      </group>
      <rect w="=W" h="=H" fill="#fff"><anim prop="opacity" from="0.85" to="0" dur="0.22" ease="linear"/></rect>
    </scene>
    <scene id="myth" dur="8.56" chapter="@ch_myth">
      <say at="0.25" text="@vo_myth"/>
      <sfx at="0" src="whoosh"/>
      <sfx at="1.2" src="pop"/>
      <rect w="=W" h="=H" fill="url(#bg_myth)"/>
      <group repeat="14" as="k" opacity="0.10">
        <rect x="=-200 + k*170 + 60*sin(T*0.6 + k)" y="-200" w="60" h="=H+400" rot="18" fill="#fff"/>
      </group>
      
      <group x="=W/2" y="720" x.landscape="560" y.landscape="560" >
        <anim prop="scale" from="1.25" to="1" dur="0.35" ease="out"/>
        <group scale="=1 + 0.03*sin(T*2.2)">
          <rect x="-46" y="-330" w="92" h="520" r="46" fill="#fff" shadow="0 14 0 #0004"/>
          <rect x="-30" y="=170 - 380*ease(T/1.6,'out')" w="60" h="=380*ease(T/1.6,'out') + 30" r="30" fill="#ff3b30"/>
          <circle y="230" r="90" fill="#fff"/><circle y="230" r="72" fill="#ff3b30"/>
          <line repeat="6" as="k" x1="60" x2="100" y1="=-280 + k*70" y2="=-280 + k*70" stroke="#fff" sw="8"/>
          <text x="140" y="-220" font="Anton" size="88" fill="#fff" stroke="#00000055" sw="10" text="{fmt(100 + 0.2*ease((T-1)/1.5,'out'), 1)}°C" at="0.6"/>
          <text x="140" y="-130" size="40" size.portrait="34" weight="700" fill="#ffffffcc" text="@myth_sub" at="0.6"/>
        </group>
      </group>
      
        <group x="=W/2 + 250" x.landscape="1350" y="300" y.landscape="300" rot="-10" at="1.3">
          <anim prop="scale" from="0" to="1" dur="0.4" ease="back"/>
          <group rot="=4*sin(T*3)">
          <rect x="-150" y="-52" w="300" h="104" r="22" fill="#fff" shadow="0 12 0 #0005"/>
          <rect x="-142" y="-44" w="284" h="88" r="16" fill="#ffd23f"/>
          <text font="Anton" size="64" align="center" y="2" fill="#111" text="@myth"/></group>
        </group>
      <group x="=W/2 + 250" y="300" x.landscape="1350" y.landscape="300" at="2.2">
        <path d="M -170 -70 L 170 70 M 170 -70 L -170 70" stroke="#e0001b" sw="14" opacity="0.85" fill="none"><anim prop="draw" from="0" to="1" dur="0.4"/></path>
      </group>
      <group x="=W/2" y="1390" x.landscape="1350" y.landscape="800">
        <text repeat="=count('w_myth')" as="i" font="Anton" size="104" align="center" sw="18" stroke="#000"
              x="=data('x_myth', i)" when="=T &gt;= data('cs_myth', i) &amp;&amp; T &lt; data('ce_myth', i)"
              fill="=(T &gt;= data('t0_myth', i) &amp;&amp; T &lt; data('ce_myth', i)) ? (T &lt; data('t1_myth', i) ? '#FFE14D' : '#ffffff') : '#ffffffaa'"
              scale="=1 + 0.16*(T &gt;= data('t0_myth', i) &amp;&amp; T &lt; data('t1_myth', i) ? 1 - ease((T - data('t0_myth', i))/0.18,'out')*0.4 : 0)"
              rot="=(T &gt;= data('t0_myth', i) &amp;&amp; T &lt; data('t1_myth', i)) ? -3 : 0" shadow="0 10 0 #0007" text="{data('w_myth', i)}"/>
      </group>
      <rect w="=W" h="=H" fill="#fff"><anim prop="opacity" from="0.85" to="0" dur="0.22" ease="linear"/></rect>
    </scene>
    <scene id="why" dur="9.16" chapter="@ch_why">
      <say at="0.25" text="@vo_why"/>
      <sfx at="0" src="whoosh"/>
      <sfx at="1.2" src="pop"/>
      <rect w="=W" h="=H" fill="url(#bg_why)"/>
      <group repeat="14" as="k" opacity="0.10">
        <rect x="=-200 + k*170 + 60*sin(T*0.6 + k)" y="-200" w="60" h="=H+400" rot="18" fill="#fff"/>
      </group>
      
      <group x="=W/2" y="720" x.landscape="560" y.landscape="560" >
        <anim prop="scale" from="1.25" to="1" dur="0.35" ease="out"/>
        <group scale="=1 + 0.03*sin(T*2.2)">
          <path d="M -300 0 C -240 -120 -160 120 -90 0 S 60 -120 120 0 S 240 120 300 0" stroke="#fff" sw="64" fill="none" shadow="0 14 0 #0004"/>
          <path d="M -300 0 C -240 -120 -160 120 -90 0 S 60 -120 120 0 S 240 120 300 0" stroke="#ffd86b" sw="46" fill="none">
            <anim prop="draw" from="0" to="1" dur="1.2" ease="io"/>
          </path>
          <path d="M -300 60 C -240 -60 -160 180 -90 60 S 60 -60 120 60 S 240 180 300 60" stroke="#ffcf4a" sw="34" fill="none" opacity="0.9">
            <anim prop="draw" from="0" to="1" at="0.3" dur="1.2" ease="io"/>
          </path>
          <circle repeat="26" as="k" x="=lerp(-330 + 660*rand(k), lerp(-300, 300, rand(k+40)), ease(fract(T*0.35 + rand(k+9)), 'in'))"
                  y="=lerp(-300 - 100*rand(k+3), 20, ease(fract(T*0.35 + rand(k+9)), 'in'))" r="=8 + 8*rand(k+7)"
                  fill="#fff" stroke="#00000033" sw="3" opacity="=1 - fract(T*0.35 + rand(k+9))"/>
        </group>
