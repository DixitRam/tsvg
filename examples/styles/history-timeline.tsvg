<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: history timeline. A horizontal line with dated milestones; the camera pans along it
     (pan from a <fn> on t), cards with photos or animated vector icons rise in as the camera
     arrives, and a year counter follows the camera. Generated by a small script. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:am_liam"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.3" sfx="0.5"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
  </mixes>
  <themes>
    <theme id="museum" bg="#14171f" fg="#f2ede3" muted="#9a9385" gold="#d9b46a" card="#f4efe4" ink="#1d1b18" ink2="#5a5448" line="#3a3f4c"/>
  </themes>

  <strings>
    <s id="title" en="Two Centuries of Electricity"/>
    <s id="kick" en="A TIMELINE"/>
    <s id="sub" en="From a stack of coins to a wired planet"/>
    <s id="hdr" en="TWO CENTURIES OF ELECTRICITY"/>
    <s id="ch1" en="Intro"/><s id="ch2" en="1800–1831"/><s id="ch3" en="1882"/><s id="ch4" en="1895"/><s id="ch5" en="1954"/><s id="ch6" en="1977"/><s id="ch7" en="Today"/>
    <s id="y0" en="1800"/><s id="h0" en="The first battery"/><s id="b0" en="Volta stacks zinc, copper and brine-soaked card: a steady current for the first time."/>
    <s id="y1" en="1831"/><s id="h1" en="Induction"/><s id="b1" en="Faraday moves a magnet through a coil of wire. Motion becomes electricity."/>
    <s id="y2" en="1882"/><s id="h2" en="Power for a city"/><s id="b2" en="The first central power stations light a few hundred homes in New York and London."/>
    <s id="y3" en="1895"/><s id="h3" en="Falling water"/><s id="b3" en="Hydroelectric plants turn rivers into power and send it over long distances."/>
    <s id="y4" en="1954"/><s id="h4" en="Sunlight to current"/><s id="b4" en="A silicon solar cell turns about 6% of sunlight into electricity."/>
    <s id="y5" en="1977"/><s id="h5" en="Power for the long trip"/><s id="b5" en="Voyager launches on nuclear batteries. It still sends data from interstellar space."/>
    <s id="y6" en="2024"/><s id="h6" en="Everything electric"/><s id="b6" en="Factories, cars and data centres: electricity's share of energy keeps climbing."/>
    <s id="vo1" en="Two hundred years ago, electricity was a laboratory curiosity. Here is how it came to run almost everything."/>
    <s id="vo2" en="In 1800, Volta stacked metal discs to make the first battery. Thirty years later, Faraday showed that a moving magnet makes current."/>
    <s id="vo3" en="By 1882, central power stations were lighting whole streets of homes in New York and London."/>
    <s id="vo4" en="In the 1890s, falling water took over: hydroelectric plants sent power far beyond the river."/>
    <s id="vo5" en="In 1954, a thin slice of silicon turned sunlight straight into current: the first practical solar cell."/>
    <s id="vo6" en="In 1977, Voyager left on nuclear batteries. Nearly fifty years on, it is still sending data home."/>
    <s id="vo7" en="Today, factories, cars and data centres all run on electricity, and its share of the world's energy keeps rising."/>
  </strings>

  <defs>
    <data id="mx" v="500, 1280, 2060, 2840, 3620, 4400, 5180"/>
    <data id="my" v="1800, 1831, 1882, 1895, 1954, 1977, 2024"/>
    <data id="fx" v="200, 890.0, 2060, 2840, 3620, 4400, 5180"/>
    <data id="st" v="0, 7, 17, 25.5, 34.0, 42.5, 51.0"/>
    <fn id="sc">(t &gt;= 7)+(t &gt;= 17)+(t &gt;= 25.5)+(t &gt;= 34.0)+(t &gt;= 42.5)+(t &gt;= 51.0)</fn>
    <fn id="cam">sc() == 0 ? data('fx', 0) : lerp(data('fx', sc() - 1), data('fx', sc()), ease((t - data('st', sc()))/1.8, 'io'))</fn>
    <fn id="fi">clamp((cam() - 500)/780, 0, 5.999)</fn>
    <fn id="year">lerp(data('my', floor(fi())), data('my', floor(fi()) + 1), fract(fi()))</fn>
    <linear id="edgeL" x1="0" y1="0" x2="260" y2="0"><stop at="0" color="$bg"/><stop at="1" color="$bg" opacity="0"/></linear>
    <linear id="edgeR" x1="1660" y1="0" x2="1920" y2="0"><stop at="0" color="$bg" opacity="0"/><stop at="1" color="$bg"/></linear>
    <radial id="spot" x="960" y="560" r="900"><stop at="0" color="#2a2f3c"/><stop at="1" color="$bg" opacity="0"/></radial>
  </defs>

  <assets>
    <asset id="city" src="images/city.jpg"/>
    <asset id="mountains" src="images/mountains.jpg"/>
    <asset id="nebula" src="images/nebula.jpg"/>
    <asset id="factory" src="images/factory.jpg"/>
    <asset id="pad" src="audio/pad.m4a"/>
    <asset id="whoosh" src="audio/whoosh.m4a"/>
    <asset id="ding" src="audio/ding.m4a"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <font family="Playfair Display" src="fonts/PlayfairDisplay.ttf"/>
  </assets>

  <music src="pad" start="0" loop="1" vol="0.8"/>

  <backdrop>
    <rect x="0" y="0" w="1920" h="1080" fill="url(#spot)"/>
    <!-- the world strip, panned by the camera -->
    <group x="=960 - cam()">
      <!-- line, ruler ticks, gold progress -->
      <line x1="-400" y1="860" x2="5600" y2="860" stroke="$line" sw="6"/>
      <line repeat="80" as="k" x1="=-200 + k*70" x2="=-200 + k*70" y1="852" y2="=k % 10 == 0 ? 884 : 870" stroke="$line" sw="3"/>
      <line x1="-400" y1="860" x2="=cam()" y2="860" stroke="$gold" sw="6"/>
      <!-- milestone dots + year labels -->
      <group repeat="7" as="i" x="=data('mx', i)" y="860">
        <circle r="=abs(cam() - data('mx', i)) &lt; 60 ? 20 + 3*sin(t*4) : 14" fill="=cam() &gt;= data('mx', i) - 1 ? $gold : $line" stroke="$bg" sw="5"/>
        <text y="58" size="34" weight="700" align="center" fill="=cam() &gt;= data('mx', i) - 1 ? $fg : $muted" font="Playfair Display" text="{data('my', i)}"/>
      </group>
      <group x="200" y="250" opacity="=clamp((t - 7.8)*2.5, 0, 1)">
        <group y="=24*(1 - ease((t - 7.8)/0.5, 'out'))">
          <rect w="600" h="530" r="12" fill="$card" shadow="0 18 40 #0008"/>
          <rect w="600" h="270" r="10" fill="#22262f"/>
          <group x="40" y="20"><group x="260" y="120">
            <rect repeat="7" as="d" x="-70" y="=60 - d*24" w="140" h="18" r="9" fill="=d % 2 == 0 ? '#c27b3a' : '#b9c0c8'"/>
            <line x1="-90" y1="70" x2="-90" y2="-110" stroke="#d9b46a" sw="4"/><line x1="90" y1="70" x2="90" y2="-110" stroke="#d9b46a" sw="4"/>
            <path d="M -90 -110 C -40 -150 40 -150 90 -110" fill="none" stroke="$gold" sw="4" draw="=fract(t*0.5)"/>
          </group></group>
          <text x="34" y="330" size="62" weight="700" fill="$gold" font="Playfair Display" text="@y0"/>
          <text x="34" y="388" size="36" weight="800" fill="$ink" text="@h0"/>
          <text x="34" y="460" size="26" maxw="530" lh="1.3" fill="$ink2" text="@b0"/>
        </group>
        <line x1="300" y1="530" x2="300" y2="610" stroke="$gold" sw="3"/>
      </group>
      <group x="980" y="250" opacity="=clamp((t - 8.6)*2.5, 0, 1)">
        <group y="=24*(1 - ease((t - 8.6)/0.5, 'out'))">
          <rect w="600" h="530" r="12" fill="$card" shadow="0 18 40 #0008"/>
          <rect w="600" h="270" r="10" fill="#22262f"/>
          <group x="40" y="20"><group x="260" y="120">
            <path d="M -150 0 C -150 -60 -110 -60 -110 0 C -110 60 -70 60 -70 0 C -70 -60 -30 -60 -30 0 C -30 60 10 60 10 0 C 10 -60 50 -60 50 0 C 50 60 90 60 90 0" fill="none" stroke="#c27b3a" sw="8"/>
            <rect x="=-200 + 280*(0.5 + 0.5*sin(t*2))" y="-20" w="90" h="40" r="6" fill="#d7261e"/>
            <rect x="=-200 + 280*(0.5 + 0.5*sin(t*2)) + 45" y="-20" w="45" h="40" r="6" fill="#4d7cc7"/>
            <path d="M 130 -40 L 160 -40 L 140 0 L 170 0 L 120 60 L 135 15 L 110 15 Z" fill="$gold" opacity="=0.4 + 0.6*abs(cos(t*2))"/>
          </group></group>
          <text x="34" y="330" size="62" weight="700" fill="$gold" font="Playfair Display" text="@y1"/>
          <text x="34" y="388" size="36" weight="800" fill="$ink" text="@h1"/>
          <text x="34" y="460" size="26" maxw="530" lh="1.3" fill="$ink2" text="@b1"/>
        </group>
        <line x1="300" y1="530" x2="300" y2="610" stroke="$gold" sw="3"/>
      </group>
      <group x="1760" y="250" opacity="=clamp((t - 17.8)*2.5, 0, 1)">
        <group y="=24*(1 - ease((t - 17.8)/0.5, 'out'))">
          <rect w="600" h="530" r="12" fill="$card" shadow="0 18 40 #0008"/>
          <image src="city" x="0" y="0" w="600" h="270" r="10"/>
          <text x="34" y="330" size="62" weight="700" fill="$gold" font="Playfair Display" text="@y2"/>
          <text x="34" y="388" size="36" weight="800" fill="$ink" text="@h2"/>
          <text x="34" y="460" size="26" maxw="530" lh="1.3" fill="$ink2" text="@b2"/>
        </group>
        <line x1="300" y1="530" x2="300" y2="610" stroke="$gold" sw="3"/>
      </group>
      <group x="2540" y="250" opacity="=clamp((t - 26.3)*2.5, 0, 1)">
        <group y="=24*(1 - ease((t - 26.3)/0.5, 'out'))">
          <rect w="600" h="530" r="12" fill="$card" shadow="0 18 40 #0008"/>
          <image src="mountains" x="0" y="0" w="600" h="270" r="10"/>
          <text x="34" y="330" size="62" weight="700" fill="$gold" font="Playfair Display" text="@y3"/>
          <text x="34" y="388" size="36" weight="800" fill="$ink" text="@h3"/>
          <text x="34" y="460" size="26" maxw="530" lh="1.3" fill="$ink2" text="@b3"/>
        </group>
        <line x1="300" y1="530" x2="300" y2="610" stroke="$gold" sw="3"/>
      </group>
      <group x="3320" y="250" opacity="=clamp((t - 34.8)*2.5, 0, 1)">
        <group y="=24*(1 - ease((t - 34.8)/0.5, 'out'))">
          <rect w="600" h="530" r="12" fill="$card" shadow="0 18 40 #0008"/>
          <rect w="600" h="270" r="10" fill="#22262f"/>
          <group x="40" y="20"><group x="260" y="130">
            <circle x="150" y="-70" r="34" fill="$gold"/>
            <group rot="-12"><rect x="-150" y="-40" w="250" h="130" r="6" fill="#1d3a6e" stroke="#9fb4d8" sw="3"/>
            <line repeat="4" as="c" x1="=-150 + (c + 1)*50" x2="=-150 + (c + 1)*50" y1="-40" y2="90" stroke="#9fb4d8" sw="2"/>
            <line repeat="2" as="r" x1="-150" x2="100" y1="=-40 + (r + 1)*43" y2="=-40 + (r + 1)*43" stroke="#9fb4d8" sw="2"/></group>
            <line repeat="3" as="r" x1="=120 - r*30" y1="=-40 + r*10" x2="=120 - r*30 - 60*fract(t*0.8 + r*0.3)" y2="=-40 + r*10 + 50*fract(t*0.8 + r*0.3)" stroke="$gold" sw="4" opacity="=1 - fract(t*0.8 + r*0.3)"/>
          </group></group>
          <text x="34" y="330" size="62" weight="700" fill="$gold" font="Playfair Display" text="@y4"/>
          <text x="34" y="388" size="36" weight="800" fill="$ink" text="@h4"/>
          <text x="34" y="460" size="26" maxw="530" lh="1.3" fill="$ink2" text="@b4"/>
        </group>
        <line x1="300" y1="530" x2="300" y2="610" stroke="$gold" sw="3"/>
      </group>
      <group x="4100" y="250" opacity="=clamp((t - 43.3)*2.5, 0, 1)">
        <group y="=24*(1 - ease((t - 43.3)/0.5, 'out'))">
          <rect w="600" h="530" r="12" fill="$card" shadow="0 18 40 #0008"/>
          <image src="nebula" x="0" y="0" w="600" h="270" r="10"/>
          <text x="34" y="330" size="62" weight="700" fill="$gold" font="Playfair Display" text="@y5"/>
          <text x="34" y="388" size="36" weight="800" fill="$ink" text="@h5"/>
          <text x="34" y="460" size="26" maxw="530" lh="1.3" fill="$ink2" text="@b5"/>
        </group>
        <line x1="300" y1="530" x2="300" y2="610" stroke="$gold" sw="3"/>
      </group>
      <group x="4880" y="250" opacity="=clamp((t - 51.8)*2.5, 0, 1)">
        <group y="=24*(1 - ease((t - 51.8)/0.5, 'out'))">
          <rect w="600" h="530" r="12" fill="$card" shadow="0 18 40 #0008"/>
          <image src="factory" x="0" y="0" w="600" h="270" r="10"/>
          <text x="34" y="330" size="62" weight="700" fill="$gold" font="Playfair Display" text="@y6"/>
          <text x="34" y="388" size="36" weight="800" fill="$ink" text="@h6"/>
          <text x="34" y="460" size="26" maxw="530" lh="1.3" fill="$ink2" text="@b6"/>
        </group>
        <line x1="300" y1="530" x2="300" y2="610" stroke="$gold" sw="3"/>
      </group>
    </group>
    <rect x="0" y="0" w="260" h="1080" fill="url(#edgeL)"/>
    <rect x="1660" y="0" w="260" h="1080" fill="url(#edgeR)"/>
  </backdrop>

  <overlay>
    <group when="t &gt; 6" opacity="=clamp(t - 6, 0, 1)">
      <text x="100" y="110" size="26" weight="700" fill="$gold" text="@hdr"/>
      <rect x="100" y="140" w="120" h="3" fill="$gold"/>
      <text x="1820" y="130" size="120" weight="700" align="right" fill="$fg" opacity="0.9" font="Playfair Display" text="{fmt(year(), 0)}"/>
    </group>
  </overlay>

  <timeline>
    <scene id="m0" dur="7" chapter="@ch1">
      <say at="0.6" text="@vo1"/>
      <sfx at="0.2" src="ding"/>
      <group opacity="=1 - ease((T - 5)/1, 'io')">
        <text x="960" y="380" size="30" weight="700" align="center" fill="$gold" text="@kick">
          <anim prop="opacity" from="0" to="1" dur="0.6"/>
        </text>
        <text x="960" y="490" size="120" weight="700" align="center" fill="$fg" font="Playfair Display" text="@title">
          <anim prop="opacity" from="0" to="1" dur="0.8"/>
          <anim prop="y" from="520" to="490" dur="1"/>
        </text>
        <text x="960" y="600" size="40" italic="1" align="center" fill="$muted" font="Playfair Display" text="@sub" at="0.8">
          <anim prop="opacity" from="0" to="1" dur="0.8"/>
        </text>
      </group>
    </scene>

    <scene id="m1" dur="10" chapter="@ch2">
      <say at="0.5" text="@vo2"/>
      <sfx at="0.2" src="whoosh"/>

    </scene>

    <scene id="m2" dur="8.5" chapter="@ch3">
      <say at="0.5" text="@vo3"/>
      <sfx at="0.2" src="whoosh"/>

    </scene>

    <scene id="m3" dur="8.5" chapter="@ch4">
      <say at="0.5" text="@vo4"/>
      <sfx at="0.2" src="whoosh"/>

    </scene>

    <scene id="m4" dur="8.5" chapter="@ch5">
      <say at="0.5" text="@vo5"/>
      <sfx at="0.2" src="whoosh"/>

    </scene>

    <scene id="m5" dur="8.5" chapter="@ch6">
      <say at="0.5" text="@vo6"/>
      <sfx at="0.2" src="whoosh"/>

    </scene>

    <scene id="m6" dur="9.5" chapter="@ch7">
      <say at="0.5" text="@vo7"/>
      <sfx at="0.2" src="whoosh"/>

    </scene>
  </timeline>

  <!-- written by `tsvg bake`: one recorded clip per <say> line and language -->
  <voices>
    <voice say="vo1" lang="en" src="voice/history-timeline/en/vo1.4d9acab28f.m4a" dur="6.31" hash="4d9acab28f" engine="kokoro:am_liam"/>
    <voice say="vo2" lang="en" src="voice/history-timeline/en/vo2.e607f0be4a.m4a" dur="8.01" hash="e607f0be4a" engine="kokoro:am_liam"/>
    <voice say="vo3" lang="en" src="voice/history-timeline/en/vo3.b057845a1d.m4a" dur="6.31" hash="b057845a1d" engine="kokoro:am_liam"/>
    <voice say="vo4" lang="en" src="voice/history-timeline/en/vo4.fd383635c2.m4a" dur="6.41" hash="fd383635c2" engine="kokoro:am_liam"/>
    <voice say="vo5" lang="en" src="voice/history-timeline/en/vo5.2b33cf382b.m4a" dur="6.71" hash="2b33cf382b" engine="kokoro:am_liam"/>
    <voice say="vo6" lang="en" src="voice/history-timeline/en/vo6.3e5b102e1a.m4a" dur="6.71" hash="3e5b102e1a" engine="kokoro:am_liam"/>
    <voice say="vo7" lang="en" src="voice/history-timeline/en/vo7.3f3943f344.m4a" dur="6.41" hash="3f3943f344" engine="kokoro:am_liam"/>
  </voices>
</tsvg>
