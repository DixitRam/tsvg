<?xml version="1.0" encoding="UTF-8"?>
<!-- Event announcement: save the date, venue, a flip-clock countdown, speaker avatars, agenda and a register CTA. -->
<tsvg version="0.2" title="@title" font="Space Grotesk, Inter">
  <layouts><layout id="landscape" w="1920" h="1080"/></layouts>
  <options>
    <option id="lang" default="en"><choice id="en" label="English" tts="kokoro:af_heart"/></option>
    <option id="mix" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.3" sfx="0.6"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="night" bg="#0d1033" fg="#ffffff" muted="#aab0ff" accent="#7c5cff"/></themes>
  <strings>
    <s id="title" en="Vector Week 2027 announcement"/>
    <s id="save" en="SAVE THE DATE"/><s id="name" en="VECTOR WEEK"/>
    <s id="sub" en="Two days of motion, graphics and code"/>
    <s id="datechip" en="14–15 MARCH 2027 · AHMEDABAD"/>
    <s id="march" en="MARCH 2027"/>
    <s id="venue" en="Riverfront Convention Centre"/><s id="city" en="Ahmedabad, India"/><s id="halls" en="Hall A talks · Hall C workshops"/>
    <s id="doors" en="Doors open in"/>
    <s id="early" en="Early-bird pricing ends at 30 days to go"/>
    <s id="spk" en="20 speakers confirmed"/><s id="more" en="+ 14 more announced next week"/>
    <s id="agenda" en="Two days, two formats"/><s id="day1" en="DAY 1 · TALKS · MAR 14"/><s id="day2" en="DAY 2 · WORKSHOPS · MAR 15"/>
    <s id="regnow" en="Register"/><s id="eb" en="early bird"/><s id="student" en="students"/><s id="regbtn" en="Get your pass →"/>
    <s id="url" en="vectorweek.dev"/><s id="scan" en="Scan to register"/>
    <s id="vo_save" en="Save the date. Vector Week returns for its third year: two days of motion, graphics and code."/>
    <s id="ch_save" en="Save the date"/>
    <s id="vo_where" en="We meet on the fourteenth and fifteenth of March, at the Riverfront Convention Centre in Ahmedabad."/>
    <s id="ch_where" en="When and where"/>
    <s id="vo_clock" en="Doors open in forty-seven days. Early-bird tickets close when this clock reaches thirty."/>
    <s id="ch_clock" en="Countdown"/>
    <s id="vo_speakers" en="Twenty speakers are confirmed, from type designers and game artists to the engineers behind real-time renderers."/>
    <s id="ch_speakers" en="Speakers"/>
    <s id="vo_agenda" en="Day one is talks. Day two is hands-on workshops, from shaders to hand-drawn animation."/>
    <s id="ch_agenda" en="Agenda"/>
    <s id="vo_register" en="Register now at vectorweek dot dev. Students get half price. See you in March."/>
    <s id="ch_register" en="Register"/>
  </strings>
  <defs>
    <data id="cx" v="-677,-511,-281,-115,115,281,511,677"/>
    <data id="div" v="86400,86400,3600,3600,60,60,1,1"/><data id="mod" v="1000,1000,24,24,60,60,60,60"/>
    <data id="sub" v="10,1,10,1,10,1,10,1"/><data id="P" v="864000,86400,36000,3600,600,60,10,1"/>
    <data id="units" v="DAYS, HOURS, MINUTES, SECONDS"/>
    <data id="dow" v="M, T, W, T, F, S, S"/>
    <fn id="rr">4107667.6 - T</fn>
    <fn id="dg" args="r,i">floor((floor(r/data('div', i)) % data('mod', i)) / data('sub', i)) % 10</fn>
    <fn id="sn" args="r,i">data('P', i)*ceil(r/data('P', i)) - r</fn>
    <clip id="topH"><rect x="-75" y="-105" w="150" h="105"/></clip>
    <clip id="botH"><rect x="-75" y="0" w="150" h="105"/></clip>
    <clip id="flapA"><rect x="-75" y="=-105*(1 - clamp(sn(rr(), i)/0.2, 0, 1))" w="150" h="=105*(1 - clamp(sn(rr(), i)/0.2, 0, 1))"/></clip>
    <clip id="flapB"><rect x="-75" y="0" w="150" h="=105*clamp((sn(rr(), i) - 0.2)/0.2, 0, 1)"/></clip>
    <linear id="cardg" x1="0" y1="-105" x2="0" y2="105"><stop at="0" color="#2a2f7a"/><stop at="0.5" color="#1d2160"/><stop at="1" color="#161a4d"/></linear>
    <linear id="title" x1="-600" y1="0" x2="600" y2="0"><stop at="0" color="#7c5cff"/><stop at="0.5" color="#ff5d73"/><stop at="1" color="#ffb547"/></linear>
    <linear id="btn" x1="-300" y1="0" x2="300" y2="0"><stop at="0" color="#7c5cff"/><stop at="1" color="#ff5d73"/></linear>
    <radial id="gloss" x="-30" y="-40" r="120"><stop at="0" color="#fff" opacity="0.45"/><stop at="1" color="#fff" opacity="0"/></radial>
    <linear id="ring0" x1="-112" y1="0" x2="112" y2="0"><stop at="0" color="#7c5cff"/><stop at="1" color="#7c5cff" opacity="0"/></linear>
    <linear id="ring1" x1="-112" y1="0" x2="112" y2="0"><stop at="0" color="#ff5d73"/><stop at="1" color="#ff5d73" opacity="0"/></linear>
    <linear id="ring2" x1="-112" y1="0" x2="112" y2="0"><stop at="0" color="#3ee6c4"/><stop at="1" color="#3ee6c4" opacity="0"/></linear>
    <linear id="ring3" x1="-112" y1="0" x2="112" y2="0"><stop at="0" color="#ffb547"/><stop at="1" color="#ffb547" opacity="0"/></linear>
    <linear id="ring4" x1="-112" y1="0" x2="112" y2="0"><stop at="0" color="#4cb8ff"/><stop at="1" color="#4cb8ff" opacity="0"/></linear>
    <linear id="ring5" x1="-112" y1="0" x2="112" y2="0"><stop at="0" color="#ff7ad9"/><stop at="1" color="#ff7ad9" opacity="0"/></linear>
    <radial id="glowA" x="0" y="0" r="520"><stop at="0" color="#7c5cff" opacity="0.35"/><stop at="1" color="#7c5cff" opacity="0"/></radial>
    <radial id="glowB" x="0" y="0" r="480"><stop at="0" color="#ff5d73" opacity="0.25"/><stop at="1" color="#ff5d73" opacity="0"/></radial>
    <mask id="rise"><rect x="-900" y="=120 - 240*ease((T-0.3)/0.8,'out')" w="1800" h="260" fill="#000"/></mask>
  </defs>
  <assets>
    <asset id="city" src="images/city.jpg"/>
    <asset id="pad" src="audio/bright.m4a"/><asset id="whoosh" src="audio/whoosh.m4a"/><asset id="click" src="audio/click.m4a"/><asset id="pop" src="audio/pop.m4a"/><asset id="ding" src="audio/ding.m4a"/>
    <font family="Space Grotesk" src="fonts/SpaceGrotesk.ttf"/><font family="JetBrains Mono" src="fonts/JetBrainsMono.ttf"/>
  </assets>
  <music src="pad" loop="1" vol="0.7"/>
  <backdrop>
    <circle x="=W*0.15 + 60*sin(t*0.2)" y="=H*0.2" r="520" fill="url(#glowA)"/>
    <group x="=W*0.85" y="=H*0.85 + 50*sin(t*0.25)"><circle r="480" fill="url(#glowB)"/></group>
    <group opacity="0.07"><line repeat="25" as="k" x1="=k*80" y1="0" x2="=k*80" y2="=H" stroke="#fff" sw="1"/><line repeat="14" as="k" x1="0" y1="=k*80" x2="=W" y2="=k*80" stroke="#fff" sw="1"/></group>
  </backdrop>
  <timeline>
    <scene id="save" dur="8.2" chapter="@ch_save">
      <say at="0.5" text="@vo_save"/>
      <sfx at="0" src="whoosh"/>
      <group opacity="=clamp(T/0.35, 0, 1)*clamp((sdur - T)/0.35, 0, 1)">
      <group x="=W/2" y="300"><anim prop="opacity" from="0" to="1" dur="0.5"/>
        <rect x="-210" y="-36" w="420" h="72" r="36" fill="#ffffff10" stroke="#7c5cff" sw="3"/>
        <text size="34" weight="700" font="Space Grotesk" align="center" fill="#c9c3ff" text="@save"/>
      </group>
      <group x="=W/2" y="490" mask="url(#rise)">
        <text size="190" weight="800" font="Space Grotesk" align="center" fill="url(#title)" text="@name"/>
      </group>
      <text x="=W/2" y="660" size="120" weight="300" font="Space Grotesk" align="center" fill="none" stroke="#ff5d73" sw="3" text="2027" at="1">
        <anim prop="opacity" from="0" to="1" dur="0.6"/><anim prop="scale" from="1.2" to="1" dur="0.8" ease="out"/>
      </text>
      <text x="=W/2" y="800" size="46" font="Space Grotesk" align="center" fill="#ffffffcc" text="@sub" at="2.2"><anim prop="opacity" from="0" to="1" dur="0.5"/></text>
      <group x="=W/2" y="920" at="3.2"><anim prop="opacity" from="0" to="1" dur="0.4"/><anim prop="y" from="960" to="920" dur="0.4"/>
        <text size="40" weight="700" font="Space Grotesk" align="center" fill="#3ee6c4" text="@datechip"/>
      </group>
      </group>
    </scene>
    <scene id="where" dur="9" chapter="@ch_where">
      <say at="0.5" text="@vo_where"/>
      <sfx at="0" src="whoosh"/>
      <group opacity="=clamp(T/0.35, 0, 1)*clamp((sdur - T)/0.35, 0, 1)">
      <group x="200" y="230"><anim prop="opacity" from="0" to="1" dur="0.4"/><anim prop="x" from="160" to="200" dur="0.5"/>
        <rect w="680" h="640" r="28" fill="#ffffff" shadow="0 30 60 #0008"/>
        <rect w="680" h="120" r="28" fill="#ff5d73"/><rect y="90" w="680" h="30" fill="#ff5d73"/>
        <text x="340" y="62" size="56" weight="800" font="Space Grotesk" align="center" fill="#fff" text="@march"/>
        <text repeat="7" as="k" x="=74 + k*82" y="170" size="26" weight="700" font="Space Grotesk" align="center" fill="#8a8fb3" text="{data('dow', k)}"/>
        <group x="74" y="235">
          <text x="0" y="0" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="1"/>
          <text x="82" y="0" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="2"/>
          <text x="164" y="0" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="3"/>
          <text x="246" y="0" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="4"/>
          <text x="328" y="0" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="5"/>
          <text x="410" y="0" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="6"/>
          <text x="492" y="0" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="7"/>
          <text x="0" y="84" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="8"/>
          <text x="82" y="84" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="9"/>
          <text x="164" y="84" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="10"/>
          <text x="246" y="84" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="11"/>
          <text x="328" y="84" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="12"/>
          <text x="410" y="84" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="13"/>
          <text x="492" y="84" size="38" weight="800" font="Space Grotesk" align="center" fill="#ff5d73" text="14"/>
          <text x="0" y="168" size="38" weight="800" font="Space Grotesk" align="center" fill="#ff5d73" text="15"/>
          <text x="82" y="168" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="16"/>
          <text x="164" y="168" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="17"/>
          <text x="246" y="168" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="18"/>
          <text x="328" y="168" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="19"/>
          <text x="410" y="168" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="20"/>
          <text x="492" y="168" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="21"/>
          <text x="0" y="252" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="22"/>
          <text x="82" y="252" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="23"/>
          <text x="164" y="252" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="24"/>
          <text x="246" y="252" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="25"/>
          <text x="328" y="252" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="26"/>
          <text x="410" y="252" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="27"/>
          <text x="492" y="252" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="28"/>
          <text x="0" y="336" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="29"/>
          <text x="82" y="336" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="30"/>
          <text x="164" y="336" size="38" weight="500" font="Space Grotesk" align="center" fill="#2a2d4a" text="31"/>
          <path repeat="2" as="k" x="=k ? 0 : 492" y="=k ? 168 : 84" d="M -6 -34 C 34 -36 46 -10 40 10 C 32 34 -10 38 -34 24 C -52 10 -44 -30 -2 -38" fill="none" stroke="#7c5cff" sw="6" at="=1.4 + k*0.7"><anim prop="draw" from="0" to="1" dur="0.6" ease="io"/></path>
        </group>
      </group>
      <group x="980" y="230" at="0.8"><anim prop="opacity" from="0" to="1" dur="0.4"/><anim prop="x" from="1020" to="980" dur="0.5"/>
        <rect w="740" h="680" r="28" fill="#141743" shadow="0 30 60 #0008"/>
        <image src="city" x="20" y="20" w="700" h="400" r="18">
          <anim prop="scale" from="1" to="1.06" dur="8" ease="linear"/>
        </image>
        <group x="370" y="=210 - 18*abs(sin(T*3))*(T &gt; 2 ? 0.4 : 1)" at="1.2">
          <anim prop="scale" from="0" to="1" dur="0.4" ease="back"/>
          <path d="M 0 0 C -20 -30 -44 -50 -44 -80 C -44 -106 -24 -124 0 -124 C 24 -124 44 -106 44 -80 C 44 -50 20 -30 0 0 Z" fill="#ff5d73" stroke="#fff" sw="6"/>
          <circle y="-82" r="16" fill="#fff"/>
        </group>
        <text x="40" y="490" size="48" weight="800" font="Space Grotesk" fill="#fff" text="@venue"/>
        <text x="40" y="550" size="34" font="Space Grotesk" fill="#aab0ff" text="@city"/>
        <text x="40" y="620" size="32" weight="700" font="Space Grotesk" fill="#3ee6c4" text="@halls"/>
      </group>
      </group>
    </scene>
    <scene id="clock" dur="10" chapter="@ch_clock">
      <say at="0.5" text="@vo_clock"/>
      <sfx at="0" src="whoosh"/><sfx at="0.6" src="click" vol="0.5"/><sfx at="1.6" src="click" vol="0.5"/><sfx at="2.6" src="click" vol="0.5"/><sfx at="3.6" src="click" vol="0.5"/><sfx at="4.6" src="click" vol="0.5"/><sfx at="5.6" src="click" vol="0.5"/><sfx at="6.6" src="click" vol="0.5"/><sfx at="7.6" src="click" vol="0.5"/><sfx at="8.6" src="click" vol="0.5"/><sfx at="9.6" src="click" vol="0.5"/>
      <group opacity="=clamp(T/0.35, 0, 1)*clamp((sdur - T)/0.35, 0, 1)">
      <text x="=W/2" y="200" size="60" weight="800" font="Space Grotesk" align="center" fill="#fff" text="@doors"><anim prop="opacity" from="0" to="1" dur="0.4"/></text>
      <group x="=W/2" y="520"><anim prop="scale" from="0.9" to="1" dur="0.6" ease="out"/><anim prop="opacity" from="0" to="1" dur="0.4"/>
        <group scale="1">
          <group repeat="8" as="i" x="=data('cx', i)">
            <rect x="-75" y="-95" w="150" h="210" r="16" fill="#000" opacity="0.35" blur="12"/>
            <group clip="url(#topH)"><rect x="-75" y="-105" w="150" h="210" r="16" fill="url(#cardg)"/>
            <text size="170" weight="700" font="Space Grotesk" align="center" y="6" fill="#fff" text="{dg(rr(), i)}"/></group>
            <group clip="url(#botH)"><rect x="-75" y="-105" w="150" h="210" r="16" fill="url(#cardg)"/>
            <text size="170" weight="700" font="Space Grotesk" align="center" y="6" fill="#fff" text="{dg(rr() + sn(rr(), i) + 0.0001, i)}"/></group>
            <group clip="url(#flapA)"><rect x="-75" y="-105" w="150" h="210" r="16" fill="url(#cardg)"/>
            <text size="170" weight="700" font="Space Grotesk" align="center" y="6" fill="#fff" text="{dg(rr() + sn(rr(), i) + 0.0001, i)}"/><rect x="-75" y="-105" w="150" h="210" r="16" fill="#000" opacity="=0.55*clamp(sn(rr(), i)/0.2, 0, 1)"/></group>
            <group clip="url(#flapB)"><rect x="-75" y="-105" w="150" h="210" r="16" fill="url(#cardg)"/>
            <text size="170" weight="700" font="Space Grotesk" align="center" y="6" fill="#fff" text="{dg(rr(), i)}"/><rect x="-75" y="-105" w="150" h="210" r="16" fill="#fff" opacity="=0.25*(1 - clamp((sn(rr(), i) - 0.2)/0.2, 0, 1))"/></group>
            <rect x="-75" y="-3" w="150" h="6" fill="#0b0d26"/>
            <circle x="-71" r="7" fill="#2b2f66"/><circle x="71" r="7" fill="#2b2f66"/>
          </group>
          <group repeat="3" as="k" x="=data('cx', 1 + 2*k) + 115">
            <circle y="-34" r="11" fill="#ff5d73" opacity="=0.35 + 0.65*(fract(T) &lt; 0.5 ? 1 : 0)"/>
            <circle y="34" r="11" fill="#ff5d73" opacity="=0.35 + 0.65*(fract(T) &lt; 0.5 ? 1 : 0)"/>
          </group>
          <text repeat="4" as="k" x="=(data('cx', 2*k) + data('cx', 2*k+1))/2" y="165" size="34" weight="700" font="Space Grotesk" align="center" fill="#aab0ff" text="{data('units', k)}"/>
        </group>
      </group>
      <group x="=W/2" y="860" at="3"><anim prop="opacity" from="0" to="1" dur="0.4"/>
        <rect x="-430" y="-40" w="860" h="80" r="40" fill="#ff5d7322" stroke="#ff5d73" sw="3"/>
        <circle x="-385" r="10" fill="#ff5d73" opacity="=0.4 + 0.6*abs(sin(T*3))"/>
        <text x="-355" size="34" weight="700" font="Space Grotesk" fill="#ffd0d6" text="@early"/>
      </group>
      </group>
    </scene>
    <scene id="speakers" dur="10" chapter="@ch_speakers">
      <say at="0.5" text="@vo_speakers"/>
      <sfx at="0" src="whoosh"/>
      <group opacity="=clamp(T/0.35, 0, 1)*clamp((sdur - T)/0.35, 0, 1)">
      <text x="=W/2" y="160" size="64" weight="800" font="Space Grotesk" align="center" fill="#fff" text="@spk"><anim prop="opacity" from="0" to="1" dur="0.4"/></text>
      <group x="360" y="370" at="0.60">
        <anim prop="scale" from="0.6" to="1" dur="0.45" ease="back"/><anim prop="opacity" from="0" to="1" dur="0.3"/>
        <circle r="112" fill="none" stroke="url(#ring0)" sw="8" rot="=T*40"/>
        <circle r="96" fill="#7c5cff"/>
        <circle r="96" fill="url(#gloss)"/>
        <text size="76" weight="800" font="Space Grotesk" align="center" y="4" fill="#0d1033" text="AM"/>
        <text y="160" size="40" weight="800" font="Space Grotesk" align="center" fill="#fff" text="Asha Mehta"/>
        <text y="208" size="30" font="Space Grotesk" align="center" fill="#aab0ff" text="Type design"/>
      </group>
      <group x="960" y="370" at="1.05">
        <anim prop="scale" from="0.6" to="1" dur="0.45" ease="back"/><anim prop="opacity" from="0" to="1" dur="0.3"/>
        <circle r="112" fill="none" stroke="url(#ring1)" sw="8" rot="=T*40"/>
        <circle r="96" fill="#ff5d73"/>
        <circle r="96" fill="url(#gloss)"/>
        <text size="76" weight="800" font="Space Grotesk" align="center" y="4" fill="#0d1033" text="DO"/>
        <text y="160" size="40" weight="800" font="Space Grotesk" align="center" fill="#fff" text="Daniel Okafor"/>
        <text y="208" size="30" font="Space Grotesk" align="center" fill="#aab0ff" text="Game art"/>
      </group>
      <group x="1560" y="370" at="1.50">
        <anim prop="scale" from="0.6" to="1" dur="0.45" ease="back"/><anim prop="opacity" from="0" to="1" dur="0.3"/>
        <circle r="112" fill="none" stroke="url(#ring2)" sw="8" rot="=T*40"/>
        <circle r="96" fill="#3ee6c4"/>
        <circle r="96" fill="url(#gloss)"/>
        <text size="76" weight="800" font="Space Grotesk" align="center" y="4" fill="#0d1033" text="LZ"/>
        <text y="160" size="40" weight="800" font="Space Grotesk" align="center" fill="#fff" text="Lin Zhou"/>
        <text y="208" size="30" font="Space Grotesk" align="center" fill="#aab0ff" text="Real-time rendering"/>
      </group>
      <group x="360" y="710" at="1.95">
        <anim prop="scale" from="0.6" to="1" dur="0.45" ease="back"/><anim prop="opacity" from="0" to="1" dur="0.3"/>
        <circle r="112" fill="none" stroke="url(#ring3)" sw="8" rot="=T*40"/>
        <circle r="96" fill="#ffb547"/>
        <circle r="96" fill="url(#gloss)"/>
        <text size="76" weight="800" font="Space Grotesk" align="center" y="4" fill="#0d1033" text="PR"/>
        <text y="160" size="40" weight="800" font="Space Grotesk" align="center" fill="#fff" text="Priya Raman"/>
        <text y="208" size="30" font="Space Grotesk" align="center" fill="#aab0ff" text="Motion direction"/>
