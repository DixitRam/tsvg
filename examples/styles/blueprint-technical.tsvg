    <option id="theme" label="Theme" default="blueprint"><choice id="blueprint" label="Blueprint"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.35" sfx="0.7"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
    <mix id="ambient" voice="0" music="0.6" sfx="0.7"/>
  </mixes>
  <themes>
    <theme id="blueprint" bg="#14417d" fg="#e8f1ff" muted="#9fd3ff" accent="#ffe27a"/>
  </themes>
  <strings>
    <s id="title" en="Bicycle gears on a blueprint"/>
    <s id="ch1" en="Drivetrain"/>
    <s id="ch2" en="Chainring"/>
    <s id="ch3" en="Cog"/>
    <s id="ch4" en="Ratio"/>
    <s id="ch5" en="Distance"/>
    <s id="ch6" en="Trade-off"/>
    <s id="ch7" en="Summary"/>
    <s id="h1" en="BICYCLE DRIVETRAIN · GEAR RATIO"/>
    <s id="h2" en="DETAIL A · CHAINRING"/>
    <s id="h3" en="DETAIL B · REAR COG"/>
    <s id="h4" en="CALC 1 · RATIO"/>
    <s id="h5" en="CALC 2 · DISTANCE PER STROKE"/>
    <s id="h6" en="CALC 3 · CLIMBING GEAR"/>
    <s id="h7" en="SUMMARY"/>
    <s id="c_ring" en="CHAINRING 48T"/>
    <s id="c_cog" en="COG 16T"/>
    <s id="c_chain" en="CHAIN, PITCH 12.7"/>
    <s id="c_crank" en="CRANK 172.5"/>
    <s id="c_ring2" en="48 TEETH, Ø 194"/>
    <s id="c_cog2" en="16 TEETH, Ø 65"/>
    <s id="eq" en="48 ÷ 16 = 3.0"/>
    <s id="eq2" en="1 CRANK REV → 3 WHEEL REV"/>
    <s id="circ" en="WHEEL CIRCUMFERENCE"/>
    <s id="eq3" en="3 × 2.10 m = 6.30 m"/>
    <s id="th1" en="COG"/>
    <s id="th2" en="RATIO"/>
    <s id="th3" en="PER STROKE"/>
    <s id="r1a" en="16T"/>
    <s id="r1b" en="3.0"/>
    <s id="r1c" en="6.30 m"/>
    <s id="r2a" en="24T"/>
    <s id="r2b" en="2.0"/>
    <s id="r2c" en="4.20 m"/>
    <s id="n_fast" en="SMALL COG → MORE SPEED"/>
    <s id="n_force" en="LARGE COG → MORE FORCE"/>
    <s id="n_note" en="NOTE: GEARS TRADE ONE FOR THE OTHER"/>
    <s id="vo_intro" en="Why does a small rear cog make you faster, and harder to pedal? Let us draw the drivetrain."/>
    <s id="vo_ring" en="Up front is the chainring. This one has forty eight teeth."/>
    <s id="vo_cog" en="At the back sits a cog with sixteen teeth. The chain links them, tooth for tooth."/>
    <s id="vo_ratio" en="Forty eight divided by sixteen is three. One turn of the pedals spins the wheel three times."/>
    <s id="vo_dist" en="The wheel is two point one metres around, so each pedal turn carries you six point three metres."/>
    <s id="vo_trade" en="Swap to a twenty four tooth cog, and you only travel four point two metres. But every push is much easier."/>
    <s id="vo_outro" en="Small cog, more speed. Big cog, more force. Gears just trade one for the other."/>
  </strings>
  <defs>
<radial id="bpglow" x="960" y="540" r="1200"><stop at="0" color="#1d58a6"/><stop at="1" color="#0f3166"/></radial>
