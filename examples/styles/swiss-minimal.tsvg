<?xml version="1.0" encoding="UTF-8"?>
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:bf_emma"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full (voice + music + sfx)"/><choice id="speech" label="Speech only"/><choice id="ambient" label="No voice"/></option>
    <option id="theme" label="Theme" default="paper"><choice id="paper" label="Paper"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.35" sfx="0.7"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
    <mix id="ambient" voice="0" music="0.6" sfx="0.7"/>
  </mixes>
  <themes>
    <theme id="paper" bg="#f2f0eb" fg="#111111" muted="#6b6b6b" accent="#e30613"/>
  </themes>
  <strings>
    <s id="title" en="Maps that lie"/>
    <s id="ch1" en="Maps that lie"/>
    <s id="ch2" en="Geography"/>
    <s id="ch3" en="Three angles"/>
    <s id="ch4" en="Even spacing"/>
    <s id="ch5" en="Colour"/>
    <s id="ch6" en="Origin"/>
    <s id="ch7" en="Order"/>
    <s id="t1" en="Maps"/>
    <s id="t2" en="that lie."/>
    <s id="tsub" en="How transit diagrams trade distance for clarity"/>
    <s id="h2" en="The real city"/>
    <s id="b2" en="Stations bunch up downtown and thin out in the suburbs."/>
    <s id="h3" en="0°, 45°, 90°"/>
    <s id="b3" en="Every line is straightened to just three angles."/>
    <s id="h4" en="Equal steps"/>
    <s id="b4" en="Even spacing gives the crowded centre room for names."/>
    <s id="h5" en="Colour = line"/>
    <s id="n01" en="Nº 01"/>
    <s id="n02" en="Nº 02"/>
    <s id="n03" en="Nº 03"/>
    <s id="n04" en="Nº 04"/>
    <s id="b5" en="You read the route and the changes, not the distance."/>
    <s id="h6" en="1930s"/>
    <s id="b6" en="A draughtsman drew the network like a circuit diagram."/>
    <s id="o1" en="Order,"/>
    <s id="o2" en="not distance"/>
    <s id="o3" en="A good diagram is honest about connections."/>
    <s id="vo_intro" en="Transit maps lie, on purpose. Here is how they trade distance for clarity."/>
    <s id="vo_geo" en="A true map of a city railway is a tangle. Stations bunch up in the centre and spread out in the suburbs."/>
    <s id="vo_angle" en="So the diagram straightens every line to three angles: horizontal, vertical and forty-five degrees."/>
    <s id="vo_space" en="Stations are spaced evenly, which gives the crowded centre room for its names."/>
    <s id="vo_colour" en="Each line gets one flat colour. You read the route and where to change, not how far it is."/>
    <s id="vo_origin" en="The idea goes back to the nineteen thirties, when a draughtsman drew the network like a circuit."/>
    <s id="vo_outro" en="A good diagram tells the truth about order and connections, not distance."/>
  </strings>
  <defs>

    <data id="cx" v="0, 300, 380, 700, 780, 1100"/><data id="cy" v="0, 0, -80, -80, 0, 0"/>
    <clip id="cut"><rect x="80" y="250" w="620" h="320"/></clip>
    <clip id="cutwide"><rect x="0" y="120" w="1920" h="640"/></clip>
  </defs>
