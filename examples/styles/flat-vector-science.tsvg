    <circle x="=300 + 20*sin(t*0.2)" y="160" r="90" fill="#ffffff" opacity="0.06"/>
    <path x="=-fract(t*0.01)*960" d="M 0 1200 L 0 940 L 0 820.0 L 40 822.0 L 80 828.0 L 120 837.6 L 160 850.0 L 200 864.5 L 240 880.0 L 280 895.5 L 320 910.0 L 360 922.4 L 400 932.0 L 440 938.0 L 480 940.0 L 520 938.0 L 560 932.0 L 600 922.4 L 640 910.0 L 680 895.5 L 720 880.0 L 760 864.5 L 800 850.0 L 840 837.6 L 880 828.0 L 920 822.0 L 960 820.0 L 1000 822.0 L 1040 828.0 L 1080 837.6 L 1120 850.0 L 1160 864.5 L 1200 880.0 L 1240 895.5 L 1280 910.0 L 1320 922.4 L 1360 932.0 L 1400 938.0 L 1440 940.0 L 1480 938.0 L 1520 932.0 L 1560 922.4 L 1600 910.0 L 1640 895.5 L 1680 880.0 L 1720 864.5 L 1760 850.0 L 1800 837.6 L 1840 828.0 L 1880 822.0 L 1920 820.0 L 1960 822.0 L 2000 828.0 L 2040 837.6 L 2080 850.0 L 2120 864.5 L 2160 880.0 L 2200 895.5 L 2240 910.0 L 2280 922.4 L 2320 932.0 L 2360 938.0 L 2400 940.0 L 2440 938.0 L 2480 932.0 L 2520 922.4 L 2560 910.0 L 2600 895.5 L 2640 880.0 L 2680 864.5 L 2720 850.0 L 2760 837.6 L 2800 828.0 L 2840 822.0 L 2880 820.0 L 2920 822.0 L 2960 828.0 L 3000 837.6 L 3040 850.0 L 3080 864.5 L 3120 880.0 L 3160 895.5 L 3200 910.0 L 3240 922.4 L 3280 932.0 L 3320 938.0 L 3360 940.0 L 3400 938.0 L 3440 932.0 L 3480 922.4 L 3520 910.0 L 3560 895.5 L 3600 880.0 L 3640 864.5 L 3680 850.0 L 3720 837.6 L 3760 828.0 L 3800 822.0 L 3840 820.0 L 3840 1200 Z" fill="#3b2a85" opacity="0.9"/>
