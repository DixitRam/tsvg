<?xml version="1.0" encoding="UTF-8"?>
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:af_bella"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full (voice + music + sfx)"/><choice id="speech" label="Speech only"/><choice id="ambient" label="No voice"/></option>
    <option id="theme" label="Theme" default="bright"><choice id="bright" label="Bright"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.35" sfx="0.7"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
    <mix id="ambient" voice="0" music="0.6" sfx="0.7"/>
  </mixes>
  <themes>
    <theme id="bright" bg="#1d2160" fg="#ffffff" muted="#c9c6ff" accent="#ffd166"/>
  </themes>
  <strings>
    <s id="title" en="Why we have seasons"/>
    <s id="ch1" en="The question"/>
    <s id="ch2" en="Distance?"/>
    <s id="ch3" en="The tilt"/>
    <s id="ch4" en="Steep light"/>
    <s id="ch5" en="Around the year"/>
    <s id="ch6" en="Opposite seasons"/>
    <s id="ch7" en="Recap"/>
    <s id="t1" en="Why do we have"/>
    <s id="t2" en="seasons?"/>
    <s id="d_near" en="Closest: early January"/>
    <s id="d_near2" en="147 million km"/>
    <s id="d_far" en="Farthest: early July"/>
    <s id="d_far2" en="152 million km"/>
    <s id="d_note" en="Only 3% apart"/>
    <s id="tilt" en="23.4°"/>
    <s id="tilt_h" en="The axis leans"/>
    <s id="tilt_b" en="and keeps pointing the same way all year"/>
    <s id="l_steep" en="Leaning toward"/>
    <s id="l_steep2" en="Light packs in: warm"/>
    <s id="l_slant" en="Leaning away"/>
    <s id="l_slant2" en="Light spreads thin: cold"/>
    <s id="m_jun" en="June"/>
    <s id="m_sep" en="September"/>
    <s id="m_dec" en="December"/>
    <s id="m_mar" en="March"/>
    <s id="y_n" en="North tilts in: summer up north"/>
    <s id="f_n" en="North in December"/>
    <s id="f_n2" en="Snow and short days"/>
    <s id="f_s" en="South in December"/>
    <s id="f_s2" en="Sun and long days"/>
    <s id="o1" en="Tilt,"/>
    <s id="o2" en="not distance."/>
    <s id="o3" en="23.4° makes the year turn"/>
    <s id="vo_intro" en="Why do we have seasons? Many people guess that Earth gets closer to the Sun in summer. Let us check."/>
    <s id="vo_orbit" en="Our orbit is almost a perfect circle. We are actually closest to the Sun in early January, in the middle of northern winter."/>
    <s id="vo_tilt" en="The real reason is the tilt. Earth leans about twenty-three degrees, and keeps pointing the same way all year."/>
    <s id="vo_light" en="When your half leans toward the Sun, light arrives steeply and packs into a small patch. Leaning away, the same light spreads thin."/>
    <s id="vo_year" en="So as we go around, the north gets the steep light in June, and the south gets it in December."/>
    <s id="vo_flip" en="That is why the seasons are opposite. Snow in Canada means beach weather in Australia."/>
    <s id="vo_outro" en="Seasons come from tilt, not distance."/>
  </strings>
  <defs>

    <linear id="sky" x1="0" y1="0" x2="0" y2="1080"><stop at="0" color="#1d2160"/><stop at="0.6" color="#4b2f9a"/><stop at="1" color="#c0478f"/></linear>
    <radial id="ocean" x="-60" y="-70" r="300"><stop at="0" color="#5cc8ff"/><stop at="1" color="#2463d6"/></radial>
    <radial id="shade" x="0" y="0" r="300"><stop at="0.55" color="#000" opacity="0"/><stop at="1" color="#0b1040" opacity="0.45"/></radial>
    <radial id="sunfill" x="-30" y="-30" r="160"><stop at="0" color="#ffe27a"/><stop at="1" color="#ff9f1c"/></radial>
    <radial id="sunglow" x="0" y="0" r="260"><stop at="0" color="#ffd166" opacity="0.6"/><stop at="1" color="#ffd166" opacity="0"/></radial>
    <linear id="warmtext" x1="0" y1="-60" x2="0" y2="60"><stop at="0" color="#ffe27a"/><stop at="1" color="#ff7a59"/></linear>
    <linear id="beam" x1="0" y1="80" x2="0" y2="600"><stop at="0" color="#ffe27a" opacity="0.1"/><stop at="1" color="#ffd166" opacity="0.9"/></linear>
    <linear id="snowsky" x1="0" y1="0" x2="0" y2="1080"><stop at="0" color="#9fc9ff"/><stop at="1" color="#dcebff"/></linear>
    <linear id="beachsky" x1="0" y1="0" x2="0" y2="1080"><stop at="0" color="#ffb36b"/><stop at="1" color="#ffe3a3"/></linear>
    <clip id="globe"><circle r="200"/></clip>
    <clip id="cardclip"><rect w="800" h="840" r="48"/></clip>
  </defs>
  <assets>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <asset id="bright" src="audio/bright.ogg"/>
    <asset id="whoosh" src="audio/whoosh.ogg"/>
    <asset id="pop" src="audio/pop.ogg"/>
    <asset id="ding" src="audio/ding.ogg"/>

  </assets>
  <music src="bright" start="0" loop="1" vol="0.8"/>
  <backdrop>

