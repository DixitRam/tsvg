  </backdrop>
  <timeline>
    <scene id="intro" dur="8" chapter="@ch1">
      <say at="0.5" text="@vo_intro"/>

      <sfx at="0.2" src="whoosh"/><sfx at="1.4" src="pop"/>
      <group x="1640" y="190">
        <circle r="220.00000000000003" fill="url(#sunglow)"/>
        <group rot="=T*10"><group repeat="12" as="k" rot="=k*30"><rect x="-10" y="-160" w="20" h="44" r="10" fill="#ffd166"/></group></group>
        <circle r="100" fill="url(#sunfill)"/>
        <circle x="-35" y="-10" r="13" fill="#7a3b00"/><circle x="35" y="-10" r="13" fill="#7a3b00"/>
        <path d="M -25 22 Q 0 45 25 22" stroke="#7a3b00" sw="7.000000000000001" fill="none"/>
        <anim prop="scale" from="0" to="1" dur="1" ease="back"/></group>
      <group x="=W/2 - 300" y="=640 + 14*sin(T*2)" scale="0.9">
        <anim prop="scale" from="0" to="0.9" at="1.2" dur="0.9" ease="back"/>
        <circle r="214" fill="#7fd1ff" opacity="0.25"/>
        <circle r="200" fill="url(#ocean)"/>
        <group clip="url(#globe)">
          <group x="=-fract(T*40/800)*800">
            <path repeat="2" as="k" x="=k*800" d="M -180 -120 C -120 -190 -20 -170 10 -110 C 40 -60 -30 -20 -80 -40 C -140 -60 -220 -60 -180 -120 Z M 120 40 C 170 0 260 30 250 100 C 240 160 170 190 130 140 C 100 100 90 70 120 40 Z M -120 80 C -80 60 -30 90 -40 130 C -50 170 -110 170 -130 130 Z M 330 -150 C 380 -190 470 -170 480 -110 C 490 -60 420 -40 370 -70 C 340 -90 310 -120 330 -150 Z M 520 60 C 560 30 640 50 640 110 C 640 170 560 180 530 140 Z" fill="#5fd38d"/>
          </group>
          <ellipse y="-190" rx="150" ry="40" fill="#ffffff"/><ellipse y="192" rx="140" ry="36" fill="#ffffff"/>
          <circle x="80" y="-40" r="300" fill="url(#shade)"/>
        </group>
        <circle x="-56" y="10" r="24" fill="#fff"/><circle x="56" y="10" r="24" fill="#fff"/>
        <circle x="-52" y="=14 - 4*abs(sin(t*0.8))" r="12" fill="#1d2160"/><circle x="60" y="=14 - 4*abs(sin(t*0.8))" r="12" fill="#1d2160"/>
        <circle x="-92" y="52" r="16" fill="#ff7eb6" opacity="0.6"/><circle x="92" y="52" r="16" fill="#ff7eb6" opacity="0.6"/>
        <path d="M -24 56 Q 0 80 24 56" stroke="#1d2160" sw="7" fill="none"/>
      </group>
      <text x="1000" y="420" size="96" weight="800" text="@t1" fill="#ffffff" at="0.4">
        <anim prop="opacity" from="0" to="1" dur="0.5"/><anim prop="x" from="1040" to="1000" dur="0.6" ease="out"/></text>
      <text x="1000" y="540" size="150" weight="900" text="@t2" fill="url(#warmtext)" at="0.9">
        <anim prop="opacity" from="0" to="1" dur="0.5"/><anim prop="scale" from="0.7" to="1" dur="0.7" ease="back"/></text>
      <group x="1520" y="=880 + 10*abs(sin(T*3))" scale="0.8" at="2.2">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <ellipse x="-26" y="58" rx="22" ry="12" fill="#b85c00"/><ellipse x="26" y="58" rx="22" ry="12" fill="#b85c00"/>
        <line x1="0" y1="-60" x2="10" y2="-98" stroke="#b85c00" sw="6"/><circle x="10" y="-104" r="11" fill="#ff7eb6"/>
        <circle r="64" fill="#ff9f43"/>
        <ellipse x="-18" y="-22" rx="30" ry="20" fill="#ffffff" opacity="0.25"/>
        <circle x="-22" y="-6" r="15" fill="#fff"/><circle x="22" y="-6" r="15" fill="#fff"/>
        <circle x="=-19 + 3*sin(t*1.3)" y="-4" r="8" fill="#1d2160"/><circle x="=25 + 3*sin(t*1.3)" y="-4" r="8" fill="#1d2160"/>
        <circle x="-38" y="16" r="9" fill="#ff7eb6" opacity="0.7"/><circle x="38" y="16" r="9" fill="#ff7eb6" opacity="0.7"/>
        <path d="M -12 22 Q 0 34 12 22" stroke="#1d2160" sw="5" fill="none"/></group>
    </scene>
    <scene id="orbit" dur="10" chapter="@ch2">
      <say at="0.5" text="@vo_orbit"/>

      <sfx at="0.3" src="whoosh"/><sfx at="4.8" src="ding"/>
      <group x="=W/2" y="560">
        <ellipse rx="560" ry="360" fill="none" stroke="#ffffff" sw="5" opacity="0.35"/>
        <ellipse rx="=560" ry="360" fill="none" stroke="#ffd166" sw="6" from="0" to="=360*ease(T/2.5,'io')"/>
        <group x="0" y="0" scale="0.85">
        <circle r="242.00000000000003" fill="url(#sunglow)"/>
        <group rot="=T*10"><group repeat="12" as="k" rot="=k*30"><rect x="-10" y="-170" w="20" h="44" r="10" fill="#ffd166"/></group></group>
        <circle r="110" fill="url(#sunfill)"/>
        <circle x="-38.5" y="-11" r="14.3" fill="#7a3b00"/><circle x="38.5" y="-11" r="14.3" fill="#7a3b00"/>
        <path d="M -27.5 24.2 Q 0 49.5 27.5 24.2" stroke="#7a3b00" sw="7.700000000000001" fill="none"/></group>
        <group x="=560*sin(T*0.5 + 2.2)" y="=-360*cos(T*0.5 + 2.2)" scale="0.32">
        <circle r="214" fill="#7fd1ff" opacity="0.25"/>
        <circle r="200" fill="url(#ocean)"/>
        <group clip="url(#globe)">
          <group x="=-fract(t*60/800)*800">
            <path repeat="2" as="k" x="=k*800" d="M -180 -120 C -120 -190 -20 -170 10 -110 C 40 -60 -30 -20 -80 -40 C -140 -60 -220 -60 -180 -120 Z M 120 40 C 170 0 260 30 250 100 C 240 160 170 190 130 140 C 100 100 90 70 120 40 Z M -120 80 C -80 60 -30 90 -40 130 C -50 170 -110 170 -130 130 Z M 330 -150 C 380 -190 470 -170 480 -110 C 490 -60 420 -40 370 -70 C 340 -90 310 -120 330 -150 Z M 520 60 C 560 30 640 50 640 110 C 640 170 560 180 530 140 Z" fill="#5fd38d"/>
          </group>
          <ellipse y="-190" rx="150" ry="40" fill="#ffffff"/><ellipse y="192" rx="140" ry="36" fill="#ffffff"/>
          <circle x="80" y="-40" r="300" fill="url(#shade)"/>
        </group>
        <circle x="-56" y="10" r="24" fill="#fff"/><circle x="56" y="10" r="24" fill="#fff"/>
        <circle x="-52" y="=14 - 4*abs(sin(t*0.8))" r="12" fill="#1d2160"/><circle x="60" y="=14 - 4*abs(sin(t*0.8))" r="12" fill="#1d2160"/>
        <circle x="-92" y="52" r="16" fill="#ff7eb6" opacity="0.6"/><circle x="92" y="52" r="16" fill="#ff7eb6" opacity="0.6"/>
        <path d="M -24 56 Q 0 80 24 56" stroke="#1d2160" sw="7" fill="none"/></group>
        <circle x="-560" y="0" r="16" fill="#7fd1ff"/><circle x="560" y="0" r="16" fill="#ff9f43"/>
      </group>
      
      <group x="80" y="90" at="1.2" >
        <anim prop="opacity" from="0" to="1" dur="0.5"/><anim prop="y" from="130" to="90" dur="0.7" ease="back"/>
        <rect w="520" h="200" r="36" fill="#ffffff" shadow="0 18 0 #00000033"/>
        <text x="40" y="70" size="40" weight="800" fill="#1d2160" text="@d_near"/>
        <text x="40" y="140" size="48" weight="800" fill="#2d8cf0" text="@d_near2"/>
      </group>
      
      <group x="1320" y="90" at="2.2" >
        <anim prop="opacity" from="0" to="1" dur="0.5"/><anim prop="y" from="130" to="90" dur="0.7" ease="back"/>
        <rect w="520" h="200" r="36" fill="#ffffff" shadow="0 18 0 #00000033"/>
        <text x="40" y="70" size="40" weight="800" fill="#1d2160" text="@d_far"/>
        <text x="40" y="140" size="48" weight="800" fill="#ff7a1a" text="@d_far2"/>
      </group>
      <group x="=W/2" y="990" at="4.6">
        <anim prop="opacity" from="0" to="1" dur="0.4"/><anim prop="scale" from="0.6" to="1" dur="0.6" ease="back"/>
        <rect x="-300" y="-50" w="600" h="100" r="50" fill="#ff7eb6"/>
        <text x="0" y="0" size="52" weight="900" align="center" fill="#ffffff" text="@d_note"/>
      </group>
    </scene>
    <scene id="tilt" dur="9.5" chapter="@ch3">
      <say at="0.5" text="@vo_tilt"/>

      <sfx at="1.2" src="pop"/>
      <group x="620" y="560">
        <line x1="0" y1="-330" x2="0" y2="330" stroke="#ffffff" sw="4" opacity="0.35"/>
        <group rot="=23.4*ease((T-0.8)/1.4,'back')">
          <line x1="0" y1="-330" x2="0" y2="330" stroke="#ffd166" sw="10"/>
          <group scale="1.2">
        <circle r="214" fill="#7fd1ff" opacity="0.25"/>
        <circle r="200" fill="url(#ocean)"/>
        <group clip="url(#globe)">
          <group x="=-fract(T*30/800)*800">
            <path repeat="2" as="k" x="=k*800" d="M -180 -120 C -120 -190 -20 -170 10 -110 C 40 -60 -30 -20 -80 -40 C -140 -60 -220 -60 -180 -120 Z M 120 40 C 170 0 260 30 250 100 C 240 160 170 190 130 140 C 100 100 90 70 120 40 Z M -120 80 C -80 60 -30 90 -40 130 C -50 170 -110 170 -130 130 Z M 330 -150 C 380 -190 470 -170 480 -110 C 490 -60 420 -40 370 -70 C 340 -90 310 -120 330 -150 Z M 520 60 C 560 30 640 50 640 110 C 640 170 560 180 530 140 Z" fill="#5fd38d"/>
          </group>
          <ellipse y="-190" rx="150" ry="40" fill="#ffffff"/><ellipse y="192" rx="140" ry="36" fill="#ffffff"/>
          <circle x="80" y="-40" r="300" fill="url(#shade)"/>
        </group>
        <circle x="-56" y="10" r="24" fill="#fff"/><circle x="56" y="10" r="24" fill="#fff"/>
        <circle x="-52" y="=14 - 4*abs(sin(t*0.8))" r="12" fill="#1d2160"/><circle x="60" y="=14 - 4*abs(sin(t*0.8))" r="12" fill="#1d2160"/>
        <circle x="-92" y="52" r="16" fill="#ff7eb6" opacity="0.6"/><circle x="92" y="52" r="16" fill="#ff7eb6" opacity="0.6"/>
        <path d="M -24 56 Q 0 80 24 56" stroke="#1d2160" sw="7" fill="none"/></group>
          <circle y="-330" r="18" fill="#ffd166"/>
        </group>
        <circle r="290" from="0" to="=23.4*ease((T-0.8)/1.4,'out')" fill="#ffd16655"/>
        <text x="80" y="-380" size="64" weight="900" fill="#ffd166" text="@tilt" at="1.6"><anim prop="opacity" from="0" to="1" dur="0.4"/></text>
      </group>
      <group x="1140" y="380" at="2.4">
        <anim prop="opacity" from="0" to="1" dur="0.5"/><anim prop="x" from="1180" to="1140" dur="0.6" ease="out"/>
        <text x="0" y="0" size="96" weight="900" fill="#ffffff" text="@tilt_h"/>
        <text x="0" y="140" size="48" weight="600" maxw="640" lh="1.3" fill="#c9c6ff" text="@tilt_b"/>
      </group>
      <group x="1720" y="180" at="4"><anim prop="opacity" from="0" to="=0.6+0.4*sin(T*5)" dur="0.5"/>
        <path d="M 0 -40 L 10 -10 L 40 0 L 10 10 L 0 40 L -10 10 L -40 0 L -10 -10 Z" fill="#ffd166"/></group>
      <line x1="620" y1="230" x2="1690" y2="185" stroke="#ffd166" sw="3" opacity="0.5" at="4"><anim prop="draw" from="0" to="1" dur="1.2" ease="io"/></line>
    </scene>
    <scene id="light" dur="11" chapter="@ch4">
      <say at="0.5" text="@vo_light"/>

      <sfx at="0.6" src="pop"/><sfx at="4.6" src="pop"/>
      
      <group x="120" y="120" at="0.4">
        <anim prop="opacity" from="0" to="1" dur="0.5"/>
        <rect w="800" h="840" r="48" fill="#2b3fa8" shadow="0 20 0 #00000040"/>
        <group clip="url(#cardclip)">
          <path d="M 300 80 L 500 80 L 500 600 L 300 600 Z" fill="url(#beam)" opacity="=0.75 + 0.15*sin(T*4)">
            <anim prop="opacity" from="0" to="0.85" dur="0.8" at="0.6"/></path>
          <path d="M 0 600 C 200 570 600 570 800 600 L 800 840 L 0 840 Z" fill="#5fd38d"/>
          <rect x="300" y="592" w="200" h="22" r="11" fill="#ffb703"/>
          <text x="400" y="650" size="34" weight="800" align="center" fill="#1d2160" text="1 unit of heat"/>
          <group x="640" y="740" scale="0.6" rot="=0">
        <ellipse x="-26" y="58" rx="22" ry="12" fill="#b85c00"/><ellipse x="26" y="58" rx="22" ry="12" fill="#b85c00"/>
        <line x1="0" y1="-60" x2="10" y2="-98" stroke="#b85c00" sw="6"/><circle x="10" y="-104" r="11" fill="#ff7eb6"/>
        <circle r="64" fill="#ff9f43"/>
