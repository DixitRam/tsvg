    <theme id="bold" bg="#111111" fg="#f4f1ea" muted="#999999" accent="#ffe600"/>
  </themes>
  <strings>
    <s id="title" en="One bag, one week"/>
    <s id="vo_intro" en="Pack for a week. In one bag. Here is how."/>
    <s id="ch0" en="Pack for a week"/>
    <s id="vo_bag" en="Start with a carry-on of about 40 litres. Nothing bigger."/>
    <s id="ch1" en="Start with a carry-on of about 40 litres"/>
    <s id="vo_palette" en="Pick one colour palette, so every top matches every bottom."/>
    <s id="ch2" en="Pick one colour palette, so every top matches every bottom"/>
    <s id="vo_count" en="3 tops, 2 bottoms, 1 jacket. Wear the bulkiest on the plane."/>
    <s id="ch3" en="3 tops, 2 bottoms, 1 jacket"/>
    <s id="vo_shoes" en="Shoes take the most space. Bring two pairs, and wear the heavier one."/>
    <s id="ch4" en="Shoes take the most space"/>
    <s id="vo_roll" en="Roll your clothes, and squeeze them into packing cubes."/>
    <s id="ch5" en="Roll your clothes, and squeeze them into packing cubes"/>
    <s id="vo_liquid" en="Liquids? A solid shampoo bar and one tiny bottle."/>
    <s id="ch6" en="Liquids"/>
    <s id="vo_extras" en="Leave the just-in-case stuff at home. You can buy it there."/>
    <s id="ch7" en="Leave the just-in-case stuff at home"/>
    <s id="vo_wash" en="Wash one thing every night. It is dry by morning."/>
    <s id="ch8" en="Wash one thing every night"/>
    <s id="vo_outro" en="One bag. Seven days. Zero waiting at baggage claim."/>
    <s id="ch9" en="One bag"/>
  </strings>
  <defs>

  </defs>
