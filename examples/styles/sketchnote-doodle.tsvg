<tsvg version="0.2" title="@title" font="Caveat">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:af_heart"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full (voice + music + sfx)"/><choice id="speech" label="Speech only"/><choice id="ambient" label="No voice"/></option>
    <option id="theme" label="Theme" default="paper"><choice id="paper" label="Paper"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.35" sfx="0.7"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
    <mix id="ambient" voice="0" music="0.6" sfx="0.7"/>
  </mixes>
  <themes>
    <theme id="paper" bg="#fbf8f1" fg="#2b2b2b" muted="#555555" accent="#1c4fa0"/>
  </themes>
  <strings>
    <s id="title" en="How to run a good retro"/>
    <s id="ch1" en="Retro"/>
    <s id="ch2" en="Set the stage"/>
    <s id="ch3" en="Gather"/>
    <s id="ch4" en="Vote"/>
    <s id="ch5" en="One action"/>
    <s id="ch6" en="Follow up"/>
    <s id="ch7" en="Recap"/>
    <s id="t1" en="Running a good"/>
    <s id="t2" en="retro"/>
    <s id="t3" en="look back · get a bit better"/>
    <s id="s_head" en="1. Set the stage"/>
    <s id="s_min" en="45 min"/>
    <s id="s_rule" en="blame the process, not people"/>
    <s id="s_safe" en="everyone writes, everyone speaks"/>
    <s id="g_head" en="2. Gather notes"/>
    <s id="g_well" en="went well :)"/>
    <s id="g_hard" en="was hard :("/>
    <s id="n1" en="pairing on bugs"/>
    <s id="n2" en="demo day!"/>
    <s id="n3" en="clear tickets"/>
    <s id="n4" en="flaky tests"/>
    <s id="n5" en="too many meetings"/>
    <s id="n6" en="CI is slow"/>
    <s id="n7" en="tests fail randomly"/>
    <s id="v_head" en="3. Group + vote"/>
    <s id="v_top" en="top issue: unreliable tests"/>
    <s id="a_head" en="4. ONE action"/>
    <s id="a_what" en="quarantine flaky tests, fix 3 per week"/>
    <s id="a_who" en="owner: Priya"/>
    <s id="a_when" en="by Friday"/>
    <s id="f_head" en="5. Follow up"/>
    <s id="f_q" en="did it happen?"/>
    <s id="f_loop" en="next retro starts here"/>
    <s id="r_head" en="The recipe"/>
    <s id="r1" en="set the stage"/>
    <s id="r2" en="sticky notes"/>
    <s id="r3" en="group + dot vote"/>
    <s id="r4" en="one action, one owner"/>
    <s id="r5" en="check it next time"/>
    <s id="r_bub" en="we got better!"/>
    <s id="vo_intro" en="A retrospective is a short meeting where a team looks back and gets a little better. Here is a simple way to run one."/>
    <s id="vo_stage" en="Start by setting the stage. Book forty five minutes, and agree to blame the process, not people."/>
    <s id="vo_gather" en="Next, everyone writes sticky notes: what went well, and what was hard. Five minutes, in silence."/>
    <s id="vo_vote" en="Group similar notes, then vote with dots. The biggest cluster is what you work on."/>
    <s id="vo_action" en="Turn it into one concrete action, with an owner and a date. Just one."/>
    <s id="vo_follow" en="At the next retro, start by checking that action. That loop is what makes teams improve."/>
    <s id="vo_outro" en="Stage, notes, vote, one action, follow up. That is a retro."/>
  </strings>
  <defs>

  </defs>
  <assets>
    <font family="Caveat" src="fonts/Caveat.ttf"/>
    <asset id="bright" src="audio/bright.ogg"/>
    <asset id="typing" src="audio/typing.ogg"/>
    <asset id="pop" src="audio/pop.ogg"/>
    <asset id="click" src="audio/click.ogg"/>
    <asset id="ding" src="audio/ding.ogg"/>

  </assets>
  <music src="bright" start="0" loop="1" vol="0.5"/>
