<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: decision-tree flowchart. Diamonds and branches draw on, a token travels the chosen path, the outcome lights up. -->
<tsvg version="0.2" title="@title" font="Space Grotesk, Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:bm_george"/></option>
    <option id="mix" label="Audio" default="full">
      <choice id="full" label="Full"/><choice id="speech" label="Speech only"/>
    </option>
    <option id="theme" label="Theme" default="blueprint"><choice id="blueprint" label="Blueprint"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.25" sfx="0.6"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
  </mixes>
  <themes>
    <theme id="blueprint" bg="#0b1726" fg="#e8f1ff" muted="#7f95b2" line="#5fb3ff" node="#11253b" dia="#ffc857" yes="#4ade80" no="#ff6b6b" amber="#ffb347" grid="#5fb3ff"/>
  </themes>
  <strings>
    <s id="title" en="Does this bug block the release?"/>
    <s id="ch1" en="The question"/><s id="ch2" en="Data or security"/><s id="ch3" en="How many users"/><s id="ch4" en="Workaround"/><s id="ch5" en="A real bug"/><s id="ch6" en="The call"/><s id="ch7" en="Outro"/>
    <s id="start" en="Bug found in the release candidate"/>
    <s id="d1" en="Data loss or security risk?"/>
    <s id="d2" en="Hits more than 5% of users?"/>
    <s id="d3" en="Is there a workaround?"/>
    <s id="o1" en="BLOCK the release"/>
    <s id="o2" en="Ship · fix next sprint"/>
    <s id="o3" en="Ship + release note"/>
    <s id="o4" en="Hotfix before shipping"/>
    <s id="yes" en="YES"/><s id="no" en="NO"/>
    <s id="caseK" en="BUG #482"/>
    <s id="caseT" en="Login button cut off on Android tablets"/>
    <s id="case1" en="✓ no data risk"/><s id="case2" en="✓ 8% of users"/><s id="case3" en="✓ rotating fixes it"/>
    <s id="decided" en="DECIDED"/>
    <s id="dec2" en="Fix scheduled for next week"/>
    <s id="out1" en="Write the rule down once."/>
    <s id="out2" en="Decide in a minute, not a meeting."/>
    <s id="vo1" en="Every release, someone asks the same question: does this bug block it? Here's a decision tree that answers it in a minute."/>
    <s id="vo2" en="First question: can it lose data or expose anything private? If yes, stop. Nothing ships until it's fixed."/>
    <s id="vo3" en="If not, how many people does it hit? Under five percent, ship on time and fix it next sprint."/>
    <s id="vo4" en="Above five percent, ask one more thing: is there a workaround? Yes means ship with a clear note. No means hotfix first."/>
    <s id="vo5" en="Let's run a real one. A cut-off login button on Android tablets. No data risk. Eight percent of users. But rotating the screen fixes it."/>
    <s id="vo6" en="So it ships, with a release note that tells tablet users the workaround, and a proper fix next week."/>
    <s id="vo7" en="Write the tree down once, and every release call takes a minute instead of a meeting."/>
  </strings>
  <defs>
    <!-- t-based reveal helper for the backdrop tree -->
    <fn id="rv" args="a,d">clamp((t - a)/d, 0, 1)</fn>
    <radial id="halo" x="0" y="0" r="60"><stop at="0" color="#ffffff" opacity="0.95"/><stop at="0.35" color="$dia" opacity="0.8"/><stop at="1" color="$dia" opacity="0"/></radial>
    <radial id="spot" x="540" y="960" r="700"><stop at="0" color="#000" opacity="0"/><stop at="0.35" color="#000" opacity="0.3"/><stop at="1" color="#000" opacity="0.8"/></radial>
    <symbol id="diamond"><path d="M 0 -95 L 230 0 L 0 95 L -230 0 Z" fill="$node" stroke="$dia" sw="4"/></symbol>
  </defs>
  <assets>
    <asset id="bed" src="audio/drone.ogg"/>
    <asset id="blip" src="audio/blip.ogg"/>
    <asset id="click" src="audio/click.ogg"/>
    <asset id="ding" src="audio/ding.ogg"/>
    <asset id="whoosh" src="audio/whoosh.ogg"/>
    <font family="Space Grotesk" src="fonts/SpaceGrotesk.ttf"/>
    <font family="JetBrains Mono" src="fonts/JetBrainsMono.ttf"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
  </assets>
  <music src="bed" loop="1" vol="0.6"/>

  <!-- blueprint grid + the tree, which draws on over the first scenes and then stays -->
  <backdrop>
    <line repeat="49" as="k" x1="=k*40" y1="0" x2="=k*40" y2="1080" stroke="$grid" sw="=k%5==0 ? 1.4 : 0.6" opacity="=k%5==0 ? 0.14 : 0.06"/>
    <line repeat="28" as="k" x1="0" y1="=k*40" x2="1920" y2="=k*40" stroke="$grid" sw="=k%5==0 ? 1.4 : 0.6" opacity="=k%5==0 ? 0.14 : 0.06"/>

    <!-- start node -->
    <group x="960" y="120" opacity="=rv(1, 0.6)" scale="=0.9 + 0.1*ease(rv(1, 0.6), 'back')">
      <rect x="-280" y="-42" w="560" h="84" r="42" fill="$node" stroke="$line" sw="4"/>
      <text size="30" weight="600" align="center" fill="$fg" text="@start"/>
    </group>

    <!-- start → D1 -->
    <path d="M 960 162 L 960 195" stroke="$line" sw="4" fill="none" draw="=rv(7.6, 0.4)"/>
    <!-- D1 -->
    <path x="960" y="290" d="M 0 -95 L 230 0 L 0 95 L -230 0 Z" fill="$node" stroke="$dia" sw="4" draw="=rv(8, 1)"/>
    <text x="960" y="290" size="29" weight="600" maxw="330" align="center" fill="$fg" text="@d1" opacity="=rv(8.8, 0.4)"/>
    <!-- D1 yes → BLOCK -->
    <path d="M 1190 290 L 1380 290" stroke="$yes" sw="4" fill="none" draw="=rv(11, 0.6)"/>
    <path x="1380" y="290" d="M -14 -9 L 0 0 L -14 9" stroke="$yes" sw="4" fill="none" opacity="=rv(11.5, 0.2)"/>
    <group x="1285" y="258" opacity="=rv(11.2, 0.3)"><rect x="-40" y="-18" w="80" h="36" r="18" fill="$yes"/><text size="20" weight="700" align="center" fill="#062b14" text="@yes" font="JetBrains Mono"/></group>
    <group x="1580" y="290" opacity="=rv(11.8, 0.4)">
      <rect x="-200" y="-48" w="400" h="96" r="18" fill="#3a1418" stroke="$no" sw="4"/>
      <text size="34" weight="700" align="center" fill="$no" text="@o1"/>
    </group>
    <!-- D1 no → D2 -->
    <path d="M 960 385 L 960 425" stroke="$no" sw="4" fill="none" draw="=rv(16.6, 0.4)"/>
    <group x="1010" y="405" opacity="=rv(16.6, 0.3)"><rect x="-34" y="-18" w="68" h="36" r="18" fill="$no"/><text size="20" weight="700" align="center" fill="#2b0606" text="@no" font="JetBrains Mono"/></group>
    <!-- D2 -->
    <path x="960" y="520" d="M 0 -95 L 230 0 L 0 95 L -230 0 Z" fill="$node" stroke="$dia" sw="4" draw="=rv(17, 1)"/>
    <text x="960" y="520" size="29" weight="600" maxw="330" align="center" fill="$fg" text="@d2" opacity="=rv(17.8, 0.4)"/>
    <!-- D2 no → ship next sprint -->
    <path d="M 730 520 L 560 520" stroke="$no" sw="4" fill="none" draw="=rv(20.5, 0.5)"/>
    <path x="560" y="520" d="M 14 -9 L 0 0 L 14 9" stroke="$no" sw="4" fill="none" opacity="=rv(21, 0.2)"/>
    <group x="645" y="488" opacity="=rv(20.6, 0.3)"><rect x="-34" y="-18" w="68" h="36" r="18" fill="$no"/><text size="20" weight="700" align="center" fill="#2b0606" text="@no" font="JetBrains Mono"/></group>
    <group x="350" y="520" opacity="=rv(21.2, 0.4)">
      <rect x="-210" y="-48" w="420" h="96" r="18" fill="#0f2e1e" stroke="$yes" sw="4"/>
      <text size="32" weight="700" align="center" fill="$yes" text="@o2"/>
    </group>
    <!-- D2 yes → D3 -->
    <path d="M 960 615 L 960 655" stroke="$yes" sw="4" fill="none" draw="=rv(25.6, 0.4)"/>
    <group x="1014" y="635" opacity="=rv(25.6, 0.3)"><rect x="-40" y="-18" w="80" h="36" r="18" fill="$yes"/><text size="20" weight="700" align="center" fill="#062b14" text="@yes" font="JetBrains Mono"/></group>
    <!-- D3 -->
    <path x="960" y="750" d="M 0 -95 L 230 0 L 0 95 L -230 0 Z" fill="$node" stroke="$dia" sw="4" draw="=rv(26, 1)"/>
    <text x="960" y="750" size="29" weight="600" maxw="330" align="center" fill="$fg" text="@d3" opacity="=rv(26.8, 0.4)"/>
    <!-- D3 yes → ship with note (left) -->
    <path d="M 730 750 L 540 750 L 540 905" stroke="$yes" sw="4" fill="none" draw="=rv(29.5, 0.7)"/>
    <path x="540" y="905" d="M -9 -14 L 0 0 L 9 -14" stroke="$yes" sw="4" fill="none" opacity="=rv(30.2, 0.2)"/>
    <group x="640" y="718" opacity="=rv(29.6, 0.3)"><rect x="-40" y="-18" w="80" h="36" r="18" fill="$yes"/><text size="20" weight="700" align="center" fill="#062b14" text="@yes" font="JetBrains Mono"/></group>
    <group x="540" y="960" opacity="=rv(30.3, 0.4)">
      <rect x="-220" y="-48" w="440" h="96" r="18" fill="#3a2a0e" stroke="$amber" sw="4"/>
      <text size="32" weight="700" align="center" fill="$amber" text="@o3"/>
    </group>
    <!-- D3 no → hotfix (right) -->
    <path d="M 1190 750 L 1380 750 L 1380 905" stroke="$no" sw="4" fill="none" draw="=rv(31.5, 0.7)"/>
    <path x="1380" y="905" d="M -9 -14 L 0 0 L 9 -14" stroke="$no" sw="4" fill="none" opacity="=rv(32.2, 0.2)"/>
    <group x="1280" y="718" opacity="=rv(31.6, 0.3)"><rect x="-34" y="-18" w="68" h="36" r="18" fill="$no"/><text size="20" weight="700" align="center" fill="#2b0606" text="@no" font="JetBrains Mono"/></group>
    <group x="1380" y="960" opacity="=rv(32.3, 0.4)">
      <rect x="-230" y="-48" w="460" h="96" r="18" fill="#3a1418" stroke="$no" sw="4"/>
      <text size="32" weight="700" align="center" fill="$no" text="@o4"/>
    </group>
  </backdrop>

  <timeline>
    <scene id="intro" dur="9.5" chapter="@ch1">
      <say at="0.4" text="@vo1"/>
      <sfx at="1" src="blip"/>
      <group x="960" y="560">
        <text y="-40" size="92" weight="700" align="center" fill="$fg" text="@title">
          <anim prop="reveal" from="0" to="1" dur="1.6" ease="linear"/>
        </text>
        <path x="-140" y="80" d="M 0 -60 L 140 0 L 0 60 L -140 0 Z" fill="none" stroke="$dia" sw="5" at="1.6" scale="0.8">
          <anim prop="draw" from="0" to="1" dur="1"/>
        </path>
        <text x="-140" y="80" size="54" weight="700" align="center" fill="$dia" text="?" at="2.4"><anim prop="opacity" from="0" to="1" dur="0.3"/></text>
        <line x1="-20" y1="80" x2="60" y2="80" stroke="$yes" sw="5" at="2.6"><anim prop="draw" from="0" to="1" dur="0.4"/></line>
        <circle x="110" y="80" r="26" fill="none" stroke="$yes" sw="5" at="3"><anim prop="opacity" from="0" to="1" dur="0.3"/></circle>
      </group>
    </scene>

    <scene id="d1" dur="9" chapter="@ch2">
      <say at="0.4" text="@vo2"/>
      <sfx at="1" src="click"/><sfx at="4" src="whoosh"/><sfx at="4.8" src="ding"/>
      <!-- emphasis ring on the active diamond -->
      <path x="960" y="290" d="M 0 -95 L 230 0 L 0 95 L -230 0 Z" fill="none" stroke="$dia" sw="10" opacity="=0.25 + 0.2*sin(T*4)" scale="1.08" blur="4"/>
    </scene>

    <scene id="d2" dur="9" chapter="@ch3">
      <say at="0.4" text="@vo3"/>
      <sfx at="1" src="click"/><sfx at="4.5" src="whoosh"/><sfx at="5.2" src="ding"/>
      <path x="960" y="520" d="M 0 -95 L 230 0 L 0 95 L -230 0 Z" fill="none" stroke="$dia" sw="10" opacity="=0.25 + 0.2*sin(T*4)" scale="1.08" blur="4"/>
    </scene>

    <scene id="d3" dur="10" chapter="@ch4">
      <say at="0.4" text="@vo4"/>
      <sfx at="1" src="click"/><sfx at="4.5" src="whoosh"/><sfx at="5.3" src="ding"/><sfx at="6.5" src="whoosh"/><sfx at="7.3" src="ding"/>
      <path x="960" y="750" d="M 0 -95 L 230 0 L 0 95 L -230 0 Z" fill="none" stroke="$dia" sw="10" opacity="=0.25 + 0.2*sin(T*4)" scale="1.08" blur="4"/>
    </scene>

    <!-- a real case: the token walks the tree -->
    <scene id="case" dur="12" chapter="@ch5">
      <say at="0.4" text="@vo5"/>
      <sfx at="1.4" src="whoosh"/><sfx at="3.2" src="blip"/><sfx at="5.6" src="blip"/><sfx at="8.2" src="blip"/><sfx at="10.3" src="ding"/>
      <!-- case card -->
      <group x="60" y="30">
        <anim prop="opacity" from="0" to="1" dur="0.5"/>
        <anim prop="x" from="-200" to="60" dur="0.6"/>
        <rect w="580" h="270" r="18" fill="#0e2034" stroke="$line" sw="2" shadow="0 16 40 #0009"/>
        <text x="30" y="46" size="24" weight="700" font="JetBrains Mono" fill="$dia" text="@caseK"/>
        <text x="30" y="104" size="28" weight="600" maxw="520" fill="$fg" text="@caseT"/>
        <text x="30" y="170" size="25" fill="=T > 3.2 ? $yes : $muted" text="@case1"/>
        <text x="30" y="205" size="25" fill="=T > 5.6 ? $yes : $muted" text="@case2"/>
        <text x="30" y="240" size="25" fill="=T > 8.2 ? $yes : $muted" text="@case3"/>
      </group>
      <!-- lit trail -->
      <path d="M 960 160 L 960 520 L 960 750 L 540 750 L 540 912" stroke="$dia" sw="12" fill="none" opacity="0.85" shadow="0 0 18 $dia">
        <keys prop="draw" ease="io" v="1.5:0; 3:0.11; 4.5:0.11; 5.5:0.306; 7:0.306; 8:0.502; 9:0.502; 9.6:0.86; 10.2:1"/>
      </path>
      <text x="960" y="290" size="29" weight="600" maxw="330" align="center" fill="$fg" stroke="$node" sw="10" text="@d1"/>
      <text x="960" y="520" size="29" weight="600" maxw="330" align="center" fill="$fg" stroke="$node" sw="10" text="@d2"/>
      <text x="960" y="750" size="29" weight="600" maxw="330" align="center" fill="$fg" stroke="$node" sw="10" text="@d3"/>
      <!-- token -->
      <group>
        <keys prop="x" ease="io" v="1.5:960; 9:960; 9.6:540"/>
        <keys prop="y" ease="io" v="1.5:160; 3:290; 4.5:290; 5.5:520; 7:520; 8:750; 9.6:750; 10.2:915"/>
        <anim prop="opacity" from="0" to="1" at="1.2" dur="0.3"/>
        <circle r="60" fill="url(#halo)" scale="=1 + 0.15*sin(T*6)"/>
        <circle r="18" fill="#fff"/>
      </group>
      <!-- answers pop next to each diamond -->
      <group x="1250" y="380" at="3.2"><anim prop="scale" from="0" to="1" dur="0.35" ease="back"/>
        <rect x="-60" y="-28" w="120" h="56" r="28" fill="$no"/><text size="30" weight="800" align="center" fill="#2b0606" font="JetBrains Mono" text="@no"/></group>
      <group x="1250" y="610" at="5.6"><anim prop="scale" from="0" to="1" dur="0.35" ease="back"/>
        <rect x="-60" y="-28" w="120" h="56" r="28" fill="$yes"/><text size="30" weight="800" align="center" fill="#062b14" font="JetBrains Mono" text="@yes"/></group>
      <group x="760" y="830" at="8.2"><anim prop="scale" from="0" to="1" dur="0.35" ease="back"/>
        <rect x="-60" y="-28" w="120" h="56" r="28" fill="$yes"/><text size="30" weight="800" align="center" fill="#062b14" font="JetBrains Mono" text="@yes"/></group>
    </scene>

    <!-- the outcome, spotlit -->
    <scene id="call" dur="8.5" chapter="@ch6">
      <say at="0.4" text="@vo6"/>
      <sfx at="0.8" src="ding"/>
      <rect w="1920" h="1080" fill="url(#spot)"><anim prop="opacity" from="0" to="1" dur="0.8"/></rect>
      <path d="M 960 160 L 960 520 L 960 750 L 540 750 L 540 912" stroke="$dia" sw="12" fill="none" opacity="0.85" shadow="0 0 18 $dia"/>
      <text x="960" y="290" size="29" weight="600" maxw="330" align="center" fill="$fg" opacity="0.5" stroke="$node" sw="10" text="@d1"/>
      <text x="960" y="520" size="29" weight="600" maxw="330" align="center" fill="$fg" opacity="0.5" stroke="$node" sw="10" text="@d2"/>
      <text x="960" y="750" size="29" weight="600" maxw="330" align="center" fill="$fg" opacity="0.5" stroke="$node" sw="10" text="@d3"/>
      <group x="540" y="960" scale="=1 + 0.1*ease(T/0.6,'back')">
        <rect x="-220" y="-48" w="440" h="96" r="18" fill="$amber" shadow="0 0 40 $amber"/>
        <text size="32" weight="800" align="center" fill="#2a1a00" text="@o3"/>
      </group>
      <!-- stamp -->
      <group x="1460" y="480" rot="-10" at="1.4">
        <anim prop="scale" from="2.2" to="1" dur="0.35" ease="out"/>
        <anim prop="opacity" from="0" to="1" dur="0.2"/>
        <rect x="-250" y="-80" w="500" h="160" r="14" fill="none" stroke="$amber" sw="10"/>
        <text y="-12" size="74" weight="700" align="center" fill="$amber" font="JetBrains Mono" text="@decided"/>
        <text y="48" size="26" align="center" fill="$amber" text="@dec2"/>
      </group>
    </scene>

    <scene id="outro" dur="7.5" chapter="@ch7">
      <say at="0.4" text="@vo7"/>
      <rect w="1920" h="1080" fill="#0b1726" opacity="0.82"><anim prop="opacity" from="0" to="0.82" dur="0.6"/></rect>
      <text x="960" y="470" size="96" weight="700" align="center" fill="$fg" text="@out1" at="0.4">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
      </text>
      <text x="960" y="610" size="64" weight="600" align="center" fill="$dia" text="@out2" at="1.4">
        <anim prop="reveal" from="0" to="1" dur="1.2" ease="linear"/>
      </text>
    </scene>
  </timeline>
  <voices>
    <voice say="vo1" lang="en" src="voice/flowchart-decision/en/vo1.d321aa68b3.ogg" dur="7.51" hash="d321aa68b3" engine="kokoro:bm_george"/>
    <voice say="vo2" lang="en" src="voice/flowchart-decision/en/vo2.a7e91c1c8d.ogg" dur="7.51" hash="a7e91c1c8d" engine="kokoro:bm_george"/>
    <voice say="vo3" lang="en" src="voice/flowchart-decision/en/vo3.17c34014e2.ogg" dur="5.91" hash="17c34014e2" engine="kokoro:bm_george"/>
    <voice say="vo4" lang="en" src="voice/flowchart-decision/en/vo4.d3969627e3.ogg" dur="8.21" hash="d3969627e3" engine="kokoro:bm_george"/>
    <voice say="vo5" lang="en" src="voice/flowchart-decision/en/vo5.a9b2258b6d.ogg" dur="9.71" hash="a9b2258b6d" engine="kokoro:bm_george"/>
    <voice say="vo6" lang="en" src="voice/flowchart-decision/en/vo6.4048d3c6ad.ogg" dur="6.61" hash="4048d3c6ad" engine="kokoro:bm_george"/>
    <voice say="vo7" lang="en" src="voice/flowchart-decision/en/vo7.b1e59d9557.ogg" dur="5.01" hash="b1e59d9557" engine="kokoro:bm_george"/>
  </voices>
</tsvg>
