          <anim prop="scale" from="1.8" to="1" dur="0.4" ease="out"/><anim prop="opacity" from="0" to="1" dur="0.2"/>
        </text>
        <group y="230" y.portrait="260" at="0.6" rot="-3">
          <anim prop="scale" from="0" to="1" dur="0.4" ease="back"/>
