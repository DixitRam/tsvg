        <text repeat="5" as="k" x="=(k-2)*170" y="420" y.portrait="560" font="Anton" size="110" align="center" fill="=k == 4 ? '#FFD23F' : '#ffffff66'" text="{5-k}" at="=1.2 + k*0.25">
          <anim prop="scale" from="2" to="1" dur="0.3" ease="out"/>
        </text>
      </group>
      <rect w="=W" h="=H" fill="#fff" opacity="=0.7*(1 - smooth(0, 0.18, T))"/>
    </scene>
