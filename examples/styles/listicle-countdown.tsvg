<?xml version="1.0" encoding="UTF-8"?>
<!-- Top-5 countdown listicle: big numbers 5 to 1, illustrated items, stat bars, a #1 reveal with confetti. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
    <layout id="portrait" w="1080" h="1920"/>
  </layouts>
  <options>
    <option id="lang" default="en"><choice id="en" label="English" tts="kokoro:am_michael"/></option>
    <option id="mix" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.3" sfx="0.6"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="main" bg="#0d1b3e" fg="#fff" muted="#ffffffaa" accent="#FFD23F"/></themes>
  <strings>
    <s id="title" en="5 ANIMALS THAT LIVE THE LONGEST"/>
    <s id="sub" en="#1 MIGHT NEVER DIE"/>
    <s id="drum" en="AND NUMBER ONE…"/>
    <s id="k_lives" en="LIVES UP TO"/>
    <s id="k_years" en="YEARS"/>
    <s id="k_maybe" en="FOREVER?"/>
    <s id="k_human" en="you (73)"/>
    <s id="k_550" en="550 yrs"/>
    <s id="out1" en="WHICH ONE SURPRISED YOU?"/>
    <s id="follow" en="FOLLOW FOR MORE"/>
    <s id="name_n5" en="Galápagos giant tortoise"/>
    <s id="fact_n5" en="Jonathan hatched around 1832 and still grazes on St Helena."/>
    <s id="name_n4" en="Bowhead whale"/>
    <s id="fact_n4" en="Old harpoon tips found in living whales date back to the 1800s."/>
    <s id="name_n3" en="Greenland shark"/>
    <s id="fact_n3" en="Eye-lens dating. It grows about one centimetre a year."/>
    <s id="name_n2" en="Ocean quahog clam"/>
    <s id="fact_n2" en="A clam nicknamed Ming had 507 growth rings, counted like a tree."/>
    <s id="name_n1" en="Immortal jellyfish"/>
    <s id="fact_n1" en="Old or hurt, it turns back into a polyp and starts life again."/>
    <s id="vo_intro" en="Five animals that outlive everyone you know. Counting down to the one that may never die at all."/>
    <s id="vo_n5" en="Number five. The Galápagos giant tortoise. One named Jonathan hatched around eighteen thirty-two, and he is still munching grass today."/>
    <s id="vo_n4" en="Number four. The bowhead whale. Old harpoon tips found in living whales show that some pass two hundred years."/>
    <s id="vo_n3" en="Number three. The Greenland shark. Eye lens dating puts the oldest one at around four hundred years. It grows just one centimetre a year."/>
    <s id="vo_n2" en="Number two. The ocean quahog clam. One nicknamed Ming had five hundred and seven growth rings, counted like a tree."/>
    <s id="vo_n1" en="And number one. The immortal jellyfish. When it gets old or hurt, it turns back into a baby polyp, and starts its life all over again."/>
    <s id="vo_outro" en="Which one surprised you most? Follow for the next top five."/>
    <s id="ch_intro" en="Intro"/>
    <s id="ch_n5" en="#5 Galápagos giant tortoise"/>
    <s id="ch_n4" en="#4 Bowhead whale"/>
    <s id="ch_n3" en="#3 Greenland shark"/>
    <s id="ch_n2" en="#2 Ocean quahog clam"/>
    <s id="ch_n1" en="#1 Immortal jellyfish"/>
    <s id="ch_outro" en="Outro"/>
  </strings>
  <defs>
    <linear id="bg" x1="0" y1="0" x2="=W*0.3" y2="=H"><stop at="0" color="#0d1b3e"/><stop at="1" color="#155e75"/></linear>
    <linear id="bar" x1="0" y1="0" x2="800" y2="0"><stop at="0" color="#FFD23F"/><stop at="1" color="#FF5A5F"/></linear>
    <linear id="gold" x1="-170" y1="-170" x2="170" y2="170"><stop at="0" color="#fff3b0"/><stop at="0.5" color="#FFD23F"/><stop at="1" color="#ff9f1c"/></linear>
    <radial id="spot" x="=W/2" y="=H/2" r="440"><stop at="0" color="#fff" opacity="0.25"/><stop at="1" color="#fff" opacity="0"/></radial>
    <radial id="jelly" x="0" y="-60" r="170"><stop at="0" color="#fff0f7"/><stop at="1" color="#ff7ab8" opacity="0.85"/></radial>
    <radial id="pool_n5" x="0" y="-80" r="340"><stop at="0" color="#a5d6a7"/><stop at="1" color="#2e7d32"/></radial>
    <radial id="pool_n4" x="0" y="-80" r="340"><stop at="0" color="#7fb3e6"/><stop at="1" color="#1e3a5f"/></radial>
    <radial id="pool_n3" x="0" y="-80" r="340"><stop at="0" color="#b0bec5"/><stop at="1" color="#37474f"/></radial>
    <radial id="pool_n2" x="0" y="-80" r="340"><stop at="0" color="#ffe0b2"/><stop at="1" color="#8d6e63"/></radial>
    <radial id="pool_n1" x="0" y="-80" r="340"><stop at="0" color="#f8bbd0"/><stop at="1" color="#ad1457"/></radial>
    <clip id="porthole"><circle r="292"/></clip>
    <data id="confetti" v="#FFD23F, #FF5A5F, #4ECDC4, #ffffff, #A78BFA, #7CFF6B"/>
    <data id="pool" v="#2e7d32, #1e3a5f, #37474f, #8d6e63, #ad1457"/>
    <data id="short" v="Tortoise, Whale, Shark, Clam, Jellyfish"/>
  </defs>
  <assets>
    <asset id="bright" src="audio/bright.m4a"/><asset id="whoosh" src="audio/whoosh.m4a"/><asset id="ding" src="audio/ding.m4a"/><asset id="pop" src="audio/pop.m4a"/>
    <font family="Anton" src="fonts/Anton.ttf"/><font family="Inter" src="fonts/Inter.ttf"/>
  </assets>
  <music src="bright" loop="1" vol="0.8"/>
  <timeline>
    <scene id="intro" dur="8.01" chapter="@ch_intro">
