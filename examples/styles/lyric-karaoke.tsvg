  <assets>
    <asset id="pad" src="audio/pad.m4a"/>
    <font family="Playfair Display" src="fonts/PlayfairDisplay.ttf"/><font family="Inter" src="fonts/Inter.ttf"/>
  </assets>
  <music src="pad" loop="1" vol="1"/>
  <backdrop>
    <group scale="=1 + 0.06*t/dur" x="=W/2*(-0.06*t/dur)" y="=H/2*(-0.06*t/dur)">
      <rect w="=W" h="=H*0.72 + 2" fill="url(#sky)"/>
      <circle repeat="90" as="k" x="=W*rand(k)" y="=H*0.68*rand(k+101)^1.4" r="=1 + 2.2*rand(k+7)" fill="#fff" opacity="=0.25 + 0.75*noise(t*0.9 + k*3)"/>
      <group x="=W*0.78" y="=H*0.17" x.portrait="=W*0.72" y.portrait="=H*0.13">
        <circle r="260" fill="url(#moonGlow)"/>
        <circle r="62" fill="#fff6e2"/>
        <circle x="-18" y="-10" r="12" fill="#efe4c8"/><circle x="20" y="18" r="8" fill="#efe4c8"/>
      </group>
      <rect y="=H*0.72" w="=W" h="=H*0.28" fill="url(#sea)"/>
      <!-- moon path on the water -->
      <rect repeat="22" as="k" x="=(portrait ? W*0.72 : W*0.78) - (20 + 70*rand(k))/2 + 30*sin(t*0.8 + k)" y="=H*0.735 + k*(portrait ? 24 : 13)" w="=20 + 70*rand(k)*(1 + k*0.05)" h="3" r="2" fill="#fff3d6" opacity="=(0.15 + 0.5*noise(t*2 + k))*(1 - k/26)"/>
      <!-- wave shimmer rows -->
      <group repeat="9" as="r">
        <rect repeat="14" as="c" x="=fract(c/14 + t*0.012*(1 + r*0.2) + rand(r))*W*1.1 - 60" y="=H*0.745 + r*r*(portrait ? 6.5 : 3.6)" w="=40 + 6*r" h="2" r="1" fill="#9fb3ff" opacity="=0.08 + 0.2*noise(t + c + r*7)"/>
      </group>
      <!-- lighthouse with sweeping beam -->
      <group x="=W*0.13" y="=H*0.72" x.portrait="=W*0.16">
        <path y="-262" d="M 0 0 L 1500 -150 L 1500 150 Z" fill="url(#beam)" blur="10" rot="=-8 + 22*sin(t*0.5)" opacity="=0.35 + 0.3*max(0, sin(t*0.5))"/>
        <path d="M -150 30 C -110 -40 110 -40 170 30 Z" fill="#05060f"/>
        <path d="M -44 0 L -30 -230 L 30 -230 L 44 0 Z" fill="#0b0d1c"/>
        <path d="M -38 -60 L -36 -90 L 36 -90 L 38 -60 Z M -34 -150 L -33 -180 L 33 -180 L 34 -150 Z" fill="#3a1f2c"/>
        <rect x="-38" y="-238" w="76" h="10" fill="#0b0d1c"/>
        <rect x="-22" y="-282" w="44" h="44" fill="#ffe6a6" shadow="0 0 40 #ffd27a"/>
        <path d="M -30 -282 L 0 -312 L 30 -282 Z" fill="#0b0d1c"/>
      </group>
      <circle repeat="26" as="k" x="=W*rand(k+300) + 40*sin(t*0.3 + k)" y="=H - fract(t*0.03*(0.5 + rand(k)) + rand(k+9))*H*1.1" r="=2 + 5*rand(k+4)" fill="#ffd27a" blur="2" opacity="=0.25*rand(k+2)"/>
    </group>
    <rect w="=W" h="=H" fill="url(#vig)"/>
    <text x="=W/2" y="80" y.portrait="140" size="26" weight="600" align="center" fill="#ffffffaa" text="@hdr"/>
    <rect x="=W/2 - 40" y="106" y.portrait="166" w="80" h="2" fill="#ffd27a88"/>
  </backdrop>
  <timeline>
    <scene id="title" dur="4.5" chapter="@ch_title">
      <say at="0.4" text="@vo_title"/>
      <group x="=W/2" y="=portrait ? 760 : 440" opacity="=min(1, T/0.8, (sdur - T)/0.6)">
        <text font="Playfair Display" weight="700" size="130" size.portrait="110" align="center" fill="url(#gold)" shadow="0 0 40 #ffb84d66" text="@ptitle">
          <anim prop="scale" from="0.94" to="1" dur="2.5" ease="out"/>
        </text>
        <line x1="-120" x2="120" y1="110" y2="110" stroke="#ffd27a" sw="3"><anim prop="draw" from="0" to="1" at="0.8" dur="1.2" ease="io"/></line>
        <text y="180" size="40" weight="400" font="Playfair Display" italic="1" align="center" fill="#ffffffcc" text="@psub" at="1"><anim prop="opacity" from="0" to="1" dur="0.8"/></text>
      </group>
    </scene>
    <scene id="s1" dur="5.19" chapter="@ch_s1">
      <say at="0.4" text="@vo_s1"/>

      <group x="=W/2" y="=(portrait ? 800 : 470) + 0 - 165*ease((T - 2.00)/0.55, 'io')" scale="=(1 - 0.38*ease((T - 2.00)/0.55, 'io'))*(portrait ? 0.731 : 1)" opacity="=min(1, T/0.5) - 0.55*ease((T - 2.00)/0.55, 'io')">
        <text font="Playfair Display" weight="700" size="80" align="center" fill="#ffffff8c" shadow="0 4 24 #000c" text="The lighthouse keeps a quiet watch"/>
        <group mask="url(#sw_s1_0)"><text font="Playfair Display" weight="700" size="80" align="center" fill="url(#gold)" shadow="0 0 22 #ffb84d88" text="The lighthouse keeps a quiet watch"/></group>
      </group>
      <group x="=W/2" y="=(portrait ? 800 : 470) + 150 - 150*ease((T - 2.00)/0.55, 'io')" scale="=(0.62 + 0.38*ease((T - 2.00)/0.55, 'io'))*(portrait ? 1.000 : 1)" opacity="=min(1, T/0.5)*(0.5 + 0.5*ease((T - 2.00)/0.55, 'io'))">
        <text font="Playfair Display" weight="700" size="80" align="center" fill="#ffffff8c" shadow="0 4 24 #000c" text="above the restless sea;"/>
        <group mask="url(#sw_s1_1)"><text font="Playfair Display" weight="700" size="80" align="center" fill="url(#gold)" shadow="0 0 22 #ffb84d88" text="above the restless sea;"/></group>
      </group>
      <group x="=W/2" y="=(portrait ? 800 : 470) + 150" scale="=(0.62)*(portrait ? 0.732 : 1)" opacity="=0.5*ease((T - 2.00)/0.55, 'io')">
        <text font="Playfair Display" weight="700" size="80" align="center" fill="#ffffff8c" shadow="0 4 24 #000c" text="it does not chase the ships at night,"/>

      </group>
    </scene>
    <scene id="s2" dur="5.71" chapter="@ch_s2">
      <say at="0.4" text="@vo_s2"/>
      <group x="=W/2" y="=(portrait ? 800 : 470) - 165 - 60*ease(T/0.6,'io')" scale="=(0.62)*(portrait ? 1.000 : 1)" opacity="=0.45*(1 - clamp(T/0.6, 0, 1))">
        <text font="Playfair Display" weight="700" size="80" align="center" fill="#ffffff8c" shadow="0 4 24 #000c" text="above the restless sea;"/>

      </group>
      <group x="=W/2" y="=(portrait ? 800 : 470) + 130*(1 - ease(T/0.5,'io')) - 165*ease((T - 2.36)/0.55, 'io')" scale="=(lerp(0.62, 1, ease(T/0.5,'io')) - 0.38*ease((T - 2.36)/0.55, 'io'))*(portrait ? 0.732 : 1)" opacity="=lerp(0.5, 1, ease(T/0.5,'io')) - 0.55*ease((T - 2.36)/0.55, 'io')">
        <text font="Playfair Display" weight="700" size="80" align="center" fill="#ffffff8c" shadow="0 4 24 #000c" text="it does not chase the ships at night,"/>
