<?xml version="1.0" encoding="UTF-8"?>
<!-- Lyric / karaoke video: a spoken poem, gold sweep across the current line (mask with keyed width),
     next line previewed, atmospheric night-sea backdrop with a lighthouse beam. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
    <layout id="portrait" w="1080" h="1920"/>
  </layouts>
  <options>
    <option id="lang" default="en"><choice id="en" label="English" tts="kokoro:bf_emma"/></option>
    <option id="mix" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/><choice id="music" label="Music only"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.4" sfx="0.5"/><mix id="speech" voice="1" music="0" sfx="0"/><mix id="music" voice="0" music="0.8" sfx="0.5"/></mixes>
  <themes><theme id="night" bg="#070b1d" fg="#ffffff" muted="#ffffff99" accent="#ffd27a"/></themes>
  <strings>
    <s id="title" en="The Lighthouse (a spoken poem)"/>
    <s id="ptitle" en="The Lighthouse"/>
    <s id="psub" en="a short poem, read aloud"/>
    <s id="otitle" en="Leave the light on"/>
    <s id="osub" en="thank you for listening"/>
    <s id="hdr" en="THE LIGHTHOUSE"/>
    <s id="vo_title" en="The Lighthouse. A short poem."/>
    <s id="vo_s1" en="The lighthouse keeps a quiet watch above the restless sea;"/>
    <s id="vo_s2" en="it does not chase the ships at night, it simply lets them see."/>
    <s id="vo_s3" en="The keeper climbs the winding stair with oil and cloth and light,"/>
    <s id="vo_s4" en="and every wave that breaks below is answered through the night."/>
    <s id="vo_s5" en="No captain ever knew her face, no sailor learned her name,"/>
    <s id="vo_s6" en="yet every boat that found the shore was guided by her flame."/>
    <s id="vo_s7" en="So when the dark is all you see and every star is gone,"/>
    <s id="vo_s8" en="be someone’s quiet lighthouse, and leave the light on."/>
    <s id="vo_outro" en="Thank you for listening. Leave a light on for someone tonight."/>
    <s id="ch_title" en="Title"/>
    <s id="ch_s1" en="Verse 1"/>
    <s id="ch_s2" en="Verse 2"/>
    <s id="ch_s3" en="Verse 3"/>
    <s id="ch_s4" en="Verse 4"/>
    <s id="ch_s5" en="Verse 5"/>
    <s id="ch_s6" en="Verse 6"/>
    <s id="ch_s7" en="Verse 7"/>
    <s id="ch_s8" en="Verse 8"/>
    <s id="ch_outro" en="Outro"/>
  </strings>
  <defs>
    <linear id="gold" x1="-500" y1="0" x2="500" y2="0"><stop at="0" color="#ffe3a3"/><stop at="0.5" color="#ffc861"/><stop at="1" color="#ffe9b8"/></linear>
    <linear id="soft" x1="0" y1="0" x2="40" y2="0"><stop at="0" color="#000"/><stop at="1" color="#000" opacity="0"/></linear>
    <linear id="sky" x1="0" y1="0" x2="0" y2="=H*0.72"><stop at="0" color="#060a1c"/><stop at="0.6" color="#1b1f4a"/><stop at="1" color="#5a3f6e"/></linear>
