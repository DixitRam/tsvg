<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: sports tactics board. A vector pitch, player dots moving along paths, pass arrows drawing on, zones highlighted, a camera that zooms into the action. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:am_adam"/></option>
    <option id="mix" label="Audio" default="full">
      <choice id="full" label="Full"/><choice id="speech" label="Speech only"/>
    </option>
    <option id="theme" label="Theme" default="pitch"><choice id="pitch" label="Pitch"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.25" sfx="0.7"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
  </mixes>
  <themes>
    <theme id="pitch" bg="#0d2416" fg="#ffffff" muted="#b9d3c0" grass="#2f7d3f" grass2="#2a7139" chalk="#f4f7f2" us="#2f7bff" them="#ff4848" ball="#ffffff" zone="#ffe14d" panel="#0b1d12"/>
  </themes>
  <strings>
    <s id="title" en="The Overlap"/>
    <s id="sub" en="Beating a full-back two against one"/>
    <s id="kick" en="TACTICS BOARD"/>
    <s id="ch1" en="The overlap"/><s id="ch2" en="Set-up"/><s id="ch3" en="The run"/><s id="ch4" en="2 v 1"/><s id="ch5" en="The pass"/><s id="ch6" en="Cut-back"/><s id="ch7" en="Recap"/>
    <s id="p2h" en="SET-UP"/><s id="p2" en="Blue attacks left to right. The winger (7) holds the touchline."/>
    <s id="p3h" en="THE RUN"/><s id="p3" en="Right-back (2) sprints round the outside of the winger."/>
    <s id="p4h" en="2 v 1"/><s id="p4" en="One defender, two attackers. Whoever he picks, the other is free."/>
    <s id="p5h" en="THE PASS"/><s id="p5" en="Slip the ball into the runner's path, not to his feet."/>
    <s id="p6h" en="CUT-BACK"/><s id="p6" en="Pull it back to the penalty spot as the striker (9) arrives."/>
    <s id="zone1" en="2 v 1"/><s id="zone2" en="cut-back zone"/>
    <s id="goal" en="GOAL!"/>
    <s id="recapH" en="THE OVERLAP IN 3"/>
    <s id="k1" en="Hold the width"/><s id="k2" en="Time the run"/><s id="k3" en="Pick the cut-back"/>
    <s id="vo1" en="The overlap: one of football's oldest tricks. Two attackers against one defender on the wing."/>
    <s id="vo2" en="We attack in blue, left to right. Our winger holds the touchline, and their full-back steps out to mark him."/>
    <s id="vo3" en="Now our right-back sprints past on the outside. The defender has to choose: stay with the winger, or follow the runner."/>
    <s id="vo4" en="That's the two-versus-one. Whichever player he picks, the other one is free."/>
    <s id="vo5" en="The winger slips the ball into the runner's path. He's free near the byline, with time to look up."/>
    <s id="vo6" en="The best ball now is the cut-back, pulled back to the penalty spot, where the striker arrives running onto it."/>
    <s id="vo7" en="So: hold the width, time the run, and pick the cut-back. Simple, and still hard to stop."/>
  </strings>
  <defs>
    <!-- camera: 0 = whole pitch, 1 = zoomed on the right flank -->
    <fn id="cam">ease(clamp((t - 17.5)/1.6, 0, 1), 'io') * (1 - ease(clamp((t - 54.3)/1.4, 0, 1), 'io'))</fn>
    <fn id="goalFlash">max(0, 1 - abs(t - 50.6)*1.2)</fn>
    <!-- formations (pitch units: 1050 × 680, blue attacks to the right) -->
    <data id="bx" v="60, 250, 250, 420, 480, 620, 640, 800"/>
    <data id="by" v="340, 250, 430, 120, 340, 240, 450, 110"/>
    <data id="rx" v="1030, 880, 900, 900, 720, 740, 720"/>
    <data id="ry" v="340, 130, 280, 410, 200, 340, 500"/>
    <radial id="vig" x="960" y="540" r="1150"><stop at="0.6" color="#000" opacity="0"/><stop at="1" color="#000" opacity="0.55"/></radial>
    <linear id="panelG" x1="0" y1="0" x2="0" y2="400"><stop at="0" color="#0b1d12" opacity="0.92"/><stop at="1" color="#0b1d12" opacity="0.82"/></linear>
    <symbol id="arrowHead"><path d="M -18 -11 L 0 0 L -18 11" stroke="$zone" sw="5" fill="none"/></symbol>
  </defs>
  <assets>
    <asset id="bed" src="audio/pulse.m4a"/>
    <asset id="whistle" src="audio/blip.m4a"/>
    <asset id="kick" src="audio/click.m4a"/>
    <asset id="whoosh" src="audio/whoosh.m4a"/>
    <asset id="ding" src="audio/ding.m4a"/>
    <asset id="pop" src="audio/pop.m4a"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <font family="Anton" src="fonts/Anton.ttf"/>
  </assets>
  <music src="bed" loop="1" vol="0.55"/>

  <backdrop>
    <group x="=lerp(225, -1087.5, cam())" y="=lerp(64, -515, cam())" scale="=lerp(1.4, 2.3, cam())">
      <!-- grass + stripes -->
      <rect x="-30" y="-30" w="1110" h="740" fill="$grass2"/>
      <rect repeat="7" as="k" x="=k*150" y="0" w="75" h="680" fill="$grass" opacity="0.9"/>
      <!-- chalk lines -->
      <group opacity="0.92">
        <rect x="0" y="0" w="1050" h="680" fill="none" stroke="$chalk" sw="3"/>
        <line x1="525" y1="0" x2="525" y2="680" stroke="$chalk" sw="3"/>
        <circle x="525" y="340" r="91.5" fill="none" stroke="$chalk" sw="3"/>
        <circle x="525" y="340" r="4" fill="$chalk"/>
        <rect x="0" y="138.5" w="165" h="403" fill="none" stroke="$chalk" sw="3"/>
        <rect x="885" y="138.5" w="165" h="403" fill="none" stroke="$chalk" sw="3"/>
        <rect x="0" y="248.5" w="55" h="183" fill="none" stroke="$chalk" sw="3"/>
        <rect x="995" y="248.5" w="55" h="183" fill="none" stroke="$chalk" sw="3"/>
        <circle x="110" y="340" r="4" fill="$chalk"/><circle x="940" y="340" r="4" fill="$chalk"/>
        <path d="M 165 266 A 91.5 91.5 0 0 1 165 414" stroke="$chalk" sw="3" fill="none"/>
        <path d="M 885 266 A 91.5 91.5 0 0 0 885 414" stroke="$chalk" sw="3" fill="none"/>
        <rect x="-24" y="303" w="24" h="74" fill="#ffffff22" stroke="$chalk" sw="3"/>
        <rect x="1050" y="303" w="24" h="74" fill="=mix('#ffffff22', $zone, goalFlash())" stroke="$chalk" sw="3"/>
      </group>

      <!-- zones -->
      <group when="=t > 26.8 &amp;&amp; t &lt; 44.5" opacity="=clamp((t - 26.8)*2, 0, 1)">
        <rect x="760" y="560" w="220" h="118" r="10" fill="$zone" opacity="=0.18 + 0.08*sin(t*4)"/>
        <rect x="760" y="560" w="220" h="118" r="10" fill="none" stroke="$zone" sw="3"/>
        <text x="870" y="540" size="34" font="Anton" align="center" fill="$zone" text="@zone1"/>
      </group>
      <group when="=t > 45.3 &amp;&amp; t &lt; 54" opacity="=clamp((t - 45.3)*2, 0, 1)">
        <rect x="880" y="270" w="110" h="150" r="10" fill="$zone" opacity="=0.18 + 0.08*sin(t*4)"/>
        <rect x="880" y="270" w="110" h="150" r="10" fill="none" stroke="$zone" sw="3"/>
        <text x="935" y="250" size="24" font="Anton" align="center" fill="$zone" text="@zone2"/>
      </group>

      <!-- run arrow for #2 (dashed: drawn as short segments along the curve) -->
      <path d="M 430 560 C 600 610, 760 680, 930 665" stroke="$us" sw="5" fill="none" opacity="0.35" when="=t > 18 &amp;&amp; t &lt; 44.5" draw="=clamp((t - 18.6)/1.2, 0, 1)"/>
      <path d="M 430 560 C 600 610, 760 680, 930 665" stroke="$chalk" sw="3" fill="none" when="=t > 18 &amp;&amp; t &lt; 44.5" draw="=clamp((t - 18.6)/1.2, 0, 1)"/>
      <use ref="arrowHead" x="930" y="665" rot="-3" when="=t > 19.8 &amp;&amp; t &lt; 44.5"/>
      <!-- pass arrow 7 → runner's path -->
      <line x1="830" y1="636" x2="1000" y2="655" stroke="$zone" sw="5" when="=t > 36 &amp;&amp; t &lt; 54" draw="=clamp((t - 36.2)/0.8, 0, 1)"/>
      <use ref="arrowHead" x="1000" y="655" rot="6" when="=t > 37 &amp;&amp; t &lt; 54"/>
      <!-- cut-back arrow -->
      <line x1="1010" y1="645" x2="945" y2="360" stroke="$zone" sw="5" when="=t > 46.8 &amp;&amp; t &lt; 54" draw="=clamp((t - 47)/0.8, 0, 1)"/>
      <use ref="arrowHead" x="945" y="360" rot="-103" when="=t > 47.8 &amp;&amp; t &lt; 54"/>
      <!-- striker's run -->
      <path d="M 820 330 C 870 330, 900 345, 930 352" stroke="$chalk" sw="3" fill="none" opacity="0.8" when="=t > 46.5 &amp;&amp; t &lt; 54" draw="=clamp((t - 46.8)/0.8, 0, 1)"/>

      <!-- defenders (red) -->
      <group repeat="7" as="d" x="=data('rx', d)" y="=data('ry', d)" opacity="=clamp((t - 9 - d*0.1)*3, 0, 1)">
        <circle r="15" fill="$them" stroke="#fff" sw="3" shadow="0 3 6 #0006"/>
      </group>
      <!-- their left-back, the man who has to choose -->
      <group opacity="=clamp((t - 9.6)*3, 0, 1)">
        <keys prop="x" ease="io" v="11.5:870; 13:842; 22.5:842; 24.5:866; 38:866; 40:930; 47:930; 49:960"/>
        <keys prop="y" ease="io" v="11.5:590; 13:612; 22.5:612; 24.5:630; 38:630; 40:640; 47:640; 49:600"/>
        <circle r="34" fill="none" stroke="$them" sw="3" opacity="=t > 22 &amp;&amp; t &lt; 35 ? 0.5 + 0.4*sin(t*6) : 0"/>
        <circle r="15" fill="$them" stroke="#fff" sw="3" shadow="0 3 6 #0006"/>
      </group>

      <!-- attackers (blue) -->
      <group repeat="8" as="b" x="=data('bx', b)" y="=data('by', b)" opacity="=clamp((t - 8 - b*0.1)*3, 0, 1)">
        <circle r="15" fill="$us" stroke="#fff" sw="3" shadow="0 3 6 #0006"/>
      </group>
      <!-- 7: winger -->
      <group x="820" opacity="=clamp((t - 8.9)*3, 0, 1)">
        <keys prop="y" ease="io" v="9:640; 38:640; 40:620"/>
        <circle r="17" fill="$us" stroke="#fff" sw="3" shadow="0 3 6 #0006"/>
        <text size="16" weight="800" align="center" fill="#fff" text="7"/>
      </group>
      <!-- 9: striker -->
      <group opacity="=clamp((t - 9)*3, 0, 1)">
        <keys prop="x" ease="io" v="46.8:820; 49.3:932"/>
        <keys prop="y" ease="io" v="46.8:330; 49.3:352"/>
        <circle r="17" fill="$us" stroke="#fff" sw="3" shadow="0 3 6 #0006"/>
        <text size="16" weight="800" align="center" fill="#fff" text="9"/>
      </group>
      <!-- 2: overlapping right-back -->
      <group opacity="=clamp((t - 9.1)*3, 0, 1)">
        <keys prop="x" ease="linear" v="20:430; 21.2:560; 22.4:700; 23.6:840; 24.6:930; 38:930; 39.6:990; 40.6:1010"/>
        <keys prop="y" ease="linear" v="20:560; 21.2:603; 22.4:645; 23.6:670; 24.6:665; 38:665; 39.6:655; 40.6:648"/>
        <circle r="24" fill="$us" opacity="=t > 20 &amp;&amp; t &lt; 24.6 ? 0.35 : 0" blur="6"/>
        <circle r="17" fill="$us" stroke="#fff" sw="3" shadow="0 3 6 #0006"/>
        <text size="16" weight="800" align="center" fill="#fff" text="2"/>
      </group>
      <!-- ball -->
      <group opacity="=clamp((t - 9.5)*3, 0, 1)">
        <keys prop="x" ease="linear" v="9:836; 37.6:836; 39.6:1000; 40.6:1022; 47:1022; 48.3:946; 49.4:946; 50.1:1062"/>
        <keys prop="y" ease="linear" v="9:650; 37.6:650; 39.6:655; 40.6:660; 47:660; 48.3:362; 49.4:362; 50.1:326"/>
        <circle r="8" fill="$ball" stroke="#111" sw="2" shadow="0 2 4 #0008"/>
      </group>
    </group>
    <rect w="1920" h="1080" fill="url(#vig)"/>
  </backdrop>

  <timeline>
    <!-- 1 · title over the empty board -->
    <scene id="intro" dur="7.5" chapter="@ch1">
      <say at="0.4" text="@vo1"/>
      <sfx at="0.3" src="whistle"/>
      <rect w="1920" h="1080" fill="#000" opacity="0.45"/>
      <group x="960" y="470">
        <rect x="-150" y="-180" w="300" h="50" r="8" fill="$zone"><anim prop="opacity" from="0" to="1" dur="0.4"/></rect>
        <text y="-155" size="26" weight="800" align="center" fill="#0b1d12" text="@kick"/>
        <text y="0" size="190" font="Anton" align="center" fill="#fff" text="@title" shadow="0 10 30 #000a">
          <anim prop="scale" from="1.3" to="1" dur="0.6" ease="out"/>
          <anim prop="opacity" from="0" to="1" dur="0.4"/>
        </text>
        <text y="150" size="44" weight="600" align="center" fill="$muted" text="@sub" at="0.8"><anim prop="opacity" from="0" to="1" dur="0.5"/></text>
        <!-- mini chalk diagram -->
        <group y="270" at="1.6">
          <circle x="-120" r="16" fill="$us" stroke="#fff" sw="3"/>
          <circle x="0" y="-10" r="16" fill="$them" stroke="#fff" sw="3"/>
          <circle x="-60" y="40" r="16" fill="$us" stroke="#fff" sw="3"/>
          <path d="M -60 40 C 0 70, 80 60, 130 30" stroke="#fff" sw="4" fill="none"><anim prop="draw" from="0" to="1" at="0.3" dur="1"/></path>
        </group>
      </group>
    </scene>

    <!-- 2 · set-up (whole pitch) -->
    <scene id="setup" dur="9.5" chapter="@ch2">
      <say at="0.4" text="@vo2"/>
      <sfx at="0.5" src="pop"/><sfx at="1.5" src="pop"/>
      <group x="40" y="40" at="0.6">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <rect w="560" h="150" r="16" fill="url(#panelG)"/>
        <rect w="8" h="150" r="4" fill="$zone"/>
        <text x="32" y="40" size="30" font="Anton" fill="$zone" text="@p2h"/>
        <text x="32" y="98" size="26" maxw="500" lh="1.3" fill="#fff" text="@p2"/>
      </group>
      <!-- attack direction -->
      <group x="960" y="1050" at="1">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <line x1="-120" y1="0" x2="120" y2="0" stroke="$us" sw="6"/>
        <path x="120" d="M -18 -12 L 0 0 L -18 12" stroke="$us" sw="6" fill="none"/>
      </group>
    </scene>

    <!-- coach notes panel on the right while zoomed -->
    <scene id="run" dur="9.5" chapter="@ch3">
      <say at="0.4" text="@vo3"/>
      <sfx at="2.8" src="whoosh"/>
      <group x="1360" y="120" at="1.6">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <anim prop="x" from="1420" to="1360" dur="0.5"/>
        <rect w="500" h="300" r="18" fill="url(#panelG)" shadow="0 20 40 #0007"/>
        <rect w="8" h="300" r="4" fill="$zone"/>
        <text x="36" y="54" size="40" font="Anton" fill="$zone" text="@p3h"/>
        <text x="36" y="150" size="32" maxw="430" lh="1.35" fill="#fff" text="@p3"/>
      </group>
    </scene>

    <scene id="twovone" dur="8.5" chapter="@ch4">
      <say at="0.4" text="@vo4"/>
      <sfx at="0.4" src="ding"/>
      <group x="1360" y="120">
        <rect w="500" h="300" r="18" fill="url(#panelG)" shadow="0 20 40 #0007"/>
        <rect w="8" h="300" r="4" fill="$zone"/>
        <text x="36" y="54" size="40" font="Anton" fill="$zone" text="@p4h"/>
        <text x="36" y="150" size="32" maxw="430" lh="1.35" fill="#fff" text="@p4"/>
      </group>
      <!-- big 2 v 1 tally -->
      <group x="1610" y="640" at="1">
        <anim prop="scale" from="0.6" to="1" dur="0.4" ease="back"/>
        <anim prop="opacity" from="0" to="1" dur="0.3"/>
        <circle x="-160" r="46" fill="$us" stroke="#fff" sw="5"/>
        <circle x="-55" r="46" fill="$us" stroke="#fff" sw="5"/>
        <text x="40" y="0" size="64" font="Anton" align="center" fill="#fff" text="v"/>
        <circle x="140" r="46" fill="$them" stroke="#fff" sw="5"/>
      </group>
    </scene>

    <scene id="pass" dur="9.5" chapter="@ch5">
      <say at="0.4" text="@vo5"/>
      <sfx at="2.6" src="kick"/><sfx at="4.6" src="pop"/>
      <group x="1360" y="120">
        <rect w="500" h="300" r="18" fill="url(#panelG)" shadow="0 20 40 #0007"/>
        <rect w="8" h="300" r="4" fill="$zone"/>
        <text x="36" y="54" size="40" font="Anton" fill="$zone" text="@p5h"/>
        <text x="36" y="150" size="32" maxw="430" lh="1.35" fill="#fff" text="@p5"/>
      </group>
    </scene>

    <scene id="cutback" dur="9.5" chapter="@ch6">
      <say at="0.4" text="@vo6"/>
      <sfx at="2.5" src="kick"/><sfx at="4.9" src="kick"/><sfx at="5.6" src="ding"/><sfx at="5.7" src="whistle"/>
      <group x="1360" y="120">
        <rect w="500" h="300" r="18" fill="url(#panelG)" shadow="0 20 40 #0007"/>
        <rect w="8" h="300" r="4" fill="$zone"/>
        <text x="36" y="54" size="40" font="Anton" fill="$zone" text="@p6h"/>
        <text x="36" y="150" size="32" maxw="430" lh="1.35" fill="#fff" text="@p6"/>
      </group>
      <!-- goal flash -->
      <text x="1610" y="700" size="150" font="Anton" align="center" fill="$zone" text="@goal" rot="-6" at="5.6" shadow="0 0 40 $zone">
        <anim prop="scale" from="2" to="1" dur="0.35" ease="out"/>
        <anim prop="opacity" from="0" to="1" dur="0.2"/>
      </text>
    </scene>

    <scene id="recap" dur="7.5" chapter="@ch7">
      <say at="0.4" text="@vo7"/>
      <rect w="1920" h="1080" fill="#000" opacity="=0.55*clamp((T - 1.2)*2, 0, 1)"/>
      <group x="960" y="300" at="1.4">
        <anim prop="opacity" from="0" to="1" dur="0.4"/>
        <text size="44" font="Anton" align="center" fill="$zone" text="@recapH"/>
      </group>
      <group repeat="3" as="k" x="560" y="=430 + k*150" at="=1.8 + k*0.7">
        <anim prop="opacity" from="0" to="1" dur="0.3"/>
        <anim prop="x" from="500" to="560" dur="0.4"/>
        <rect w="800" h="120" r="18" fill="url(#panelG)"/>
        <circle x="70" y="60" r="38" fill="$us" stroke="#fff" sw="4"/>
        <text x="70" y="60" size="40" font="Anton" align="center" fill="#fff" text="{k+1}"/>
        <text x="140" y="60" size="56" font="Anton" fill="#fff" text="@k1" when="=k==0"/>
        <text x="140" y="60" size="56" font="Anton" fill="#fff" text="@k2" when="=k==1"/>
        <text x="140" y="60" size="56" font="Anton" fill="#fff" text="@k3" when="=k==2"/>
      </group>
    </scene>
  </timeline>
  <voices>
    <voice say="vo1" lang="en" src="voice/sports-tactics/en/vo1.a0b49f5a30.m4a" dur="5.51" hash="a0b49f5a30" engine="kokoro:am_adam"/>
    <voice say="vo2" lang="en" src="voice/sports-tactics/en/vo2.597d6b60e6.m4a" dur="5.71" hash="597d6b60e6" engine="kokoro:am_adam"/>
    <voice say="vo3" lang="en" src="voice/sports-tactics/en/vo3.1c4fbd546f.m4a" dur="6.71" hash="1c4fbd546f" engine="kokoro:am_adam"/>
    <voice say="vo4" lang="en" src="voice/sports-tactics/en/vo4.4575a8ea30.m4a" dur="3.91" hash="4575a8ea30" engine="kokoro:am_adam"/>
    <voice say="vo5" lang="en" src="voice/sports-tactics/en/vo5.c17a9c6e30.m4a" dur="5.01" hash="c17a9c6e30" engine="kokoro:am_adam"/>
    <voice say="vo6" lang="en" src="voice/sports-tactics/en/vo6.0ff52171cd.m4a" dur="6.01" hash="0ff52171cd" engine="kokoro:am_adam"/>
    <voice say="vo7" lang="en" src="voice/sports-tactics/en/vo7.3fad4e6560.m4a" dur="4.71" hash="3fad4e6560" engine="kokoro:am_adam"/>
  </voices>
</tsvg>
