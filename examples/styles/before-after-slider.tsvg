<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: before/after slider. Two states of the same scene; a vertical handle sweeps a clip between them. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:af_heart"/></option>
    <option id="mix" label="Audio" default="full">
      <choice id="full" label="Full"/><choice id="speech" label="Speech only"/>
    </option>
    <option id="theme" label="Theme" default="studio"><choice id="studio" label="Studio"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.3" sfx="0.6"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
  </mixes>
  <themes>
    <theme id="studio" bg="#14161b" fg="#f2f4f8" muted="#8b93a3" panel="#1d2027" bad="#ff5d5d" good="#3ddc97" handle="#ffffff" accent="#6d8cff"/>
  </themes>
  <strings>
    <s id="title" en="Before / After: the Settings page"/>
    <s id="kick" en="REDESIGN"/>
    <s id="t1" en="Before"/><s id="t2" en="After"/>
    <s id="sub" en="How we redesigned a cluttered settings page"/>
    <s id="BEFORE" en="BEFORE"/><s id="AFTER" en="AFTER"/>
    <s id="ch1" en="Intro"/><s id="ch2" en="Where we started"/><s id="ch3" en="The sweep"/><s id="ch4" en="Up close"/><s id="ch5" en="Results"/><s id="ch6" en="Photos too"/><s id="ch7" en="Outro"/>
    <s id="c1" en="14 toolbar buttons"/><s id="c2" en="5 font sizes"/><s id="c3" en="3 banners at once"/>
    <s id="settings" en="Settings"/>
    <s id="settingsSub" en="Manage your account and notifications"/>
    <s id="account" en="Account"/><s id="notif" en="Notifications"/>
    <s id="name" en="Full name"/><s id="email" en="Email"/><s id="pw" en="Password"/>
    <s id="nameV" en="Asha Patel"/><s id="emailV" en="asha@example.com"/><s id="pwV" en="••••••••••"/>
    <s id="n1" en="Mentions and replies"/><s id="n2" en="Weekly summary"/><s id="n3" en="Product news"/>
    <s id="save" en="Save changes"/>
    <s id="change" en="Change"/>
    <s id="ban1" en="Your trial expires in 3 days! UPGRADE NOW"/>
    <s id="ban2" en="NEW: dark mode beta. Click here to learn more about dark mode"/>
    <s id="ban3" en="Tip: you can change your settings in Settings"/>
    <s id="m1" en="Time to change a password"/><s id="m2" en="Settings tickets / month"/><s id="m3" en="Clicks to save"/>
    <s id="m1b" en="48 s"/><s id="m1a" en="12 s"/><s id="m2b" en="120"/><s id="m2a" en="74"/><s id="m3b" en="5"/><s id="m3a" en="1"/>
    <s id="raw" en="RAW"/><s id="edit" en="EDITED"/>
    <s id="out1" en="Less on screen."/><s id="out2" en="Nothing lost."/>
    <s id="vo1" en="Before and after: how we redesigned a cluttered settings page, and why every change earned its place."/>
    <s id="vo2" en="Here's where we started. Fourteen toolbar buttons, five font sizes, three banners shouting at once, and no clear place to begin."/>
    <s id="vo3" en="Drag the line across. The after version keeps every setting, but groups them into two sections with one clear action."/>
    <s id="vo4" en="Up close, the form tells the story. Labels sit above their fields, the spacing doubles, and the inputs are easy to hit."/>
    <s id="vo5" en="And it paid off. Changing a password went from forty-eight seconds to twelve, and settings tickets dropped by more than a third."/>
    <s id="vo6" en="The same slider works for photos too. On the left, the raw hazy shot. On the right, the cleaned-up edit."/>
    <s id="vo7" en="Less on screen, but nothing lost. That's the before and after."/>
  </strings>
  <defs>
    <data id="btn" v="#e53935, #43a047, #1e88e5, #fdd835, #8e24aa, #fb8c00, #00acc1, #6d4c41, #c0ca33, #d81b60, #3949ab, #546e7a, #f4511e, #7cb342"/>
    <data id="side" v="Dashboard, Profile, Profile (advanced), Account, Billing, Billing history, Invoices, Security, 2FA, Sessions, API keys, Webhooks, Integrations, Labs, Notifications, Email prefs"/>
    <data id="sideA" v="Profile, Account, Notifications, Billing, Security"/>
    <data id="btnL" v="Save, Apply, Reset, Export, Import, Sync, Undo, Redo, Help, Share, Print, Copy, Clear, More"/>
    <data id="actL" v="Save, Save + close, Apply, Reset, Cancel, Export"/>
    <data id="fld" v="Full name, Email, Password, Phone, Language, Timezone, Username, Display name, Region"/>
    <data id="chk" v="Email me, Email me daily, Push, SMS, Desktop, Digest, Mentions, Replies, Likes, News"/>
    <!-- slider positions (screen x) per scene -->
    <fn id="s3">lerp(1680, 240, ease(clamp((T-1)/3.2, 0, 1), 'io')) + 720*ease(clamp((T-5)/1.6, 0, 1), 'io')</fn>
    <fn id="s4">lerp(1700, 220, ease(clamp((T-1.2)/3.6, 0, 1), 'io')) + 740*ease(clamp((T-5.4)/1.4, 0, 1), 'io')</fn>
    <fn id="s5">lerp(1680, 240, ease(clamp((T-1.6)/3.4, 0, 1), 'io'))</fn>
    <fn id="s6">960 + 520*sin(clamp(T-0.8, 0, 99)*0.9)*min(1, max(0, T-0.8))</fn>
    <fn id="s7">960 + 300*sin(T*1.1)</fn>
    <clip id="k3"><rect x="=s3()" y="0" w="2000" h="1080"/></clip>
    <clip id="k4"><rect x="=s4()" y="0" w="2000" h="1080"/></clip>
    <clip id="k5"><rect x="=s5()" y="0" w="2000" h="1080"/></clip>
    <clip id="k6"><rect x="=s6()" y="0" w="2000" h="1080"/></clip>
    <clip id="k7"><rect x="=s7()" y="0" w="2000" h="1080"/></clip>
    <clip id="win"><rect x="240" y="150" w="1440" h="820" r="18"/></clip>
    <clip id="photo"><rect x="160" y="140" w="1600" h="840" r="18"/></clip>
    <linear id="hazeG" x1="0" y1="140" x2="0" y2="980"><stop at="0" color="#d9e1e8" opacity="0.75"/><stop at="1" color="#aeb8c2" opacity="0.4"/></linear>
    <radial id="vign" x="960" y="560" r="1000"><stop at="0.55" color="#000" opacity="0"/><stop at="1" color="#000" opacity="0.45"/></radial>

    <!-- the cluttered page (window coords: 1440 × 820) -->
    <symbol id="before">
      <rect w="1440" h="820" r="18" fill="#eceff1"/>
      <rect w="1440" h="44" r="18" fill="#cfd8dc"/><rect y="26" w="1440" h="18" fill="#cfd8dc"/>
      <circle repeat="3" as="d" x="=26 + d*24" y="22" r="7" fill="=d==0 ? '#ff5f57' : d==1 ? '#febc2e' : '#28c840'"/>
      <!-- toolbar of 14 buttons -->
      <rect y="44" w="1440" h="56" fill="#b0bec5"/>
      <rect repeat="14" as="b" x="=12 + b*101" y="56" w="92" h="32" r="3" fill="=data('btn', b)"/>
      <text repeat="14" as="b" x="=58 + b*101" y="72" size="13" weight="700" align="center" fill="#fff" text="{data('btnL', b)}"/>
      <!-- sidebar with 16 items -->
      <rect y="100" w="240" h="720" fill="#dfe4e7"/>
      <text repeat="16" as="k" x="16" y="=124 + k*42" size="=k%3==0 ? 19 : k%3==1 ? 15 : 17" weight="=k%4==0 ? 800 : 400" fill="=k%5==0 ? '#c62828' : k%5==2 ? '#1565c0' : '#37474f'" text="{data('side', k)}"/>
      <!-- banners -->
      <rect x="256" y="112" w="1170" h="40" fill="#ffcdd2" stroke="#e53935" sw="2"/>
      <text x="270" y="132" size="17" weight="800" fill="#b71c1c" text="@ban1"/>
      <rect x="256" y="158" w="1170" h="36" fill="#fff59d" stroke="#fbc02d" sw="2"/>
      <text x="270" y="176" size="15" fill="#6d5d00" text="@ban2"/>
      <rect x="256" y="200" w="1170" h="34" fill="#bbdefb" stroke="#1e88e5" sw="2"/>
      <text x="270" y="217" size="14" italic="1" fill="#0d47a1" text="@ban3"/>
      <text x="260" y="262" size="22" weight="700" fill="#263238" text="@settings"/>
      <!-- cramped three-column form -->
      <group repeat="9" as="f" x="=260 + (f%3)*390" y="=292 + floor(f/3)*62">
        <text x="0" y="10" size="=12 + (f%3)*2" fill="#546e7a" text="{data('fld', f)}"/>
        <rect x="0" y="22" w="370" h="26" fill="#fff" stroke="#90a4ae" sw="1"/>
      </group>
      <!-- checkbox soup -->
      <group repeat="10" as="c" x="=260 + (c%5)*235" y="=500 + floor(c/5)*34">
        <rect w="16" h="16" fill="=c%3==0 ? '#1e88e5' : '#fff'" stroke="#607d8b" sw="1"/>
        <text x="24" y="8" size="15" fill="#37474f" text="{data('chk', c)}"/>
      </group>
      <text x="260" y="600" size="12" fill="#78909c" maxw="1150" lh="1.3" text="By changing settings you agree that changes may take up to 24 hours. Some settings are only available on some plans. Contact your administrator for advanced settings. See also: Profile (advanced), Labs, Email prefs."/>
      <!-- six buttons, no primary -->
      <rect repeat="6" as="b" x="=260 + b*190" y="680" w="176" h="44" r="4" fill="=data('btn', b + 3)"/>
      <text repeat="6" as="b" x="=348 + b*190" y="702" size="16" weight="700" align="center" fill="#fff" text="{data('actL', b)}"/>
    </symbol>

    <!-- the clean page -->
    <symbol id="after">
      <rect w="1440" h="820" r="18" fill="#ffffff"/>
      <rect w="1440" h="44" r="18" fill="#f3f4f6"/><rect y="26" w="1440" h="18" fill="#f3f4f6"/>
      <circle repeat="3" as="d" x="=26 + d*24" y="22" r="7" fill="=d==0 ? '#ff5f57' : d==1 ? '#febc2e' : '#28c840'"/>
      <rect y="44" w="280" h="776" fill="#f8f9fb"/>
      <circle x="44" y="96" r="18" fill="#6d8cff"/>
      <text x="74" y="96" size="22" weight="700" fill="#111827" text="Acme"/>
      <rect x="20" y="=150 + 2*58 - 22" w="240" h="46" r="12" fill="#e8edff"/>
      <group repeat="5" as="k" y="=150 + k*58">
        <rect x="40" y="-9" w="18" h="18" r="5" fill="=k==2 ? '#6d8cff' : '#c7ccd6'"/>
        <text x="74" y="0" size="22" weight="=k==2 ? 700 : 500" fill="=k==2 ? '#3451d1' : '#4b5563'" text="{data('sideA', k)}"/>
      </group>
      <text x="340" y="110" size="46" weight="800" fill="#111827" text="@settings"/>
      <text x="340" y="160" size="22" fill="#6b7280" text="@settingsSub"/>
      <!-- account card -->
      <rect x="340" y="210" w="1040" h="300" r="16" fill="#fff" stroke="#e5e7eb" sw="2"/>
      <text x="376" y="250" size="24" weight="700" fill="#111827" text="@account"/>
      <group repeat="3" as="f" x="=376 + f*330">
        <text x="0" y="300" size="19" weight="600" fill="#374151" text="=f==0 ? 'Full name' : f==1 ? 'Email' : 'Password'"/>
        <rect x="0" y="326" w="300" h="58" r="10" fill="#fff" stroke="#d1d5db" sw="2"/>
        <text x="18" y="355" size="20" fill="#111827" text="=f==0 ? 'Asha Patel' : f==1 ? 'asha@example.com' : '••••••••••'"/>
      </group>
      <text x="1006" y="430" size="18" weight="600" fill="#3451d1" text="@change"/>
      <!-- notifications card -->
      <rect x="340" y="534" w="1040" h="190" r="16" fill="#fff" stroke="#e5e7eb" sw="2"/>
      <text x="376" y="574" size="24" weight="700" fill="#111827" text="@notif"/>
      <group repeat="3" as="n" x="=376 + n*340" y="640">
        <rect w="52" h="30" r="15" fill="=n==2 ? '#d1d5db' : '#3ddc97'"/>
        <circle x="=n==2 ? 15 : 37" y="15" r="11" fill="#fff"/>
        <text x="66" y="15" size="19" fill="#374151" text="=n==0 ? 'Mentions and replies' : n==1 ? 'Weekly summary' : 'Product news'"/>
      </group>
      <!-- one primary action -->
      <rect x="1170" y="748" w="210" h="52" r="12" fill="#3451d1"/>
      <text x="1275" y="774" size="20" weight="700" align="center" fill="#fff" text="@save"/>
    </symbol>

    <!-- slider handle: line + knob with arrows -->
    <symbol id="knob">
      <circle r="38" fill="$handle" shadow="0 6 18 #0008"/>
      <path d="M -10 -12 L -22 0 L -10 12 Z M 10 -12 L 22 0 L 10 12 Z" fill="#14161b"/>
    </symbol>
  </defs>
  <assets>
    <asset id="mount" src="images/mountains.jpg"/>
    <asset id="bed" src="audio/pad.ogg"/>
    <asset id="whoosh" src="audio/whoosh.ogg"/>
    <asset id="click" src="audio/click.ogg"/>
    <asset id="pop" src="audio/pop.ogg"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <font family="Space Grotesk" src="fonts/SpaceGrotesk.ttf"/>
  </assets>
  <music src="bed" loop="1" vol="0.8"/>

  <backdrop>
    <group repeat="40" as="gx">
      <circle repeat="23" as="gy" x="=gx*50 + 10" y="=gy*50 + 10" r="1.6" fill="#ffffff" opacity="0.07"/>
    </group>
  </backdrop>

  <timeline>
    <!-- 1 · title: a split card that is half "before", half "after" -->
    <scene id="intro" dur="7.5" chapter="@ch1">
      <say at="0.4" text="@vo1"/>
      <sfx at="0.3" src="whoosh"/>
      <rect x="440" y="230" w="1040" h="400" r="28" fill="#2a2d35"/>
      <text x="700" y="430" size="110" weight="800" font="Space Grotesk" align="center" fill="$bad" text="@t1"/>
      <group clip="url(#k7)">
        <rect x="440" y="230" w="1040" h="400" r="28" fill="#f4f6ff"/>
        <text x="700" y="430" size="110" weight="800" font="Space Grotesk" align="center" fill="#c9cfdb" text="@t1"/>
        <text x="1220" y="430" size="110" weight="800" font="Space Grotesk" align="center" fill="#3451d1" text="@t2"/>
      </group>
      <line x1="=s7()" y1="200" x2="=s7()" y2="660" stroke="$handle" sw="5" shadow="0 0 12 #0008"/>
      <use ref="knob" x="=s7()" y="430"/>
      <rect x="960" y="740" ax="0.5" w="220" h="50" r="25" fill="$accent" at="0.8"><anim prop="opacity" from="0" to="1" dur="0.4"/></rect>
      <text x="960" y="765" size="26" weight="800" align="center" fill="#fff" text="@kick" at="0.8"><anim prop="opacity" from="0" to="1" dur="0.4"/></text>
      <text x="960" y="850" size="52" weight="700" align="center" fill="$fg" text="@sub" at="1.2"><anim prop="opacity" from="0" to="1" dur="0.6"/></text>
    </scene>

    <!-- 2 · the before, annotated -->
    <scene id="before" dur="10" chapter="@ch2">
      <say at="0.4" text="@vo2"/>
      <sfx at="2.0" src="pop"/><sfx at="3.6" src="pop"/><sfx at="5.2" src="pop"/>
      <group>
        <anim prop="opacity" from="0" to="1" dur="0.5"/>
        <use ref="before" x="240" y="150"/>
      </group>
      <rect x="60" y="66" w="200" h="50" r="25" fill="$bad"/>
      <text x="160" y="91" size="26" weight="800" align="center" fill="#fff" text="@BEFORE"/>
      <!-- callouts -->
      <group at="1.8">
        <rect x="244" y="190" w="1430" h="64" r="8" fill="none" stroke="$bad" sw="5">
          <anim prop="opacity" from="0" to="1" dur="0.3"/>
        </rect>
        <group x="1300" y="120"><anim prop="scale" from="0" to="1" dur="0.4" ease="back"/>
          <rect x="-180" y="-30" w="360" h="60" r="30" fill="$bad" shadow="0 8 20 #0007"/>
          <text size="28" weight="800" align="center" fill="#fff" text="@c1"/>
        </group>
      </group>
      <group at="3.4">
        <rect x="244" y="250" w="250" h="690" r="8" fill="none" stroke="$bad" sw="5"><anim prop="opacity" from="0" to="1" dur="0.3"/></rect>
        <group x="370" y="1010"><anim prop="scale" from="0" to="1" dur="0.4" ease="back"/>
          <rect x="-170" y="-30" w="340" h="60" r="30" fill="$bad" shadow="0 8 20 #0007"/>
          <text size="28" weight="800" align="center" fill="#fff" text="@c2"/>
        </group>
      </group>
      <group at="5.0">
        <rect x="490" y="256" w="1180" h="134" r="8" fill="none" stroke="$bad" sw="5"><anim prop="opacity" from="0" to="1" dur="0.3"/></rect>
        <group x="1080" y="1010"><anim prop="scale" from="0" to="1" dur="0.4" ease="back"/>
          <rect x="-190" y="-30" w="380" h="60" r="30" fill="$bad" shadow="0 8 20 #0007"/>
          <text size="28" weight="800" align="center" fill="#fff" text="@c3"/>
        </group>
      </group>
    </scene>

    <!-- 3 · the sweep -->
    <scene id="sweep" dur="9.5" chapter="@ch3">
      <say at="0.4" text="@vo3"/>
      <sfx at="1" src="whoosh"/><sfx at="5" src="whoosh"/>
      <use ref="before" x="240" y="150"/>
      <group clip="url(#k3)"><use ref="after" x="240" y="150"/></group>
      <line x1="=s3()" y1="130" x2="=s3()" y2="990" stroke="$handle" sw="5" shadow="0 0 14 #000a"/>
      <use ref="knob" x="=s3()" y="560"/>
      <rect x="60" y="66" w="200" h="50" r="25" fill="$bad"/>
      <text x="160" y="91" size="26" weight="800" align="center" fill="#fff" text="@BEFORE"/>
      <rect x="1660" y="66" w="200" h="50" r="25" fill="$good"/>
      <text x="1760" y="91" size="26" weight="800" align="center" fill="#0b2a1d" text="@AFTER"/>
    </scene>

    <!-- 4 · up close on the form -->
    <scene id="zoom" dur="10" chapter="@ch4">
      <say at="0.4" text="@vo4"/>
      <sfx at="1.2" src="whoosh"/>
      <group>
        <group x="=lerp(240, -380, ease(T/1,'io'))" y="=lerp(150, -280, ease(T/1,'io'))" scale="=lerp(1, 2.1, ease(T/1,'io'))">
          <use ref="before"/>
        </group>
      </group>
      <group clip="url(#k4)">
        <group x="=lerp(240, -380, ease(T/1,'io'))" y="=lerp(150, -280, ease(T/1,'io'))" scale="=lerp(1, 2.1, ease(T/1,'io'))">
          <use ref="after"/>
        </group>
      </group>
      <line x1="=s4()" y1="0" x2="=s4()" y2="1080" stroke="$handle" sw="5" shadow="0 0 14 #000a"/>
      <use ref="knob" x="=s4()" y="980"/>
      <rect x="60" y="66" w="200" h="50" r="25" fill="$bad"/>
      <text x="160" y="91" size="26" weight="800" align="center" fill="#fff" text="@BEFORE"/>
      <rect x="1660" y="66" w="200" h="50" r="25" fill="$good"/>
      <text x="1760" y="91" size="26" weight="800" align="center" fill="#0b2a1d" text="@AFTER"/>
    </scene>

    <!-- 5 · results as a before/after card -->
    <scene id="results" dur="10.5" chapter="@ch5">
      <say at="0.4" text="@vo5"/>
      <sfx at="1.6" src="whoosh"/>
      <group>
        <rect x="240" y="170" w="1440" h="760" r="28" fill="#2a1b1f"/>
        <group repeat="3" as="m" y="=330 + m*230">
          <text x="320" y="-40" size="32" fill="#d7b8bd" text="@m1" when="=m==0"/>
          <text x="320" y="-40" size="32" fill="#d7b8bd" text="@m2" when="=m==1"/>
          <text x="320" y="-40" size="32" fill="#d7b8bd" text="@m3" when="=m==2"/>
          <text x="1600" y="10" size="110" weight="800" font="Space Grotesk" align="right" fill="$bad" text="@m1b" when="=m==0"/>
          <text x="1600" y="10" size="110" weight="800" font="Space Grotesk" align="right" fill="$bad" text="@m2b" when="=m==1"/>
          <text x="1600" y="10" size="110" weight="800" font="Space Grotesk" align="right" fill="$bad" text="@m3b" when="=m==2"/>
          <rect x="320" y="20" h="18" r="9" w="=m==0 ? 900 : m==1 ? 900 : 900" fill="$bad" opacity="0.6"/>
        </group>
      </group>
      <group clip="url(#k5)">
        <rect x="240" y="170" w="1440" h="760" r="28" fill="#123326"/>
        <group repeat="3" as="m" y="=330 + m*230">
          <text x="320" y="-40" size="32" fill="#a9dcc5" text="@m1" when="=m==0"/>
          <text x="320" y="-40" size="32" fill="#a9dcc5" text="@m2" when="=m==1"/>
          <text x="320" y="-40" size="32" fill="#a9dcc5" text="@m3" when="=m==2"/>
          <text x="1600" y="10" size="110" weight="800" font="Space Grotesk" align="right" fill="$good" text="@m1a" when="=m==0"/>
          <text x="1600" y="10" size="110" weight="800" font="Space Grotesk" align="right" fill="$good" text="@m2a" when="=m==1"/>
          <text x="1600" y="10" size="110" weight="800" font="Space Grotesk" align="right" fill="$good" text="@m3a" when="=m==2"/>
          <rect x="320" y="20" h="18" r="9" w="=m==0 ? 225 : m==1 ? 555 : 180" fill="$good" opacity="0.8"/>
        </group>
      </group>
      <line x1="=s5()" y1="150" x2="=s5()" y2="950" stroke="$handle" sw="5" shadow="0 0 14 #000a"/>
      <use ref="knob" x="=s5()" y="560"/>
      <rect x="60" y="66" w="200" h="50" r="25" fill="$bad"/>
      <text x="160" y="91" size="26" weight="800" align="center" fill="#fff" text="@BEFORE"/>
      <rect x="1660" y="66" w="200" h="50" r="25" fill="$good"/>
      <text x="1760" y="91" size="26" weight="800" align="center" fill="#0b2a1d" text="@AFTER"/>
    </scene>

    <!-- 6 · the same slider on a photo -->
    <scene id="photo" dur="9" chapter="@ch6">
      <say at="0.4" text="@vo6"/>
      <group clip="url(#photo)">
        <group blur="5"><image src="mount" x="160" y="140" w="1600" h="840"/></group>
        <rect x="160" y="140" w="1600" h="840" fill="url(#hazeG)"/>
      </group>
      <group clip="url(#k6)">
        <group clip="url(#photo)">
          <image src="mount" x="160" y="140" w="1600" h="840"/>
