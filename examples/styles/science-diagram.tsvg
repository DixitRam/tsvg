<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: labelled science diagram. Parts appear one by one with callouts, leader lines and flow arrows. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts><layout id="landscape" w="1920" h="1080"/></layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:bf_emma"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
    <option id="theme" default="textbook"><choice id="textbook" label="Textbook"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.25" sfx="0.5"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="textbook" bg="#eef5f8" fg="#1d3347" line="#1d3347" muted="#4c6275" accent="#e0663a" sun="#ffc83d" vapour="#e0663a" water="#2f7fc1" rain="#3b82c4" leaf="#4fa64a"/></themes>
  <strings>
    <s id="title" en="The water cycle"/>
    <s id="sub" en="How every drop keeps moving"/>
    <s id="ch1" en="Overview"/>
    <s id="ch2" en="Evaporation"/>
    <s id="ch3" en="Condensation"/>
    <s id="ch4" en="Precipitation"/>
    <s id="ch5" en="Collection"/>
    <s id="ch6" en="Transpiration"/>
    <s id="ch7" en="The cycle"/>
    <s id="l1" en="Evaporation"/>
    <s id="l2" en="Condensation"/>
    <s id="l3" en="Precipitation"/>
    <s id="l4" en="Collection"/>
    <s id="l5" en="Transpiration"/>
    <s id="gw" en="groundwater"/>
    <s id="sun" en="Sun"/>
    <s id="ocean" en="Ocean"/>
    <s id="d1" en="Warm water becomes vapour"/>
    <s id="d2" en="Vapour cools into clouds"/>
    <s id="d3" en="Falls as rain or snow"/>
    <s id="d4" en="Water flows back to the sea"/>
    <s id="d5" en="Leaves give off vapour"/>
    <s id="fig" en="Fig. 1 · The water cycle"/>
    <s id="again" en="The same water, again and again."/>
    <s id="n1" en="1"/>
    <s id="n2" en="2"/>
    <s id="n3" en="3"/>
    <s id="n4" en="4"/>
    <s id="n5" en="5"/>
    <s id="vo1" en="Every drop of water on Earth is on a journey. Here is the water cycle, one stage at a time."/>
    <s id="vo2" en="The sun warms the ocean. Water at the surface turns into vapour, and rises into the air."/>
    <s id="vo3" en="High up, the air is cold. The vapour condenses into tiny droplets, which gather as clouds."/>
    <s id="vo4" en="When the droplets grow heavy, they fall as rain, or as snow on the mountain tops."/>
    <s id="vo5" en="Rivers and groundwater carry that water downhill, back to the sea."/>
    <s id="vo6" en="Plants return water too. They draw it up from the soil, and release it from their leaves."/>
    <s id="vo7" en="Round and round it goes. The water you drink today may once have rained on dinosaurs."/>
  </strings>
  <defs>
    <linear id="sky" x1="0" y1="0" x2="0" y2="900"><stop at="0" color="#bfe0f3"/><stop at="1" color="#f3f9fb"/></linear>
    <linear id="sea" x1="0" y1="820" x2="0" y2="1080"><stop at="0" color="#3f93cf"/><stop at="1" color="#1f5f99"/></linear>
    <linear id="land" x1="0" y1="380" x2="0" y2="920"><stop at="0" color="#a8b48a"/><stop at="0.45" color="#8fc06d"/><stop at="1" color="#6aa152"/></linear>
    <radial id="sunG" x="-20" y="-20" r="110"><stop at="0" color="#fff1a8"/><stop at="1" color="#ffc23a"/></radial>
  </defs>
  <assets>
    <asset id="pad" src="audio/pad.ogg"/><asset id="pop" src="audio/pop.ogg"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
  </assets>
  <music src="pad" loop="1" vol="0.7"/>
  <backdrop>
      <rect w="1920" h="1080" fill="url(#sky)"/>
      <rect x="0" y="820" w="980" h="260" fill="url(#sea)"/>
      <path d="M 0 822 Q 40 810 80 822 T 160 822 T 240 822 T 320 822 T 400 822 T 480 822 T 560 822 T 640 822 T 720 822 T 800 822 T 880 822 T 960 822" stroke="#e8f6ff" sw="4" fill="none" x="=-40 + 40*fract(t/3)"/>
      <path d="M 720 840 Q 820 800 940 808 L 1120 792 L 1300 600 L 1450 380 L 1560 560 L 1700 470 L 1920 690 L 1920 1080 L 720 1080 Z" fill="url(#land)" stroke="$line" sw="3"/>
      <rect x="720" y="920" w="1200" h="160" fill="#8b6a4a"/>
      <path d="M 720 920 L 1920 920" stroke="$line" sw="3"/>
      <circle repeat="40" as="k" x="=740 + rand(k)*1160" y="=940 + rand(k+3)*120" r="=3 + rand(k+1)*4" fill="#6e5238"/>
      <text x="200" y="900" size="34" weight="700" fill="#e8f6ff" text="@ocean"/>
  </backdrop>
  <overlay>
    <text x="1880" y="1050" size="24" align="right" fill="#f4ead8" text="@fig"/>
