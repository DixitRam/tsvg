<?xml version="1.0" encoding="UTF-8"?>
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:bf_emma"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full (voice + music + sfx)"/><choice id="speech" label="Speech only"/><choice id="ambient" label="No voice"/></option>
    <option id="theme" label="Theme" default="kraft"><choice id="kraft" label="Kraft"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.35" sfx="0.7"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
    <mix id="ambient" voice="0" music="0.6" sfx="0.7"/>
  </mixes>
  <themes>
    <theme id="kraft" bg="#e9d8b4" fg="#3b2a20" muted="#7a6248" accent="#d64933"/>
  </themes>
  <strings>
    <s id="title" en="Masala chai, step by step"/>
    <s id="ch1" en="Chai"/>
    <s id="ch2" en="Ingredients"/>
    <s id="ch3" en="Crush"/>
    <s id="ch4" en="Boil"/>
    <s id="ch5" en="Milk"/>
    <s id="ch6" en="Strain"/>
    <s id="ch7" en="Serve"/>
    <s id="sub" en="for two, roadside style"/>
    <s id="i_water" en="1 cup water"/>
    <s id="i_milk" en="1 cup milk"/>
    <s id="i_tea" en="2 tsp tea"/>
    <s id="i_ginger" en="thumb of ginger"/>
    <s id="i_card" en="2 cardamom"/>
    <s id="i_sugar" en="2 tsp sugar"/>
    <s id="crush" en="crush!"/>
    <s id="boil_t" en="2 min"/>
    <s id="tea_in" en="+ tea"/>
    <s id="rise" en="let it rise twice"/>
    <s id="strain" en="strain &amp; pour"/>
    <s id="out1" en="CHAI TIME"/>
    <s id="out2" en="made by hand, shared by two"/>
    <s id="vo_intro" en="Let us make masala chai for two, the way a roadside stall makes it."/>
    <s id="vo_ingr" en="You need water, milk, black tea, a thumb of ginger, two cardamom pods and a little sugar."/>
    <s id="vo_crush" en="First, crush the ginger and cardamom. Bruising them lets the oils out."/>
    <s id="vo_boil" en="Boil a cup of water with the spices for two minutes, then add the tea."/>
    <s id="vo_milk" en="Pour in the milk and sugar. Let it rise twice, so the chai turns strong and creamy."/>
    <s id="vo_strain" en="Strain it into two cups, and serve it hot."/>
    <s id="vo_outro" en="That is chai. Share it with someone."/>
  </strings>
  <defs>
<clip id="cupclip"><path d="M -110 -90 L 110 -90 L 90 80 C 80 110 -80 110 -90 80 Z"/></clip>
  </defs>
