    <scene id="crush" dur="7.5" chapter="@ch3">
      <say at="0.5" text="@vo_crush"/>

      <sfx at="1.2" src="click"/><sfx at="2.0" src="click"/><sfx at="2.8" src="click"/><sfx at="3.6" src="click"/>
      <group x="=760 + 3*(rand(floor(t*8)*1.31 + 400) - 0.5)" y="=700 + 3*(rand(floor(t*8)*1.31 + 450) - 0.5)" rot="=0 + 2.5*(rand(floor(t*8)*2.17 + 490) - 0.5)" >
        <path d="M -260 -60 L 260 -60 C 250 120 140 200 0 200 C -140 200 -250 120 -260 -60 Z" fill="#d64933" shadow="5 8 2 #0000004d"/>
        <rect x="-280" y="-90" w="560" h="40" r="20" fill="#b83a27" shadow="5 8 2 #0000004d"/>
        <rect x="-90" y="200" w="180" h="50" fill="#b83a27" shadow="5 8 2 #0000004d"/></group>
