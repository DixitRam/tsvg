      <text size="26" weight="800" fill="$accent" text="@ep"/>
      <text y="56" size="44" weight="700" fill="#fff" maxw="940" text="@eptitle"/>
    </group>
    <group x="=W/2" y="830" only="portrait">
      <text size="26" weight="800" align="center" fill="$accent" text="@ep"/>
      <text y="52" size="40" weight="700" align="center" fill="#fff" text="@eptitle"/>
    </group>
