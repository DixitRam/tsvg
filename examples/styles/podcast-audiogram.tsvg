<?xml version="1.0" encoding="UTF-8"?>
<!-- Podcast audiogram: cover art, live waveform (repeat + noise), pull quote, episode title. Two speakers. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
    <layout id="portrait" w="1080" h="1920"/>
  </layouts>
  <options>
    <option id="lang" default="en"><choice id="en" label="English" tts="kokoro:af_heart"/></option>
    <option id="mix" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.22" sfx="0.6"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="night" bg="#100d1c" fg="#ffffff" muted="#a7a3c2" accent="#ffb347"/></themes>
  <strings>
    <s id="title" en="Night Shift, Ep. 47: How your brain takes out the trash"/>
    <s id="show" en="NIGHT SHIFT"/>
    <s id="tag" en="a podcast about sleep"/>
    <s id="ep" en="EPISODE 47"/>
    <s id="eptitle" en="How your brain takes out the trash"/>
    <s id="listen" en="Full episode on every podcast app"/>
    <s id="vo_q1" en="Welcome back to Night Shift. Today: what your brain is actually doing while you sleep."/>
    <s id="vo_q2" en="During deep sleep, the fluid around your brain cells starts to pulse in slow waves, almost like a rinse cycle."/>
    <s id="vo_q3" en="Wait. So sleep is literally a cleaning shift? That changes how I think about staying up late."/>
    <s id="vo_q4" en="The spaces between cells open up, and waste proteins get washed out much faster than when you're awake."/>
    <s id="vo_q5" en="So what happens when we cut it short, night after night?"/>
    <s id="vo_q6" en="The trash piles up. One bad night won't hurt you, but a habit of short sleep is something your brain really notices."/>
    <s id="vo_q7" en="The full episode is out now. Search for Night Shift, episode forty seven, wherever you listen."/>
    <s id="ch_q1" en="Welcome"/>
    <s id="ch_q2" en="Rinse cycle"/>
    <s id="ch_q3" en="A cleaning shift"/>
    <s id="ch_q4" en="Wider channels"/>
    <s id="ch_q5" en="Cutting it short"/>
    <s id="ch_q6" en="The trash piles up"/>
    <s id="ch_q7" en="Listen"/>
  </strings>
  <defs>
    <linear id="wave" x1="0" y1="0" x2="920" y2="0"><stop at="0" color="#ffb347"/><stop at="0.5" color="#ff6f91"/><stop at="1" color="#7fd1ff"/></linear>
    <linear id="coverShade" x1="0" y1="0" x2="0" y2="600"><stop at="0" color="#1b1240" opacity="0.1"/><stop at="1" color="#1b1240" opacity="0.92"/></linear>
    <radial id="glow" x="0" y="0" r="700"><stop at="0" color="#5b3fd1" opacity="0.45"/><stop at="1" color="#5b3fd1" opacity="0"/></radial>
    <clip id="coverClip"><rect w="600" h="600" r="28"/></clip>
    <clip id="moonCut"><circle r="80"/></clip>
  </defs>
  <assets>
    <asset id="nebula" src="images/nebula.jpg"/><asset id="pad" src="audio/pad.ogg"/><asset id="blip" src="audio/blip.ogg"/>
    <font family="Inter" src="fonts/Inter.ttf"/><font family="Playfair Display" src="fonts/PlayfairDisplay.ttf"/><font family="Space Grotesk" src="fonts/SpaceGrotesk.ttf"/>
  </assets>
  <music src="pad" loop="1" vol="0.9"/>
  <backdrop>
    <image src="nebula" x="0" y="0" w="=W" h="=H" blur="60" opacity="0.35"/>
    <rect w="=W" h="=H" fill="#100d1ccc"/>
    <circle x="460" y="500" x.portrait="540" y.portrait="500" r="700" fill="url(#glow)" scale="=1 + 0.05*sin(t*0.7)"/>
    <!-- cover art (square, persistent) -->
    <group x="160" y="200" x.portrait="240" y.portrait="160" scale.portrait="1">
      <group scale.portrait="1">
        <rect w="600" h="600" r="28" fill="#000" shadow="0 30 60 #000a"/>
        <group clip="url(#coverClip)">
          <image src="nebula" x="=-40 - 20*sin(t*0.1)" y="-40" w="760" h="680"/>
          <rect w="600" h="600" fill="url(#coverShade)"/>
          <circle repeat="40" as="k" x="=600*rand(k)" y="=380*rand(k+50)" r="=1.5 + 2.5*rand(k+9)" fill="#fff" opacity="=0.4 + 0.6*noise(t*1.5 + k)"/>
          <group x="430" y="150">
            <circle r="80" fill="#fff4d6" shadow="0 0 50 #fff4d6"/>
            <circle x="34" y="-22" r="72" fill="#2a1d5c"/>
          </group>
          <text x="48" y="440" font="Space Grotesk" size="88" weight="700" fill="#fff" text="@show"/>
          <text x="52" y="512" size="30" weight="500" fill="#ffd9a1" text="@tag"/>
          <rect x="52" y="548" w="150" h="6" r="3" fill="#ffb347"/>
        </group>
        <rect w="600" h="600" r="28" fill="none" stroke="#ffffff22" sw="2"/>
      </group>
    </group>
    <text x="460" y="880" x.portrait="540" y.portrait="830" only="landscape" size="28" align="center" fill="$muted" text="@listen"/>
    <!-- episode header -->
