<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: whiteboard animation. Marker strokes draw on, handwritten notes reveal, simple doodles. -->
<tsvg version="0.2" title="@title" font="Caveat, Inter">
  <layouts><layout id="landscape" w="1920" h="1080"/></layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:af_bella"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
    <option id="theme" default="board"><choice id="board" label="Whiteboard"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.22" sfx="0.5"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="board" bg="#f6f6f2" fg="#1c1d21" ink="#1c1d21" blue="#1f5fd6" red="#d93a3a" green="#1f9a54" orange="#e89a16" frame="#c4c8ce"/></themes>
  <strings>
    <s id="title" en="How habits stick"/>
    <s id="ch1" en="The question"/>
    <s id="ch2" en="Cue"/>
    <s id="ch3" en="Routine"/>
    <s id="ch4" en="Reward"/>
    <s id="ch5" en="The loop"/>
    <s id="ch6" en="The chain"/>
    <s id="ch7" en="Recap"/>
    <s id="q" en="?"/>
    <s id="h1" en="1. Cue"/>
    <s id="h2" en="2. Routine"/>
    <s id="h3" en="3. Reward"/>
    <s id="n1a" en="a trigger you can’t miss"/>
    <s id="n1b" en="shoes by the door"/>
    <s id="n2a" en="the action itself"/>
    <s id="n2b" en="keep it tiny: 2 minutes"/>
    <s id="n3a" en="feels good right away"/>
    <s id="n3b" en="brain: “do that again”"/>
    <s id="l1" en="cue"/>
    <s id="l2" en="routine"/>
    <s id="l3" en="reward"/>
    <s id="loop" en="habit loop"/>
    <s id="chain" en="don’t break the chain!"/>
    <s id="week" en="M  T  W  T  F  S  S"/>
    <s id="o1" en="Make it obvious."/>
    <s id="o2" en="Make it tiny."/>
    <s id="o3" en="Make it rewarding."/>
    <s id="vo1" en="Why do some habits stick, while others fade after a week? It comes down to one simple loop."/>
    <s id="vo2" en="First, a cue. Something you can’t miss, like an alarm, or your running shoes left by the door."/>
    <s id="vo3" en="Second, the routine. The action itself. Keep it so small that skipping it feels silly."/>
    <s id="vo4" en="Third, a reward. Something that feels good right away, so your brain marks the path as worth repeating."/>
    <s id="vo5" en="Cue, routine, reward. Run the loop enough times, and it starts to run itself."/>
    <s id="vo6" en="Track it on a calendar. Every tick is a small win, and soon you won’t want to break the chain."/>
    <s id="vo7" en="Make it obvious. Make it tiny. Make it rewarding. That’s the whole trick."/>
  </strings>
  <defs>
    <data id="days" v="M, T, W, T, F, S, S"/>
    <radial id="gloss" x="420" y="160" r="900"><stop at="0" color="#ffffff" opacity="0.9"/><stop at="1" color="#ffffff" opacity="0"/></radial>
    <linear id="rim" x1="0" y1="0" x2="0" y2="40"><stop at="0" color="#dfe2e6"/><stop at="1" color="#aeb3ba"/></linear>
    <symbol id="marker">
      <group rot="-35">
        <rect x="-14" y="0" w="28" h="150" r="6" fill="#2a2d33" shadow="6 10 14 #0003"/>
        <rect x="-14" y="0" w="28" h="40" r="4" fill="$blue"/>
        <path d="M -10 0 L -6 -22 L 6 -22 L 10 0 Z" fill="#555"/>
      </group>
    </symbol>
  </defs>
  <assets>
    <asset id="bright" src="audio/bright.ogg"/><asset id="pop" src="audio/pop.ogg"/><asset id="ding" src="audio/ding.ogg"/>
    <font family="Caveat" src="fonts/Caveat.ttf"/><font family="Inter" src="fonts/Inter.ttf"/>
  </assets>
  <music src="bright" loop="1" vol="0.6"/>
  <backdrop>
    <rect w="1920" h="1080" fill="url(#gloss)"/>
    <ellipse x="1500" y="820" rx="260" ry="70" fill="#9aa0a8" opacity="0.07" blur="30"/>
    <ellipse x="300" y="980" rx="200" ry="40" fill="#9aa0a8" opacity="0.06" blur="24"/>
  </backdrop>
  <overlay>
    <rect x="8" y="8" w="1904" h="1064" r="10" fill="none" stroke="url(#rim)" sw="16"/>
    <rect x="660" y="1050" w="600" h="22" r="6" fill="#b5bac1"/>
    <rect x="700" y="1040" w="120" h="14" r="7" fill="$red"/><rect x="840" y="1040" w="120" h="14" r="7" fill="$blue"/><rect x="980" y="1040" w="120" h="14" r="7" fill="$ink"/>
