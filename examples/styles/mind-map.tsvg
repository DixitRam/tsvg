<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: mind map. A central topic, coloured branches growing to sub-topics, a camera that travels between branches. -->
<tsvg version="0.2" title="@title" font="Space Grotesk, Inter">
  <layouts><layout id="landscape" w="1920" h="1080"/><layout id="portrait" w="1080" h="1920"/></layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:bf_emma"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
    <option id="theme" default="paper"><choice id="paper" label="Paper"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.25" sfx="0.5"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="paper" bg="#fbf6ee" fg="#2b2622" teal="#2a9d8f" coral="#e76f51" violet="#8e7dbe" amber="#e9a23b" blue="#457b9d"/></themes>
  <strings>
    <s id="title" en="Weekend in Udaipur"/>
    <s id="ch0" en="Budget"/>
    <s id="chE" en="Whole map"/>
    <s id="tag" en="MIND MAP"/>
    <s id="one" en="One page. Whole trip."/>
    <s id="vo0" en="Planning a weekend away can feel like a hundred decisions. A mind map turns them into five."/>
    <s id="vo6" en="Zoom out, and the whole weekend fits on one page."/>
    <s id="b0" en="Budget"/>
    <s id="vo1" en="Start with the budget. Set one total for two people, book the trains early, and keep ten percent spare."/>
    <s id="l00" en="₹12,000 for two"/>
    <s id="l01" en="Book trains early"/>
    <s id="l02" en="Keep 10% spare"/>
    <s id="b1" en="Getting there"/>
    <s id="ch1" en="Getting there"/>
    <s id="vo2" en="Getting there: an overnight train saves a hotel night. In town, auto rickshaws and your own feet do the rest."/>
    <s id="l10" en="Overnight train"/>
    <s id="l11" en="Autos in town"/>
    <s id="l12" en="Walk the old city"/>
    <s id="b2" en="Stay"/>
    <s id="ch2" en="Stay"/>
    <s id="vo3" en="Where to stay: a guesthouse with a lake view, close to the palace. Read the recent reviews first."/>
    <s id="l20" en="Lake-view guesthouse"/>
    <s id="l21" en="Near City Palace"/>
    <s id="l22" en="Read recent reviews"/>
    <s id="b3" en="Food"/>
    <s id="ch3" en="Food"/>
    <s id="vo4" en="Food is half the trip. Try dal baati churma, a rooftop dinner at sunset, and plenty of street chai."/>
    <s id="l30" en="Dal baati churma"/>
    <s id="l31" en="Rooftop dinner"/>
    <s id="l32" en="Street chai"/>
    <s id="b4" en="Things to do"/>
    <s id="ch4" en="Things to do"/>
    <s id="vo5" en="And things to do: a boat on Lake Pichola, the City Palace, and sunset from the hilltop palace."/>
    <s id="l40" en="Boat on Lake Pichola"/>
    <s id="l41" en="City Palace"/>
    <s id="l42" en="Sunset viewpoint"/>
  </strings>
  <defs>
    <radial id="core" x="-50" y="-60" r="260"><stop at="0" color="#4a3f8f"/><stop at="1" color="#2b2357"/></radial>
  </defs>
  <assets>
    <asset id="bright" src="audio/bright.m4a"/><asset id="pop" src="audio/pop.m4a"/><asset id="whoosh" src="audio/whoosh.m4a"/>
    <font family="Space Grotesk" src="fonts/SpaceGrotesk.ttf"/><font family="Inter" src="fonts/Inter.ttf"/>
  </assets>
  <music src="bright" loop="1" vol="0.5"/>
  <backdrop>
    <circle repeat="60" as="k" x="=rand(k)*W" y="=rand(k+31)*H" r="3" fill="$fg" opacity="0.07"/>
  </backdrop>
