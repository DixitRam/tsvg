<?xml version="1.0" encoding="UTF-8"?>
<!-- Quote cards: serif quotes on photo backgrounds with a frosted card, slow zoom, fade-through-black transitions. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
    <layout id="portrait" w="1080" h="1920"/>
  </layouts>
  <options>
    <option id="lang" default="en"><choice id="en" label="English" tts="kokoro:bf_emma"/></option>
    <option id="mix" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.4" sfx="0.4"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="main" bg="#0b0b0f" fg="#fbf7ef" muted="#ffffff99" accent="#e8c98a"/></themes>
  <strings>
    <s id="title" en="On Patience"/>
    <s id="kicker" en="FIVE LINES WORTH KEEPING"/>
    <s id="sub" en="for the days when everything feels slow"/>
    <s id="out1" en="Slow is still moving."/>
    <s id="out2" en="SAVE THE ONE YOU NEEDED TODAY"/>
    <s id="q_q1" en="Adopt the pace of nature: her secret is patience."/>
    <s id="who_q1" en="RALPH WALDO EMERSON"/>
    <s id="yr_q1" en="1803 – 1882"/>
    <s id="q_q2" en="It does not matter how slowly you go as long as you do not stop."/>
    <s id="who_q2" en="CONFUCIUS"/>
    <s id="yr_q2" en="attributed"/>
    <s id="q_q3" en="Rivers know this: there is no hurry. We shall get there some day."/>
    <s id="who_q3" en="A. A. MILNE"/>
    <s id="yr_q3" en="Winnie-the-Pooh, 1926"/>
    <s id="q_q4" en="Patience is bitter, but its fruit is sweet."/>
    <s id="who_q4" en="JEAN-JACQUES ROUSSEAU"/>
    <s id="yr_q4" en="attributed"/>
    <s id="q_q5" en="He that can have patience can have what he will."/>
    <s id="who_q5" en="BENJAMIN FRANKLIN"/>
    <s id="yr_q5" en="Poor Richard's Almanack"/>
    <s id="vo_intro" en="On patience. Five lines worth keeping, for the days when everything feels slow."/>
    <s id="vo_q1" en="Adopt the pace of nature: her secret is patience. Ralph Waldo Emerson."/>
    <s id="vo_q2" en="It does not matter how slowly you go as long as you do not stop. Confucius."/>
    <s id="vo_q3" en="Rivers know this: there is no hurry. We shall get there some day. A. A. Milne."/>
    <s id="vo_q4" en="Patience is bitter, but its fruit is sweet. Jean-Jacques Rousseau."/>
    <s id="vo_q5" en="He that can have patience can have what he will. Benjamin Franklin."/>
    <s id="vo_outro" en="Save the one you needed today. Slow is still moving."/>
    <s id="ch_intro" en="Intro"/>
    <s id="ch_q1" en="Ralph Waldo Emerson"/>
    <s id="ch_q2" en="Confucius"/>
    <s id="ch_q3" en="A. A. Milne"/>
    <s id="ch_q4" en="Jean-Jacques Rousseau"/>
    <s id="ch_q5" en="Benjamin Franklin"/>
    <s id="ch_outro" en="Outro"/>
  </strings>
  <defs>
    <radial id="vignette" x="=W/2" y="=H/2" r="=max(W, H)*0.75"><stop at="0" color="#000" opacity="0.15"/><stop at="1" color="#000" opacity="0.75"/></radial>
    <clip id="card"><rect x="=W/2" y="=H/2" ax="0.5" ay="0.5" w="=portrait ? 900 : 1440" h="=portrait ? 1180 : 760" r="6"/></clip>
  </defs>
  <assets>
    <asset id="paper" src="images/paper.jpg"/>
    <asset id="mountains" src="images/mountains.jpg"/>
    <asset id="city" src="images/city.jpg"/>
    <asset id="nebula" src="images/nebula.jpg"/>
    <asset id="factory" src="images/factory.jpg"/>
    <asset id="pad" src="audio/pad.m4a"/><asset id="whoosh" src="audio/whoosh.m4a"/>
    <font family="Playfair Display" src="fonts/PlayfairDisplay.ttf"/><font family="Inter" src="fonts/Inter.ttf"/>
  </assets>
  <music src="pad" loop="1" vol="0.9"/>
  <timeline>
    <scene id="intro" dur="8" chapter="@ch_intro">
      <say at="0.9" text="@vo_intro"/>
      <sfx at="0.1" src="whoosh" vol="0.5"/>
      <group scale="=1.04 + 0.10*T/sdur" rot="=1*0.6*T/sdur">
        <image src="paper" x="0" y="0" w="=W" h="=H" blur="2"/>
      </group>
      <rect w="=W" h="=H" fill="#8a5a2b" blend="multiply"/>
      <rect w="=W" h="=H" fill="url(#vignette)"/>
