<?xml version="1.0" encoding="UTF-8"?>
<!-- Style: dark maths animation. Axes draw on, curves trace, a tangent slides, a circle unrolls, shapes morph. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts><layout id="landscape" w="1920" h="1080"/></layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:am_michael"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
    <option id="theme" default="ink"><choice id="ink" label="Ink"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.25" sfx="0.5"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="ink" bg="#101318" fg="#ece9e1" muted="#8b93a3" grid="#3b5a78" blue="#5cc8e8" yellow="#f5d76e" green="#8fd16a" red="#ff6f61" purple="#b18cff"/></themes>
  <strings>
    <s id="eq" en="="/>
    <s id="why" en="Why?"/>
    <s id="title" en="The slope of a wave"/>
    <s id="ch1" en="Question"/>
    <s id="ch2" en="Sine"/>
    <s id="ch3" en="Tangent"/>
    <s id="ch4" en="Slope curve"/>
    <s id="ch5" en="Circle"/>
    <s id="ch6" en="Result"/>
    <s id="q" en="How steep is it, at every moment?"/>
    <s id="slope" en="slope"/>
    <s id="peak" en="slope 0 at the peak"/>
    <s id="fast" en="steepest going down"/>
    <s id="turn" en="height = sin θ"/>
    <s id="speed" en="rate of height = cos θ"/>
    <s id="shift" en="same wave, shifted a quarter turn"/>
    <s id="vo1" en="Here is a question worth a minute. When a wave rises and falls, how steep is it at each moment?"/>
    <s id="vo2" en="Start with the sine curve. It climbs from zero, peaks at one, and falls back below the axis."/>
    <s id="vo3" en="Now slide a tangent line along it. The slope is one at the start, zero at the peak, and minus one where the curve falls fastest."/>
    <s id="vo4" en="Plot that slope as its own curve, and a familiar shape appears. It is the cosine wave."/>
    <s id="vo5" en="Why? Picture a point turning around a circle. Its height is the sine, and how fast that height changes is the cosine."/>
    <s id="vo6" en="So the derivative of sine is cosine. The same wave, shifted a quarter turn ahead."/>
  </strings>
  <defs>
    <fn id="u3" args="">clamp((T - 1.2)/8, 0, 1) * 2 * PI</fn>
    <fn id="u4" args="">clamp((T - 0.8)/5.5, 0, 1) * 2 * PI</fn>
    <fn id="th" args="">clamp((T - 1.5)/7, 0, 1) * 2 * PI</fn>
    <clip id="upto4"><rect x="260" y="0" h="1080" w="=222.8 * u4()"/></clip>
    <clip id="upto5"><rect x="820" y="0" h="1080" w="=159.2 * th()"/></clip>
    <radial id="vign" x="960" y="540" r="1150"><stop at="0" color="#000" opacity="0"/><stop at="1" color="#000" opacity="0.55"/></radial>
    <radial id="dotglow" x="0" y="0" r="40"><stop at="0" color="$yellow" opacity="0.7"/><stop at="1" color="$yellow" opacity="0"/></radial>
  </defs>
  <assets>
    <asset id="pad" src="audio/pad.ogg"/><asset id="whoosh" src="audio/whoosh.ogg"/><asset id="blip" src="audio/blip.ogg"/>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <font family="Playfair Display" src="fonts/PlayfairDisplay.ttf"/>
  </assets>
  <music src="pad" loop="1" vol="0.8"/>
  <overlay><rect w="1920" h="1080" fill="url(#vign)"/></overlay>
  <timeline>
    <!-- 1 · the question -->
    <scene id="q" dur="9" chapter="@ch1">
      <say at="0.6" text="@vo1"/>
      <sfx at="0.2" src="whoosh"/>
      
      <group at="0">
        <group opacity="0.22">
          <anim prop="opacity" from="0" to="0.22" dur="1.2"/>
          <line repeat="15" as="g" x1="=260 + g*100" y1="300" x2="=260 + g*100" y2="900" stroke="$grid" sw="1.5"/>
          <line repeat="7" as="g" x1="200" y1="=300 + g*100" x2="1720" y2="=300 + g*100" stroke="$grid" sw="1.5"/>
        </group>
        <line x1="200" y1="600" x2="1740" y2="600" stroke="$fg" sw="3"><anim prop="draw" from="0" to="1" dur="1.2" ease="io"/></line>
        <line x1="260" y1="880" x2="260" y2="310" stroke="$fg" sw="3"><anim prop="draw" from="0" to="1" at="0.3" dur="1.2" ease="io"/></line>
        <path x="1740" y="600" d="M -18 -10 L 0 0 L -18 10" stroke="$fg" sw="3" fill="none" at="1.2"/>
        <path x="260" y="310" d="M -10 18 L 0 0 L 10 18" stroke="$fg" sw="3" fill="none" at="1.4"/>
        <group at="1"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="610" y1="590" x2="610" y2="610" stroke="$fg" sw="3"/><text x="610" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="π/2"/></group>
        <group at="1.15"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="960" y1="590" x2="960" y2="610" stroke="$fg" sw="3"/><text x="960" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="π"/></group>
        <group at="1.3"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="1310" y1="590" x2="1310" y2="610" stroke="$fg" sw="3"/><text x="1310" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="3π/2"/></group>
        <group at="1.45"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="1660" y1="590" x2="1660" y2="610" stroke="$fg" sw="3"/><text x="1660" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="2π"/></group>
        <text x="230" y="390" size="30" align="right" fill="$muted" text="1" at="1.2"/>
        <line x1="250" y1="390" x2="270" y2="390" stroke="$fg" sw="3" at="1.2"/>
        <text x="230" y="810" size="30" align="right" fill="$muted" text="−1" at="1.2"/>
        <line x1="250" y1="810" x2="270" y2="810" stroke="$fg" sw="3" at="1.2"/>
      </group>
      <path d="M 260 600 L 274.6 586.3 L 289.2 572.6 L 303.8 559 L 318.3 545.6 L 332.9 532.5 L 347.5 519.6 L 362.1 507.1 L 376.7 495 L 391.3 483.3 L 405.8 472.2 L 420.4 461.5 L 435 451.5 L 449.6 442.1 L 464.2 433.4 L 478.8 425.4 L 493.3 418.1 L 507.9 411.7 L 522.5 406 L 537.1 401.1 L 551.7 397.2 L 566.3 394 L 580.8 391.8 L 595.4 390.4 L 610 390 L 624.6 390.4 L 639.2 391.8 L 653.8 394 L 668.3 397.2 L 682.9 401.1 L 697.5 406 L 712.1 411.7 L 726.7 418.1 L 741.3 425.4 L 755.8 433.4 L 770.4 442.1 L 785 451.5 L 799.6 461.5 L 814.2 472.2 L 828.8 483.3 L 843.3 495 L 857.9 507.1 L 872.5 519.6 L 887.1 532.5 L 901.7 545.6 L 916.3 559 L 930.8 572.6 L 945.4 586.3 L 960 600 L 974.6 613.7 L 989.2 627.4 L 1003.8 641 L 1018.3 654.4 L 1032.9 667.5 L 1047.5 680.4 L 1062.1 692.9 L 1076.7 705 L 1091.3 716.7 L 1105.8 727.8 L 1120.4 738.5 L 1135 748.5 L 1149.6 757.9 L 1164.2 766.6 L 1178.8 774.6 L 1193.3 781.9 L 1207.9 788.3 L 1222.5 794 L 1237.1 798.9 L 1251.7 802.8 L 1266.3 806 L 1280.8 808.2 L 1295.4 809.6 L 1310 810 L 1324.6 809.6 L 1339.2 808.2 L 1353.8 806 L 1368.3 802.8 L 1382.9 798.9 L 1397.5 794 L 1412.1 788.3 L 1426.7 781.9 L 1441.3 774.6 L 1455.8 766.6 L 1470.4 757.9 L 1485 748.5 L 1499.6 738.5 L 1514.2 727.8 L 1528.7 716.7 L 1543.3 705 L 1557.9 692.9 L 1572.5 680.4 L 1587.1 667.5 L 1601.7 654.4 L 1616.3 641 L 1630.8 627.4 L 1645.4 613.7 L 1660 600" stroke="$blue" sw="6" fill="none" at="2" opacity="0.35"><anim prop="draw" from="0" to="1" dur="3" ease="io"/></path>
      <text x="960" y="150" size="86" align="center" font="Playfair Display" weight="600" text="@title" fill="$fg"><anim prop="reveal" from="0" to="1" dur="1.4" ease="linear"/></text>
      <text x="960" y="245" size="50" align="center" text="@q" fill="$yellow" at="4"><anim prop="opacity" from="0" to="1" dur="0.8"/></text>
    </scene>

    <!-- 2 · the sine curve -->
    <scene id="sine" dur="9" chapter="@ch2">
      <say at="0.3" text="@vo2"/>
      
      <group at="-5">
        <group opacity="0.22">
          <anim prop="opacity" from="0" to="0.22" dur="1.2"/>
          <line repeat="15" as="g" x1="=260 + g*100" y1="300" x2="=260 + g*100" y2="900" stroke="$grid" sw="1.5"/>
          <line repeat="7" as="g" x1="200" y1="=300 + g*100" x2="1720" y2="=300 + g*100" stroke="$grid" sw="1.5"/>
        </group>
        <line x1="200" y1="600" x2="1740" y2="600" stroke="$fg" sw="3"><anim prop="draw" from="0" to="1" dur="1.2" ease="io"/></line>
        <line x1="260" y1="880" x2="260" y2="310" stroke="$fg" sw="3"><anim prop="draw" from="0" to="1" at="0.3" dur="1.2" ease="io"/></line>
        <path x="1740" y="600" d="M -18 -10 L 0 0 L -18 10" stroke="$fg" sw="3" fill="none" at="1.2"/>
        <path x="260" y="310" d="M -10 18 L 0 0 L 10 18" stroke="$fg" sw="3" fill="none" at="1.4"/>
        <group at="1"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="610" y1="590" x2="610" y2="610" stroke="$fg" sw="3"/><text x="610" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="π/2"/></group>
        <group at="1.15"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="960" y1="590" x2="960" y2="610" stroke="$fg" sw="3"/><text x="960" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="π"/></group>
        <group at="1.3"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="1310" y1="590" x2="1310" y2="610" stroke="$fg" sw="3"/><text x="1310" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="3π/2"/></group>
        <group at="1.45"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="1660" y1="590" x2="1660" y2="610" stroke="$fg" sw="3"/><text x="1660" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="2π"/></group>
        <text x="230" y="390" size="30" align="right" fill="$muted" text="1" at="1.2"/>
        <line x1="250" y1="390" x2="270" y2="390" stroke="$fg" sw="3" at="1.2"/>
        <text x="230" y="810" size="30" align="right" fill="$muted" text="−1" at="1.2"/>
        <line x1="250" y1="810" x2="270" y2="810" stroke="$fg" sw="3" at="1.2"/>
      </group>
      <path d="M 260 600 L 274.6 586.3 L 289.2 572.6 L 303.8 559 L 318.3 545.6 L 332.9 532.5 L 347.5 519.6 L 362.1 507.1 L 376.7 495 L 391.3 483.3 L 405.8 472.2 L 420.4 461.5 L 435 451.5 L 449.6 442.1 L 464.2 433.4 L 478.8 425.4 L 493.3 418.1 L 507.9 411.7 L 522.5 406 L 537.1 401.1 L 551.7 397.2 L 566.3 394 L 580.8 391.8 L 595.4 390.4 L 610 390 L 624.6 390.4 L 639.2 391.8 L 653.8 394 L 668.3 397.2 L 682.9 401.1 L 697.5 406 L 712.1 411.7 L 726.7 418.1 L 741.3 425.4 L 755.8 433.4 L 770.4 442.1 L 785 451.5 L 799.6 461.5 L 814.2 472.2 L 828.8 483.3 L 843.3 495 L 857.9 507.1 L 872.5 519.6 L 887.1 532.5 L 901.7 545.6 L 916.3 559 L 930.8 572.6 L 945.4 586.3 L 960 600 L 974.6 613.7 L 989.2 627.4 L 1003.8 641 L 1018.3 654.4 L 1032.9 667.5 L 1047.5 680.4 L 1062.1 692.9 L 1076.7 705 L 1091.3 716.7 L 1105.8 727.8 L 1120.4 738.5 L 1135 748.5 L 1149.6 757.9 L 1164.2 766.6 L 1178.8 774.6 L 1193.3 781.9 L 1207.9 788.3 L 1222.5 794 L 1237.1 798.9 L 1251.7 802.8 L 1266.3 806 L 1280.8 808.2 L 1295.4 809.6 L 1310 810 L 1324.6 809.6 L 1339.2 808.2 L 1353.8 806 L 1368.3 802.8 L 1382.9 798.9 L 1397.5 794 L 1412.1 788.3 L 1426.7 781.9 L 1441.3 774.6 L 1455.8 766.6 L 1470.4 757.9 L 1485 748.5 L 1499.6 738.5 L 1514.2 727.8 L 1528.7 716.7 L 1543.3 705 L 1557.9 692.9 L 1572.5 680.4 L 1587.1 667.5 L 1601.7 654.4 L 1616.3 641 L 1630.8 627.4 L 1645.4 613.7 L 1660 600" stroke="$blue" sw="7" fill="none" shadow="0 0 18 $blue"><anim prop="draw" from="0.0" to="1" at="0.4" dur="5.5" ease="io"/></path>
      <group x="1330" y="170">
        <anim prop="opacity" from="0" to="1" at="0.6" dur="0.6"/>
        <text x="0" y="0" size="72" font="Playfair Display" italic="1" fill="$fg" text="y"/>
        <text x="58" y="0" size="72" font="Playfair Display" fill="$muted" text="@eq"/>
        <text x="122" y="0" size="72" font="Playfair Display" fill="$blue" text="sin"/>
        <text x="240" y="0" size="72" font="Playfair Display" italic="1" fill="$yellow" text="x"/>
      </group>
      <group at="3.2"><anim prop="opacity" from="0" to="1" dur="0.4"/>
        <circle x="610" y="390" r="12" fill="$yellow"/>
        <line x1="610" y1="406" x2="610" y2="600" stroke="$yellow" sw="2" opacity="0.6"/>
      </group>
    </scene>

    <!-- 3 · tangent line sliding -->
    <scene id="tangent" dur="11" chapter="@ch3">
      <say at="0.3" text="@vo3"/>
      
      <group at="-5">
        <group opacity="0.22">
          <anim prop="opacity" from="0" to="0.22" dur="1.2"/>
          <line repeat="15" as="g" x1="=260 + g*100" y1="300" x2="=260 + g*100" y2="900" stroke="$grid" sw="1.5"/>
          <line repeat="7" as="g" x1="200" y1="=300 + g*100" x2="1720" y2="=300 + g*100" stroke="$grid" sw="1.5"/>
        </group>
        <line x1="200" y1="600" x2="1740" y2="600" stroke="$fg" sw="3"><anim prop="draw" from="0" to="1" dur="1.2" ease="io"/></line>
        <line x1="260" y1="880" x2="260" y2="310" stroke="$fg" sw="3"><anim prop="draw" from="0" to="1" at="0.3" dur="1.2" ease="io"/></line>
        <path x="1740" y="600" d="M -18 -10 L 0 0 L -18 10" stroke="$fg" sw="3" fill="none" at="1.2"/>
        <path x="260" y="310" d="M -10 18 L 0 0 L 10 18" stroke="$fg" sw="3" fill="none" at="1.4"/>
        <group at="1"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="610" y1="590" x2="610" y2="610" stroke="$fg" sw="3"/><text x="610" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="π/2"/></group>
        <group at="1.15"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="960" y1="590" x2="960" y2="610" stroke="$fg" sw="3"/><text x="960" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="π"/></group>
        <group at="1.3"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="1310" y1="590" x2="1310" y2="610" stroke="$fg" sw="3"/><text x="1310" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="3π/2"/></group>
        <group at="1.45"><anim prop="opacity" from="0" to="1" dur="0.4"/><line x1="1660" y1="590" x2="1660" y2="610" stroke="$fg" sw="3"/><text x="1660" y="644" size="32" align="center" fill="$muted" font="Playfair Display" italic="1" text="2π"/></group>
        <text x="230" y="390" size="30" align="right" fill="$muted" text="1" at="1.2"/>
        <line x1="250" y1="390" x2="270" y2="390" stroke="$fg" sw="3" at="1.2"/>
        <text x="230" y="810" size="30" align="right" fill="$muted" text="−1" at="1.2"/>
        <line x1="250" y1="810" x2="270" y2="810" stroke="$fg" sw="3" at="1.2"/>
      </group>
      <path d="M 260 600 L 274.6 586.3 L 289.2 572.6 L 303.8 559 L 318.3 545.6 L 332.9 532.5 L 347.5 519.6 L 362.1 507.1 L 376.7 495 L 391.3 483.3 L 405.8 472.2 L 420.4 461.5 L 435 451.5 L 449.6 442.1 L 464.2 433.4 L 478.8 425.4 L 493.3 418.1 L 507.9 411.7 L 522.5 406 L 537.1 401.1 L 551.7 397.2 L 566.3 394 L 580.8 391.8 L 595.4 390.4 L 610 390 L 624.6 390.4 L 639.2 391.8 L 653.8 394 L 668.3 397.2 L 682.9 401.1 L 697.5 406 L 712.1 411.7 L 726.7 418.1 L 741.3 425.4 L 755.8 433.4 L 770.4 442.1 L 785 451.5 L 799.6 461.5 L 814.2 472.2 L 828.8 483.3 L 843.3 495 L 857.9 507.1 L 872.5 519.6 L 887.1 532.5 L 901.7 545.6 L 916.3 559 L 930.8 572.6 L 945.4 586.3 L 960 600 L 974.6 613.7 L 989.2 627.4 L 1003.8 641 L 1018.3 654.4 L 1032.9 667.5 L 1047.5 680.4 L 1062.1 692.9 L 1076.7 705 L 1091.3 716.7 L 1105.8 727.8 L 1120.4 738.5 L 1135 748.5 L 1149.6 757.9 L 1164.2 766.6 L 1178.8 774.6 L 1193.3 781.9 L 1207.9 788.3 L 1222.5 794 L 1237.1 798.9 L 1251.7 802.8 L 1266.3 806 L 1280.8 808.2 L 1295.4 809.6 L 1310 810 L 1324.6 809.6 L 1339.2 808.2 L 1353.8 806 L 1368.3 802.8 L 1382.9 798.9 L 1397.5 794 L 1412.1 788.3 L 1426.7 781.9 L 1441.3 774.6 L 1455.8 766.6 L 1470.4 757.9 L 1485 748.5 L 1499.6 738.5 L 1514.2 727.8 L 1528.7 716.7 L 1543.3 705 L 1557.9 692.9 L 1572.5 680.4 L 1587.1 667.5 L 1601.7 654.4 L 1616.3 641 L 1630.8 627.4 L 1645.4 613.7 L 1660 600" stroke="$blue" sw="7" fill="none"/>
      <group x="=260 + 222.8*u3()" y="=600 - 210*sin(u3())">
        <group rot="=atan2(-210*cos(u3()), 222.8) * 180 / PI">
          <line x1="-240" y1="0" x2="240" y2="0" stroke="$yellow" sw="5"><anim prop="draw" from="0" to="1" dur="0.8"/></line>
        </group>
        <circle r="40" fill="url(#dotglow)"/>
        <circle r="13" fill="$yellow"/>
      </group>
      <group x="1360" y="170">
        <rect x="-40" y="-70" w="460" h="140" r="18" fill="#1b2230" stroke="#2e3a4d" sw="2" shadow="0 12 30 #0009"/>
        <text x="0" y="0" size="56" fill="$muted" text="@slope"/>
        <text x="150" y="0" size="56" fill="$muted" text="@eq"/>
        <text x="210" y="0" size="64" weight="700" font="Inter" fill="=cos(u3()) &gt; 0.05 ? $green : cos(u3()) &lt; -0.05 ? $red : $yellow" text="{fmt(cos(u3()), 2)}"/>
      </group>
      <text x="610" y="300" size="34" align="center" fill="$yellow" text="@peak" when="=u3() &gt; 1.2 &amp;&amp; u3() &lt; 2.2"/>
      <text x="960" y="710" size="34" align="left" fill="$red" text="@fast" when="=u3() &gt; 2.7 &amp;&amp; u3() &lt; 3.7"/>
    </scene>

    <!-- 4 · the slope becomes a curve -->
    <scene id="slopecurve" dur="9" chapter="@ch4">
      <say at="0.3" text="@vo4"/>
      
      <group at="-5">
        <group opacity="0.22">
          <anim prop="opacity" from="0" to="0.22" dur="1.2"/>
          <line repeat="15" as="g" x1="=260 + g*100" y1="300" x2="=260 + g*100" y2="900" stroke="$grid" sw="1.5"/>
          <line repeat="7" as="g" x1="200" y1="=300 + g*100" x2="1720" y2="=300 + g*100" stroke="$grid" sw="1.5"/>
        </group>
        <line x1="200" y1="600" x2="1740" y2="600" stroke="$fg" sw="3"><anim prop="draw" from="0" to="1" dur="1.2" ease="io"/></line>
        <line x1="260" y1="880" x2="260" y2="310" stroke="$fg" sw="3"><anim prop="draw" from="0" to="1" at="0.3" dur="1.2" ease="io"/></line>
        <path x="1740" y="600" d="M -18 -10 L 0 0 L -18 10" stroke="$fg" sw="3" fill="none" at="1.2"/>
        <path x="260" y="310" d="M -10 18 L 0 0 L 10 18" stroke="$fg" sw="3" fill="none" at="1.4"/>
