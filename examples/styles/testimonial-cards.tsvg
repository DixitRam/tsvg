<?xml version="1.0" encoding="UTF-8"?>
<!-- Customer testimonials: review cards, star ratings filling, initials avatars, rating summary bars. -->
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
    <layout id="portrait" w="1080" h="1920"/>
  </layouts>
  <options>
    <option id="lang" default="en"><choice id="en" label="English" tts="kokoro:af_heart"/></option>
    <option id="mix" default="full"><choice id="full" label="Full"/><choice id="speech" label="Speech only"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.3" sfx="0.5"/><mix id="speech" voice="1" music="0" sfx="0"/></mixes>
  <themes><theme id="warm" bg="#f4efe6" fg="#1d1b18" muted="#7a7368" panel="#ffffff" track="#e7e0d4" gold="#f5a524" brand="#1f6f5c" brand2="#3f9b7f" brandsoft="#dcece6" warn="#d97757"/></themes>
  <strings>
    <s id="title" en="What homeowners say about Brightside Solar"/>
    <s id="brand" en="Brightside Solar"/>
    <s id="headline" en="Rooftop solar, rated by the people who live under it"/>
    <s id="outof" en="out of 5"/>
    <s id="kicker" en="REAL REVIEWS · VERIFIED INSTALLS"/>
    <s id="verified" en="Verified install"/>
    <s id="sumtitle" en="2,000 reviews at a glance"/>
    <s id="replies" en="We reply to every review under 4 stars"/>
    <s id="ctatitle" en="See if your roof qualifies"/>
    <s id="ctabtn" en="Book a free roof check"/>
    <s id="ctasub" en="15-minute visit · no obligation · read every review first"/>
    <s id="vo_intro" en="Two thousand homeowners have rated their Brightside rooftop solar install. Here is what they told us, in their own words."/>
    <s id="ch_intro" en="Ratings"/>
    <s id="vo_r1" en="Priya in Ahmedabad gave us five stars. Her bill dropped from four thousand two hundred rupees to six hundred in the first month."/>
    <s id="ch_r1" en="Priya Shah"/>
    <s id="vo_r2" en="Daniel in Pune liked that we showed him the shading report before quoting. No pressure, and no surprises."/>
    <s id="ch_r2" en="Daniel Okafor"/>
    <s id="vo_r3" en="Meera in Bengaluru gave four stars. The install was smooth, but the power company paperwork ran three weeks late."/>
    <s id="ch_r3" en="Meera Iyer"/>
    <s id="vo_r4" en="And the Mehtas in Surat say that after two monsoons, the panels still look brand new."/>
    <s id="ch_r4" en="Rahul &amp; Anjali Mehta"/>
    <s id="vo_summary" en="Across every review, the average is four point eight. Eighty-four percent are five stars, and we reply to every one below four."/>
    <s id="ch_summary" en="Summary"/>
    <s id="vo_cta" en="Thinking about solar? Book a free roof check, and read every review before you decide."/>
    <s id="ch_cta" en="Book a check"/>
  </strings>
  <defs>
    <data id="avi" v="PS, DO, MI, RM, KN"/>
    <data id="avc" v="#f97316, #6366f1, #a855f7, #10b981, #0ea5e9"/>
    <data id="bs" v="5,4,3,2,1"/>
    <data id="bc" v="1684,236,58,14,8"/>
    <data id="bp" v="84.2,11.8,2.9,0.7,0.4"/>
    <radial id="blob" x="0" y="0" r="420"><stop at="0" color="#f5a524" opacity="0.28"/><stop at="1" color="#f5a524" opacity="0"/></radial>
    <radial id="blob2" x="0" y="0" r="480"><stop at="0" color="#3f9b7f" opacity="0.22"/><stop at="1" color="#3f9b7f" opacity="0"/></radial>
    <linear id="avr1" x1="-60" y1="-60" x2="60" y2="60"><stop at="0" color="#f97316"/><stop at="1" color="#ef4444"/></linear>
    <linear id="avr2" x1="-60" y1="-60" x2="60" y2="60"><stop at="0" color="#0ea5e9"/><stop at="1" color="#6366f1"/></linear>
    <linear id="avr3" x1="-60" y1="-60" x2="60" y2="60"><stop at="0" color="#a855f7"/><stop at="1" color="#ec4899"/></linear>
    <linear id="avr4" x1="-60" y1="-60" x2="60" y2="60"><stop at="0" color="#10b981"/><stop at="1" color="#0d9488"/></linear>
    <clip id="sc0"><rect x="-38" y="-40" h="80" w="=394.4*ease((T-1.6)/1.3,'out')"/></clip>
    <clip id="sc1"><rect x="-26" y="-28" h="56" w="=295.2*ease((T-1.8)/1.3,'out')"/></clip>
    <clip id="sc2"><rect x="-30" y="-32" h="64" w="=316.0*ease((T-0.9)/1.3,'out')"/></clip>
    <clip id="sc3"><rect x="-30" y="-32" h="64" w="=316.0*ease((T-0.9)/1.3,'out')"/></clip>
    <clip id="sc4"><rect x="-30" y="-32" h="64" w="=252.0*ease((T-0.9)/1.3,'out')"/></clip>
    <clip id="sc5"><rect x="-30" y="-32" h="64" w="=316.0*ease((T-0.9)/1.3,'out')"/></clip>
  </defs>
  <assets>
    <asset id="pad" src="audio/pad.m4a"/><asset id="pop" src="audio/pop.m4a"/><asset id="ding" src="audio/ding.m4a"/><asset id="whoosh" src="audio/whoosh.m4a"/>
    <font family="Inter" src="fonts/Inter.ttf"/><font family="Playfair Display" src="fonts/PlayfairDisplay.ttf"/>
  </assets>
  <music src="pad" loop="1" vol="0.8"/>
  <backdrop>
    <circle x="=W*0.12 + 40*sin(t*0.2)" y="=H*0.15" r="420" fill="url(#blob)"/>
    <circle x="=W*0.9" y="=H*0.88 + 50*sin(t*0.17)" r="480" fill="url(#blob2)"/>
  </backdrop>
  <timeline>
    <scene id="intro" dur="9.31" chapter="@ch_intro">
      <say at="0.4" text="@vo_intro"/>
      <sfx at="0.05" src="pop"/>
      <group>
        <anim prop="opacity" from="1" to="0" at="=sdur-0.4" dur="0.4" ease="in"/>
      <group x="=W/2" y="250" y.portrait="420">
        <anim prop="opacity" from="0" to="1" dur="0.6"/>
        <circle x="-230" r="34" fill="$brand"/><circle x="-230" r="14" fill="$gold"/>
        <path repeat="8" as="k" x="-230" rot="=k*45 + T*20" d="M 0 -46 L 0 -58" stroke="$gold" sw="6"/>
        <text x="-180" size="46" weight="800" fill="$fg" text="@brand"/>
      </group>
      <text x="=W/2" y="430" y.portrait="640" size="84" size.portrait="76" weight="800" align="center" maxw="1500" maxw.portrait="900" lh="1.15" fill="$fg" text="@headline" at="0.3">
        <anim prop="opacity" from="0" to="1" dur="0.6"/><anim prop="y" from="=portrait ? 680 : 470" to="=portrait ? 640 : 430" dur="0.7"/>
      </text>
      <group x="=W/2" y="720" y.portrait="1100" at="1.2">
