        <text x="-250" y="90" size="30" align="center" fill="$muted" text="@outof"/>
        <group x="-70" y="-40" >
          <path repeat="5" as="s" x="=s*84" d="M 0.0 -34.0 L 9.0 -12.4 L 32.3 -10.5 L 14.6 4.7 L 20.0 27.5 L 0.0 15.3 L -20.0 27.5 L -14.6 4.7 L -32.3 -10.5 L -9.0 -12.4 Z" fill="$track"/>
          <group clip="url(#sc0)"><path repeat="5" as="s" x="=s*84" d="M 0.0 -34.0 L 9.0 -12.4 L 32.3 -10.5 L 14.6 4.7 L 20.0 27.5 L 0.0 15.3 L -20.0 27.5 L -14.6 4.7 L -32.3 -10.5 L -9.0 -12.4 Z" fill="$gold"/></group>
        </group>
        <text x="-70" y="60" size="34" weight="600" fill="$fg" text="{fmt(2000*ease((T-1.4)/1.6,'out'), 0)} verified reviews"/>
      </group>
      <group repeat="5" as="k" x="=W/2 - 160 + k*80" y="980" y.portrait="1520" at="=2.4 + k*0.12">
        <anim prop="scale" from="0" to="1" dur="0.4" ease="back"/>
        <circle r="44" fill="$panel"/><circle r="38" fill="=data('avc', k)"/>
        <text size="28" weight="800" align="center" y="1" fill="#fff" text="{data('avi', k)}"/>
      </group>
      </group>
    </scene>
