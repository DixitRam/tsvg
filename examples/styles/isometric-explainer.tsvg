<?xml version="1.0" encoding="UTF-8"?>
<tsvg version="0.2" title="@title" font="Inter">
  <layouts>
    <layout id="landscape" w="1920" h="1080"/>
  </layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English" tts="kokoro:am_michael"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Full (voice + music + sfx)"/><choice id="speech" label="Speech only"/><choice id="ambient" label="No voice"/></option>
    <option id="theme" label="Theme" default="light"><choice id="light" label="Light"/></option>
  </options>
  <mixes>
    <mix id="full" voice="1" music="0.35" sfx="0.7"/>
    <mix id="speech" voice="1" music="0" sfx="0"/>
    <mix id="ambient" voice="0" music="0.6" sfx="0.7"/>
  </mixes>
  <themes>
    <theme id="light" bg="#eef2fb" fg="#1e2a52" muted="#5b6688" accent="#6f8ff0"/>
  </themes>
  <strings>
    <s id="title" en="Where does your photo go?"/>
    <s id="ch1" en="Intro"/>
    <s id="ch2" en="Upload"/>
    <s id="ch3" en="Gateway"/>
    <s id="ch4" en="Storage"/>
    <s id="ch5" en="Thumbnails"/>
    <s id="ch6" en="Delivery"/>
    <s id="ch7" en="Recap"/>
    <s id="h1" en="Where does your photo go?"/>
    <s id="h1b" en="One backup, five stops in the cloud"/>
    <s id="c2" en="Chunk &amp; send"/>
    <s id="c2b" en="The phone splits the photo into small encrypted chunks."/>
    <s id="c3" en="Check who"/>
    <s id="c3b" en="The gateway verifies your account, then routes each chunk."/>
    <s id="c4" en="Three copies"/>
    <s id="c4b" en="Every chunk is written to three separate machines."/>
    <s id="c5" en="Make thumbnails"/>
    <s id="c5b" en="A worker renders small, medium and large previews."/>
    <s id="c6" en="Ship nearby"/>
    <s id="c6b" en="Previews are cached on edge servers close to you."/>
    <s id="o1" en="Safe in about 2 seconds"/>
    <s id="o2" en="chunks"/>
    <s id="o3" en="copies"/>
    <s id="o4" en="sizes"/>
    <s id="tag_ok" en="✓ signed in"/>
    <s id="tag_3" en="×3"/>
    <s id="vo_intro" en="What happens to a photo after you tap backup? Let us follow one through the cloud."/>
    <s id="vo_upload" en="First, your phone cuts the photo into small chunks and sends them over an encrypted connection."/>
    <s id="vo_gate" en="The gateway checks who you are, then hands each chunk on to storage."/>
    <s id="vo_store" en="Storage writes three copies on different machines, so one broken disk loses nothing."/>
    <s id="vo_work" en="Next, a worker picks up the new file and renders thumbnails in a few sizes."/>
    <s id="vo_cdn" en="Those thumbnails are pushed to servers near you, so your gallery opens fast on any device."/>
    <s id="vo_outro" en="Five stops, about two seconds, and your photo is safe."/>
  </strings>
  <defs>

    <linear id="chip" x1="0" y1="0" x2="110" y2="110"><stop at="0" color="#9db8ff"/><stop at="1" color="#6f8ff0"/></linear>
    <linear id="screen" x1="-60" y1="0" x2="60" y2="0"><stop at="0" color="#7aa2ff"/><stop at="1" color="#ff9a8b"/></linear>
    <radial id="bgglow" x="1300" y="560" r="900"><stop at="0" color="#ffffff"/><stop at="1" color="#eef2fb" opacity="0"/></radial>
  </defs>
  <assets>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <font family="Space Grotesk" src="fonts/SpaceGrotesk.ttf"/>
    <asset id="pulse" src="audio/pulse.ogg"/>
    <asset id="pop" src="audio/pop.ogg"/>
    <asset id="whoosh" src="audio/whoosh.ogg"/>
    <asset id="ding" src="audio/ding.ogg"/>
    <asset id="click" src="audio/click.ogg"/>
    <asset id="blip" src="audio/blip.ogg"/>

  </assets>
  <music src="pulse" start="0" loop="1" vol="0.6"/>
  <backdrop>
<rect w="1920" h="1080" fill="url(#bgglow)"/>
  </backdrop>
