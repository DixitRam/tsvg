    <scene id="filt" dur="10" chapter="@ch3">
      <say at="0.5" text="@vo_filt"/>

      
      <group x="140" y="130" at="0">
        <anim prop="opacity" from="0" to="1" dur="0.3"/>
        <text x="=-6*step(0.85, rand(floor(T*12)))*8" size="100" weight="900" italic="1" text="@filt" fill="#00f0ff" opacity="0.7" blend="screen"/>
        <text x="=6*step(0.85, rand(floor(T*12)+5))*8" size="100" weight="900" italic="1" text="@filt" fill="#ff2a6d" opacity="0.7" blend="screen"/>
        <text size="100" weight="900" italic="1" text="@filt" fill="url(#chrome100)" stroke="#ffffff" sw="1.5"/>
      </group>
      
      <rect x="300" y="230" w="1000" h="420" r="18" fill="#12002bcc" stroke="#00f0ff" sw="4" shadow="0 0 24 #00f0ff" at="0.2"><anim prop="opacity" from="0" to="1" dur="0.4"/></rect>
      <group x="380" y="610">
        <rect repeat="24" as="k" x="=k*36" y="0" w="24" ay="1" r="4"
          h="=(330/(1 + k*0.35)) * (0.6 + 0.4*abs(sin(t*6 + k))) * clamp(1 - (k - (23 - 20*ease((T-1)/4,'io')))/3, 0.06, 1)"
          fill="=mix('#00f0ff', '#ff2a6d', k/23)" shadow="0 0 10 #ff2a6d"/>
        
      </group>
      <line x1="=380 + 36*(23 - 20*ease((T-1)/4,'io')) + 12" y1="240" x2="=380 + 36*(23 - 20*ease((T-1)/4,'io')) + 12" y2="640" stroke="#ffe66d" sw="4" shadow="0 0 12 #ffb000"/>
      
