<scene id="pixel-art--tr--cross-dither" dur="4.4" chapter="Cross dither">
<sfx at="1.4" src="blip" vol="0.4"/>
<group when="=T&lt;2.8"><use ref="pxA"/></group><group when="=T&lt;2.8"><rect repeat="1296" as="c" x="=(c%48)*40" y="=floor(c/48)*40" w="41" h="41" fill="=data('px2',c)" opacity="=step((data('bay',(c%48)%4+4*(floor(c/48)%4))+0.5)/16, floor((clamp((T-(1.4))/1.4,0,1))/0.0625)*0.0625)"/></group><group when="=T&gt;=2.8"><use ref="pxB"/></group>
<group x="36" y="916"><rect w="752" h="128" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Cross dither"/><text x="24" y="66" size="21" fill="#c9d1e0" text="pixel-art · ◐ partial"/><text x="24" y="100" size="20" italic="1" fill="#ffd38a" text="coarse 40 px Bayer cells (one per art block), not a per-pixel mask"/></group>
</scene>
<scene id="pixel-art--tr--dissolve" dur="4.4" chapter="Dither dissolve">
<sfx at="1.2" src="blip" vol="0.4"/>
<group when="=T&lt;2.1"><use ref="pxA"/></group><group when="=T&gt;=2.1"><use ref="pxB"/></group><rect repeat="1296" as="c" x="=(c%48)*40" y="=floor(c/48)*40" w="41" h="41" fill="#10132b" opacity="=step((data('bay',(c%48)%4+4*(floor(c/48)%4))+0.5)/16, floor((((T&lt;2.1)*clamp((T-(1.2))/0.9,0,1)+(T&gt;=2.1)*(1-clamp((T-(2.2))/0.9,0,1))))/0.0625)*0.0625)"/>
<group x="36" y="916"><rect w="635" h="128" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Dither dissolve"/><text x="24" y="66" size="21" fill="#c9d1e0" text="pixel-art · ◐ partial"/><text x="24" y="100" size="20" italic="1" fill="#ffd38a" text="Bayer pattern as a 40 px repeat grid, not per art pixel"/></group>
</scene>
