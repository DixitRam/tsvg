<group when="=T&lt;2.3"><use ref="pxA"/></group><group when="=T&gt;=2.3"><use ref="pxB"/></group><rect x="=floor(((T&lt;2.05)*(1920*(1-ease(clamp((T-(1.4))/0.45,0,1),'io')))+(T&gt;=2.05)*(-1920*ease(clamp((T-(2.05))/0.45,0,1),'io')))/40)*40" y="0" w="1960" h="120" fill="#232a5c"/><rect x="=floor(((T&lt;2.05)*(1920*(1-ease(clamp((T-(1.4))/0.45,0,1),'io')))+(T&gt;=2.05)*(-1920*ease(clamp((T-(2.05))/0.45,0,1),'io')))/40)*40" y="0" w="40" h="120" fill="#ffd34e"/><rect x="=floor(((T&lt;2.1)*(1920*(1-ease(clamp((T-(1.45))/0.45,0,1),'io')))+(T&gt;=2.1)*(-1920*ease(clamp((T-(2.1))/0.45,0,1),'io')))/40)*40" y="120" w="1960" h="120" fill="#141a3a"/><rect x="=floor(((T&lt;2.1)*(1920*(1-ease(clamp((T-(1.45))/0.45,0,1),'io')))+(T&gt;=2.1)*(-1920*ease(clamp((T-(2.1))/0.45,0,1),'io')))/40)*40" y="120" w="40" h="120" fill="#ffd34e"/><rect x="=floor(((T&lt;2.15)*(1920*(1-ease(clamp((T-(1.5))/0.45,0,1),'io')))+(T&gt;=2.15)*(-1920*ease(clamp((T-(2.15))/0.45,0,1),'io')))/40)*40" y="240" w="1960" h="120" fill="#232a5c"/><rect x="=floor(((T&lt;2.15)*(1920*(1-ease(clamp((T-(1.5))/0.45,0,1),'io')))+(T&gt;=2.15)*(-1920*ease(clamp((T-(2.15))/0.45,0,1),'io')))/40)*40" y="240" w="40" h="120" fill="#ffd34e"/><rect x="=floor(((T&lt;2.2)*(1920*(1-ease(clamp((T-(1.55))/0.45,0,1),'io')))+(T&gt;=2.2)*(-1920*ease(clamp((T-(2.2))/0.45,0,1),'io')))/40)*40" y="360" w="1960" h="120" fill="#141a3a"/><rect x="=floor(((T&lt;2.2)*(1920*(1-ease(clamp((T-(1.55))/0.45,0,1),'io')))+(T&gt;=2.2)*(-1920*ease(clamp((T-(2.2))/0.45,0,1),'io')))/40)*40" y="360" w="40" h="120" fill="#ffd34e"/><rect x="=floor(((T&lt;2.25)*(1920*(1-ease(clamp((T-(1.6))/0.45,0,1),'io')))+(T&gt;=2.25)*(-1920*ease(clamp((T-(2.25))/0.45,0,1),'io')))/40)*40" y="480" w="1960" h="120" fill="#232a5c"/><rect x="=floor(((T&lt;2.25)*(1920*(1-ease(clamp((T-(1.6))/0.45,0,1),'io')))+(T&gt;=2.25)*(-1920*ease(clamp((T-(2.25))/0.45,0,1),'io')))/40)*40" y="480" w="40" h="120" fill="#ffd34e"/><rect x="=floor(((T&lt;2.3)*(1920*(1-ease(clamp((T-(1.65))/0.45,0,1),'io')))+(T&gt;=2.3)*(-1920*ease(clamp((T-(2.3))/0.45,0,1),'io')))/40)*40" y="600" w="1960" h="120" fill="#141a3a"/><rect x="=floor(((T&lt;2.3)*(1920*(1-ease(clamp((T-(1.65))/0.45,0,1),'io')))+(T&gt;=2.3)*(-1920*ease(clamp((T-(2.3))/0.45,0,1),'io')))/40)*40" y="600" w="40" h="120" fill="#ffd34e"/><rect x="=floor(((T&lt;2.35)*(1920*(1-ease(clamp((T-(1.7))/0.45,0,1),'io')))+(T&gt;=2.35)*(-1920*ease(clamp((T-(2.35))/0.45,0,1),'io')))/40)*40" y="720" w="1960" h="120" fill="#232a5c"/><rect x="=floor(((T&lt;2.35)*(1920*(1-ease(clamp((T-(1.7))/0.45,0,1),'io')))+(T&gt;=2.35)*(-1920*ease(clamp((T-(2.35))/0.45,0,1),'io')))/40)*40" y="720" w="40" h="120" fill="#ffd34e"/><rect x="=floor(((T&lt;2.4)*(1920*(1-ease(clamp((T-(1.75))/0.45,0,1),'io')))+(T&gt;=2.4)*(-1920*ease(clamp((T-(2.4))/0.45,0,1),'io')))/40)*40" y="840" w="1960" h="120" fill="#141a3a"/><rect x="=floor(((T&lt;2.4)*(1920*(1-ease(clamp((T-(1.75))/0.45,0,1),'io')))+(T&gt;=2.4)*(-1920*ease(clamp((T-(2.4))/0.45,0,1),'io')))/40)*40" y="840" w="40" h="120" fill="#ffd34e"/><rect x="=floor(((T&lt;2.45)*(1920*(1-ease(clamp((T-(1.8))/0.45,0,1),'io')))+(T&gt;=2.45)*(-1920*ease(clamp((T-(2.45))/0.45,0,1),'io')))/40)*40" y="960" w="1960" h="120" fill="#232a5c"/><rect x="=floor(((T&lt;2.45)*(1920*(1-ease(clamp((T-(1.8))/0.45,0,1),'io')))+(T&gt;=2.45)*(-1920*ease(clamp((T-(2.45))/0.45,0,1),'io')))/40)*40" y="960" w="40" h="120" fill="#ffd34e"/>
