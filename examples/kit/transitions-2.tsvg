<rect x="0" y="0" w="1920" h="1080" fill="#000"/><group when="=T&lt;5.6"><group x="=960+(-1300*pow(clamp((T-(5.38))/0.22,0,1),3))" y="=540+(0*pow(clamp((T-(5.38))/0.22,0,1),3))" blur="=36*clamp((T-(5.38))/0.22,0,1)"><group x="-960" y="-540"><group x="960" y="540" rot="=(T&gt;=3.6)*14*ease(clamp((T-(3.7))/1.5,0,1),'io')" scale="=1+(T&gt;=3.6)*0.22*ease(clamp((T-(3.7))/1.5,0,1),'io')"><group x="-960" y="-540"><group x="=960+(T&lt;1.8)*(-260*sin(PI*clamp((T-(0))/1.8,0,1)))" y="540" scale="=(1+(T&gt;=1.8 &amp;&amp; T&lt;3.6)*0.6*ease(clamp((T-(1.9))/1.5,0,1),'io'))"><group x="-960" y="-540"><image src="oldmap" x="-200" y="-120" w="2320" h="1320" fit="cover"/><rect x="-200" y="-120" w="2320" h="1320" fill="#f3e9d2" opacity="0.35"/></group></group><group x="=960+(T&lt;1.8)*(200*sin(PI*clamp((T-(0))/1.8,0,1)))" y="540" sx="=(T&lt;1.8)*(-0.22*sin(PI*clamp((T-(0))/1.8,0,1)))+1" scale="=(1-(T&gt;=1.8 &amp;&amp; T&lt;3.6)*0.12*ease(clamp((T-(1.9))/1.5,0,1),'io'))"><group x="-960" y="-540"><group x="960" y="560"><circle r="230" fill="#f3e9d2" stroke="#1b1e26" sw="10"/><circle r="200" fill="#e85d3a"/><text x="0" y="0" size="96" weight="800" align="center" fill="#fff" text="1914"/></group><rect x="560" y="140" w="800" h="100" fill="#ffe14d" rot="-1.5"/><text x="960" y="190" size="70" weight="800" align="center" fill="#1b1e26" text="Why borders moved"/></group></group></group></group></group></group></group><group when="=T&gt;=5.6"><group x="=960+(1300*pow(1-clamp((T-(5.6))/0.3,0,1),3))" y="=540+(0*pow(1-clamp((T-(5.6))/0.3,0,1),3))" blur="=36*pow(1-clamp((T-(5.6))/0.3,0,1),2)"><group x="-960" y="-540"><rect x="-100" y="-100" w="2120" h="1280" fill="#1b1e26"/><text x="960" y="480" size="120" weight="800" align="center" fill="#ffe14d" text="Then came 1945"/><text x="960" y="620" size="44" align="center" fill="#f3e9d2" text="a new map, drawn in weeks"/></group></group></group><group when="=T&gt;=0 &amp;&amp; T&lt;1.8"><rect x="865" y="36" w="190" h="64" r="32" fill="#0b0d12c8"/><text x="960" y="68" size="34" weight="700" align="center" fill="#ffffff" text="orbit"/></group><group when="=T&gt;=1.8 &amp;&amp; T&lt;3.6"><rect x="800" y="36" w="320" h="64" r="32" fill="#0b0d12c8"/><text x="960" y="68" size="34" weight="700" align="center" fill="#ffffff" text="dolly zoom"/></group><group when="=T&gt;=3.6 &amp;&amp; T&lt;5.3"><rect x="774" y="36" w="372" h="64" r="32" fill="#0b0d12c8"/><text x="960" y="68" size="34" weight="700" align="center" fill="#ffffff" text="roll / dutch"/></group><group when="=T&gt;=5.3 &amp;&amp; T&lt;6.6"><rect x="878" y="36" w="164" h="64" r="32" fill="#0b0d12c8"/><text x="960" y="68" size="34" weight="700" align="center" fill="#ffffff" text="whip"/></group>
<group x="36" y="916"><rect w="730" h="128" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Bold camera moves"/><text x="24" y="66" size="21" fill="#c9d1e0" text="vox-director · ◐ partial"/><text x="24" y="100" size="20" italic="1" fill="#ffd38a" text="orbit and dolly zoom faked in 2D (parallax, scaleX), not real 3D"/></group>
