<scene id="whiteboard--tr--page-flip" dur="4.4" chapter="Page flip">
<sfx at="1.4" src="whoosh" vol="0.4"/>
<use ref="wbB"/><group when="=T&gt;1.4 &amp;&amp; T&lt;2.7"><path d="='M '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-60)+' '+(-200)+' '+'L '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))+200)+' '+(-200)+' '+'L '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-1080+200)+' '+(1280)+' '+'L '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-1080-60)+' '+(1280)+' '+'Z'" fill="#00000028" blur="30"/></group><group when="=T&lt;2.7"><group clip="url(#c45)"><use ref="wbA"/></group></group><group when="=T&gt;1.4 &amp;&amp; T&lt;2.7"><path d="='M '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-min((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io')),1920)))+' '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-(min((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io')),1920)))+' '+'L '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-(max((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-1920,0)))+' '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-(1920))+' '+'L '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-(1080))+' '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-(1920))+' '+'L '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-(1080))+' '+((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-((3000-3100*ease(clamp((T-(1.4))/1.3,0,1),'io'))-1080))+' '+'Z'" fill="url(#pfG)" stroke="#d8d6cc" sw="3" shadow="-14 -14 30 #0005"/></group>
<group x="36" y="916"><rect w="550" h="128" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Page flip"/><text x="24" y="66" size="21" fill="#c9d1e0" text="whiteboard · ◐ partial"/><text x="24" y="100" size="20" italic="1" fill="#ffd38a" text="page curl approximated with a flat folding flap"/></group>
</scene>
