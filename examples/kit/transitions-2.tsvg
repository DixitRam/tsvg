<use ref="wbA"/><group when="=T&lt;2.25"><rect x="1290" y="366" w="=400*clamp(clamp((T-1.2)/1,0,0.9999)*4-0,0,1)" h="73" fill="#f7f6f1"/><rect x="=1290+400*(1-clamp(clamp((T-1.2)/1,0,0.9999)*4-1,0,1))" y="431" w="=400*clamp(clamp((T-1.2)/1,0,0.9999)*4-1,0,1)" h="73" fill="#f7f6f1"/><rect x="1290" y="496" w="=400*clamp(clamp((T-1.2)/1,0,0.9999)*4-2,0,1)" h="73" fill="#f7f6f1"/><rect x="=1290+400*(1-clamp(clamp((T-1.2)/1,0,0.9999)*4-3,0,1))" y="561" w="=400*clamp(clamp((T-1.2)/1,0,0.9999)*4-3,0,1)" h="73" fill="#f7f6f1"/></group><group when="=T&gt;=2.25"><rect x="1290" y="366" w="400" h="268" fill="#f7f6f1"/></group><group when="=T&gt;=2.25"><path d="M 1300 380 L 1680 380 L 1680 620 L 1300 620 Z" fill="none" stroke="#2f9d5a" sw="8" draw="=clamp((T-(2.25))/0.6,0,1)"/><text x="1490" y="500" size="72" font="Caveat" weight="700" align="center" fill="#2f9d5a" text="Ship!" reveal="=clamp((T-(2.65))/0.5,0,1)"/></group><group when="=T&gt;=1.2 &amp;&amp; T&lt;2.25"><group x="=1290+(floor(clamp((T-1.2)/1,0,0.9999)*4)%2==0)*lerp(0,400,fract(clamp((T-1.2)/1,0,0.9999)*4))+(floor(clamp((T-1.2)/1,0,0.9999)*4)%2==1)*lerp(400,0,fract(clamp((T-1.2)/1,0,0.9999)*4))" y="=402.5+floor(clamp((T-1.2)/1,0,0.9999)*4)*65" rot="-12"><rect x="-90" y="-40" w="180" h="80" r="12" fill="#2f6fd6"/><rect x="-90" y="20" w="180" h="26" r="6" fill="#4a4a4a"/><ellipse x="10" y="-70" rx="80" ry="46" fill="#f2c28b" stroke="#c48d5a" sw="4"/><rect x="40" y="-130" w="60" h="120" r="30" fill="#f2c28b" stroke="#c48d5a" sw="4" rot="20"/></group></group>
