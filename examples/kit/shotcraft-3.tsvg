    <scene id="video-shotcraft--rhythm--speed-ramp-freeze" dur="4.4" chapter="speed-ramp-freeze"><rect x="0" y="0" w="1920" h="1080" fill="#05070e"/><group repeat="6" as="i"><group x="=fract((T&lt;1.4 ? T : T&lt;2.9 ? 1.4+0.15*ease(clamp((T-1.4)/0.4,0,1),'out') : 1.55+(T-2.9)*1.6)*0.35+i/6)*2400-240" y="=300+i%3*200" rot="=(T&lt;1.4 ? T : T&lt;2.9 ? 1.4+0.15*ease(clamp((T-1.4)/0.4,0,1),'out') : 1.55+(T-2.9)*1.6)*60+i*30"><rect x="-60" y="-60" w="120" h="120" r="26" fill="=data('sr',i)"/></group></group><circle x="=fract(1.55*0.35+0/6)*2400-240" y="300" r="110" arc="1" from="0" to="=360*eo(1.6,0.5)" fill="none" stroke="#ffb547" sw="6" opacity="=step(1.6,T)*(1-step(2.9,T))"/><text x="960" y="920" size="40" text="time freezes: annotate, then resume" weight="700" align="center" fill="#ffb547" opacity="=step(1.6,T)*(1-step(2.9,T))"/><text x="1840" y="80" size="40" text="=T&lt;1.4 ? &quot;1.0x&quot; : T&lt;2.9 ? &quot;0x&quot; : &quot;1.6x&quot;" font="JetBrainsMono" align="right" fill="#fff"/><sfx at="1.4" src="click"/><sfx at="2.9" src="whoosh"/><group x="32" y="1030"><rect x="0" y="-27" w="503.53" h="54" r="27" fill="#0a0c12d9" stroke="#ffffff26" sw="1.5"/><group><circle x="30" y="0" r="13" fill="#34d399"/><path d="M23.5 0.5 L28.5 5.5 L37 -4.5" fill="none" stroke="#06281b" sw="3.4"/></group><text x="54" y="0" size="24" text="speed-ramp-freeze" weight="700" fill="#ffffff"/><text x="288.06" y="1" size="18" text="video-shotcraft" weight="500" fill="#a3acc0"/><text x="429.91" y="1" size="18" text="native" weight="700" fill="#34d399"/></group></scene>
    <scene id="video-shotcraft--rhythm--trailer-grammar-moves" dur="4.2" chapter="trailer-grammar-moves"><rect x="0" y="0" w="1920" h="1080" fill="#000"/><group at="0.1" dur="0.3"><image src="city" x="0" y="0" w="1920" h="1080" scale="=1.05+0.1*fract(T*3)"/></group><group at="0.4" dur="0.3"><image src="factory" x="0" y="0" w="1920" h="1080" scale="=1.05+0.1*fract(T*3)"/></group><group at="0.7" dur="0.3"><image src="nebula" x="0" y="0" w="1920" h="1080" scale="=1.05+0.1*fract(T*3)"/></group><text x="960" y="500" size="200" text="LUMEN" font="Anton" align="center" fill="#fff" at="1.6" opacity="=eo(1.6,0.2)" scale="=lerp(1.08,1,eo(1.6,2))"/><text x="960" y="660" size="40" text="THIS SPRING" weight="700" align="center" fill="#bbb" at="2.2" opacity="=eo(2.2,0.4)"/><sfx at="0.1" src="click"/><sfx at="0.4" src="click"/><sfx at="0.7" src="click"/><sfx at="1.6" src="drone"/><group x="32" y="1030"><rect x="0" y="-27" w="547.7" h="54" r="27" fill="#0a0c12d9" stroke="#ffffff26" sw="1.5"/><group><circle x="30" y="0" r="13" fill="#34d399"/><path d="M23.5 0.5 L28.5 5.5 L37 -4.5" fill="none" stroke="#06281b" sw="3.4"/></group><text x="54" y="0" size="24" text="trailer-grammar-moves" weight="700" fill="#ffffff"/><text x="332.23" y="1" size="18" text="video-shotcraft" weight="500" fill="#a3acc0"/><text x="474.08" y="1" size="18" text="native" weight="700" fill="#34d399"/></group></scene>
    <scene id="video-shotcraft--rhythm--beat-step-list-theme-cycle" dur="4.2" chapter="beat-step-list-theme-cycle"><rect x="0" y="0" w="1920" h="1080" fill="=data('bc',max(0,step(0.5,T)+step(1.3,T)+step(2.1,T)+step(2.9,T)-1))"/><text x="760" y="540" size="104" text="Lumen is" weight="800" align="right" fill="#fff"/><rect x="800" y="470" w="640" h="140" r="70" fill="#ffffff" opacity="0.95"/><text x="1120" y="=540+(0-(eb(1.3,0.3)+eb(2.1,0.3)+eb(2.9,0.3)))*130" size="96" text="quiet." weight="800" align="center" fill="=abs(0-(eb(1.3,0.3)+eb(2.1,0.3)+eb(2.9,0.3)))&lt;0.4 ? '#111' : '#ffffff66'"/><text x="1120" y="=540+(1-(eb(1.3,0.3)+eb(2.1,0.3)+eb(2.9,0.3)))*130" size="96" text="fast." weight="800" align="center" fill="=abs(1-(eb(1.3,0.3)+eb(2.1,0.3)+eb(2.9,0.3)))&lt;0.4 ? '#111' : '#ffffff66'"/><text x="1120" y="=540+(2-(eb(1.3,0.3)+eb(2.1,0.3)+eb(2.9,0.3)))*130" size="96" text="focused." weight="800" align="center" fill="=abs(2-(eb(1.3,0.3)+eb(2.1,0.3)+eb(2.9,0.3)))&lt;0.4 ? '#111' : '#ffffff66'"/><text x="1120" y="=540+(3-(eb(1.3,0.3)+eb(2.1,0.3)+eb(2.9,0.3)))*130" size="96" text="yours." weight="800" align="center" fill="=abs(3-(eb(1.3,0.3)+eb(2.1,0.3)+eb(2.9,0.3)))&lt;0.4 ? '#111' : '#ffffff66'"/><sfx at="0.5" src="pulse" vol="0.5"/><sfx at="1.3" src="pulse" vol="0.5"/><sfx at="2.1" src="pulse" vol="0.5"/><sfx at="2.9" src="pulse" vol="0.5"/><group x="32" y="1030"><rect x="0" y="-27" w="592.01" h="54" r="27" fill="#0a0c12d9" stroke="#ffffff26" sw="1.5"/><group><circle x="30" y="0" r="12" fill="none" stroke="#fbbf24" sw="3"/><circle x="30" y="0" r="12" from="180" to="360" fill="#fbbf24"/></group><text x="54" y="0" size="24" text="beat-step-list-theme-cycle" weight="700" fill="#ffffff"/><text x="375.31" y="1" size="18" text="video-shotcraft" weight="500" fill="#a3acc0"/><text x="517.16" y="1" size="18" text="partial" weight="700" fill="#fbbf24"/><rect x="0" y="-88" w="779.04" h="40" r="12" fill="#0a0c12c4"/><text x="18" y="-68" size="19" text="TSVG compromise: beats