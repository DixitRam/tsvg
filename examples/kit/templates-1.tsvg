    <scene id="slideshow--page-to-deck" dur="6.3" chapter="Convert a web page into a deck"><sfx at="1.4" src="whoosh"/><sfx at="2.8" src="whoosh"/><sfx at="4.2" src="whoosh"/><rect w="1920" h="1080" fill="#11141b"/><text text="web page" x="110" y="200" size="28" weight="700" fill="#8792a8"/><rect x="102" y="242" w="688" h="436" r="10" fill="#1d2230"/><image src="ui-spec" x="110" y="250" w="672" h="420"/><rect x="110" y="250" w="420" h="236.46" fill="none" stroke="#ffb35c" sw="4" at="0.3" opacity="=T &gt;= 1.4 &amp;&amp; T &lt; 2.8 ? 1 : 0.35"/><rect x="236" y="359.2" w="420" h="236.46" fill="none" stroke="#ffb35c" sw="4" at="0.55" opacity="=T &gt;= 2.8 &amp;&amp; T &lt; 4.199999999999999 ? 1 : 0.35"/><rect x="362" y="433.54" w="420" h="236.46" fill="none" stroke="#ffb35c" sw="4" at="0.8" opacity="=T &gt;= 4.199999999999999 &amp;&amp; T &lt; 5.6 ? 1 : 0.35"/><text text="deck" x="720" y="200" size="28" weight="700" fill="#8792a8"/><rect x="712" y="222" w="1116" h="635" r="16" fill="none" stroke="#2c3446" sw="2"/><group clip="url(#deckClip)"><group x="=720 + 1200*(1 - ease(clamp((T-1.4)/0.5,0,1),'io')) - 1200*ease(clamp((T-2.8)/0.5,0,1),'io')" y="230" clip="url(#slideClip)" when="=T &gt;= 1.4 &amp;&amp; T &lt; 3.4"><rect w="1100" h="619" fill="#ffffff"/><image src="ui-spec" x="0.27" y="0.5" w="1759.15" h="1099.47"/></group><group x="=720 + 1200*(1 - ease(clamp((T-2.8)/0.5,0,1),'io')) - 1200*ease(clamp((T-4.199999999999999)/0.5,0,1),'io')" y="230" clip="url(#slideClip)" when="=T &gt;= 2.8 &amp;&amp; T &lt; 4.799999999999999"><rect w="1100" h="619" fill="#ffffff"/><image src="ui-spec" x="-329.57" y="-285.36" w="1759.15" h="1099.47"/></group><group x="=720 + 1200*(1 - ease(clamp((T-4.199999999999999)/0.5,0,1),'io')) - 1200*ease(clamp((T-5.6)/0.5,0,1),'io')" y="230" clip="url(#slideClip)" when="=T &gt;= 4.199999999999999 &amp;&amp; T &lt; 6.199999999999999"><rect w="1100" h="619" fill="#ffffff"/><image src="ui-spec" x="-659.41" y="-479.97" w="1759.15" h="1099.47"/></group>