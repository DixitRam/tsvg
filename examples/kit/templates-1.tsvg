    <scene id="particle-system" dur="5" chapter="Particle system"><sfx at="0.4" src="pop"/><rect w="1920" h="1080" fill="#141026"/><text text="Launch day" x="960" y="470" size="150" weight="900" align="center" fill="#ffffff" font="Space Grotesk" at="0.35"><anim prop="scale" from="0.6" to="1" at="0" dur="0.5" ease="back"/><anim prop="opacity" from="0" to="1" at="0" dur="0.2" ease="out"/></text><text text="confetti: 300 particles · gravity + drag" x="960" y="590" size="30" align="center" fill="#ffffff88" at="0.6"><anim prop="opacity" from="0" to="1" at="0" dur="0.3" ease="out"/></text><rect repeat="300" as="i" at="0.4" x="=960 + (rand(i*1.3) - 0.5)*2600*(1 - exp(-1.6*max(0, T - 0.4)))/1.6 + 30*sin(max(0, T - 0.4)*4 + i)" y="=1060 + -(900 + 1300*rand(i*2.7))*(1 - exp(-1.6*max(0, T - 0.4)))/1.6 + 900*(max(0, T - 0.4) - (1 - exp(-1.6*max(0, T - 0.4)))/1.6)/1.6*1.4" w="=10 + 10*rand(i*5.1)" h="=6 + 6*rand(i*6.3)" ax="0.5" ay="0.5" fill="=data('cf_pal', floor(rand(i*8.8)*6))" rot="=max(0, T - 0.4)*(200 + 500*rand(i*9.9))" sy="=cos(max(0, T - 0.4)*(5 + 6*rand(i)))"/><group x="32" y="944" opacity="0.94"><anim prop="opacity" from="0" to="1" at="0.15" dur="0.4" ease="out"/><rect w="734.527" h="104" r="14" fill="#0b0e14d9" stroke="#ffffff26" sw="1"/><group x="28" y="26"><circle x="0" y="0" r="11" fill="none" stroke="#ffb547" sw="2.5"/><circle x="0" y="0" r="11" from="90" to="270" fill="#ffb547"/></group><text text="Particle system" x="50" y="26" size="24" weight="700" fill="#ffffff" font="Inter"/><text text="particle-system · partial" x="50" y="55" size="19" weight="500" fill="#ffd08a" font="Inter"/><text text="compromise: closed-form ballistic motion only; no stateful force integration" x="50" y="83" size="19" weight="500" italic="1" fill="#c9d1e0" font="Inter"/></group></scene>
