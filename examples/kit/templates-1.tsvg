    <scene id="motion-graphics--3d-page-scroll" dur="5.5" chapter="3D page scroll"><rect w="1920" h="1080" fill="#0c0f16"/><circle x="960" y="200" r="600" fill="#2f5bea33" blur="120"/><group repeat="60" as="k" x="960" y="=data('ps_y',k)" scale="=data('ps_s',k)" clip="url(#psStrip)"><image src="ui-github" x="-700" y="=-data('ps_o',k) - (80 + 150*T)" w="1400" h="875"/><image src="ui-spec" x="-700" y="=875 - data('ps_o',k) - (80 + 150*T)" w="1400" h="875"/></group><rect x="0" y="140" w="1920" h="200" fill="url(#psFog)"/><group x="32" y="32" opacity="0.94"><anim prop="opacity" from="0" to="1" at="0.15" dur="0.4" ease="out"/><rect w="716.58" h="104" r="14" fill="#0b0e14d9" stroke="#ffffff26" sw="1"/><group x="28" y="26"><circle x="0" y="0" r="11" fill="none" stroke="#ffb547" sw="2.5"/><circle x="0" y="0" r="11" from="90" to="270" fill="#ffb547"/></group><text text="3D page scroll" x="50" y="26" size="24" weight="700" fill="#ffffff" font="Inter"/><text text="motion-graphics · partial" x="50" y="55" size="19" weight="500" fill="#ffd08a" font="Inter"/><text text="compromise: 2.5D: the page is cut into strips scaled by depth, not real 3D" x="50" y="83" size="19" weight="500" italic="1" fill="#c9d1e0" font="Inter"/></group></scene>
    <scene id="motion-graphics--viewport-change" dur="5" chapter="Viewport change"><rect w="1920" h="1080" fill="#e9ecf2"/><group x="960" y="520"><rect x="=-lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io'))/2" y="=-lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io'))/2" w="=lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io'))" h="=lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io'))" r="=lerp(14, 48, ease(clamp((T-1.7)/1,0,1),'io'))" fill="#1b1e26" shadow="0 24 60 #00000040"/><rect x="=-lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 12" y="=-lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 44" w="=lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io')) - 24" h="=lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io')) - 56" r="10" fill="#ffffff"/><image src="ui-playground" x="=-lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 12" y="=-lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 44" w="=lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io')) - 24" h="=lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io')) - 56" r="10" fit="cover" opacity="=1 - ease(clamp((T-1.7)/1,0,1),'io')"/><image src="ui-phone-playground" x="=-lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 12" y="=-lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 44" w="=lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io')) - 24" h="=lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io')) - 56" r="10" fit="cover" opacity="=ease(clamp((T-1.7)/1,0,1),'io')"/><circle x="=-lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 30" y="=-lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 22" r="7" fill="#ff5f57"/><circle x="=-lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 52" y="=-lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 22" r="7" fill="#febc2e"/><circle x="=-lerp(1500, 430, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 74" y="=-lerp(900, 880, ease(clamp((T-1.7)/1,0,1),'io'))/2 + 22" r="7" fill="#28c840"/></group><text text="=fmt(lerp(1440, 390, ease(clamp((T-1.7)/1,0,1),'io')),0) + &quot; px&quot;" x="960" y="1015" size="30" weight="700" 