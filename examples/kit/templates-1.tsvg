    <scene id="particle-system--gpu-points" dur="5" chapter="GPU points with life/respawn"><rect w="1920" h="1080" fill="#040510"/><circle x="960" y="540" r="160" fill="#ffcf8a55" blur="90"/><circle repeat="3000" as="i" x="=960 + (30 + 470*sqrt(rand(i*1.7 + floor((T/2.5 + rand(i*3.3)))*13.1)))*cos((rand(i*2.9 + floor((T/2.5 + rand(i*3.3)))*7.7)*0.9 + (i % 3)*2.094 + (30 + 470*sqrt(rand(i*1.7 + floor((T/2.5 + rand(i*3.3)))*13.1)))*0.0085 + T*(0.9 - (30 + 470*sqrt(rand(i*1.7 + floor((T/2.5 + rand(i*3.3)))*13.1)))*0.0011)))*1.35" y="=540 + (30 + 470*sqrt(rand(i*1.7 + floor((T/2.5 + rand(i*3.3)))*13.1)))*sin((rand(i*2.9 + floor((T/2.5 + rand(i*3.3)))*7.7)*0.9 + (i % 3)*2.094 + (30 + 470*sqrt(rand(i*1.7 + floor((T/2.5 + rand(i*3.3)))*13.1)))*0.0085 + T*(0.9 - (30 + 470*sqrt(rand(i*1.7 + floor((T/2.5 + rand(i*3.3)))*13.1)))*0.0011)))*0.8" r="=1.2 + 1.6*rand(i*0.7)" fill="=rand(i*4.1) &gt; 0.7 ? '#ffd9a0' : rand(i*4.1) &gt; 0.35 ? '#a9c4ff' : '#ffffff'" opacity="=sin(fract((T/2.5 + rand(i*3.3)))*PI)"/><text text="3,000 points · each respawns every 2.5 s" x="1880" y="60" size="24" align="right" fill="#ffffff99"/><group x="32" y="944" opacity="0.94"><anim prop="opacity" from="0" to="1" at="0.15" dur="0.4" ease="out"/><rect w="725.917" h="104" r="14" fill="#0b0e14d9" stroke="#ffffff26" sw="1"/><group x="28" y="26"><circle x="0" y="0" r="11" fill="none" stroke="#ffb547" sw="2.5"/><circle x="0" y="0" r="11" from="90" to="270" fill="#ffb547"/></group><text text="GPU points with life/respawn" x="50" y="26" size="24" weight="700" fill="#ffffff" font="Inter"/><text text="particle-system · partial" x="50" y="55" size="19" weight="500" fill="#ffd08a" font="Inter"/><text text="compromise: 3,000 points via repeat; GPU scale (tens of thousands) is not" x="50" y="83" size="19" weight="500" italic="1" fill="#c9d1e0" font="Inter"/></group></scene>
