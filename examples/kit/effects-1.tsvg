<?xml version="1.0" encoding="UTF-8"?>
<tsvg version="0.2" title="Edit Kit effects in TSVG (1)" font="Inter">
  <layouts><layout id="landscape" w="1920" h="1080"/></layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Music + sfx"/><choice id="quiet" label="Sfx only"/></option>
    <option id="theme" label="Theme" default="dark"><choice id="dark" label="Dark"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.3" sfx="0.75"/><mix id="quiet" voice="1" music="0" sfx="0.75"/></mixes>
  <themes><theme id="dark" bg="#0c0e13" fg="#f2f4f8" muted="#8a93a6" accent="#7aa2ff"/></themes>
  <assets>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <font family="Anton" src="fonts/Anton.ttf"/>
    <font family="Caveat" src="fonts/Caveat.ttf"/>
    <font family="JetBrains Mono" src="fonts/JetBrainsMono.ttf"/>
    <font family="Playfair Display" src="fonts/PlayfairDisplay.ttf"/>
    <font family="Space Grotesk" src="fonts/SpaceGrotesk.ttf"/>
    <font family="VT323" src="fonts/VT323.ttf"/>
    <asset id="blip" src="audio/blip.m4a"/>
    <asset id="bright" src="audio/bright.m4a"/>
    <asset id="click" src="audio/click.m4a"/>
    <asset id="ding" src="audio/ding.m4a"/>
    <asset id="drone" src="audio/drone.m4a"/>
    <asset id="pad" src="audio/pad.m4a"/>
    <asset id="pop" src="audio/pop.m4a"/>
    <asset id="pulse" src="audio/pulse.m4a"/>
    <asset id="typing" src="audio/typing.m4a"/>
    <asset id="whoosh" src="audio/whoosh.m4a"/>
    <asset id="img-city" src="images/city.jpg"/>
    <asset id="img-factory" src="images/factory.jpg"/>
    <asset id="img-food" src="images/food.jpg"/>
    <asset id="img-mountains" src="images/mountains.jpg"/>
    <asset id="img-nebula" src="images/nebula.jpg"/>
    <asset id="img-oldmap" src="images/oldmap.jpg"/>
    <asset id="img-paper" src="images/paper.jpg"/>
    <asset id="img-ui-github" src="images/ui-github.jpg"/>
    <asset id="img-ui-phone-playground" src="images/ui-phone-playground.jpg"/>
    <asset id="img-ui-playground" src="images/ui-playground.jpg"/>
    <asset id="img-ui-spec" src="images/ui-spec.jpg"/>
    <asset id="img-ui-taskmanager-login" src="images/ui-taskmanager-login.jpg"/>
    <asset id="img-workspace" src="images/workspace.jpg"/>
  </assets>
  <defs>
    <symbol id="ac-face">
      <circle r="110" fill="#ffe3cf" stroke="#2b1d1d" sw="5"/>
      <ellipse x="-44" y="18" rx="17" ry="25" fill="#2b1d1d"/><ellipse x="44" y="18" rx="17" ry="25" fill="#2b1d1d"/>
      <circle x="-38" y="8" r="7" fill="#ffffff"/><circle x="50" y="8" r="7" fill="#ffffff"/>
      <ellipse x="-70" y="56" rx="16" ry="8" fill="#ff9aa8" opacity="0.6"/><ellipse x="70" y="56" rx="16" ry="8" fill="#ff9aa8" opacity="0.6"/>
      <path d="M -16 66 Q 0 76 16 66" stroke="#2b1d1d" sw="4"/>
      <path d="M -120 0 C -132 -120 -40 -152 10 -142 C 92 -140 142 -80 120 2 C 108 -40 84 -70 50 -84 L 40 -50 L 18 -88 C -10 -92 -30 -80 -48 -66 L -60 -30 L -70 -70 C -98 -54 -112 -30 -120 0 Z" fill="#3b2a55" stroke="#2b1d1d" sw="4"/>
      <path d="M -80 -96 Q -30 -118 30 -112" stroke="#8f7ad8" sw="7" opacity="0.8"/>
    </symbol>
    <symbol id="ac-star"><path d="M 0 -30 Q 4 -4 30 0 Q 4 4 0 30 Q -4 4 -30 0 Q -4 -4 0 -30 Z" fill="#fff7c2"/></symbol>
    <symbol id="ac-heart"><path d="M 0 22 C -30 0 -34 -22 -18 -30 C -8 -35 0 -28 0 -20 C 0 -28 8 -35 18 -30 C 34 -22 30 0 0 22 Z" fill="#ff4d7a"/></symbol>
    <symbol id="person"><circle y="-150" r="78" fill="#1a1d26"/><path d="M -190 140 C -180 0 -110 -50 0 -50 C 110 -50 180 0 190 140 Z" fill="#1a1d26"/></symbol>
    <linear id="ac-sky" x1="0" y1="0" x2="0" y2="1080"><stop at="0" color="#4f8fe6"/><stop at="0.7" color="#bfe3ff"/><stop at="1" color="#fff3df"/></linear>
    <clip id="frame"><rect w="1920" h="1080"/></clip>
    <data id="spx" v="-120, 110, 130, -90"/>
    <data id="spy" v="-110, -120, 40, 60"/>
    <data id="skx" v="-260, 240, -200, 210, 0, -330, 330, -120, 140, -40, 60, 280, -280, 190, -170, 20"/>
    <data id="sky" v="-150, -170, 120, 140, -250, -10, 30, -230, 210, 230, -200, -80, 70, -60, 190, 260"/>
    <data id="gbx" v="420, 1500, 900, 1600"/>
    <data id="gby" v="300, 260, 820, 860"/>
    <data id="gbc" v="#5b4bff, #ff4bb3, #2fd0ff, #ff9a3b"/>
    <data id="lsc" v="#c9d7ff, #ffd6ec, #d4f5e8, #ffe7c4"/>
    <linear id="pt-sky" x1="0" y1="0" x2="0" y2="1080"><stop at="0" color="#ffb48a"/><stop at="1" color="#ffe5d0"/></linear>
    <clip id="bb-band"><rect y="=600 - 170*ease(clamp((T-(0.8))/(0.25),0,1),'out')" w="1920" h="=340*ease(clamp((T-(0.8))/(0.25),0,1),'out')"/></clip>
    <linear id="tr-bg" x1="0" y1="0" x2="0" y2="1080"><stop at="0" color="#1b1e27"/><stop at="1" color="#050608"/></linear>
    <clip id="tr-wipe"><rect x="520" y="540" w="=900*ease(clamp((T-(2.1))/(0.7),0,1),'io')" h="140"/></clip>
    <radial id="cs-vig" x="960" y="540" r="1150"><stop at="0.5" color="#000000" opacity="0"/><stop at="1" color="#5a3a1a" opacity="0.55"/></radial>
    <clip id="cs-border"><rect w="1920" h="70"/><rect y="1010" w="1920" h="70"/><rect w="70" h="1080"/><rect x="1850" w="70" h="1080"/></clip>
    <linear id="pb-fill" x1="368" y1="0" x2="1552" y2="0"><stop at="0" color="#7aa2ff"/><stop at="1" color="#c08bff"/></linear>
    <linear id="sh-gold" x1="460" y1="0" x2="1460" y2="0"><stop at="0" color="#b8860b"/><stop at="=ease(clamp((T-(0.6))/(1.4),0,1),'io')*1.3 - 0.25" color="#b8860b"/><stop at="=ease(clamp((T-(0.6))/(1.4),0,1),'io')*1.3 - 0.15" color="#fff6c8"/><stop at="=ease(clamp((T-(0.6))/(1.4),0,1),'io')*1.3 - 0.05" color="#b8860b"/><stop at="1" color="#b8860b"/></linear>
    <linear id="sh-silver" x1="560" y1="0" x2="1360" y2="0"><stop at="0" color="#8e98a8"/><stop at="=ease(clamp((T-(2))/(1.4),0,1),'io')*1.3 - 0.25" color="#8e98a8"/><stop at="=ease(clamp((T-(2))/(1.4),0,1),'io')*1.3 - 0.15" color="#ffffff"/><stop at="=ease(clamp((T-(2))/(1.4),0,1),'io')*1.3 - 0.05" color="#8e98a8"/><stop at="1" color="#8e98a8"/></linear>
    <clip id="cb-box"><rect x="=60*(ease(clamp((T-(0.8))/(0.8),0,1),'io') - ease(clamp((T-(3.6))/(0.7),0,1),'io'))" y="=90*(ease(clamp((T-(0.8))/(0.8),0,1),'io') - ease(clamp((T-(3.6))/(0.7),0,1),'io'))" w="=1920 - 1240*(ease(clamp((T-(0.8))/(0.8),0,1),'io') - ease(clamp((T-(3.6))/(0.7),0,1),'io'))" h="=1080 - 180*(ease(clamp((T-(0.8))/(0.8),0,1),'io') - ease(clamp((T-(3.6))/(0.7),0,1),'io'))" r="=40*(ease(clamp((T-(0.8))/(0.8),0,1),'io') - ease(clamp((T-(3.6))/(0.7),0,1),'io'))"/></clip>
    <linear id="cb-bg" x1="0" y1="0" x2="0" y2="1080"><stop at="0" color="#d7c7b4"/><stop at="1" color="#8f7c68"/></linear>
    <linear id="wb-sky" x1="0" y1="0" x2="0" y2="1080"><stop at="0" color="#ff7e5f"/><stop at="1" color="#feb47b"/></linear>
    <linear id="pa-sky" x1="0" y1="0" x2="0" y2="1080"><stop at="0" color="#020414"/><stop at="1" color="#0b1a33"/></linear>
  </defs>
  <music src="pulse" loop="1" vol="0.6"/>
  <timeline>
    <scene id="anime-cel--reactions" dur="5" chapter="Anime reaction emotes">
      <sfx at="0.6" src="pop"/><sfx at="1.1" src="pop"/><sfx at="1.6" src="whoosh" vol="0.4"/><sfx at="2.1" src="blip"/><sfx at="2.6" src="ding" vol="0.5"/>
      <rect w="1920" h="1080" fill="url(#ac-sky)"/><group x="240" y="500" scale="0.92"><use ref="ac-face"/><path x="100" y="-70" d="M 0 -34 C 14 -10 22 4 22 16 A 22 22 0 0 1 -22 16 C -22 4 -14 -10 0 -34 Z" fill="#a8dcff" stroke="#2b6c9c" sw="3"><anim prop="scale" from="0" to="1" at="0.6" dur="0.22" ease="back"/></path><text y="190" size="34" weight="700" align="center" fill="#1b2a44" text="sweat drop"/></group><group x="600" y="500" scale="0.92"><use ref="ac-face"/><group x="78" y="-92" at="1.1"><anim prop="scale" from="0" to="1" at="0" dur="0.18" ease="back"/><path repeat="4" rot="=i*90" d="M 8 -26 Q 8 -8 26 -8" stroke="#e3263b" sw="7"/></group><text y="190" size="34" weight="700" align="center" fill="#1b2a44" text="anger vein"/></group><group x="960" y="500" scale="0.92"><use ref="ac-face"/><group y="-130" at="1.6"><circle repeat="3" x="=-60 + i*60" y="=-20*(i%2) - 60*fract((T-1.6)*0.9 + i*0.3)" r="=22 + 18*fract((T-1.6)*0.9 + i*0.3)" fill="#ffffff" opacity="=0.9 - 0.8*fract((T-1.6)*0.9 + i*0.3)"/></group><text y="190" size="34" weight="700" align="center" fill="#1b2a44" text="steam"/></group><group x="1320" y="500" scale="0.92"><use ref="ac-face"/><group at="2.1"><circle r="108" fill="#3a2f8a" opacity="=0.35*clamp((T-(2.1))/(0.4),0,1)"/><line repeat="7" x1="=-75 + i*25" y1="-100" x2="=-75 + i*25" y2="=-100 + 90*ease(clamp((T-(2.1))/(0.4),0,1),'out')" stroke="#5a4bb0" sw="4"/></group><text y="190" size="34" weight="700" align="center" fill="#1b2a44" text="gloom lines"/></group><group x="1680" y="500" scale="0.92"><use ref="ac-face"/><group at="2.6"><use repeat="4" ref="ac-star" x="=data('spx', i)" y="=data('spy', i)" scale="=ease(clamp((T-(2.6))/(0.3),0,1),'back')*(0.6 + 0.4*abs(sin(T*5 + i*1.7)))" rot="=T*40 + i*20"/></group><text y="190" size="34" weight="700" align="center" fill="#1b2a44" text="sparkles"/></group><text x="960" y="150" size="64" weight="800" align="center" fill="#ffffff" shadow="0 4 0 #1b2a44" text="Anime reaction emotes"/>
      
      <group x="28" y="978" opacity="0.94">
      <rect w="390" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
      <rect x="16" y="20" w="34" h="34" r="9" fill="#22b573"/><path d="M 24 37 L 31 44 L 43 29" stroke="#ffffff" sw="4.5"/>
      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="Anime reaction emotes"/>
      <text x="64" y="53" size="19" fill="#8fe3b8" font="JetBrains Mono" text="anime-cel  ·  native"/>
    </group>
    </scene>
    <scene id="anime-cel--fx--blur-band" dur="4" chapter="Blur band">
      <sfx at="0.8" src="whoosh"/>
      <rect w="1920" h="1080" fill="url(#ac-sky)"/><group x="=-((T*900) % 480)"><rect x="0" y="470" w="300" h="420" fill="#2c3a63"/><rect x="40" y="520" w="50" h="70" fill="#ffd46b"/><rect x="480" y="510" w="300" h="380" fill="#2c3a63"/><rect x="520" y="560" w="50" h="70" fill="#ffd46b"/><rect x="960" y="550" w="300" h="340" fill="#2c3a63"/><rect x="1000" y="600" w="50" h="70" fill="#ffd46b"/><rect x="1440" y="470" w="300" h="420" fill="#2c3a63"/><rect x="1480" y="520" w="50" h="70" fill="#ffd46b"/><rect x="1920" y="510" w="300" h="380" fill="#2c3a63"/><rect x="1960" y="560" w="50" h="70" fill="#ffd46b"/><rect x="2400" y="550" w="300" h="340" fill="#2c3a63"/><rect x="2440" y="600" w="50" h="70" fill="#ffd46b"/><rect x="2880" y="470" w="300" h="420" fill="#2c3a63"/><rect x="2920" y="520" w="50" h="70" fill="#ffd46b"/></group>
      <group x="960" y="760"><ellipse rx="230" ry="60" fill="#e8434a"/><rect x="-170" y="-90" w="300" h="70" r="30" fill="#e8434a"/><circle x="-140" y="50" r="40" fill="#1a1d26"/><circle x="140" y="50" r="40" fill="#1a1d26"/></group>
        <group clip="url(#bb-band)"><rect w="1920" h="1080" fill="#9cc8f0"/><group blur="22" sx="1.05"><group x="=-((T*900) % 480)"><rect x="0" y="470" w="300" h="420" fill="#2c3a63"/><rect x="40" y="520" w="50" h="70" fill="#ffd46b"/><rect x="480" y="510" w="300" h="380" fill="#2c3a63"/><rect x="520" y="560" w="50" h="70" fill="#ffd46b"/><rect x="960" y="550" w="300" h="340" fill="#2c3a63"/><rect x="1000" y="600" w="50" h="70" fill="#ffd46b"/><rect x="1440" y="470" w="300" h="420" fill="#2c3a63"/><rect x="1480" y="520" w="50" h="70" fill="#ffd46b"/><rect x="1920" y="510" w="300" h="380" fill="#2c3a63"/><rect x="1960" y="560" w="50" h="70" fill="#ffd46b"/><rect x="2400" y="550" w="300" h="340" fill="#2c3a63"/><rect x="2440" y="600" w="50" h="70" fill="#ffd46b"/><rect x="2880" y="470" w="300" h="420" fill="#2c3a63"/><rect x="2920" y="520" w="50" h="70" fill="#ffd46b"/></group>
      <group x="960" y="760"><ellipse rx="230" ry="60" fill="#e8434a"/><rect x="-170" y="-90" w="300" h="70" r="30" fill="#e8434a"/><circle x="-140" y="50" r="40" fill="#1a1d26"/><circle x="140" y="50" r="40" fill="#1a1d26"/></group></group>
          <rect repeat="14" x="=fract(T*2.5 + rand(i))*2400 - 300" y="=440 + rand(i*3)*320" w="=200 + 260*rand(i*7)" h="4" fill="#ffffff" opacity="0.7"/></group>
        <text x="960" y="170" size="72" font="Anton" align="center" fill="#ffffff" shadow="0 5 0 #1b2a44" text="BLUR BAND"/>
      
      <group x="28" y="978" opacity="0.94">
      <rect w="312" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
      <rect x="16" y="20" w="34" h="34" r="9" fill="#22b573"/><path d="M 24 37 L 31 44 L 43 29" stroke="#ffffff" sw="4.5"/>
      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="Blur band"/>
      <text x="64" y="53" size="19" fill="#8fe3b8" font="JetBrains Mono" text="anime-cel  ·  native"/>
    </group>
    </scene>
    <scene id="anime-cel--fx--dramatic-zoom" dur="4" chapter="Dramatic zoom">
      <sfx at="1.2" src="whoosh"/>
      <rect w="1920" h="1080" fill="#fbe7c6"/>
      <group at="1.2"><anim prop="opacity" from="0" to="1" dur="0.05"/><rect w="1920" h="1080" fill="#ffffff"/>
        <path repeat="60" x="960" y="470" rot="=i*6 + 2*rand(i)" d="='M 0 ' + (-260 - 120*rand(i*3)) + ' L 9 -1400 L -9 -1400 Z'" fill="#1a1d26"/></group>
      <group x="960" y="470" scale="=1 + 1.4*ease(clamp((T-(1.2))/(0.12),0,1),'out')">
        <use ref="ac-face"/>
        <group at="1.2"><anim prop="opacity" from="0" to="1" dur="0.05"/><ellipse x="-44" y="18" rx="17" ry="25" fill="#ffffff" stroke="#2b1d1d" sw="4"/><ellipse x="44" y="18" rx="17" ry="25" fill="#ffffff" stroke="#2b1d1d" sw="4"/><circle x="-44" y="18" r="5" fill="#2b1d1d"/><circle x="44" y="18" r="5" fill="#2b1d1d"/><ellipse y="68" rx="14" ry="10" fill="#2b1d1d"/></group>
      </group>
      <text x="960" y="130" size="64" font="Anton" align="center" fill="#e3263b" at="1.3" text="!?"/>
      
      <group x="28" y="978" opacity="0.94">
      <rect w="312" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
      <rect x="16" y="20" w="34" h="34" r="9" fill="#22b573"/><path d="M 24 37 L 31 44 L 43 29" stroke="#ffffff" sw="4.5"/>
      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="Dramatic zoom"/>
      <text x="64" y="53" size="19" fill="#8fe3b8" font="JetBrains Mono" text="anime-cel  ·  native"/>
    </group>
    </scene>
    <scene id="anime-cel--fx--flash" dur="4" chapter="Flash">
      <sfx at="1.2" src="click"/><sfx at="2.3" src="click"/>
      <rect w="1920" h="1080" fill="#2a1f4d"/>
      <circle repeat="2" x="=i == 0 ? 600 + 300*ease(clamp((T-(0.6))/(0.6),0,1),'in') - 300*ease(clamp((T-(2))/(0.3),0,1),'in') + 300*ease(clamp((T-(2.4))/(0.4),0,1),'out'): 1320 - 300*ease(clamp((T-(0.6))/(0.6),0,1),'in') + 300*ease(clamp((T-(1.3))/(0.5),0,1),'out') - 300*ease(clamp((T-(1.9))/(0.4),0,1),'in')" y="560" r="120" fill="=i == 0 ? '#ff6b5a' : '#5ac8ff'" stroke="#ffffff" sw="6"/>
      <group x="960" y="560" when="=(T > 1.2)*(T &lt; 1.6) + (T > 2.3)*(T &lt; 2.7)"><path repeat="12" rot="=i*30" d="M 0 -40 L 18 -220 L -18 -220 Z" fill="#ffe36b"/></group>
      <text x="960" y="200" size="80" font="Anton" align="center" fill="#ffe36b" at="1.2" text="HIT!"/>
      <rect w="1920" h="1080" fill="#ffffff" opacity="=max(1 - (T-1.2)/0.3, 0)*(T > 1.2) + max(1 - (T-2.3)/0.3, 0)*(T > 2.3)"/>
      
      <group x="28" y="978" opacity="0.94">
      <rect w="312" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
      <rect x="16" y="20" w="34" h="34" r="9" fill="#22b573"/><path d="M 24 37 L 31 44 L 43 29" stroke="#ffffff" sw="4.5"/>
      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="Flash"/>
      <text x="64" y="53" size="19" fill="#8fe3b8" font="JetBrains Mono" text="anime-cel  ·  native"/>
    </group>
    </scene>
    <scene id="anime-cel--fx--impact-frame" dur="4" chapter="Impact frame">
      <sfx at="1.2" src="whoosh"/>
      <rect w="1920" h="1080" fill="url(#ac-sky)"/><rect y="760" w="1920" h="320" fill="#6aa86b"/>
        <group x="=700 + 200*ease(clamp((T-(0.3))/(0.9),0,1),'in')" y="560"><use ref="ac-face" scale="0.9"/></group>
        <group x="1260" y="600"><rect x="-90" y="-180" w="180" h="360" r="40" fill="#8a4b2f" stroke="#2b1d1d" sw="5"/></group>
        <group at="1.2" dur="0.25"><rect w="1920" h="1080" fill="#000000"/><group x="1080" y="560"><path d="M 620 0 L 244 62 L 475 279 L 130 158 L 108 427 L -45 179 L -310 376 L -199 117 L -583 148 L -260 0 L -583 -148 L -199 -117 L -310 -376 L -45 -179 L 108 -427 L 130 -158 L 475 -279 L 244 -62 Z" fill="#ffffff"/></group><circle x="900" y="560" r="100" fill="#000000" stroke="#ffffff" sw="8"/><rect x="1170" y="420" w="180" h="360" r="40" fill="#000000" stroke="#ffffff" sw="8"/></group>
        <group at="1.45" dur="0.15"><rect w="1920" h="1080" fill="#ffffff"/><group x="1080" y="560"><path d="M 620 0 L 244 62 L 475 279 L 130 158 L 108 427 L -45 179 L -310 376 L -199 117 L -583 148 L -260 0 L -583 -148 L -199 -117 L -310 -376 L -45 -179 L 108 -427 L 130 -158 L 475 -279 L 244 -62 Z" fill="#000000"/></group><circle x="900" y="560" r="100" fill="#ffffff" stroke="#000000" sw="8"/></group>
        <text x="960" y="160" size="90" font="Anton" align="center" fill="#ffffff" stroke="#1a1d26" sw="8" at="1.6" text="BAM"/>
      
      <group x="28" y="978" opacity="0.94">
      <rect w="312" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
      <rect x="16" y="20" w="34" h="34" r="9" fill="#22b573"/><path d="M 24 37 L 31 44 L 43 29" stroke="#ffffff" sw="4.5"/>
      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="Impact frame"/>
      <text x="64" y="53" size="19" fill="#8fe3b8" font="JetBrains Mono" text="anime-cel  ·  native"/>
    </group>
    </scene>
    <scene id="anime-cel--fx--petals" dur="5" chapter="Petals">
      
      <rect w="1920" h="1080" fill="url(#pt-sky)"/>
      <path d="M 1920 120 C 1600 180 1400 260 1150 230 C 1300 300 1500 280 1920 230 Z" fill="#4a2c2a"/>
      <circle repeat="26" x="=1250 + 640*rand(i)" y="=150 + 120*rand(i*5)" r="=40 + 40*rand(i*9)" fill="#ffb7cf" opacity="0.85"/>
