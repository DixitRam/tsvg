    <scene id="pixel-art--weather" dur="5" chapter="Pixel weather and particles">
      
      <rect w="1920" h="1080" fill="=floor(T*12)/12 &lt; 2.5 ? '#3b4a6b' : '#22264a'"/>
        <rect x="0" y="840" w="1920" h="240" fill="#3d6b3a"/><rect x="0" y="840" w="1920" h="24" fill="#5e9a4f"/>
        <rect x="780" y="600" w="360" h="240" fill="#a0633c"/><path d="M 756 600 L 960 456 L 1164 600 Z" fill="#7a3a2a"/><rect x="900" y="720" w="72" h="120" fill="#3b2418"/><rect x="1020" y="660" w="72" h="60" fill="#ffd36b"/>
        <rect repeat="90" when="=floor(T*12)/12 &lt; 2.5" x="=floor((rand(i)*1920 - 220*fract(floor(T*12)/12*1.3 + rand(i*2)))/6)*6" y="=floor((fract(floor(T*12)/12*1.3 + rand(i*2))*1000 - 60)/6)*6" w="6" h="24" fill="#9cc4ff"/>
        <rect repeat="70" when="=floor(T*12)/12 >= 2.5" x="=floor((rand(i)*1920 + 30*sin(floor(T*12)/12*2 + i))/6)*6" y="=floor((fract(floor(T*12)/12*0.25 + rand(i*2))*900)/6)*6" w="12" h="12" fill="#ffffff"/>
        <rect repeat="12" when="=floor(T*12)/12 >= 2.5" x="=floor((300 + rand(i*5)*1300 + 40*sin(floor(T*12)/12 + i))/6)*6" y="=floor((700 + 80*sin(floor(T*12)/12*1.3 + i*2))/6)*6" w="12" h="12" fill="#fff36b" opacity="=0.4 + 0.6*step(0.5, fract(floor(T*12)/12*2 + rand(i)))"/>
        <text x="960" y="160" size="90" font="VT323" align="center" fill="#ffffff" text="=floor(T*12)/12 &lt; 2.5 ? 'RAIN' : 'SNOW + FIREFLIES'"/>
      <group x="1177" y="1000" opacity="0.94"><rect w="715" h="46" r="12" fill="#0b0d12d9" stroke="#f5b94255" sw="1.5"/>
      <text x="357.5" y="23" size="22" italic="1" align="center" fill="#ffe2a6" font="Inter" text="TSVG: floor() snaps every particle to the 6 px art grid at 12 fps"/></group>
