      <rect w="1920" h="1080" fill="#0d0f16"/>
    <circle repeat="4" x="=data('gbx', i) + 160*(noise(T*0.4 + i*3) - 0.5)" y="=data('gby', i) + 120*(noise(T*0.3 + i*5) - 0.5)" r="320" fill="=data('gbc', i)" opacity="0.5" blur="110"/>
