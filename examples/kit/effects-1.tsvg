    <scene id="anime-cel--fx--smear" dur="4" chapter="Smear frames">
      <sfx at="1" src="whoosh"/>
      <rect w="1920" h="1080" fill="#fdf1dc"/>
      <line x1="140" y1="840" x2="1780" y2="840" stroke="#d9c7a7" sw="6"/>
      <circle x="360" y="600" r="90" fill="#ff6b5a" stroke="#2b1d1d" sw="6" when="=T &lt; 1.0"/>
      <group when="=(T >= 1.0)*(T &lt; 1.17)">
        <path d="M 330 600 C 600 470 1150 500 1560 520 C 1640 560 1640 640 1560 680 C 1150 700 600 730 330 600 Z" fill="#ff6b5a" stroke="#2b1d1d" sw="6" opacity="=T &lt; 1.085 ? 1 : 0"/>
        <path d="M 1100 560 C 1300 520 1500 520 1560 530 C 1650 560 1650 640 1560 670 C 1500 680 1300 680 1100 640 Z" fill="#ff6b5a" stroke="#2b1d1d" sw="6" opacity="=T >= 1.085 ? 1 : 0"/>
        <line repeat="7" x1="=500 + 70*i" y1="=520 + i*26" x2="=1080 + 50*i" y2="=520 + i*26" stroke="#2b1d1d" sw="5"/>
      </group>
      <group when="=T >= 1.17"><circle x="1560" y="600" r="90" fill="#ff6b5a" stroke="#2b1d1d" sw="6" sx="=1 - 0.25*sin(clamp((T-1.17)/0.3,0,1)*PI)" sy="=1 + 0.2*sin(clamp((T-1.17)/0.3,0,1)*PI)"/>
        <line repeat="5" x1="=1000 + 60*i" y1="=540 + i*30" x2="=1380 + 30*i" y2="=540 + i*30" stroke="#2b1d1d" sw="4" opacity="=max(0, 1 - (T-1.17)/0.4)"/></group>
      <text x="960" y="200" size="64" weight="800" align="center" fill="#2b1d1d" text="Smear frames on a fast move"/>
      
      <group x="28" y="978" opacity="0.94">
      <rect w="312" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
      <rect x="16" y="20" w="34" h="34" r="9" fill="#22b573"/><path d="M 24 37 L 31 44 L 43 29" stroke="#ffffff" sw="4.5"/>
      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="Smear frames"/>
      <text x="64" y="53" size="19" fill="#8fe3b8" font="JetBrains Mono" text="anime-cel  ·  native"/>
    </group>
    </scene>
