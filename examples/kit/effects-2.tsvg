          <path repeat="28" rot="=atan2(300, (-500 + i*37) - (-700 + 1400*ease(clamp((T-(0.3))/(3.4),0,1),'io')))*57.3" d="M 0 -6 L 900 -60 L 900 60 L 0 6 Z" x="=-500 + i*37" y="0" fill="url(#ray)" opacity="=0.35 + 0.3*rand(i)"/></group>
