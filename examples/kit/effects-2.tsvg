      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="bg-flow-field"/>
      <text x="64" y="53" size="19" fill="#ffd27a" font="JetBrains Mono" text="music-to-video  ·  partial"/>
    </group>
