    <scene id="motion-graphics--motion-primitives" dur="5" chapter="Motion vocabulary primitives">
      
      <rect w="1920" h="1080" fill="#0e1117"/><rect x="140" y="145" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="330" y="240"><text size="64" weight="800" align="center" fill="#ffffff" x="=-300*(1 - ease(clamp((T-(0.3))/(0.5),0,1),'out'))" text="slide"/></group><rect x="560" y="145" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="750" y="240"><text size="64" weight="800" align="center" fill="#ffffff" scale="=ease(clamp((T-(0.55))/(0.5),0,1),'back')" text="scale"/></group><rect x="980" y="145" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="1170" y="240"><text size="64" weight="800" align="center" fill="#ffffff" opacity="=ease(clamp((T-(0.8))/(0.6),0,1),'io')" text="fade"/></group><rect x="1400" y="145" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="1590" y="240"><text size="64" weight="800" align="center" fill="#ffffff" blur="=16*(1 - ease(clamp((T-(1.05))/(0.6),0,1),'out'))" opacity="=clamp((T-(1.05))/(0.2),0,1)" text="blur"/></group><rect x="140" y="405" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="330" y="500"><text size="64" weight="800" align="center" fill="#ffffff" reveal="=clamp((T-(1.3))/(0.8),0,1)" text="typewriter"/></group><rect x="560" y="405" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="750" y="500"><text size="64" weight="800" align="center" fill="#ffffff" y="=-14*sin((T - 1.55)*8)*(T > 1.55)" text="wave"/></group><rect x="980" y="405" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="1170" y="500"><text size="64" weight="800" align="center" fill="#ffffff" y="=-120*abs(cos((T - 1.8)*7))*max(0, 1 - (T - 1.8)/1.1)*(T > 1.8)" text="bounce"/></group><rect x="1400" y="405" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="1590" y="500"><text size="64" weight="800" align="center" fill="#ffffff" scale="=3 - 2*ease(clamp((T-(2.05))/(0.18),0,1),'in')" opacity="=clamp((T-(2.05))/(0.05),0,1)" text="slam"/></group><rect x="140" y="665" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="330" y="760"><text size="64" weight="800" align="center" fill="#ffffff" scale="=1 + 0.12*abs(sin((T - 2.3)*6))*(T > 2.3)" text="pulse"/></group><rect x="560" y="665" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="750" y="760"><text size="64" weight="800" align="center" fill="#ffffff" x="=18*sin((T - 2.55)*60)*max(0, 1 - (T - 2.55)/0.6)*(T > 2.55)" text="shake"/></group><rect x="980" y="665" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="1170" y="760"><text size="64" weight="800" align="center"  shadow="0 0 30 #7aa2ff" fill="=mix('#ffffff', '#bcd0ff', clamp((T-(2.8))/(0.4),0,1))" text="glow"/></group><rect x="1400" y="665" w="380" h="200" r="22" fill="#161b26" stroke="#262d3d" sw="2"/><group x="1590" y="760"><text size="64" weight="800" align="center"  fill="=mix('#ffffff', '#ff6b9a', ease(clamp((T-(3.05))/(0.6),0,1),'out'))" text="colour"/></group>
      
