      <rect w="1920" h="1080" fill="#f4f1ea"/><group x="300" y="=380 - 160*ease(clamp((T-(1.5))/(0.4),0,1),'in')" opacity="=1 - clamp((T-(1.6))/(0.3),0,1)"><rect w="420" h="200" r="18" fill="#ff3d5a"/><text x="210" y="100" size="80" font="Anton" align="center" fill="#ffffff" text="Intro"/></group><group x="760" y="=380 - 160*ease(clamp((T-(1.58))/(0.4),0,1),'in')" opacity="=1 - clamp((T-(1.6800000000000002))/(0.3),0,1)"><rect w="420" h="200" r="18" fill="#111111"/><text x="210" y="100" size="80" font="Anton" align="center" fill="#ffffff" text="Verse"/></group><group x="1220" y="=380 - 160*ease(clamp((T-(1.66))/(0.4),0,1),'in')" opacity="=1 - clamp((T-(1.76))/(0.3),0,1)"><rect w="420" h="200" r="18" fill="#3d7bff"/><text x="210" y="100" size="80" font="Anton" align="center" fill="#ffffff" text="Hook"/></group><group x="300" y="=640 - 160*ease(clamp((T-(1.74))/(0.4),0,1),'in')" opacity="=1 - clamp((T-(1.84))/(0.3),0,1)"><rect w="420" h="200" r="18" fill="#ff3d5a"/><text x="210" y="100" size="80" font="Anton" align="center" fill="#ffffff" text="Bridge"/></group><group x="760" y="=640 - 160*ease(clamp((T-(1.82))/(0.4),0,1),'in')" opacity="=1 - clamp((T-(1.9200000000000002))/(0.3),0,1)"><rect w="420" h="200" r="18" fill="#111111"/><text x="210" y="100" size="80" font="Anton" align="center" fill="#ffffff" text="Drop"/></group><group x="1220" y="=640 - 160*ease(clamp((T-(1.9))/(0.4),0,1),'in')" opacity="=1 - clamp((T-(2))/(0.3),0,1)"><rect w="420" h="200" r="18" fill="#3d7bff"/><text x="210" y="100" size="80" font="Anton" align="center" fill="#ffffff" text="Outro"/></group>
        <text x="960" y="540" size="64" font="Playfair Display" italic="1" align="center" fill="#111111" at="2.4" text="cleared."/>
      
      <group x="28" y="978" opacity="0.94">
