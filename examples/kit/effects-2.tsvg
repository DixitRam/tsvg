    <scene id="music-to-video--fx-system-replace" dur="4" chapter="system-replace">
      <sfx at="1.8" src="click"/><sfx at="1.9" src="blip"/>
      <group when="=T &lt; 1.8"><rect w="1920" h="1080" fill="#0a1a3f"/><group repeat="8" as="r"><circle repeat="14" x="=100 + i*130" y="=90 + r*130" r="=22 + 16*sin(T*4 + i*0.6 + r*0.8)" fill="#3d7bff"/></group></group>
      <group when="=T >= 1.8"><rect w="1920" h="1080" fill="#ff7a1a"/><rect repeat="12" x="0" y="=i*90" w="=1920*ease(clamp((T-(1.8))/(0.25),0,1),'out')" h="44" fill="#111111" opacity="=(i % 2)*1"/>
        <group x="960" y="540" scale="=ease(clamp((T-(1.9))/(0.3),0,1),'back')"><rect x="-560" y="-150" w="1120" h="300" fill="#f4f1ea"/><text x="0" y="0" size="220" font="Anton" align="center" fill="#111111"  text="SYSTEM B"/></group></group>
      
      <group x="28" y="978" opacity="0.94">
      <rect w="369" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
      <rect x="16" y="20" w="34" h="34" r="9" fill="#22b573"/><path d="M 24 37 L 31 44 L 43 29" stroke="#ffffff" sw="4.5"/>
      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="system-replace"/>
      <text x="64" y="53" size="19" fill="#8fe3b8" font="JetBrains Mono" text="music-to-video  ·  native"/>
    </group>
    </scene>
    <scene id="music-to-video--fx-tile-mosaic" dur="4" chapter="tile-mosaic">
      <sfx at="0.3" src="typing" vol="0.3"/>
      <rect w="1920" h="1080" fill="#111"/><group repeat="7" as="r"><group repeat="12" as="c" clip="url(#tm-tile)" opacity="=clamp((T - 0.3 - (c + r)*0.08)/0.25, 0, 1)">
        <group x="=c*160 + 80" y="=r*154 + 77" scale="=1.3 - 0.3*clamp((T - 0.3 - (c + r)*0.08)/0.35, 0, 1)"><image src="img-food" x="=-c*160 - 80" y="=-r*154 - 77" w="1920" h="1080"/></group></group></group>
        <group x="960" y="540" opacity="=ease(clamp((T-(2.4))/(0.4),0,1),'out')"><text x="0" y="0" size="180" font="Anton" align="center" fill="#ffffff" shadow="0 6 30 #000" text="SUNDAY TABLE"/></group>
      
      <group x="28" y="978" opacity="0.94">
      <rect w="369" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
      <rect x="16" y="20" w="34" h="34" r="9" fill="#22b573"/><path d="M 24 37 L 31 44 L 43 29" stroke="#ffffff" sw="4.5"/>
      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="tile-mosaic"/>
      <text x="64" y="53" size="19" fill="#8fe3b8" font="JetBrains Mono" text="music-to-video  ·  native"/>
    </group>
