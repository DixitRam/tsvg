    <scene id="music-to-video--fx-gooey-metaball" dur="4.5" chapter="gooey-metaball">
      
      <rect w="1920" h="1080" fill="#120b24"/><group x="960" y="540" fill="#ff6b9a">
        <circle x="=-(380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))" r="170" fill="#ff6b9a"/><circle x="=(380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))" r="=150 + 20*max(0, 1 - (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))/330)" fill="#ff6b9a"/>
        <path fill="#ff6b9a" opacity="=max(0, 1 - (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))/330) > 0.02 ? 1 : 0" d="='M ' + (-(380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))) + ' -' + (60 + 90*max(0, 1 - (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))/330)) + ' Q 0 ' + (-150*max(0, 1 - (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))/330)*max(0, 1 - (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))/330) + 10) + ' ' + (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io')) + ' -' + (60 + 90*max(0, 1 - (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))/330)) + ' L ' + (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io')) + ' ' + (60 + 90*max(0, 1 - (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))/330)) + ' Q 0 ' + (150*max(0, 1 - (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))/330)*max(0, 1 - (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))/330) - 10) + ' ' + (-(380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))) + ' ' + (60 + 90*max(0, 1 - (380*(1 - ease(clamp((T-(0.3))/(1.6),0,1),'io')) + 380*ease(clamp((T-(2.8))/(1.2),0,1),'io'))/330)) + ' Z'"/></group>
      <group x="1291" y="1000" opacity="0.94"><rect w="601" h="46" r="12" fill="#0b0d12d9" stroke="#f5b94255" sw="1.5"/>
      <text x="300.5" y="23" size="22" italic="1" align="center" fill="#ffe2a6" font="Inter" text="TSVG: no blur+threshold filter; neck path between blobs"/></group>
      <group x="28" y="978" opacity="0.94">
