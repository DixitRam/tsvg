    <scene id="music-to-video--fx-word-grid-burst" dur="4.5" chapter="word-grid-burst">
      <sfx at="2.4" src="ding" vol="0.5"/>
      <rect w="1920" h="1080" fill="#0d0d12"/><group repeat="4" as="r"><group repeat="4" as="c" x="=300 + c*440" y="=230 + r*210" opacity="=(T > 0.3 + (r*4 + c)*0.12)*((T &lt; 2.4) + (T >= 2.4)*((r*4 + c) == 6 ? 1 : 0.25))" blur="=(T >= 2.4)*((r*4 + c) == 6 ? 0 : 10*clamp((T-(2.4))/(0.3),0,1))" scale="=(r*4 + c) == 6 ? 1 + 0.5*ease(clamp((T-(2.4))/(0.4),0,1),'back') : 1">
        <text size="90" font="Anton" align="center" fill="=(r*4 + c) == 6 ? '#ffd23f' : '#ffffff'" text="{data('wg', r*4 + c)}"/></group></group>
      
      <group x="28" y="978" opacity="0.94">
      <rect w="369" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
      <rect x="16" y="20" w="34" h="34" r="9" fill="#22b573"/><path d="M 24 37 L 31 44 L 43 29" stroke="#ffffff" sw="4.5"/>
      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="word-grid-burst"/>
      <text x="64" y="53" size="19" fill="#8fe3b8" font="JetBrains Mono" text="music-to-video  ·  native"/>
    </group>
    </scene>
    <scene id="music-to-video--fx-bg-flow-field" dur="4.5" chapter="bg-flow-field">
      
      <rect w="1920" h="1080" fill="#06070d"/><line repeat="360" x1="=fract(rand(i) + T*(0.03 + 0.03*rand(i*3)))*2000 - 40" y1="=rand(i*7)*1080 + 90*sin(fract(rand(i) + T*(0.03 + 0.03*rand(i*3)))*6 + rand(i*7)*5) + 60*(noise(i*0.3 + T*0.3) - 0.5)" x2="=fract(rand(i) + T*(0.03 + 0.03*rand(i*3)))*2000 - 4" y2="=rand(i*7)*1080 + 90*sin((fract(rand(i) + T*(0.03 + 0.03*rand(i*3))) + 0.018)*6 + rand(i*7)*5) + 60*(noise(i*0.3 + T*0.3) - 0.5)" stroke="=mix('#3d7bff', '#ff6b9a', rand(i*11))" sw="3" opacity="0.8"/>
      <text x="960" y="540" size="120" font="Anton" align="center" fill="#ffffff" text="FLOW"/>
      <group x="1200" y="1000" opacity="0.94"><rect w="692" h="46" r="12" fill="#0b0d12d9" stroke="#f5b94255" sw="1.5"/>
      <text x="346" y="23" size="22" italic="1" align="center" fill="#ffe2a6" font="Inter" text="TSVG: noise() streamlines, 360 particles, not a per-pixel field"/></group>
      <group x="28" y="978" opacity="0.94">
      <rect w="380" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
