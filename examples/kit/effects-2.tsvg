        <path d="M 563 392 L 755 196 L 1003 179 L 1357 351 L 1320 474 L 1270 589 L 1326 778 L 1047 843 L 1041 893 L 737 819 L 774 597 L 712 499 Z" stroke="#ffffff" sw="=5 + 4*max(0, sin((T - 2.3)*6))*(T > 2.3)*(T &lt; 3.4)" draw="=ease(clamp((T-(0.2))/(1.1),0,1),'io')"/>
        <text x="960" y="980" size="56" weight="800" align="center" fill="#ffffff" text="France"/>
      
      <group x="28" y="978" opacity="0.94">
