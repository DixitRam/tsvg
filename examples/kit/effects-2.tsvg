  <defs>
    <symbol id="person"><circle y="-150" r="78" fill="#1a1d26"/><path d="M -190 140 C -180 0 -110 -50 0 -50 C 110 -50 180 0 190 140 Z" fill="#1a1d26"/></symbol>
