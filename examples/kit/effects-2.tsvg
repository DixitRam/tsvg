    <data id="pf-fg" v="#111111,#f4f1ea,#f4f1ea,#ffd23f"/>
    <mask id="pd-m"><group repeat="9" as="r"><rect repeat="16" x="=i*120" y="=r*120" w="121" h="121" fill="#000" opacity="=rand(i*31 + r*17) > ease(clamp((T-(0.8))/(1.6),0,1),'linear') ? 1 : 0"/></group></mask>
    <clip id="slot-w"><rect x="-120" y="-140" w="240" h="280"/></clip>
