    <clip id="mr-a"><rect x="0" y="0" w="=1920*ease(clamp((T-(0.5))/(0.9),0,1),'io')" h="1080"/></clip>
    <clip id="mr-b"><rect x="0" y="0" w="=320*ease(clamp((T-(2))/(0.6),0,1),'io')" h="1080"/><rect x="320" y="0" w="=320*ease(clamp((T-(2.06))/(0.6),0,1),'io')" h="1080"/><rect x="640" y="0" w="=320*ease(clamp((T-(2.12))/(0.6),0,1),'io')" h="1080"/><rect x="960" y="0" w="=320*ease(clamp((T-(2.18))/(0.6),0,1),'io')" h="1080"/><rect x="1280" y="0" w="=320*ease(clamp((T-(2.24))/(0.6),0,1),'io')" h="1080"/><rect x="1600" y="0" w="=320*ease(clamp((T-(2.3))/(0.6),0,1),'io')" h="1080"/></clip>
