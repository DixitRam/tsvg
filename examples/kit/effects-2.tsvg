    <data id="cg-pal" v="#ff3d5a, #ffd23f, #2bd9a8, #3d7bff, #111111, #f4f1ea"/>
    <data id="cs-w" v="MAKE,BREAK,SHAKE,TAKE,WAKE,MAKE"/>
