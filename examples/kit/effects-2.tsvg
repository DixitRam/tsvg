      <rect w="1920" h="1080" fill="#0a1a3f"/><text x="510" y="=540 + 60*sin(T*4 - 0)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" rot="=8*cos(T*4 - 0)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" size="200" font="Anton" align="center" fill="=mix('#5cc8ff', '#ffffff', 0.5 + 0.5*sin(T*4 - 0))" text="W"/><text x="610" y="=540 + 60*sin(T*4 - 0.6)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" rot="=8*cos(T*4 - 0.6)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" size="200" font="Anton" align="center" fill="=mix('#5cc8ff', '#ffffff', 0.5 + 0.5*sin(T*4 - 0.6))" text="A"/><text x="710" y="=540 + 60*sin(T*4 - 1.2)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" rot="=8*cos(T*4 - 1.2)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" size="200" font="Anton" align="center" fill="=mix('#5cc8ff', '#ffffff', 0.5 + 0.5*sin(T*4 - 1.2))" text="V"/><text x="810" y="=540 + 60*sin(T*4 - 1.7999999999999998)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" rot="=8*cos(T*4 - 1.7999999999999998)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" size="200" font="Anton" align="center" fill="=mix('#5cc8ff', '#ffffff', 0.5 + 0.5*sin(T*4 - 1.7999999999999998))" text="E"/><text x="910" y="=540 + 60*sin(T*4 - 2.4)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" rot="=8*cos(T*4 - 2.4)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" size="200" font="Anton" align="center" fill="=mix('#5cc8ff', '#ffffff', 0.5 + 0.5*sin(T*4 - 2.4))" text="L"/><text x="1010" y="=540 + 60*sin(T*4 - 3)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" rot="=8*cos(T*4 - 3)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" size="200" font="Anton" align="center" fill="=mix('#5cc8ff', '#ffffff', 0.5 + 0.5*sin(T*4 - 3))" text="E"/><text x="1110" y="=540 + 60*sin(T*4 - 3.5999999999999996)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" rot="=8*cos(T*4 - 3.5999999999999996)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" size="200" font="Anton" align="center" fill="=mix('#5cc8ff', '#ffffff', 0.5 + 0.5*sin(T*4 - 3.5999999999999996))" text="N"/><text x="1210" y="=540 + 60*sin(T*4 - 4.2)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" rot="=8*cos(T*4 - 4.2)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" size="200" font="Anton" align="center" fill="=mix('#5cc8ff', '#ffffff', 0.5 + 0.5*sin(T*4 - 4.2))" text="G"/><text x="1310" y="=540 + 60*sin(T*4 - 4.8)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" rot="=8*cos(T*4 - 4.8)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" size="200" font="Anton" align="center" fill="=mix('#5cc8ff', '#ffffff', 0.5 + 0.5*sin(T*4 - 4.8))" text="T"/><text x="1410" y="=540 + 60*sin(T*4 - 5.3999999999999995)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" rot="=8*cos(T*4 - 5.3999999999999995)*ease(clamp((T-(0.3))/(0.8),0,1),'out')" size="200" font="Anton" align="center" fill="=mix('#5cc8ff', '#ffffff', 0.5 + 0.5*sin(T*4 - 5.3999999999999995))" text="H"/>
