  <music src="bright" loop="1" vol="0.6"/>
  <timeline>
    <scene id="motion-graphics--apple-money-count" dur="4.5" chapter="apple-money-count block">
      <sfx at="0.3" src="typing" vol="0.4"/><sfx at="2.3" src="ding"/>
      <rect w="1920" h="1080" fill="#050806"/>
      <circle x="960" y="520" r="=420*ease(clamp((T-(2.3))/(0.4),0,1),'out')" fill="#1fd66b" opacity="=0.35*(1 - clamp((T-(2.3))/(0.8),0,1))" blur="40"/>
      <text x="960" y="520" size="200" weight="800" align="center" fill="=mix('#ffffff', '#1fd66b', clamp((T-(2.3))/(0.15),0,1) - clamp((T-(2.6))/(0.8),0,1)*0.6)" text="{'$' + fmt(floor(12480*ease(clamp((T-(0.3))/(2),0,1),'io')), 0)}"/>
      <group x="960" y="520" at="2.3"><text repeat="26" x="=cos(i*2.4)*900*ease(clamp((T-(2.3))/(1.2),0,1),'out')" y="=sin(i*2.4)*520*ease(clamp((T-(2.3))/(1.2),0,1),'out') + 500*clamp((T-(2.3))/(1.6),0,1)^2" rot="=i*37 + T*200" size="=40 + 30*rand(i)" weight="800" fill="#1fd66b" opacity="=1 - clamp((T-(3.2))/(0.8),0,1)" text="$"/></group>
      <text x="960" y="740" size="40" align="center" fill="#8fa59a" text="revenue this week"/>
      
      <group x="28" y="978" opacity="0.94">
      <rect w="419" h="74" r="14" fill="#0b0d12d9" stroke="#ffffff2a" sw="1.5"/>
      <rect x="16" y="20" w="34" h="34" r="9" fill="#22b573"/><path d="M 24 37 L 31 44 L 43 29" stroke="#ffffff" sw="4.5"/>
      <text x="64" y="25" size="26" weight="700" fill="#ffffff" font="Inter" text="apple-money-count block"/>
      <text x="64" y="53" size="19" fill="#8fe3b8" font="JetBrains Mono" text="motion-graphics  ·  native"/>
    </group>
    </scene>
