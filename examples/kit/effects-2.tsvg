    <scene id="music-to-video--fx-flash-cut" dur="3.5" chapter="flash-cut">
      <sfx at="1.5" src="whoosh"/>
      <rect w="1920" h="1080" fill="=T &lt; 1.6 ? '#ffd23f' : '#0b1a4a'"/>
      <group x="960" y="540"><text size="300" font="Anton" align="center" fill="=T &lt; 1.6 ? '#111111' : '#ffffff'" text="=T &lt; 1.6 ? 'DAY' : 'NIGHT'"/></group>
      <rect w="1920" h="1080" fill="#ffffff" opacity="=(T > 1.45)*clamp(min((T - 1.45)/0.1, 1 - (T - 1.6)/0.35), 0, 1)"/>
      
