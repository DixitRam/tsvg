<?xml version="1.0" encoding="UTF-8"?>
<tsvg version="0.2" title="Edit Kit effects in TSVG (2)" font="Inter">
  <layouts><layout id="landscape" w="1920" h="1080"/></layouts>
  <options>
    <option id="lang" label="Language" default="en"><choice id="en" label="English"/></option>
    <option id="mix" label="Audio" default="full"><choice id="full" label="Music + sfx"/><choice id="quiet" label="Sfx only"/></option>
    <option id="theme" label="Theme" default="dark"><choice id="dark" label="Dark"/></option>
  </options>
  <mixes><mix id="full" voice="1" music="0.3" sfx="0.75"/><mix id="quiet" voice="1" music="0" sfx="0.75"/></mixes>
  <themes><theme id="dark" bg="#0c0e13" fg="#f2f4f8" muted="#8a93a6" accent="#7aa2ff"/></themes>
  <assets>
    <font family="Inter" src="fonts/Inter.ttf"/>
    <font family="Anton" src="fonts/Anton.ttf"/>
