<scene id="faceless-explainer--push-slide" dur="4.6" chapter="Push slide">
<sfx at="1.3" src="whoosh" vol="0.5"/><sfx at="2.9" src="whoosh" vol="0.5"/>
<group when="=T&lt;1.75"><group x="=960+(-1920*ease(clamp((T-(1.25))/0.5,0,1),'io'))" y="=540+(0*ease(clamp((T-(1.25))/0.5,0,1),'io'))"><group x="-960" y="-540"><use ref="feA"/></group></group></group><group when="=T&gt;=1.25 &amp;&amp; T&lt;3.35"><group x="=960+(0*ease(clamp((T-(2.85))/0.5,0,1),'io'))" y="=540+(-1080*ease(clamp((T-(2.85))/0.5,0,1),'io'))"><group x="-960" y="-540"><group x="=960+(1920*(1-ease(clamp((T-(1.25))/0.5,0,1),'io')))" y="=540+(0*(1-ease(clamp((T-(1.25))/0.5,0,1),'io')))"><group x="-960" y="-540"><use ref="feB"/></group></group></group></group></group><group when="=T&gt;=2.85"><group x="=960+(0*(1-ease(clamp((T-(2.85))/0.5,0,1),'io')))" y="=540+(1080*(1-ease(clamp((T-(2.85))/0.5,0,1),'io')))"><group x="-960" y="-540"><use ref="feC"/></group></group></group>
<group x="36" y="950"><rect w="377" h="94" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Push slide"/><text x="24" y="66" size="21" fill="#c9d1e0" text="faceless-explainer · ✅ native"/></group>
</scene>
<scene id="faceless-explainer--squeeze" dur="4.2" chapter="Squeeze">
<sfx at="1.8" src="whoosh" vol="0.4"/>
<rect x="0" y="0" w="1920" h="1080" fill="#000"/><group when="=T&lt;2.25"><group x="0" y="540" sx="=max(0.001,1-ease(clamp((T-(1.75))/0.5,0,1),'io'))"><group x="0" y="-540"><use ref="feC"/></group></group></group><group when="=T&gt;=1.75"><group x="1920" y="540" sx="=max(0.001,ease(clamp((T-(1.75))/0.5,0,1),'io'))"><group x="-1920" y="-540"><use ref="feA"/></group></group></group>
<group x="36" y="950"><rect w="377" h="94" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Squeeze"/><text x="24" y="66" size="21" fill="#c9d1e0" text="faceless-explainer · ✅ native"/></group>
</scene>
<scene id="faceless-explainer--waterfall-cut" dur="4.4" chapter="Waterfall cut">
<sfx at="1.75" src="whoosh" vol="0.5"/>
<rect x="0" y="0" w="1920" h="1080" fill="#101827"/><group when="=T&lt;1.956"><text x="=247.4-230*pow(clamp((T-(1.616))/0.34,0,1),4)" y="540" size="140" weight="800" font="Inter" fill="#f4f6fb" text="Heat" opacity="=1-clamp((T-(1.616))/0.18,0,1)"/></group><group when="=T&lt;1.978"><text x="=614.2-230*pow(clamp((T-(1.638))/0.34,0,1),4)" y="540" size="140" weight="800" font="Inter" fill="#f4f6fb" text="builds" opacity="=1-clamp((T-(1.638))/0.18,0,1)"/></group><group when="=T&lt;2"><text x="=1143.4-230*pow(clamp((T-(1.66))/0.34,0,1),4)" y="540" size="140" weight="800" font="Inter" fill="#f4f6fb" text="slowly" opacity="=1-clamp((T-(1.66))/0.18,0,1)"/></group><group when="=T&gt;=2"><text x="=64+230*pow(1-clamp((T-(2))/0.3,0,1),4)" y="540" size="140" weight="800" font="Inter" fill="#ff6b9a" text="then" opacity="=lerp(0.35,1,clamp((T-(2))/0.12,0,1))"/></group><group when="=T&gt;=2.05"><text x="=430.8+230*pow(1-clamp((T-(2.05))/0.3,0,1),4)" y="540" size="140" weight="800" font="Inter" fill="#ff6b9a" text="breaks" opacity="=lerp(0.35,1,clamp((T-(2.05))/0.12,0,1))"/></group><group when="=T&gt;=2.092"><text x="=960+230*pow(1-clamp((T-(2.092))/0.3,0,1),4)" y="540" size="140" weight="800" font="Inter" fill="#ff6b9a" text="all" opacity="=lerp(0.35,1,clamp((T-(2.092))/0.12,0,1))"/></group><group when="=T&gt;=2.127"><text x="=1245.6+230*pow(1-clamp((T-(2.127))/0.3,0,1),4)" y="540" size="140" weight="800" font="Inter" fill="#ff6b9a" text="records" opacity="=lerp(0.35,1,clamp((T-(2.127))/0.12,0,1))"/></group>
<group x="36" y="950"><rect w="377" h="94" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Waterfall cut"/><text x="24" y="66" size="21" fill="#c9d1e0" text="faceless-explainer · ✅ native"/></group>
</scene>
<scene id="faceless-explainer--zoom-through-frame" dur="4.2" chapter="Zoom-through (frame)">
<sfx at="1.8" src="whoosh" vol="0.6"/>
<rect x="0" y="0" w="1920" h="1080" fill="#000"/><group when="=T&lt;2.2"><group x="960" y="540" scale="=1+1.5*pow(clamp((T-(1.8))/0.4,0,1),3)" opacity="=1-clamp((T-(1.8))/0.4,0,1)" blur="=8*clamp((T-(1.8))/0.4,0,1)"><group x="-960" y="-540"><use ref="feB"/></group></group></group><group when="=T&gt;=1.8"><group x="960" y="540" scale="=0.5+0.5*(1-pow(1-clamp((T-(1.8))/0.4,0,1),3))" opacity="=clamp((T-(1.8))/0.4,0,1)" blur="=8*(1-(1-pow(1-clamp((T-(1.8))/0.4,0,1),3)))"><group x="-960" y="-540"><use ref="feC"/></group></group></group>
<group x="36" y="950"><rect w="377" h="94" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Zoom-through (frame)"/><text x="24" y="66" size="21" fill="#c9d1e0" text="faceless-explainer · ✅ native"/></group>
</scene>
<scene id="faceless-explainer--zoom-through-cut" dur="4.4" chapter="Zoom-through cut (within frame)">
<sfx at="1.85" src="whoosh" vol="0.5"/>
<rect x="0" y="0" w="1920" h="1080" fill="#101827"/><rect x="260" y="200" w="1400" h="680" r="30" fill="#18233a" stroke="#2c3a5c" sw="4"/><text x="960" y="280" size="34" weight="700" align="center" fill="#7aa2ff" text="STEP 2 OF 3"/><group when="=T&lt;2"><group x="960" y="540" scale="=1+0.2*pow(clamp((T-(1.8))/0.2,0,1),3)" blur="=10*clamp((T-(1.8))/0.2,0,1)" opacity="=1-0.85*clamp((T-(1.8))/0.2,0,1)"><group x="-960" y="-540"><text x="960" y="540" size="140" weight="800" font="Inter" align="center" fill="#f4f6fb" text="Measure it"/></group></group></group><group when="=T&gt;=2"><group x="960" y="540" scale="=0.75+0.25*(1-pow(2,-10*clamp((T-(2))/0.5,0,1)))" blur="=10*(1-(1-pow(2,-10*clamp((T-(2))/0.5,0,1))))" opacity="=0.15+0.85*(1-pow(2,-10*clamp((T-(2))/0.5,0,1)))"><group x="-960" y="-540"><text x="960" y="540" size="140" weight="800" font="Inter" align="center" fill="#5fd39a" text="Map it"/></group></group></group>
<group x="36" y="950"><rect w="533" h="94" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Zoom-through cut (within frame)"/><text x="24" y="66" size="21" fill="#c9d1e0" text="faceless-explainer · ✅ native"/></group>
</scene>
<scene id="motion-graphics--shader-transitions" dur="7.2" chapter="Shader transitions (domain-warp, whip-pan, sdf-iris, glitch...)">
<sfx at="1.2" src="whoosh" vol="0.6"/><sfx at="2.6" src="whoosh" vol="0.4"/><sfx at="4.2" src="blip" vol="0.6"/><sfx at="5.5" src="whoosh" vol="0.4"/>
<rect x="0" y="0" w="1920" h="1080" fill="#000"/><group when="=T&lt;3.5"><group when="=T&lt;1.4"><group x="=960+(-460*pow(clamp((T-(1.18))/0.22,0,1),3))" y="=540+(0*pow(clamp((T-(1.18))/0.22,0,1),3))" blur="=40*clamp((T-(1.18))/0.22,0,1)"><group x="-960" y="-540"><group x="960" y="540" scale="1.5"><group x="-960" y="-540"><use ref="mgA"/></group></group></group></group></group><group when="=T&gt;=1.4"><group x="=960+(460*pow(1-clamp((T-(1.4))/0.3,0,1),3))" y="=540+(0*pow(1-clamp((T-(1.4))/0.3,0,1),3))" blur="=40*pow(1-clamp((T-(1.4))/0.3,0,1),2)"><group x="-960" y="-540"><group x="960" y="540" scale="1.5"><group x="-960" y="-540"><use ref="mgB"/></group></group></group></group></group></group><group when="=T&gt;=2.6 &amp;&amp; T&lt;4.4"><group clip="url(#c8)"><use ref="mgC"/></group><circle x="1300" y="450" r="=2300*ease(clamp((T-(2.6))/0.6,0,1),'io')" fill="none" stroke="#ffffff" sw="=14*(1-clamp((T-(2.6))/0.6,0,1))"/></group><group when="=T&gt;=4.2 &amp;&amp; T&lt;5.5"><group x="=(T&gt;4.2 &amp;&amp; T&lt;4.6000000000000005)*(rand(0*3.1+floor(T*24))-0.5)*160" clip="url(#c9)" when="=rand(0*7.3+floor(T*30))&lt;clamp((T-(4.2))/0.4,0,1)"><use ref="mgD"/></group><group x="=(T&gt;4.2 &amp;&amp; T&lt;4.6000000000000005)*(rand(0*3.1+floor(T*24))-0.5)*160" clip="url(#c9)" when="=!(rand(0*7.3+floor(T*30))&lt;clamp((T-(4.2))/0.4,0,1))"><use ref="mgC"/></group><group x="=(T&gt;4.2 &amp;&amp; T&lt;4.6000000000000005)*(rand(1*3.1+floor(T*24))-0.5)*160" clip="url(#c10)" when="=rand(1*7.3+floor(T*30))&lt;clamp((T-(4.2))/0.4,0,1)"><use ref="mgD"/></group><group x="=(T&gt;4.2 &amp;&amp; T&lt;4.6000000000000005)*(rand(1*3.1+floor(T*24))-0.5)*160" clip="url(#c10)" when="=!(rand(1*7.3+floor(T*30))&lt;clamp((T-(4.2))/0.4,0,1))"><use ref="mgC"/></group><group x="=(T&gt;4.2 &amp;&amp; T&lt;4.6000000000000005)*(rand(2*3.1+floor(T*24))-0.5)*160" clip="url(#c11)" when="=rand(2*7.3+floor(T*30))&lt;clamp((T-(4.2))/0.4,0,1)"><use ref="mgD"/></group><group x="=(T&gt;4.2 &amp;&amp; T&lt;4.600000