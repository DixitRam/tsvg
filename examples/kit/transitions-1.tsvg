<use ref="crB"/><rect x="=(1920-2000*ease(clamp((T-(1.5))/1.6,0,1),'io'))-40" y="0" w="120" h="1080" fill="#00000030" blur="30" when="=T&gt;1.5 &amp;&amp; T&lt;3.1"/><group when="=T&lt;3.1"><group clip="url(#c6)"><use ref="crA"/></group></group><group when="=T&gt;1.5 &amp;&amp; T&lt;3.1"><rect x="=(1920-2000*ease(clamp((T-(1.5))/1.6,0,1),'io'))-(1920-(1920-2000*ease(clamp((T-(1.5))/1.6,0,1),'io')))*0.9" y="0" w="=(1920-(1920-2000*ease(clamp((T-(1.5))/1.6,0,1),'io')))*0.9" h="1080" fill="#efe3c8" shadow="-20 0 40 #0006"/><group clip="url(#c7)" opacity="0.12"><group x="=(1920-2000*ease(clamp((T-(1.5))/1.6,0,1),'io'))" sx="-0.9"><group x="=-(1920-2000*ease(clamp((T-(1.5))/1.6,0,1),'io'))"><use ref="crA"/></group></group></group><rect x="=(1920-2000*ease(clamp((T-(1.5))/1.6,0,1),'io'))-(1920-(1920-2000*ease(clamp((T-(1.5))/1.6,0,1),'io')))*0.9" y="0" w="=(1920-(1920-2000*ease(clamp((T-(1.5))/1.6,0,1),'io')))*0.9*0.25" h="1080" fill="#00000018"/><rect x="=(1920-2000*ease(clamp((T-(1.5))/1.6,0,1),'io'))-30" y="0" w="30" h="1080" fill="#ffffff40"/></group>
<group x="36" y="916"><rect w="497" h="128" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Page turn"/><text x="24" y="66" size="21" fill="#c9d1e0" text="crayon-storybook · ◐ partial"/><text x="24" y="100" size="20" italic="1" fill="#ffd38a" text="curl approximated with a flat folding flap"/></group>
</scene>
<scene id="cut-the-curve--cut-the-curve" dur="4.6" chapter="Cut the Curve">
<sfx at="1.35" src="whoosh" vol="0.5"/><sfx at="2.75" src="whoosh" vol="0.5"/>
<rect x="0" y="0" w="1920" h="1080" fill="#0d0f14"/><group when="=T&lt;1.6"><group x="=960+(-230*pow(clamp((T-(1.28))/0.32,0,1),4))" y="=540+(0*pow(clamp((T-(1.28))/0.32,0,1),4))" opacity="=1-clamp((T-(1.32))/0.28,0,1)" blur="=8*clamp((T-(1.28))/0.32,0,1)"><group x="-960" y="-540"><text x="960" y="540" size="190" weight="800" font="Inter" align="center" fill="#f4f6fb" text="Plan it."/><text x="960" y="682.5" size="40" weight="600" align="center" fill="#7aa2ff" text="step one"/></group></group></group><group when="=T&gt;=1.6 &amp;&amp; T&lt;3"><group x="=960+(-230*pow(clamp((T-(2.68))/0.32,0,1),4))" y="=540+(0*pow(clamp((T-(2.68))/0.32,0,1),4))" opacity="=1-clamp((T-(2.72))/0.28,0,1)" blur="=8*clamp((T-(2.68))/0.32,0,1)"><group x="-960" y="-540"><group x="=960+(230*pow(1-clamp((T-(1.6))/0.34,0,1),4))" y="=540+(0*pow(1-clamp((T-(1.6))/0.34,0,1),4))" opacity="=lerp(0.35,1,clamp((T-(1.6))/0.15,0,1))" blur="=8*pow(1-clamp((T-(1.6))/0.34,0,1),2)"><group x="-960" y="-540"><text x="960" y="540" size="190" weight="800" font="Inter" align="center" fill="#ffd36b" text="Build it."/><text x="960" y="682.5" size="40" weight="600" align="center" fill="#ffd36b" text="step two"/></group></group></group></group></group><group when="=T&gt;=3"><group x="=960+(230*pow(1-clamp((T-(3))/0.34,0,1),4))" y="=540+(0*pow(1-clamp((T-(3))/0.34,0,1),4))" opacity="=lerp(0.35,1,clamp((T-(3))/0.15,0,1))" blur="=8*pow(1-clamp((T-(3))/0.34,0,1),2)"><group x="-960" y="-540"><text x="960" y="540" size="190" weight="800" font="Inter" align="center" fill="#5fd39a" text="Ship it."/><text x="960" y="682.5" size="40" weight="600" align="center" fill="#5fd39a" text="step three"/></group></group></group>
<group x="36" y="950"><rect w="321" h="94" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Cut the Curve"/><text x="24" y="66" size="21" fill="#c9d1e0" text="cut-the-curve · ✅ native"/></group>
</scene>
<scene id="cut-the-curve--inverse-zoom-through" dur="4.4" chapter="Inverse Zoom-Through">
