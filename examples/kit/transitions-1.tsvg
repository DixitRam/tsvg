<rect x="0" y="0" w="1920" h="1080" fill="#0d0f14"/><group when="=T&lt;1.956"><text x="=240-230*pow(clamp((T-(1.616))/0.34,0,1),4)" y="540" size="150" weight="800" font="Inter" fill="#f4f6fb" text="Every" opacity="=1-clamp((T-(1.616))/0.18,0,1)"/></group><group when="=T&lt;1.978"><text x="=720-230*pow(clamp((T-(1.638))/0.34,0,1),4)" y="540" size="150" weight="800" font="Inter" fill="#f4f6fb" text="word" opacity="=1-clamp((T-(1.638))/0.18,0,1)"/></group><group when="=T&lt;2"><text x="=1113-230*pow(clamp((T-(1.66))/0.34,0,1),4)" y="540" size="150" weight="800" font="Inter" fill="#f4f6fb" text="leaves" opacity="=1-clamp((T-(1.66))/0.18,0,1)"/></group><group when="=T&gt;=2"><text x="=130.5+230*pow(1-clamp((T-(2))/0.3,0,1),4)" y="540" size="150" weight="800" font="Inter" fill="#ffd36b" text="and" opacity="=lerp(0.35,1,clamp((T-(2))/0.12,0,1))"/></group><group when="=T&gt;=2.05"><text x="=436.5+230*pow(1-clamp((T-(2.05))/0.3,0,1),4)" y="540" size="150" weight="800" font="Inter" fill="#ffd36b" text="the" opacity="=lerp(0.35,1,clamp((T-(2.05))/0.12,0,1))"/></group><group when="=T&gt;=2.092"><text x="=742.5+230*pow(1-clamp((T-(2.092))/0.3,0,1),4)" y="540" size="150" weight="800" font="Inter" fill="#ffd36b" text="next" opacity="=lerp(0.35,1,clamp((T-(2.092))/0.12,0,1))"/></group><group when="=T&gt;=2.127"><text x="=1135.5+230*pow(1-clamp((T-(2.127))/0.3,0,1),4)" y="540" size="150" weight="800" font="Inter" fill="#ffd36b" text="arrives" opacity="=lerp(0.35,1,clamp((T-(2.127))/0.12,0,1))"/></group>
<group x="36" y="950"><rect w="321" h="94" r="14" fill="#0b0d12c8"/><text x="24" y="32" size="28" weight="700" fill="#ffffff" text="Waterfall Cut"/><text x="24" y="66" size="21" fill="#c9d1e0" text="cut-the-curve · ✅ native"/></group>
</scene>
