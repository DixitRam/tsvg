<rect x="0" y="0" w="1920" h="1080" fill="#0d0f14"/><group when="=T&lt;1.8"><group x="960" y="540" scale="=1-0.2*pow(clamp((T-(1.6))/0.2,0,1),3)" blur="=10*clamp((T-(1.6))/0.2,0,1)" opacity="=1-0.85*clamp((T-(1.6))/0.2,0,1)"><group x="-960" y="-540"><text x="960" y="540" size="150" weight="800" font="Inter" align="center" fill="#f4f6fb" text="Then it grew."/></group></group></group><group when="=T&gt;=1.8"><group x="960" y="540" scale="=1.25-0.25*(1-pow(2,-10*clamp((T-(1.8))/0.5,0,1)))" blur="=10*(1-(1-pow(2,-10*clamp((T-(1.8))/0.5,0,1))))" opacity="=0.15+0.85*(1-pow(2,-10*clamp((T-(1.8))/0.5,0,1)))"><group x="-960" y="-540"><text x="960" y="540" size="210" weight="800" font="Inter" align="center" fill="#ffd36b" text="10,000 teams"/></group></group></group>
