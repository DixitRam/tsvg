<rect x="0" y="0" w="1920" h="1080" fill="#0d0f14"/><group when="=T&lt;1.9"><group x="960" y="540" scale="=1+0.2*pow(clamp((T-(1.7))/0.2,0,1),3)" blur="=10*clamp((T-(1.7))/0.2,0,1)" opacity="=1-0.85*clamp((T-(1.7))/0.2,0,1)"><group x="-960" y="-540"><text x="960" y="540" size="170" weight="800" font="Inter" align="center" fill="#f4f6fb" text="Go deeper"/></group></group></group><group when="=T&gt;=1.9"><group x="960" y="540" scale="=0.75+0.25*(1-pow(2,-10*clamp((T-(1.9))/0.5,0,1)))" blur="=10*(1-(1-pow(2,-10*clamp((T-(1.9))/0.5,0,1))))" opacity="=0.15+0.85*(1-pow(2,-10*clamp((T-(1.9))/0.5,0,1)))"><group x="-960" y="-540"><text x="960" y="540" size="170" weight="800" font="Inter" align="center" fill="#7aa2ff" text="into the data"/></group></group></group>
