)"/><path d="M -200 780 C 300 730 700 840 1000 780 C 1300 720 1650 830 2150 780" fill="none" stroke="#ffffff" sw="5" opacity="0.25" dash="30 18" draw="=clamp((T-(1.61))/0.42,0,1)"/><path d="M -200 860 C 300 810 700 920 1000 860 C 1300 800 1650 910 2150 860" fill="none" stroke="#ffffff" sw="5" opacity="0.25" dash="37 23" draw="=clamp((T-(1.61))/0.42,0,1)"/><path d="M -200 940 C 300 890 700 1000 1000 940 C 1300 880 1650 990 2150 940" fill="none" stroke="#ffffff" sw="5" opacity="0.25" dash="44 28" draw="=clamp((T-(1.61))/0.42,0,1)"/><path d="M -200 1020 C 300 970 700 1080 1000 1020 C 1300 960 1650 1070 2150 1020" fill="none" stroke="#ffffff" sw="5" opacity="0.25" dash="51 33" draw="=clamp((T-(1.61))/0.42,0,1)"/></group>
