    <scene id="motion-graphics--caption-particle-burst" dur="4.8" chapter="Caption block: caption-particle-burst"><sfx at="1.6" src="pop"/><sfx at="1.62" src="whoosh" vol="0.5"/><rect w="1920" h="1080" fill="#0c0a08"/><text x="960" y="540" size="240" font="Anton" align="center" fill="#ffb347" at="0.2" dur="1.4" text="SPARK"><anim prop="scale" from="0.8" to="1" at="0" dur="0.3" ease="back"/></text><circle repeat="140" x="=960 + (rand(i)-0.5)*700 + cos(i*2.4)*900*ease((T-1.6)/1.0,&quot;out&quot;)*rand(i*5)" y="=540 + (rand(i*3)-0.5)*200 + sin(i*2.4)*600*ease((T-1.6)/1.0,&quot;out&quot;)*rand(i*5)" r="=3 + 5*rand(i*7)" fill="=i%3 ? &quot;#ffb347&quot; : &quot;#ff5f2e&quot;" at="1.6" opacity="=1 - ease((T-1.6)/1.2,&quot;in&quot;)"/><circle repeat="140" x="=lerp(960 + cos(i*1.7)*1000*rand(i*2), 960 + (rand(i*11)-0.5)*700, ease((T-2.4)/0.8,&quot;out&quot;))" y="=lerp(540 + sin(i*1.7)*700*rand(i*2), 540 + (rand(i*13)-0.5)*200, ease((T-2.4)/0.8,&quot;out&quot;))" r="=3 + 4*rand(i*9)" fill="#fff1c2" at="2.4" dur="0.95"/><text x="960" y="540" size="240" font="Anton" align="center" fill="#fff1c2" at="3.15" text="FLAME" shadow="0 0 30 #ff5f2e"><anim prop="opacity" from="0" to="1" at="0" dur="0.25"/><anim prop="scale" from="1.1" to="1" at="0" dur="0.3" ease="out"/></text><group x="24" y="24" id="label"><anim prop="opacity" from="0" to="1" at="0" dur="0.3"/><rect w="492.8" h="84" r="14" fill="#0b0d12d9" stroke="#ffffff26" sw="1.5"/><text x="18" y="27" size="26" weight="700" fill="#ffffff" text="Caption block: caption-particle-burst"/><text x="18" y="59" size="19" weight="500" font="JetBrains Mono" fill="#ffffffaa" text="/motion-graphics"/><rect x="214.4" y="46" w="97.8" h="27" r="13.5" fill="#1e8e4e"/><text x="263.3" y="60" size="17" weight="700" align="center" fill="#ffffff" text="✅ native"/></group></scene>
    <scene id="motion-graphics--caption-other" dur="5.2" chapter="Other caption-* blocks"><sfx at="0.3" src="typing" vol="0.4"/><rect w="1920" h="1080" fill="#0e1117"/><group x="500" y="370"><rect x="-440" y="-200" w="880" h="400" r="18" fill="#161a22" stroke="#ffffff1a" sw="2"/><text x="-410" y="-165" size="24" font="JetBrains Mono" fill="#7aa2ff" text="caption-glitch-rgb"/><group><text x="=6 + (fract(T*1.3) &lt; 0.08 ? (rand(floor(T*40))-0.5)*40 : 0)" y="20" size="110" weight="900" align="center" fill="#ff2e5b" blend="lighter" opacity="0.7" text="GLITCH"/><text x="=-6 + (fract(T*1.3) &lt; 0.08 ? (rand(floor(T*40))-0.5)*40 : 0)" y="20" size="110" weight="900" align="center" fill="#2ee6ff" blend="lighter" opacity="0.7" text="GLITCH"/><text x="=0 + (fract(T*1.3) &lt; 0.08 ? (rand(floor(T*40))-0.5)*40 : 0)" y="20" size="110" weight="900" align="center" fill="#ffffff" opacity="1" text="GLITCH"/></group></group><group x="1420" y="370"><rect x="-440" y="-200" w="880" h="400" r="18" fill="#161a22" stroke="#ffffff1a" sw="2"/><text x="-410" y="-165" size="24" font="JetBrains Mono" fill="#7aa2ff" text="caption-pill-karaoke"/><group><group><rect x="-186.75" y="-22" w="117.9" h="76" r="38" fill="#7c5cff" opacity="=floor((T*1.6) % 4) == 0 ? 1 : 0"/><text x="-127.8" y="16" size="56" weight="700" align="center" fill="#ffffff" text="say"/></group><group><rect x="-84.85" y="-22" w="62.8" h="76" r="38" fill="#7c5cff" opacity="=floor((T*1.6) % 4) == 1 ? 1 : 0"/><text x="-53.45" y="16" size="56" weight="700" align="center" fill="#ffffff" text="it"/></group><group><rect x="-38.05" y="-22" w="116.5" h="76" r="38" fill="#7c5cff" opacity="=floor((T*1.6) % 4) == 2 ? 1 : 0"/><text x="20.2" y="16" size="56" weight="700" align="center" fill="#ffffff" text="like"/></group><group><rect x="62.45" y="-22" w="124.3" h="76" r="38" fill="#7c5cff" opacity="=floor((T*1.6) % 4) == 3 ? 1 : 0"/><text x="124.6" y="16" size="56" weight="700" align="center" fill="#ffffff" text="this"/></group></group></group><group x="500" y="820"><rect x="-440" y="-200" w="880" h="400" r="18" fill="#161a22" stroke="#ffffff1a" sw="2"/><text x="-410" y="-165" size="24" font="JetBrains Mono" fill="#7aa2ff" text="caption-typewriter"/><text x="-360" y="20" size="64" font="JetBrains Mono" fill="#e6edf3" text="one key at a time" reveal="=clamp(fract(T/2.6)*1.6, 0, 1)"/></group><group x="1420" y="820"><rect x="-440" y="-200" w="880" h="400" r="18" fill="#161a22" stroke="#ffffff1a" sw="2"/><text x="-410" y="-165" size="24" font="JetBrains Mono" fill="#7aa2ff" text="caption-bounce"/><group><text x="-224.8" y="=20 - 50*abs(sin(T*3 + 0))" size="80" weight="900" align="center" fill="#ffe14d" text="hop"/><text x="-62.1" y="=20 - 50*abs(sin(T*3 + 0.7))" size="80" weight="900" align="center" fill="#47e5bc" text="hop"/><text x="162.7" y="=20 - 50*abs(sin(T*3 + 1.4))" size="80" weight="900" align="center" fill="#ff7a59" text="hooray"/></group></group><group x="24" y="24" id="label"><anim prop="opacity" from="0" to="1" at="0" dur="0.3"/><rect w="346.2" h="112" r="14" fill="#0b0d12d9" stroke="#ffffff26" sw="1.5"/><text x="18" y="27" size="26" weight="700" fill="#ffffff" text="Other caption-* blocks"/><text x="18" y="59" size="19" weight="500" font="JetBrains Mono" fill="#ffffffaa" text="/motion-graphics"/><rect x="214.4" y="46" w="97.8" h="27" r="13.5" fill="#1e8e4e"/><text x="263.3" y="60" size="17" weight="700" align="center" fill="#ffffff" text="✅ native"/><text x="18" y="92" size="18" weight="500" italic="1" fill="#ffd58a" text="4 of the 17 caption-* blocks sampled"/></group></scene>
    <scene id="motion-graphics--caption-weight-shift" dur="4.8" chapter="Caption block: caption-weight-shift"><sfx at="0.3" src="whoosh" vol="0.4"/><rect w="1920" h="1080" fill="#f2f2ef"/><text x="529.5" y="540" size="160" align="center" fill="#14161c" at="0.2" text="light" weight="=round(lerp(100, 900, 0.5 + 0.5*sin(T*2.2 - 0)))"><anim prop="opacity" from="0" to="1" at="0" dur="0.3"/></text><text x="858.75" y="540" size="160" align="center" fill="#14161c" at="0.45" text="to" weight="=round(lerp(100, 900, 0.5 + 0.5*sin(T*2.2 - 0.9)))"><anim prop="opacity" from="0" to="1" at="0" dur="0.3"/></text><text x="1289.25" y="540" size="160" align="center" fill="#14161c" at="0.7" text="HEAVY" weight="=round(lerp(100, 900, 0.5 + 0.5*sin(T*2.2 - 1.8)))"><anim prop="opacity" from="0" to="1" at="0" dur="0.3"/></text><text x="960" y="760" size="40" font="JetBrains Mono" align="center" fill="#14161c99" text="=&quot;wght &quot; + round(lerp(100, 900, 0.5 + 0.5*sin(T*2.2)))"/><group x="24" y="24" id="label"><anim prop="opacity" from="0" to="1" at="0" dur="0.3"/><rect w="586.8" h="112" r="14" fill="#0b0d12d9" stroke="#ffffff26" sw="1.5"/><text x="18" y="27" size="26" weight="700" fill="#ffffff" text="Caption block: caption-weight-shift"/><text x="18" y="59" size="19" weight="500" font="JetBrains Mono" fill="#ffffffaa" text="/motion-graphics"/><rect x="214.4" y="46" w="95.8" h="27" r="13.5" fill="#b8730a"/><text x="262.3" y="60" size="17" weight="700" align="center" fill="#ffffff" text="◐ partial"/><text x="18" y="92" size="18" weight="500" italic="1" fill="#ffd58a" text="weight set per frame on variable Inter (smooth in the web engine)"/></group></scene>
